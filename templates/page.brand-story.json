    "brand_about_values_KAahqc": {
      "type": "brand-about-values",
      "blocks": {
        "item_XqzNaG": {
          "type": "item",
          "settings": {
            "title": "Modern Luxury",
            "text": "Fine jewelry should fit naturally into modern life.\nIt can belong at a wedding, at dinner, at work, or with a T-shirt and jeans. A piece does not need to wait for an occasion to feel special."
          }
        },
        "item_pkeMmx": {
          "type": "item",
          "settings": {
            "title": "Timeless Design",
            "text": "We prefer good proportion over novelty.\n\nTrends can be useful references, but they are not the reason a piece should exist. The goal is to create jewelry that still feels right after the trend around it has moved on."
          }
        },
        "item_wRMgbR": {
          "type": "item",
          "settings": {
            "title": "Personal Meaning",
            "text": "We can design the jewelry. We cannot decide what it will come to mean to you.\nThat part happens later — through the proposal, the anniversary, the ordinary day, the person who gave it to you, or the years you spend wearing it."
          }
        },
        "item_4YHBVB": {
          "type": "item",
          "settings": {
            "title": "Honest Value",
            "text": "We want more of what you spend to be present in the jewelry itself — in the diamond, the gold, the design, and the work required to make the piece well.\n\nThese principles guide what we make, but also what we leave out."
          }
        }
      },
      "block_order": [
        "item_XqzNaG",
        "item_pkeMmx",
        "item_wRMgbR",
        "item_4YHBVB"
      ],
