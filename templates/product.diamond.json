          "settings": {
            "title": "Clarity",
            "content": "{clarity}",
            "intro": "",
            "learn_more_link": "",
            "learn_more_text": "Learn More",
            "description": "<p>Clarity in a diamond refers to the presence of imperfections within the stone, stemming from the crystallization process in the controlled laboratory environment. As lab-grown diamonds are formed, they may occasionally contain minute traces of natural elements, known as inclusions, which can affect their clarity.</p>",
            "intro_position_left": 10,
            "image": "shopify://shop_images/The_4Cs_of_Your_Diamond_Diamond_Clarity.webp"
          }
        }
