                      ]
                    },
                    "accordion_row_Ft7pUt": {
                      "type": "_accordion-row",
                      "settings": {
                        "heading": "What lab grown diamond shapes are available?",
                        "open_by_default": false,
                        "icon": "none",
                        "width": 20
                      },
                      "blocks": {
                        "text_Ay6bjt": {
                          "type": "text",
                          "settings": {
                            "text": "<p>We offer a full range of diamond shapes, each precision-cut to maximize brilliance and light performance:</p><ul><li>The Classics: Round Brilliant, Princess, and Cushion</li><li>The Elongated: Oval, Pear, and Marquise</li><li>The Architectural: Emerald, Radiant, and Asscher</li><li>The Romantic: The symbolic Heart shape</li></ul>",
                            "width": "100%",
                            "max_width": "none",
