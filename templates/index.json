    "section_RKqE8L": {
      "type": "section",
      "blocks": {
        "accordion_Nr78Le": {
          "type": "accordion",
          "name": "t:names.accordion",
          "settings": {
            "icon": "caret",
            "dividers": true,
            "type_preset": "h6",
            "inherit_color_scheme": false,
            "color_scheme": "scheme-58084d4c-a86e-4d0a-855e-a0966e5043f7",
