                      ]
                    },
                    "accordion_row_DrCnnX": {
                      "type": "_accordion-row",
                      "name": "t:names.accordion_row",
                      "settings": {
                        "heading": "Do lab grown diamonds get cloudy or change color over time?",
                        "open_by_default": false,
                        "icon": "none",
                        "width": 20
                      },
                      "blocks": {
                        "text_iFeXJq": {
                          "type": "text",
                          "settings": {
                            "text": "<p>Never. Unlike diamond simulants like cubic zirconia, lab grown diamonds are permanent gemstones. They do not cloud, fade, or change color. A lab grown diamond will remain as brilliant decades from now as it was on the day you first wore it.</p>",
                            "width": "100%",
                            "max_width": "none",
                            "alignment": "left",
                            "type_preset": "rte",
                            "font": "var(--font-body--family)",
                            "font_size": "1rem",
                            "line_height": "normal",
                            "letter_spacing": "normal",
                            "case": "none",
                            "wrap": "pretty",
                            "color": "var(--color-foreground)",
