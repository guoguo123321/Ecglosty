                    "accordion_row_gKAcyw": {
                      "type": "_accordion-row",
                      "name": "t:names.accordion_row",
                      "settings": {
                        "heading": "Why are lab grown diamonds more affordable than mined diamonds?",
                        "open_by_default": false,
                        "icon": "none",
                        "width": 20
                      },
                      "blocks": {
                        "text_NpymNq": {
                          "type": "text",
                          "settings": {
                            "text": "<p>Lab grown diamonds are more accessible because they have a shorter and more efficient supply chain. By removing the high costs of traditional mining and multiple middle-men, we can pass those savings directly to you. This allows you to choose a larger or higher-quality diamond for your budget.</p>",
                            "width": "100%",
                            "max_width": "none",
                            "alignment": "left",
                            "type_preset": "rte",
                            "font": "var(--font-body--family)",
                            "font_size": "1rem",
