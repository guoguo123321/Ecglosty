{%- doc -%}
  Removes Metal metaobject Variant Color Title values and a preceding "in".
  The same values are exposed as JSON for client-side updates.
  Matching accepts the legacy Whtie spelling without changing merchant data.

  @param {string} [title] - Raw product title
  @param {string} [variant_title] - Optional custom.variant_title override
  @param {string} [output] - Set to metals_json to return the matching values as JSON

  @example
  {% render 'product-style-title', title: 'Necklace in 14K White Gold' %}
{%- enddoc -%}

{%- liquid
  assign style_title = variant_title | default: title | default: '' | strip
  assign metal_entries = shop.metaobjects.variant_color.values
  if metal_entries == blank
    assign metal_entries = shop.metaobjects['variant-color'].values
  endif
  assign metals = metal_entries | map: 'variant_color_title' | map: 'value' | compact | uniq

  if output == 'metals_json'
    echo metals | json
  else

    for metal_value in metals
      assign metal = metal_value | strip
      if metal == blank
        continue
      endif
      # The sentinel preserves the final fragment when a title ends in metal.
      # This spelling correction preserves length, keeping original slices aligned.
      assign searchable_title = style_title | append: '~' | downcase | replace: 'whtie', 'white'
      assign metal_down = metal | downcase | replace: 'whtie', 'white'
      assign parts = searchable_title | split: metal_down
      assign offset = 0
      assign cleaned_title = ''

      for part in parts
        assign original_part = style_title | slice: offset, part.size
        assign cleaned_title = cleaned_title | append: original_part
        assign offset = offset | plus: part.size | plus: metal.size

        unless forloop.last
          assign cleaned_title = cleaned_title | rstrip
          assign preceding_word = cleaned_title | split: ' ' | last | downcase
          if preceding_word == 'in'
            assign remaining_size = cleaned_title.size | minus: 2
            assign cleaned_title = cleaned_title | slice: 0, remaining_size | rstrip
          endif
          assign cleaned_title = cleaned_title | append: ' '
        endunless
      endfor

      assign style_title = cleaned_title | strip
    endfor

    assign words = style_title | split: ' '
    assign style_title = ''
    for word in words
      if word != blank
        unless style_title == blank
          assign style_title = style_title | append: ' '
        endunless
        assign style_title = style_title | append: word
      endif
    endfor
    echo style_title
  endif
-%}
