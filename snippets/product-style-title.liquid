{%- doc -%}
  Returns a collection-friendly product title with metal/color removed from
  the start or end of the title.
  Examples:
  - "Necklace in 18K Rose Gold" → "Necklace"
  - "18K Rose Gold Radiant Bezel Necklace" → "Radiant Bezel Necklace"
  - "Platinum Radiant Bezel Necklace" → "Radiant Bezel Necklace"

  @param {string} title - Raw product title
  @param {string} [variant_title] - Optional custom.variant_title override
{%- enddoc -%}

{%- liquid
  assign style_title = variant_title | default: title | default: '' | strip

  if style_title != blank
    # Longer prefixes first so "18K Rose Gold" wins over "Rose Gold"
    assign metal_prefixes = '18K Rose Gold,18K Yellow Gold,18K White Gold,18K Pink Gold,14K Rose Gold,14K Yellow Gold,14K White Gold,14K Pink Gold,10K Rose Gold,10K Yellow Gold,10K White Gold,10K Pink Gold,9K Rose Gold,9K Yellow Gold,9K White Gold,Sterling Silver,Rose Gold,Yellow Gold,White Gold,Pink Gold,Platinum,Palladium,Silver' | split: ','

    for prefix in metal_prefixes
      assign prefix_spaced = prefix | append: ' '
      assign head = style_title | slice: 0, prefix_spaced.size
      assign head_down = head | downcase
      assign prefix_down = prefix_spaced | downcase
      if head_down == prefix_down
        assign style_title = style_title | remove_first: head | strip
        break
      endif
    endfor

    # Trailing " in <metal>"
    assign title_parts = style_title | split: ' in '
    if title_parts.size > 1
      assign metal_tail = title_parts | last | strip | downcase
      assign looks_like_metal = false
      if metal_tail contains 'gold' or metal_tail contains 'platinum' or metal_tail contains 'silver' or metal_tail contains 'palladium' or metal_tail contains '白金' or metal_tail contains '黄金' or metal_tail contains '玫瑰金' or metal_tail contains '白银'
        assign looks_like_metal = true
      endif
      if looks_like_metal
        assign style_title = ''
        for part in title_parts
          unless forloop.last
            if style_title != blank
              assign style_title = style_title | append: ' in '
            endif
            assign style_title = style_title | append: part
          endunless
        endfor
        assign style_title = style_title | strip
      endif
    endif
  endif

  echo style_title
-%}
