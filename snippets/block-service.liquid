{% doc %}
  Product contact/service bar (Drop a Hint / Email Us / Phone / Live Chat).
  @param {object} block - Section or theme block
  @param {boolean} [report_mode] - Render the diamond report contact card
{% enddoc %}
{% liquid
  assign blo_setts = block.settings
  assign uid = block.id
  assign phone = blo_setts.phone | default: '+1.818.666.6081'
  assign phone_href = phone | replace: ' ', '' | replace: '.', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
%}

{%- capture default_svg_hint -%}
