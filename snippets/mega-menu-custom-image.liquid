{% liquid
  assign item_title = settings.title
  assign item_image = settings.image
%}

<div class="mega-menu-custom__image_itme"{% if shopify_attributes != blank %} {{ shopify_attributes }}{% endif %}>
  {% if item_image != blank %}
    {{
      item_image
      | image_url: width: 1200
      | image_tag:
        loading: 'eager',
        class: 'mega-menu-custom__img',
        widths: '400, 600, 800, 1000, 1200',
        sizes: '(min-width: 990px) 25vw, 45vw',
        alt: item_title
    }}
  {% endif %}
  {% if settings.title1 != blank %}<a class="mega-menu-custom__image_link" href="{{ settings.link1 }}">{{ settings.title1 }}</a>{% endif %}
  {% if settings.title2 != blank %}<a class="mega-menu-custom__image_link" href="{{ settings.link2 }}">{{ settings.title2 }}</a>{% endif %}
</div>
