{%- doc -%}
  Metal / Color metaobject image strip for collection filters.

  @param {object} [filters] - Collection filters for URL matching
  @param {string} [heading_text] - Heading above images (default: Metal)
  @param {string} [filter_style] - 'horizontal' | 'vertical'
  @param {string} [id_prefix] - Prefix to avoid duplicate IDs
  @param {boolean} [deferred] - Drawer: accordion + multi-select
{%- enddoc -%}

{% liquid
  assign panel_heading = heading_text
  if panel_heading == blank
    assign panel_heading = 'Metal'
  endif
%}

{% render 'variant-metaobject-filter',
  metaobject_type: 'variant_color',
  filter_label: 'Color',
  heading_text: panel_heading,
  panel_id: 'metal-shape',
  swatch_row_class: 'variant-metaobject-strip--metal',
  filters: filters,
  filter_style: filter_style,
  id_prefix: id_prefix,
  deferred: deferred
%}
