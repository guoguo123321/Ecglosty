<div class="faq-container {{ block.id }}">
  <div class="faq-header">
    {% for content_item in settings.faqs  %}
      <div class="faq-item">
        <div class="faq-item-title unfold-title" data-deg="180" {%if forloop.index0 %}data-index-open="true"{% endif %}>
          <div class="faq-item-title-title">{{ content_item.title }}</div>
          <div class="faq-item-title-arrow unfold-arrow">
            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="14.6666667px" height="8px" viewBox="0 0 14.6666667 8" version="1.1">
                <g id="页面-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                    <g id="1.-选戒托-戒托列表页" transform="translate(-1568.000000, -2587.000000)" fill="#000000" fill-rule="nonzero">
                        <polygon id="路径备份" points="1568 2588.19999 1569.29411 2587 1575.33333 2592.60002 1581.37256 2587 1582.66667 2588.19999 1575.33333 2595 1568 2588.1998"/>
                    </g>
                </g>
            </svg>
          </div>
        </div>
        <div class="faq-item-content unfold-content">
          <div class="faq-item-inner-content">{{ content_item.content }}</div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
<script type="module">
  import { unfoldArrow } from "{{ 'unit.js' | asset_url }}"
  document.addEventListener("DOMContentLoaded",function(){
    unfoldArrow(document.querySelectorAll(".{{ block.id }} .faq-item .faq-item-title"));
  })
</script>