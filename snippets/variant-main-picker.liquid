  }

  .variant-option__browse-diamonds:hover {
    background: #f5f5f5 !important;
    color: #1a1a1a !important;
  }
{% endstylesheet %}

<script>
  (function () {
    if (window.__ringSizeMoreBound) return;
    window.__ringSizeMoreBound = true;

    var expandedMap = (window.__ringSizeExpandedMap = window.__ringSizeExpandedMap || {});
    var syncedMap = (window.__ringSizeSyncedMap = window.__ringSizeSyncedMap || {});
    var PREFERRED_SIZES = [4.5, 5, 6, 7, 8];

    function getProductId(el) {
      var picker = el && el.closest('variant-picker');
      return picker && picker.dataset.productId ? String(picker.dataset.productId) : 'default';
    }

    function getLabelSize(label) {
      var input = label.querySelector('input');
      return input ? String(input.value).trim() : '';
    }

    function sizesMatch(a, b) {
      var na = parseFloat(a);
      var nb = parseFloat(b);
      if (!isNaN(na) && !isNaN(nb)) return Math.abs(na - nb) < 0.001;
      return String(a).trim() === String(b).trim();
    }

    function getDisplayLabels(labels) {
      var preferred = [];
      PREFERRED_SIZES.forEach(function (preferredSize) {
        for (var i = 0; i < labels.length; i++) {
          if (sizesMatch(getLabelSize(labels[i]), preferredSize)) {
            preferred.push(labels[i]);
            break;
          }
        }
      });

      // Product has none of 4.5/5/6/7/8 → follow product option order (first 5)
      if (preferred.length === 0) {
        return labels.slice(0, 5);
      }

      return preferred;
    }

    function findNearestLabel(displayed, currentValue) {
      var cur = parseFloat(currentValue);
      if (isNaN(cur) || !displayed.length) return displayed[0] || null;

      var best = displayed[0];
      var bestDist = Infinity;
      displayed.forEach(function (label) {
        var size = parseFloat(getLabelSize(label));
        if (isNaN(size)) return;
        var dist = Math.abs(size - cur);
        if (dist < bestDist) {
          bestDist = dist;
          best = label;
        }
      });
      return best;
    }

    function applyRingSizeDisplay(root) {
      (root || document).querySelectorAll('.variant-option--ring-size').forEach(function (fieldset) {
        var labels = Array.prototype.slice.call(
          fieldset.querySelectorAll('.variant-option__button-label')
        );
        var moreBtn = fieldset.querySelector('[data-ring-size-more]');
        var productId = getProductId(fieldset);
        var expanded = !!expandedMap[productId];

        labels.forEach(function (label) {
          label.classList.remove('variant-option__button-label--ring-size-overflow');
        });

        if (expanded) {
          fieldset.classList.add('is-expanded');
          if (moreBtn) moreBtn.hidden = true;
          return;
        }

        fieldset.classList.remove('is-expanded');

        if (labels.length <= 5) {
          if (moreBtn) moreBtn.hidden = true;
          return;
        }

        var displayed = getDisplayLabels(labels);
        labels.forEach(function (label) {
          if (displayed.indexOf(label) === -1) {
            label.classList.add('variant-option__button-label--ring-size-overflow');
          }
        });

        if (moreBtn) moreBtn.hidden = false;

        // Keep collapsed row as preferred sizes (4.5/5/6/7/8).
        // - No ?variant= : once switch to nearest preferred (clean default row)
        // - Has ?variant= : also show the currently selected size if it is outside preferred
        var checkedInput = fieldset.querySelector('input:checked');
        var checkedLabel = checkedInput && checkedInput.closest('.variant-option__button-label');
        if (
          checkedLabel &&
          checkedLabel.classList.contains('variant-option__button-label--ring-size-overflow')
        ) {
          var hasVariantParam = false;
          try {
            hasVariantParam = new URL(window.location.href).searchParams.has('variant');
          } catch (e) {}

          if (!hasVariantParam && !syncedMap[productId]) {
            var nearest = findNearestLabel(displayed, getLabelSize(checkedLabel));
            var nearestInput = nearest && nearest.querySelector('input');
            if (nearestInput && nearestInput !== checkedInput) {
              syncedMap[productId] = true;
              nearestInput.click();
            }
          } else {
            checkedLabel.classList.remove('variant-option__button-label--ring-size-overflow');
          }
        }
      });
    }

    function scheduleApply() {
      requestAnimationFrame(function () {
        applyRingSizeDisplay(document);
      });
    }

    document.addEventListener('click', function (event) {
      var btn = event.target.closest('[data-ring-size-more]');
      if (!btn) return;
      event.preventDefault();
      event.stopPropagation();
      var fieldset = btn.closest('.variant-option--ring-size');
      if (!fieldset) return;
      expandedMap[getProductId(fieldset)] = true;
      fieldset.classList.add('is-expanded');
      fieldset.querySelectorAll('.variant-option__button-label--ring-size-overflow').forEach(function (label) {
        label.classList.remove('variant-option__button-label--ring-size-overflow');
      });
      btn.hidden = true;
    });

    document.addEventListener('variant:update', scheduleApply);
    document.addEventListener('variant:selected', scheduleApply);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', scheduleApply);
    } else {
      scheduleApply();
    }
  })();
</script>
