{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block, featured product block, and the product card block.
  The product object is null or when placeholders are rendered.

  @param {object} product - The product object
  @param {object} children - The children of the product card
  @param {object} [block] - The block object
  @param {number} [product_card_gap] - The gap between the product card children (overrides block settings)
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% style %}
  {% if request.visual_preview_mode %}
    product-card[data-product-transition] {
      width: 100%;
      min-width: 250px;
    }
  {% endif %}
{% endstyle %}

{% liquid
  assign has_quick_add = false
  if settings.quick_add and product.available
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif

  assign product_card_id = 'product-card-link-' | append: block.id | append: '-' | append: product.id
  assign product_card_gap_value = product_card_gap | default: block_settings.product_card_gap

  # Collection Metal/Shape strip filters — prefer matching variant for card link/image.
  assign preferred_metal = ''
  assign preferred_shape = ''
  if request.query_string != blank
    assign qs_decoded = request.query_string | url_decode | replace: '+', ' '
    assign qs_parts = qs_decoded | split: '&'
    for part in qs_parts
      assign kv = part | split: '='
      assign qs_key = kv[0] | strip
      assign qs_val = kv[1] | default: '' | strip
      if qs_key == 'vm_color' and qs_val != blank
        assign preferred_metal = qs_val
      elsif qs_key == 'vm_shape' and qs_val != blank
        assign preferred_shape = qs_val
      endif
    endfor
  endif

  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant

  if preferred_metal != blank or preferred_shape != blank
    assign preferred_metal_handle = preferred_metal | handleize
    assign preferred_shape_handle = preferred_shape | handleize
    assign metal_opt_position = 0
    assign shape_opt_position = 0
    for opt in product.options_with_values
      assign opt_name_down = opt.name | downcase | strip
      if metal_opt_position == 0
        if opt_name_down contains 'metal' or opt_name_down contains 'color' or opt_name_down contains 'colour' or opt_name_down contains '颜色' or opt_name_down contains '金属'
          assign metal_opt_position = opt.position
        endif
      endif
      if shape_opt_position == 0
        if opt_name_down contains 'shape' or opt_name_down contains '形状'
          assign shape_opt_position = opt.position
        endif
      endif
    endfor

    for variant in product.variants
      assign metal_ok = true
      assign shape_ok = true
      if preferred_metal != blank and metal_opt_position > 0
        assign metal_ok = false
        assign metal_key = 'option' | append: metal_opt_position
        assign variant_metal = variant[metal_key] | strip
        assign variant_metal_handle = variant_metal | handleize
        if variant_metal == preferred_metal or variant_metal_handle == preferred_metal_handle
          assign metal_ok = true
        endif
      endif
      if preferred_shape != blank and shape_opt_position > 0
        assign shape_ok = false
        assign shape_key = 'option' | append: shape_opt_position
        assign variant_shape = variant[shape_key] | strip
        assign variant_shape_handle = variant_shape | handleize
        if variant_shape == preferred_shape or variant_shape_handle == preferred_shape_handle
          assign shape_ok = true
        endif
      endif
      if metal_ok and shape_ok
        assign variant_to_link = variant
        break
      endif
    endfor
  endif

  if settings.transition_to_main_product
    assign featured_image = variant_to_link.featured_image
    if featured_image == blank
      assign featured_image = product.featured_media.preview_image
    endif

    if featured_image != blank
      assign featured_media_url = featured_image | image_url: width: 500
    endif
  endif

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif

  assign active_collection = collection

  capture product_card_url
    render 'collection-product-url', url: variant_to_link.url, context_collection: active_collection, product: product
  endcapture
  assign product_card_url = product_card_url | strip

  assign variant_options_json = ''
  unless onboarding or product == blank
    capture variant_options_json
      echo '['
      for option in product.options_with_values
        echo '{'
        echo '"name":'
        echo option.name | json
        echo ',"position":'
        echo option.position | json
        echo ',"values":['
        for value in option.values
          assign value_label = value.name | default: value
          echo value_label | json
          unless forloop.last
            echo ','
          endunless
        endfor
        echo ']}'
        unless forloop.last
          echo ','
        endunless
      endfor
      echo ']'
    endcapture
  endunless

  assign product_group_value = ''
  unless onboarding or product == blank
    assign product_group_value = product.metafields.custom.product_group.value | default: product.metafields.custom.product_group | default: '' | strip
  endunless

  assign card_style_title = product.title
  if template.name == 'collection' or request.page_type == 'collection'
    capture card_style_title
      render 'product-style-title', title: product.title
    endcapture
    assign card_style_title = card_style_title | strip
  endif
%}

<product-card
  class="product-card size-style"
  style="{% render 'size-style', settings: block_settings %}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-style-title="{{ card_style_title | escape }}"
  {% if product_group_value != blank %}
    data-product-group="{{ product_group_value | escape }}"
  {% endif %}
  {% if variant_options_json != blank %}
    data-variant-options="{{ variant_options_json | escape }}"
  {% endif %}
  {% if active_collection != blank %}
    data-collection-handle="{{ active_collection.handle }}"
    data-collection-title="{{ active_collection.title | escape }}"
  {% endif %}
  id="product-card-{{ block.id }}"
  {% if settings.transition_to_main_product %}
    data-product-transition="true"
    data-featured-media-url="{{ featured_media_url }}"
    on:click="/handleViewTransition"
  {% endif %}
  {{ block.shopify_attributes }}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
>
  <a
    id="{{ product_card_id | md5 }}"
    {% unless onboarding %}
      href="{{ product_card_url }}"
    {% endunless %}
    class="product-card__link"
    ref="productCardLink"
  >
    <span class="visually-hidden">
      {{ card_style_title }}
    </span>
  </a>
  <div
    class="
      product-card__content
      layout-panel-flex
      layout-panel-flex--column
      product-grid__card
      spacing-style
      border-style
      gap-style
      {% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}
    "
    style="
      {% render 'border-override', settings: block_settings %}
      {% render 'layout-panel-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
      {% render 'gap-style', value: product_card_gap_value, name: 'product-card-gap' %}
      --quick-add-display: {% if has_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-display: {% if has_mobile_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-opacity: {% if has_mobile_quick_add %}1{% else %}0{% endif %};
      {% if block_settings.padding-inline-start > 0 %}--zoom-out-padding-inline-start: min(var(--padding-xs), {{ block_settings.padding-inline-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-inline-end > 0 %}--zoom-out-padding-inline-end: min(var(--padding-xs), {{ block_settings.padding-inline-end | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-start > 0 %}--zoom-out-padding-block-start: min(var(--padding-xs), {{ block_settings.padding-block-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-end > 0 %}--zoom-out-padding-block-end: min(var(--padding-xs), {{ block_settings.padding-block-end | times: 0.7}}px);{% endif %}
    "
  >
    {{ children }}
  </div>
</product-card>

{% stylesheet %}
  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  .product-grid__item--group-duplicate[hidden],
  .product-grid__item[data-group-duplicate='true'] {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
{% endstylesheet %}
