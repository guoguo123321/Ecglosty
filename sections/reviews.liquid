{% liquid
  assign se_stts = section.settings
  assign set_blo = section.blocks
  assign stt_layout = se_stts.layout
  if stt_layout == 'lgs-container'
    assign html_layout = '<div class="lgs-container">__</div>' | split: '__'
  elsif stt_layout == 'custom-container'
    assign html_layout = '<div class="custom-container">__</div>' | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
  assign show_pag = false
  assign show_nav = false
  if se_stts.show_pagination_pc or se_stts.show_pagination_mb
    assign show_pag = true
  endif
  if se_stts.show_navigation_pc or se_stts.show_navigation_mb
    assign show_nav = true
  endif
%}
<style>
  {%- if se_stts.layout == 'custom-container' -%}
  .{{ section.id }} .custom-container{max-width:{{ se_stts.custom_container }};margin: 0 auto;}
  {%- endif -%}
  {%- liquid
    assign heading_c = se_stts.color_scheme.settings.foreground_heading
    assign subheading_c = se_stts.color_scheme.settings.foreground_subheading
  -%}
  {%- if heading_c != blank and heading_c.alpha != 0.0 -%}
  .{{ section.id }} .lgs-title{--color:var(--color-foreground-heading);color:var(--color-foreground-heading);}
  {%- endif -%}
  {%- if subheading_c != blank and subheading_c.alpha != 0.0 -%}
  .{{ section.id }} .lgs-subtitle{--color:var(--color-foreground-subheading);color:var(--color-foreground-subheading);}
  {%- endif -%}
  .{{ section.id }} .reviews-info{text-align:{{ se_stts.info_align }};{% if se_stts.info_align == 'center' %}padding-left:clamp(20px,2.94117647vw,40px);padding-right:clamp(20px,2.94117647vw,40px);{% elsif se_stts.info_align == 'right' %}padding-left:clamp(20px,2.94117647vw,40px);padding-right:0;{% endif %}}
  .{{ section.id }} .reviews-info .reviews-star{justify-content:{% if se_stts.info_align == 'center' %}center{% elsif se_stts.info_align == 'right' %}flex-end{% else %}flex-start{% endif %};}
  .{{ section.id }} .reviews-info .reviews-title{color:var(--color-foreground-heading);}
  .{{ section.id }} .reviews-info .reviews-star{color:var(--color-star);}
  .{{ section.id }} .swiper-button-prev.common-prev svg rect,
  .{{ section.id }} .swiper-button-next.common-next svg rect{stroke:var(--color-arrow);}
  .{{ section.id }} .swiper-button-prev.common-prev svg path,
  .{{ section.id }} .swiper-button-next.common-next svg path{fill:var(--color-arrow);}
  .{{ section.id }} .swiper-button-prev.common-prev:hover svg rect,
  .{{ section.id }} .swiper-button-next.common-next:hover svg rect{fill:var(--color-arrow-hover);stroke:var(--color-arrow-hover);fill-opacity:1;}
  .{{ section.id }} .swiper-button-prev.common-prev:hover svg path,
  .{{ section.id }} .swiper-button-next.common-next:hover svg path{fill:#ffffff;fill-opacity:1;}
</style>
{% render 'swiper-assets' %}
<div class="{{ section.id }} reviews-box reviews-img-{{ se_stts.image_ratio }} lgs-section-inner color-{{ se_stts.color_scheme }}" {% render 'section_style', se_stts: se_stts -%}>
  {{-html_layout[0]-}}
    {%- render 'section_tophead', se_stts: se_stts -%}
    <div class="reviews-swiper">
      <div class="swiper reviews">
        <div class="swiper-wrapper">
          {% for block in set_blo %}
            {%- assign blo_setts = block.settings -%}
            {%- liquid
              assign is_video = false
              assign embed_url = ''
              if blo_setts.media_type == 'video' and blo_setts.video_url != blank
                assign is_video = true
                if blo_setts.video_url.type == 'youtube'
                  assign embed_url = 'https://www.youtube.com/embed/' | append: blo_setts.video_url.id | append: '?autoplay=1&rel=0'
                elsif blo_setts.video_url.type == 'vimeo'
                  assign embed_url = 'https://player.vimeo.com/video/' | append: blo_setts.video_url.id | append: '?autoplay=1'
                endif
              endif
            -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="reviews-item img-water-box">
                  {% comment %} 图片 / 视频封面 {% endcomment %}
                  {%- if is_video -%}
                    <button type="button" class="reviews-media-trigger" data-reviews-video="{{ embed_url | escape }}" aria-label="Play video">
                      <div class="img-water-ripples">
                        {% if blo_setts.image != blank %}
                          <img src="{{ blo_setts.image | image_url }}" width="{{ blo_setts.image.width }}" height="{{ blo_setts.image.height }}" alt="{{ blo_setts.title | escape }}">
                        {%- else -%}
                          {{ 'blog-apparel-1' | placeholder_svg_tag: 'lgs-placeholder-svg lgs-obj-eff' }}
                        {% endif %}
                        <span class="reviews-play-btn" aria-hidden="true">
                          <svg viewBox="0 0 68 48" width="68" height="48" xmlns="http://www.w3.org/2000/svg">
                            <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="red"></path>
                            <path d="M45 24 27 14v20" fill="#fff"></path>
                          </svg>
                        </span>
                      </div>
                    </button>
                  {%- else -%}
                    {% if blo_setts.image != blank %}
                      <div class="img-water-ripples"><img src="{{ blo_setts.image | image_url }}" width="{{ blo_setts.image.width }}" height="{{ blo_setts.image.height }}" alt="{{ blo_setts.title | escape }}"></div>
                    {%- else -%}
                      <div class="img-water-ripples">{{ 'blog-apparel-1' | placeholder_svg_tag: 'lgs-placeholder-svg lgs-obj-eff' }}</div>
                    {% endif %}
                  {%- endif -%}
                  <div class="reviews-info">
                    <div
                      class="{% render 'lg-typography-classes', settings: se_stts, prefix: 'date_', base_class: 'reviews-date' %}"
                      style="{% render 'lg-typography-style', settings: se_stts, prefix: 'date_' %}"
                    >{{ blo_setts.date }}</div>
                    <div class="reviews-star">
                      {% for sts in (1..blo_setts.star) %}
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="19.0211303px" height="18.0901699px" viewBox="0 0 19.0211303 18.0901699" version="1.1" aria-hidden="true">
                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                <g transform="translate(-332.489435, -3072.000000)" fill="currentColor">
                                    <g transform="translate(260.000000, 2709.000000)">
                                        <g transform="translate(0.000000, 292.000000)">
                                            <g transform="translate(0.000000, 71.000000)">
                                                <polygon points="82 15 76.1221475 18.0901699 77.2447174 11.545085 72.4894348 6.90983006 79.0610737 5.95491503 82 0 84.9389263 5.95491503 91.5105652 6.90983006 86.7552826 11.545085 87.8778525 18.0901699"/>
                                            </g>
                                        </g>
                                    </g>
                                </g>
                            </g>
                        </svg>
                      {% endfor %}
                    </div>
                    <div class="reviews-title">{{ blo_setts.title }}</div>
                    <div
                      class="{% render 'lg-typography-classes', settings: se_stts, prefix: 'content_', base_class: 'reviews-content' %}"
                      style="{% render 'lg-typography-style', settings: se_stts, prefix: 'content_' %}"
                    >{{ blo_setts.content }}</div>
                    <div
                      class="{% render 'lg-typography-classes', settings: se_stts, prefix: 'name_', base_class: 'reviews-name' %}"
                      style="{% render 'lg-typography-style', settings: se_stts, prefix: 'name_' %}"
                    >{{ blo_setts.name }}</div>
                  </div>
                </div>
            </div>
            {% endfor %}
        </div>
        <div class="reviews-media common-swiper-media{% if se_stts.show_pagination_pc %} has-pag-pc{% endif %}{% if se_stts.show_navigation_pc %} has-nav-pc{% endif %}{% if se_stts.show_pagination_mb %} has-pag-mb{% endif %}{% if se_stts.show_navigation_mb %} has-nav-mb{% endif %} media-align-{{ se_stts.media_align_mb }}">
          {%- if show_pag -%}
          <div class="swiper-pagination reviews-pagination common-swiper-pagination"></div>
          {%- endif -%}
          {%- if show_nav -%}
          <div class="common-swiper-direction">
            <div class="common-prev swiper-button-prev reviews-prev custom-prev">
              <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34">
                <rect x="0.5" y="0.5" width="33" height="33" rx="16.5" fill="none" stroke="#000"/>
                <path fill="#000" d="M20 21.257 19.248 22 14 17l5.248-5 .752.743L15.587 17z"/>
              </svg>
            </div>
            <div class="common-next swiper-button-next reviews-next custom-next">
              <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34">
                <rect x="0.5" y="0.5" width="33" height="33" rx="16.5" fill="none" stroke="#000"/>
                <path fill="#000" d="M14 12.743 14.752 12 20 17l-5.248 5-.752-.743L18.413 17z"/>
              </svg>
            </div>
          </div>
          {%- endif -%}
        </div>
      </div>  
    </div>
  {{-html_layout[1]-}}

  <div class="reviews-video-modal" data-reviews-modal hidden>
    <div class="reviews-video-modal__overlay" data-reviews-modal-close></div>
    <div class="reviews-video-modal__dialog" role="dialog" aria-modal="true" aria-label="Video">
      <button type="button" class="reviews-video-modal__close" data-reviews-modal-close aria-label="Close">&times;</button>
      <div class="reviews-video-modal__frame">
        <iframe src="" title="Review video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>
  </div>
</div>

<script>
themeSwiperReady(function () {

  (function() {
    var root = document.querySelector('.{{ section.id }}.reviews-box');
    if (!root) return;

    new Swiper(root.querySelector('.reviews'), {
      slidesPerView : {{ se_stts.col_dk }},
      loop: true,
      loopAdditionalSlides: 3,
      {%- if show_pag -%}
      pagination: {
        el: root.querySelector('.reviews-pagination'),
        clickable: true,
      },
      {%- endif -%}
      {%- if show_nav -%}
      navigation: {
        nextEl: root.querySelector('.reviews-next'),
        prevEl: root.querySelector('.reviews-prev'),
      },
      {%- endif -%}
      {%- if se_stts.autoplay -%}
      autoplay: {
        delay: {{ se_stts.autoplay_speed | times: 1000 }},
        pauseOnMouseEnter: true,
        disableOnInteraction: false,
      },
      {%- endif -%}
       breakpointsBase: 'container',
       breakpoints: { 
         0: { slidesPerView: {{ se_stts.col_mb }}, spaceBetween: 8 },
         768: { slidesPerView: {{ se_stts.col_tb }}, spaceBetween: 8 },
         1025: { slidesPerView: {{ se_stts.col_dk }}, spaceBetween: 25 }
       },
    });

    var modal = root.querySelector('[data-reviews-modal]');
    var iframe = modal && modal.querySelector('iframe');
    if (!modal || !iframe) return;

    function openModal(url) {
      iframe.src = url;
      modal.hidden = false;
      document.documentElement.classList.add('reviews-modal-open');
    }
    function closeModal() {
      modal.hidden = true;
      iframe.src = '';
      document.documentElement.classList.remove('reviews-modal-open');
    }

    root.addEventListener('click', function(e) {
      var trigger = e.target.closest('[data-reviews-video]');
      if (trigger && root.contains(trigger)) {
        e.preventDefault();
        var url = trigger.getAttribute('data-reviews-video');
        if (url) openModal(url);
        return;
      }
      if (e.target.closest('[data-reviews-modal-close]')) closeModal();
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });
  })();
}, '.{{ section.id }}');
</script>
{% schema %}
  {
    "name": "reviews",
    "class": "shopify-reviews",
    "tag": "section",
    "settings": [
      {"type": "select","id": "layout","label": "layout","default":"lgs-container",
        "options": [
          {"label":"lgs-container","value": "lgs-container"},
          {"label":"wrapped container","value": "wrapped-container"},
          {"label":"custom container","value": "custom-container"},
        ]
      },
      {"type": "text","id": "custom_container","label": "custom container","default": "1200px"},

      {"type": "select","id": "col_dk","label": "Items per row","default": "3",
        "options": [
          {"value": "1","label": "1"},
          {"value": "2","label": "2"},
          {"value": "3","label": "3"},
          {"value": "4","label": "4"},
          {"value": "5","label": "5"},
          {"value": "6","label": "6"}
        ]
      },
      {"type": "select","id": "col_tb","label": "Items per row (Tablet)","default": "2",
        "options": [
          {"value": "1","label": "1"},
          {"value": "2","label": "2"},
          {"value": "3","label": "3"},
          {"value": "4","label": "4"}
        ]
      },
      {"type": "select","id": "col_mb","label": "Items per row (Mobile)","default": "2",
        "options": [
          {"value": "1","label": "1"},
          {"value": "2","label": "2"}
        ]
      },

      {"type": "header","content": "Swiper controls"},
      {"type": "checkbox","id": "show_pagination_pc","label": "Show pagination (PC)","default": false},
      {"type": "checkbox","id": "show_navigation_pc","label": "Show navigation arrows (PC)","default": true},
      {"type": "checkbox","id": "show_pagination_mb","label": "Show pagination (Mobile)","default": false},
      {"type": "checkbox","id": "show_navigation_mb","label": "Show navigation arrows (Mobile)","default": true},
      {"type": "select","id": "media_align_mb","label": "Controls align (Mobile)","default": "between",
        "options": [
          {"value": "start","label": "Left"},
          {"value": "center","label": "Center"},
          {"value": "end","label": "Right"},
          {"value": "between","label": "Space between"}
        ]
      },
      {"type": "checkbox","id": "autoplay","label": "Autoplay","default": false},
      {"type": "range","id": "autoplay_speed","label": "Autoplay speed","min": 2,"max": 10,"step": 1,"unit": "s","default": 4,
        "visible_if": "{{ section.settings.autoplay }}"
      },

      {"type": "header","content": "Image style"},
      {"type": "select","id": "image_ratio","label": "Image ratio","default": "landscape",
        "options": [
          {"value": "landscape","label": "Landscape (横长方形)"},
          {"value": "portrait","label": "Portrait (竖长方形)"}
        ]
      },

      {"type": "header","content": "Info align"},
      {"type": "select","id": "info_align","label": "Reviews info align","default": "left",
        "options": [
          {"value": "left","label": "Left"},
          {"value": "center","label": "Center"},
          {"value": "right","label": "Right"}
        ]
      },

      {"type": "header","content": "Colors"},
      {"type": "color_scheme","id": "color_scheme","label": "t:settings.color_scheme","default": "scheme-1","info": "Navigation arrows and review title/star. Date / content / name colors come from Typography below. Section heading uses Headings / Sub heading when set; otherwise Config Header"},

      {"type": "header","content": "Date typography"},
      {
        "type": "select",
        "id": "date_type_preset",
        "label": "t:settings.preset",
        "options": [
          {"value": "rte","label": "t:options.default"},
          {"value": "paragraph","label": "t:options.paragraph"},
          {"value": "h1","label": "t:options.h1"},
          {"value": "h2","label": "t:options.h2"},
          {"value": "h3","label": "t:options.h3"},
          {"value": "h4","label": "t:options.h4"},
          {"value": "h5","label": "t:options.h5"},
          {"value": "h6","label": "t:options.h6"},
          {"value": "custom","label": "t:options.custom"}
        ],
        "default": "rte",
        "info": "t:info.edit_presets_in_theme_settings"
      },
      {
        "type": "select",
        "id": "date_font",
        "label": "t:settings.font",
        "options": [
          {"value": "var(--font-body--family)","label": "t:options.body"},
          {"value": "var(--font-subheading--family)","label": "t:options.subheading"},
          {"value": "var(--font-heading--family)","label": "t:options.heading"},
          {"value": "var(--font-accent--family)","label": "t:options.accent"}
        ],
        "default": "var(--font-body--family)",
