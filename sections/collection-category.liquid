{% liquid
  assign se_stts = section.settings
  assign set_blo = section.blocks
  assign stt_layout = se_stts.layout
  if stt_layout == 'lgs-container'
    assign html_layout = '<div class="lgs-container">__</div>' | split: '__'
  elsif stt_layout == 'custom-container'
    assign html_layout = '<div class="custom-container">__</div>' | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
  assign image = set_blo | where:"type","image"
  assign text = set_blo | where:"type","text"
%}
<style>
  {%- if se_stts.layout == 'custom-container' -%}
  .{{ section.id }} .custom-container{max-width:{{ se_stts.custom_container }};margin: 0 auto;}
  {%- endif -%}
  {%- liquid
    assign heading_c = se_stts.color_scheme.settings.foreground_heading
    assign subheading_c = se_stts.color_scheme.settings.foreground_subheading
  -%}
  {%- if heading_c != blank and heading_c.alpha != 0.0 -%}
  .{{ section.id }} .lgs-title{--color:var(--color-foreground-heading);color:var(--color-foreground-heading);}
  {%- endif -%}
  {%- if subheading_c != blank and subheading_c.alpha != 0.0 -%}
  .{{ section.id }} .lgs-subtitle{--color:var(--color-foreground-subheading);color:var(--color-foreground-subheading);}
  {%- endif -%}
  .{{ section.id }}.collection-category-box{background:var(--bg-gradient);background-color:var(--bg-color);}
  .{{ section.id }} .collection-category-title{color:var(--color-foreground);}
  .{{ section.id }} .collection-category-item a{color:var(--color-primary);text-decoration:none;}
  .{{ section.id }} .collection-category-item a .collection-category-title{color:var(--color-foreground);}
  .{{ section.id }} .collection-category-item a:hover .collection-category-title{color:var(--color-primary);}
  .{{ section.id }} .collection-category-item:hover img{border-color:var(--color-border);}
  /* 首屏未 init 前预留横滑，避免系列切换时纵向堆叠闪动 */
  .{{ section.id }} .collection-category:not(.swiper-initialized){overflow:hidden;}
  .{{ section.id }} .collection-category:not(.swiper-initialized) .swiper-wrapper{display:flex;}
  .{{ section.id }} .collection-category:not(.swiper-initialized) .swiper-slide{flex-shrink:0;box-sizing:border-box;width:calc((100% - {{ se_stts.col_mb | minus: 1 | times: 4 }}px) / {{ se_stts.col_mb }});}
  @media (min-width:768px){
    .{{ section.id }} .collection-category:not(.swiper-initialized) .swiper-slide{width:calc((100% - {{ se_stts.col_tb | minus: 1 | times: 4 }}px) / {{ se_stts.col_tb }});}
  }
  @media (min-width:1025px){
    .{{ section.id }} .collection-category:not(.swiper-initialized) .swiper-slide{width:calc((100% - {{ se_stts.col_dk | minus: 1 | times: 12 }}px) / {{ se_stts.col_dk }});}
  }
</style>
{% render 'swiper-assets', critical: true %}
<div class="{{ section.id }} collection-category-box lgs-section-inner color-{{ se_stts.color_scheme }}" {% render 'section_style', se_stts: se_stts -%}>
  {{-html_layout[0]-}}
    {%- render 'section_tophead', se_stts: se_stts -%}
    <div class="collection-category-swiper">
      <div class="swiper collection-category">
        <div class="swiper-wrapper">
          {% for block in set_blo %}
            {%- assign blo_setts = block.settings -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="collection-category-item">
                {%- if blo_setts.link != blank -%}
                  <a href="{{ blo_setts.link }}">
                {%- endif -%}
                  {% comment %} 图片 {% endcomment %}
                  {% if blo_setts.image != blank %}
                    <img src="{{ blo_setts.image | image_url }}" width="{{ blo_setts.image.width }}" height="{{ blo_setts.image.height }}" alt="{{ blo_setts.title | escape }}">
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'lgs-placeholder-svg lgs-obj-eff' }}
                  {% endif %}
                  <div class="collection-category-info">
                    <div class="collection-category-title">{{ blo_setts.title }}</div>
                  </div>
                {%- if blo_setts.link != blank -%}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="swiper-button-prev collection-category-prev"></div>
        <div class="swiper-button-next collection-category-next"></div>
      </div>
    </div>
  {{-html_layout[1]-}}
</div>

<script>
themeSwiperReady(function () {

  new Swiper('.{{ section.id }} .collection-category', {
    slidesPerView: {{ se_stts.col_dk }},
    navigation: {
      nextEl: '.{{ section.id }} .collection-category-next',
      prevEl: '.{{ section.id }} .collection-category-prev',
    },
    breakpointsBase: 'container',
    breakpoints: {
      0: {
        slidesPerView: {{ se_stts.col_mb }},
        spaceBetween: 4
      },
      768: {
        slidesPerView: {{ se_stts.col_tb }},
        spaceBetween: 4
      },
      1025: {
        slidesPerView: {{ se_stts.col_dk }},
        spaceBetween: 12
      }
    },
  })
});
</script>
