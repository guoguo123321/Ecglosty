{% liquid
  assign se_stts = section.settings
  assign set_blo = section.blocks
  assign stt_layout = se_stts.layout
  if stt_layout == 'lgs-container'
    assign html_layout = '<div class="lgs-container">__</div>' | split: '__'
  elsif stt_layout == 'custom-container'
    assign html_layout = '<div class="custom-container">__</div>' | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
  assign show_pag = false
  assign show_nav = false
  if se_stts.show_pagination_pc or se_stts.show_pagination_mb
    assign show_pag = true
  endif
  if se_stts.show_navigation_pc or se_stts.show_navigation_mb
    assign show_nav = true
  endif
%}
<style>
  {%- if se_stts.layout == 'custom-container' -%}
  .{{ section.id }} .custom-container{max-width:{{ se_stts.custom_container }};margin: 0 auto;}
  {%- endif -%}
  {%- liquid
    assign heading_c = se_stts.color_scheme.settings.foreground_heading
    assign subheading_c = se_stts.color_scheme.settings.foreground_subheading
  -%}
  {%- if heading_c != blank and heading_c.alpha != 0.0 -%}
  .{{ section.id }} .lgs-title{--color:var(--color-foreground-heading);color:var(--color-foreground-heading);}
  {%- endif -%}
  {%- if subheading_c != blank and subheading_c.alpha != 0.0 -%}
  .{{ section.id }} .lgs-subtitle{--color:var(--color-foreground-subheading);color:var(--color-foreground-subheading);}
  {%- endif -%}
  .{{ section.id }} .collection-diamonds-item:hover .collection-diamonds-title{--color:var(--color-primary-hover);color:var(--color-primary-hover);}
  .{{ section.id }} .swiper-button-prev.common-prev svg rect,
  .{{ section.id }} .swiper-button-next.common-next svg rect{stroke:var(--color-arrow);}
  .{{ section.id }} .swiper-button-prev.common-prev svg path,
  .{{ section.id }} .swiper-button-next.common-next svg path{fill:var(--color-arrow);}
  .{{ section.id }} .swiper-button-prev.common-prev:hover svg rect,
  .{{ section.id }} .swiper-button-next.common-next:hover svg rect{fill:var(--color-arrow-hover);stroke:var(--color-arrow-hover);fill-opacity:1;}
  .{{ section.id }} .swiper-button-prev.common-prev:hover svg path,
  .{{ section.id }} .swiper-button-next.common-next:hover svg path{fill:#ffffff;fill-opacity:1;}
  /* 首屏未 init 前预留横滑，避免切换集合时纵向堆叠闪动 */
  .{{ section.id }} .collection-diamonds:not(.swiper-initialized){overflow:hidden;}
  .{{ section.id }} .collection-diamonds:not(.swiper-initialized) .swiper-wrapper{display:flex;}
  .{{ section.id }} .collection-diamonds:not(.swiper-initialized) .swiper-slide{flex-shrink:0;box-sizing:border-box;width:calc((100% - {{ se_stts.col_mb | minus: 1 | times: 8 }}px) / {{ se_stts.col_mb }});}
  @media (min-width:768px){
    .{{ section.id }} .collection-diamonds:not(.swiper-initialized) .swiper-slide{width:calc((100% - {{ se_stts.col_tb | minus: 1 | times: 8 }}px) / {{ se_stts.col_tb }});}
  }
  @media (min-width:1025px){
    .{{ section.id }} .collection-diamonds:not(.swiper-initialized) .swiper-slide{width:calc((100% - {{ se_stts.col_dk | minus: 1 | times: 15 }}px) / {{ se_stts.col_dk }});}
  }
</style>
{% render 'swiper-assets', critical: true %}
<div class="{{ section.id }} collection-diamonds-box lgs-section-inner color-{{ se_stts.color_scheme }}" {% render 'section_style', se_stts: se_stts -%}>
  {{-html_layout[0]-}}
  {%- render 'section_tophead', se_stts: se_stts -%}
  <div class="collection-diamonds-swiper {{ se_stts.box_align }}">
    <div class="swiper collection-diamonds">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% assign blo_setts = block.settings %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <a class="collection-diamonds-item" href="{{ blo_setts.url }}">
              {% if blo_setts.image != blank %}
                {{
                  blo_setts.image
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    widths: '80,120,160,240,320,400',
                    sizes: '(min-width: 1025px) 10vw, (min-width: 768px) 20vw, 33vw',
                    alt: blo_setts.title,
                    width: blo_setts.image.width,
                    height: blo_setts.image.height
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'lgs-placeholder-svg lgs-obj-eff' }}
              {% endif %}
              <div
                class="{% render 'lg-typography-classes', settings: se_stts, base_class: 'collection-diamonds-title' %}"
                style="{% render 'lg-typography-style', settings: se_stts %}"
              >{{ blo_setts.title }}</div>
            </a>
          </div>
        {% endfor %}
      </div>
      <div class="collection-diamonds-media common-swiper-media{% if se_stts.show_pagination_pc %} has-pag-pc{% endif %}{% if se_stts.show_navigation_pc %} has-nav-pc{% endif %}{% if se_stts.show_pagination_mb %} has-pag-mb{% endif %}{% if se_stts.show_navigation_mb %} has-nav-mb{% endif %} media-align-{{ se_stts.media_align_mb }}">
        {%- if show_pag -%}
        <div class="swiper-pagination collection-diamonds-pagination common-swiper-pagination"></div>
        {%- endif -%}
        {%- if show_nav -%}
        <div class="common-swiper-direction">
          <div class="common-prev swiper-button-prev collection-diamonds-prev custom-prev">
            <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34">
              <rect x="0.5" y="0.5" width="33" height="33" rx="16.5" fill="none" stroke="#000"/>
              <path fill="#000" d="M20 21.257 19.248 22 14 17l5.248-5 .752.743L15.587 17z"/>
            </svg>
          </div>
          <div class="common-next swiper-button-next collection-diamonds-next custom-next">
            <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34">
              <rect x="0.5" y="0.5" width="33" height="33" rx="16.5" fill="none" stroke="#000"/>
              <path fill="#000" d="M14 12.743 14.752 12 20 17l-5.248 5-.752-.743L18.413 17z"/>
            </svg>
          </div>
        </div>
        {%- endif -%}
      </div>
    </div>
  </div>
  {{-html_layout[1]-}}
</div>

<script>
themeSwiperReady(function () {

  new Swiper('.{{ section.id }} .collection-diamonds', {
    slidesPerView: {{ se_stts.col_dk }},
    loop: true,
    loopAdditionalSlides: 5,
    {%- if show_pag -%}
    pagination: {
      el: '.{{ section.id }} .collection-diamonds-pagination',
      clickable: true,
    },
    {%- endif -%}
    {%- if show_nav -%}
    navigation: {
      nextEl: '.{{ section.id }} .collection-diamonds-next',
      prevEl: '.{{ section.id }} .collection-diamonds-prev',
    },
    {%- endif -%}
    breakpointsBase: 'container',
    breakpoints: {
      0: {
        slidesPerView: {{ se_stts.col_mb }},
        spaceBetween: 8
      },
      768: {
        slidesPerView: {{ se_stts.col_tb }},
        spaceBetween: 8
      },
      1025: {
        slidesPerView: {{ se_stts.col_dk }},
        spaceBetween: 15
      }
    },
  })
});
</script>
{% schema %}
  {
    "name": "collection-diamonds",
    "class": "shopify-collection-diamonds",
    "tag": "section",
    "settings": [
      {"type": "select","id": "layout","label": "layout","default":"lgs-container",
        "options": [
          {"label":"lgs-container","value": "lgs-container"},
          {"label":"wrapped container","value": "wrapped-container"},
          {"label":"custom container","value": "custom-container"},
        ]
      },
      {"type": "text","id": "custom_container","label": "custom container","default": "1200px"},

      {"type": "select","id": "box_align","label": "+ box align","default": "lgs-text-center",
        "options": [
            {"value": "lgs-text-start","label": "Left"},
            {"value": "lgs-text-center","label": "Center"},
            {"value": "lgs-text-end","label": "Right"}
        ]
      },
      {"type": "select","id": "col_dk","label": "Items per row","default": "4",
        "options": [
          {"value": "1","label": "1"},
          {"value": "2","label": "2"},
          {"value": "3","label": "3"},
          {"value": "4","label": "4"},
          {"value": "5","label": "5"},
          {"value": "6","label": "6"},
          {"value": "7","label": "7"},
          {"value": "8","label": "8"},
          {"value": "9","label": "9"},
          {"value": "10","label": "10"}
        ]
      },
      {"type": "select","id": "col_tb","label": "Items per row (Tablet)","default": "2",
        "options": [
          {"value": "1","label": "1"},
          {"value": "2","label": "2"},
          {"value": "3","label": "3"},
          {"value": "4","label": "4"},
          {"value": "5","label": "5"},
          {"value": "6","label": "6"}
        ]
      },
      {"type": "select","id": "col_mb","label": "Items per row (Mobile)","default": "2",
        "options": [
          {"value": "1","label": "1"},
          {"value": "2","label": "2"},
          {"value": "3","label": "3"},
          {"value": "4","label": "4"}
        ]
      },

      {"type": "header","content": "Swiper controls"},
      {"type": "checkbox","id": "show_pagination_pc","label": "Show pagination (PC)","default": false},
      {"type": "checkbox","id": "show_navigation_pc","label": "Show navigation arrows (PC)","default": true},
      {"type": "checkbox","id": "show_pagination_mb","label": "Show pagination (Mobile)","default": false},
      {"type": "checkbox","id": "show_navigation_mb","label": "Show navigation arrows (Mobile)","default": true},
      {"type": "select","id": "media_align_mb","label": "Controls align (Mobile)","default": "between",
        "options": [
          {"value": "start","label": "Left"},
          {"value": "center","label": "Center"},
          {"value": "end","label": "Right"},
          {"value": "between","label": "Space between"}
        ]
      },

      {"type": "header","content": "Colors"},
      {"type": "color_scheme","id": "color_scheme","label": "t:settings.color_scheme","default": "scheme-1","info": "Item title color comes from Title typography below. Hover uses Hover links. Section heading uses Headings / Sub heading when set; otherwise Config Header"},

      {"type": "header","content": "Title typography"},
      {
        "type": "select",
        "id": "type_preset",
        "label": "t:settings.preset",
        "options": [
          {"value": "rte","label": "t:options.default"},
          {"value": "paragraph","label": "t:options.paragraph"},
          {"value": "h1","label": "t:options.h1"},
          {"value": "h2","label": "t:options.h2"},
          {"value": "h3","label": "t:options.h3"},
          {"value": "h4","label": "t:options.h4"},
          {"value": "h5","label": "t:options.h5"},
          {"value": "h6","label": "t:options.h6"},
          {"value": "custom","label": "t:options.custom"}
        ],
        "default": "rte",
        "info": "t:info.edit_presets_in_theme_settings"
      },
      {
        "type": "select",
        "id": "font",
        "label": "t:settings.font",
        "options": [
          {"value": "var(--font-body--family)","label": "t:options.body"},
          {"value": "var(--font-subheading--family)","label": "t:options.subheading"},
          {"value": "var(--font-heading--family)","label": "t:options.heading"},
          {"value": "var(--font-accent--family)","label": "t:options.accent"}
        ],
        "default": "var(--font-body--family)",
        "visible_if": "{{ section.settings.type_preset == 'custom' }}"
      },
      {
        "type": "select",
        "id": "font_size",
        "label": "t:settings.size",
        "options": [
          {"value": "","label": "t:options.default"},
          {"value": "0.625rem","label": "10px"},
          {"value": "0.75rem","label": "12px"},
          {"value": "0.875rem","label": "14px"},
          {"value": "1rem","label": "16px"},
          {"value": "1.125rem","label": "18px"},
          {"value": "1.25rem","label": "20px"},
          {"value": "1.5rem","label": "24px"},
          {"value": "2rem","label": "32px"},
          {"value": "2.5rem","label": "40px"},
          {"value": "3rem","label": "48px"},
          {"value": "3.5rem","label": "56px"},
          {"value": "4.5rem","label": "72px"},
          {"value": "5.5rem","label": "88px"},
          {"value": "7.5rem","label": "120px"},
          {"value": "9.5rem","label": "152px"},
          {"value": "11.5rem","label": "184px"}
        ],
        "default": "1rem",
        "visible_if": "{{ section.settings.type_preset == 'custom' }}"
      },
      {
        "type": "select",
        "id": "weight",
        "label": "t:settings.font_weight",
        "options": [
          {"value": "","label": "t:options.default"},
          {"value": "300","label": "300"},
          {"value": "400","label": "400"},
          {"value": "500","label": "500"},
          {"value": "600","label": "600"},
          {"value": "700","label": "700"}
        ],
        "default": "",
        "visible_if": "{{ section.settings.type_preset == 'custom' }}"
      },
      {
        "type": "select",
        "id": "line_height",
        "label": "t:settings.line_height",
        "options": [
          {"value": "tight","label": "t:options.tight"},
          {"value": "normal","label": "t:options.normal"},
          {"value": "loose","label": "t:options.loose"}
        ],
        "default": "normal",
        "visible_if": "{{ section.settings.type_preset == 'custom' }}"
      },
      {
        "type": "select",
        "id": "letter_spacing",
        "label": "t:settings.letter_spacing",
        "options": [
          {"value": "tight","label": "t:options.tight"},
          {"value": "normal","label": "t:options.normal"},
          {"value": "loose","label": "t:options.loose"}
        ],
        "default": "normal",
        "visible_if": "{{ section.settings.type_preset == 'custom' }}"
      },
      {
        "type": "select",
        "id": "case",
        "label": "t:settings.case",
        "options": [
          {"value": "none","label": "t:options.default"},
          {"value": "uppercase","label": "t:options.uppercase"}
        ],
        "default": "none",
        "visible_if": "{{ section.settings.type_preset == 'custom' }}"
      },
      {
        "type": "select",
        "id": "wrap",
