
{% liquid
  if product == blank
    assign product = closest.product
  endif

  if settings.transition_to_main_product
    assign featured_media_url = product.selected_or_first_available_variant.featured_image | image_url: width: 500
    if featured_media_url == blank
      assign featured_media_url = product.featured_media.preview_image | image_url: width: 500
    endif
  endif

  assign url = product.selected_or_first_available_variant.url
  unless url
    assign url = product.first_available_variant.url
  endunless
  unless url
    assign url = product.url
  endunless

  assign active_collection = collection

  if active_collection == blank
    assign path_segments = request.path | split: '/'
    assign read_collection_handle = false

    for segment in path_segments
      if read_collection_handle and segment != blank and segment != 'products'
        assign active_collection = collections[segment]
        break
      endif

      if segment == 'collections'
        assign read_collection_handle = true
      endif
    endfor
  endif

  capture product_card_url
    render 'collection-product-url', url: url, context_collection: active_collection, product: product
  endcapture
  assign product_card_url = product_card_url | strip

  assign sku = product.selected_or_first_available_variant.sku
  assign selected_variant = product.selected_or_first_available_variant
  assign variant_title_metafield = selected_variant.metafields.custom.variant_title.value
  capture display_title
    render 'product-style-title', title: product.title, variant_title: variant_title_metafield
  endcapture
  assign display_title = display_title | strip
  assign product_group_value = product.metafields.custom.product_group.value | default: product.metafields.custom.product_group | default: '' | strip
%}

<product-card
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-style-title="{{ display_title | escape }}"
  {% if product_group_value != blank %}
    data-product-group="{{ product_group_value | escape }}"
  {% endif %}
  {% if active_collection != blank %}
    data-collection-handle="{{ active_collection.handle }}"
    data-collection-title="{{ active_collection.title | escape }}"
  {% endif %}
  {% if settings.transition_to_main_product %}
    data-product-transition="true"
    {% if featured_media_url != blank %}
      data-featured-media-url="{{ featured_media_url }}"
    {% endif %}
    on:click="/handleViewTransition"
  {% endif %}
>
  <a
    href="{{ product_card_url }}"
    ref="productCardLink"
  >
    <variant-picker>
      <script type="application/json">
        {{ product.selected_or_first_available_variant | json }}
      </script>
    </variant-picker>
    {% render 'variant-swatches', product_resource: product, has_option_selected: true %}

    <p ref="productCardTitle" hidden>{{ display_title }}</p>

    <product-price>
      {% render 'price', product_resource: product, show_unit_price: true %}
    </product-price>

    <product-sku-component
      data-product-id="{{ product.id }}"
      style="{% if sku == blank %}display: none;{% else %}display: block;{% endif %}"
    >
      {% render 'sku', product_resource: product %}
    </product-sku-component>
  </a>
</product-card>

{% schema %}
{
  "name": "t:names.product_card_rendering",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    }
  ]
}
{% endschema %}
