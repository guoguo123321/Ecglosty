{% liquid
  assign se_stts = section.settings
  assign stt_layout = se_stts.layout
  if stt_layout == 'lgs-container'
    assign html_layout = '<div class="lgs-container">__</div>' | split: '__'
  elsif stt_layout == 'custom-container'
    assign html_layout = '<div class="custom-container">__</div>' | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
%}
<style>
  {%- if se_stts.layout == 'custom-container' -%}
  .{{ section.id }} .custom-container{max-width:{{ se_stts.custom_container }};margin:0 auto;}
  {%- endif -%}
  .{{ section.id }}.brand-about-values-box{background:var(--bg-gradient);background-color:var(--bg-color);}
  .{{ section.id }} .lgs-title,
  .{{ section.id }} .brand-about-values__title{--color:var(--color-foreground-heading);color:var(--color-foreground-heading);}
  .{{ section.id }} .lgs-subtitle{--color:var(--color-foreground-subheading);color:var(--color-foreground-subheading);}
  .{{ section.id }} .brand-about-values__index,
  .{{ section.id }} .brand-about-values__text{color:var(--color-foreground);}
  .{{ section.id }} .brand-about-values__item{border-top-color:var(--color-border);}
</style>
<div class="{{ section.id }} brand-about-values-box lgs-section-inner color-{{ se_stts.color_scheme }}" {% render 'section_style', se_stts: se_stts %}>
  {{- html_layout[0] -}}
    {%- render 'section_tophead', se_stts: se_stts -%}
    <div class="brand-about-values__grid">
      {%- for block in section.blocks -%}
        {%- assign blo = block.settings -%}
        <article class="brand-about-values__item" {{ block.shopify_attributes }}>
          <span class="brand-about-values__index">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          {%- if blo.title != blank -%}<h3 class="brand-about-values__title">{{ blo.title }}</h3>{%- endif -%}
          {%- if blo.text != blank -%}<p class="brand-about-values__text">{{ blo.text }}</p>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  {{- html_layout[1] -}}
</div>

{% schema %}
{
  "name": "Brand About Values",
  "tag": "section",
  "class": "shopify-brand-about-values",
  "settings": [
    {"type": "select","id": "layout","label": "layout","default": "lgs-container",
      "options": [
        {"label": "lgs-container","value": "lgs-container"},
        {"label": "wrapped container","value": "wrapped-container"},
        {"label": "custom container","value": "custom-container"}
      ]
    },
    {"type": "text","id": "custom_container","label": "custom container","default": "1100px"},
    {"type": "header","content": "Colors"},
    {"type": "color_scheme","id": "color_scheme","label": "t:settings.color_scheme","default": "scheme-1","info": "Titles (Headings), index/text (Text), border (Borders). Section background still uses bg_color below."},
    {"type": "header","content": "1. Heading options"},
    {"type": "select","id": "design_heading","label": "+ Design heading","default": "1",
      "options": [
        {"value": "1","label": "Design 01"},
        {"value": "2","label": "Design 02"},
        {"value": "3","label": "Design 03"},
        {"value": "4","label": "Design 04"},
        {"value": "5","label": "Design 05"},
        {"value": "6","label": "Design 06 (width line-awesome)"},
        {"value": "7","label": "Design 07"},
        {"value": "8","label": "Design 08"},
        {"value": "9","label": "Design 09"},
        {"value": "10","label": "Design 10"},
        {"value": "11","label": "Design 11"},
        {"value": "12","label": "Design 12"},
        {"value": "13","label": "Design 13"},
        {"value": "14","label": "Design 14"},
        {"value": "15","label": "Design 15"},
        {"value": "16","label": "Design 16"}
      ]
    },
    {"type": "select","id": "heading_align","label": "+ Heading align","default": "lgs-text-center",
      "options": [
        {"value": "lgs-text-start","label": "Left"},
        {"value": "lgs-text-center","label": "Center"},
        {"value": "lgs-text-end","label": "Right"}
      ]
    },
    {"type": "html","id": "top_heading","label": "+ Heading","default": "What We Stand For"},
    {"type": "text","id": "icon_heading","label": "Enter a icon name on heading","info": "Only used for design 6 [LineAwesome]()","default": "las la-gem"},
    {"type": "textarea","id": "top_subheading","label": "+ Subheading","default": "Like pillars that hold a house upright, these values shape how we design, source, and serve."},
    {"type": "number","id": "tophead_mb","label": "+ Space bottom (px)","info": "The vertical spacing between heading and content","default": 60},
    {"type": "color","id": "cl_bg","label": "bg_color","default": "#f7f8f8"},
    {"type": "color_background","id": "cl_bg_gradient","label": "Background gradient"},
    {"type": "header","content": "+ Design pc options"},
    {"type": "text","id": "mg","label": "Margin","info": "Margin top, margin right, margin bottom, margin left. If you not use to blank","default": "0px,0px,0px,0px"},
    {"type": "text","id": "pd","label": "Padding","info": "Padding top, padding right, padding bottom, padding left. If you not use to blank","default": "90px,0px,90px,0px"},
    {"type": "header","content": "+ Design Tablet Options"},
    {"type": "text","id": "mg_tb","label": "Margin","default": "0px,0px,0px,0px"},
    {"type": "text","id": "pd_tb","label": "Padding","default": "50px,0px,50px,0px"},
    {"type": "header","content": "+ Design mobile options"},
    {"type": "text","id": "mg_mb","label": "Margin","default": "0px,0px,0px,0px"},
    {"type": "text","id": "pd_mb","label": "Padding","default": "30px,0px,30px,0px"}
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Value item",
      "settings": [
        {"type": "text","id": "title","label": "Title","default": "Craft with Intention"},
        {"type": "textarea","id": "text","label": "Text","default": "Every curve and setting is considered. We design for beauty that lasts, not trends that fade."}
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand About Values",
      "category": "t:categories.storytelling",
      "blocks": [
        {"type": "item","settings": {"title": "Craft with Intention","text": "Every curve and setting is considered. We design for beauty that lasts, not trends that fade."}},
        {"type": "item","settings": {"title": "Honesty in Every Detail","text": "From materials to making, we aim for clarity you can trust—so your choice feels confident."}},
        {"type": "item","settings": {"title": "Human First","text": "Jewelry marks people and milestones. We put care for customers, makers, and communities at the center."}},
        {"type": "item","settings": {"title": "Beauty with Responsibility","text": "We pursue better materials and thoughtful practices, so elegance and impact can travel together."}}
      ]
    }
  ]
}
{% endschema %}
