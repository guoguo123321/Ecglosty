{% comment %}
  Diamond List Section
  - Left: custom filter panel (Origin, Shape, Carat, Color, Clarity, Cut, Price, Report)
  - Right: list view with accordion row expand, Visual/List toggle, Quick Ship, Sort
  - Data: fetched from external api_endpoint setting
{% endcomment %}

<style>
  /* ===== LAYOUT ===== */
  .dl-page {
    display: flex;
    gap: 24px;
    padding: 24px 16px;
    max-width: 1365px;
    margin: 0 auto;
    font-family: inherit;
    font-size: 13px;
    color: #1a1a1a;
  }

  /* ===== LEFT FILTER PANEL ===== */
  .dl-filters {
    width: 295px;
    flex-shrink: 0;
  }

  .dl-filter-reset {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 12px;
    color: #555;
  }
  .dl-filter-reset button {
    background: none;
    border: none;
    cursor: pointer;
    color: #555;
    font-size: 12px;
    padding: 0;
    text-decoration: underline;
  }

  /* Origin toggle */
  .dl-origin-toggle {
    display: flex;
    border: 1px solid #ccc;
   
    overflow: hidden;
    margin-bottom: 20px;
  }
  .dl-origin-toggle button {
    flex: 1;
    padding: 8px 4px;
    border: none;
    background: #fff;
    cursor: pointer;
    font-size: 12px;
    color: #555;
    transition: background 0.2s, color 0.2s;
  }
  .dl-origin-toggle button.active {
    background: #073746;
    color: #fff;
  }

  /* Filter group */
  .dl-filter-group {
    border-top: 1px solid #e5e5e5;
    padding: 12px 0;
  }
  .dl-filter-group-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    user-select: none;
  }
  .dl-filter-group-header .dl-chevron {
    font-size: 10px;
    transition: transform 0.2s;
  }
  .dl-filter-group.open .dl-chevron {
    transform: rotate(180deg);
  }
  .dl-filter-group-body {
    display: none;
    padding-top: 12px;
  }
  .dl-filter-group.open .dl-filter-group-body {
    display: block;
  }

  /* Shape grid */
  .dl-shape-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .dl-shape-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    padding: 6px 4px;
    border-radius: 4px;
    border: 1px solid transparent;
    font-size: 10px;
    color: #555;
    text-align: center;
    transition: border-color 0.2s;
  }
  .dl-shape-item:hover,
  .dl-shape-item.active {
    border-color: #073746;
    color: #073746;
  }
  .dl-shape-item svg,
  .dl-shape-item img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  /* Range slider */
  .dl-range-wrap {
    padding: 4px 0 8px;
  }
  .dl-range-track {
    position: relative;
    height: 4px;
    background: #e0e0e0;
    border-radius: 2px;
    margin: 16px 0 8px;
  }
  .dl-range-fill {
    position: absolute;
    height: 100%;
    background: #073746;
    border-radius: 2px;
  }
  .dl-range-wrap input[type=range] {
  position: absolute;
  width: 100%;
  height: 4px;
  top: 0;
  left: 0;
  opacity: 1;                  /* 改为 1，让 thumb 可见 */
  cursor: pointer;
  margin: 0;
  pointer-events: none;
  background: transparent;     /* input 本身透明，只显示 thumb */
  -webkit-appearance: none;
  appearance: none;
}

/* Chrome / Safari */
.dl-range-wrap input[type=range]::-webkit-slider-thumb {
  pointer-events: all;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #073746;         /* 深绿色实心圆球 */
  cursor: pointer;
  -webkit-appearance: none;
  appearance: none;
  
  box-shadow: 0 1px 4px rgba(0,0,0,0.2);
}

/* Firefox */
.dl-range-wrap input[type=range]::-moz-range-thumb {
  pointer-events: all;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #073746;
  cursor: pointer;
  border: 2px solid #fff;
  box-shadow: 0 1px 4px rgba(0,0,0,0.2);
}

/* Firefox track 透明 */
.dl-range-wrap input[type=range]::-moz-range-track {
  background: transparent;
}


  .dl-range-wrap input[type=range][data-role=min] {
    z-index: 4;
    }
    .dl-range-wrap input[type=range][data-role=max] {
    z-index: 5;
    }
  .dl-range-labels {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #888;
    margin-top: 4px;
  }
  .dl-range-ticks {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: #aaa;
    margin-top: 6px;
  }
  /* 仅用于 Cut、Color、Clarity，不影响 Carat 和 Price */
  .dl-step-range .dl-range-track {
    margin: 16px 7px 8px;
    background: #d8dedc;
  }

  /* 白色分隔线盖在已选和未选轨道之上 */
  .dl-step-range .dl-range-track::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      to right,
      transparent calc(100% - 2px),
      #fff calc(100% - 2px)
    );
    background-size: calc(100% / var(--dl-segments)) 100%;
  }

  /* 扩大输入范围，让首尾圆点的中心对齐轨道两端 */
  .dl-step-range input[type="range"] {
    left: -7px;
    width: calc(100% + 14px);
  }

  .dl-step-range .dl-range-ticks {
    margin: 6px 7px 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    color: #555;
    font-size: 10px;
    line-height: 1.15;
  }

  .dl-step-range .dl-range-ticks span {
    width: 0;
    display: flex;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
  }

  .dl-step-range[data-filter="cut"] .dl-range-ticks {
    min-height: 25px;
  }
/* end仅用于 Cut、Color、Clarity，不影响 Carat 和 Price */

  /* Checkboxes */
  .dl-checkbox-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .dl-checkbox-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    cursor: pointer;
  }
  .dl-checkbox-item input[type=checkbox] {
    width: 14px;
    height: 14px;
    accent-color: #073746;
    cursor: pointer;
  }

  /* ===== RIGHT CONTENT ===== */
  .dl-content {
    flex: 1;
    min-width: 0;
  }

  /* Top bar */
  .dl-topbar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .dl-view-toggle {
    display: flex;
    border: 1px solid #ccc;
   
    overflow: hidden;
  }
  .dl-view-toggle button {
    padding: 6px 14px;
    border: none;
    background: #fff;
    cursor: pointer;
    font-size: 12px;
    color: #555;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .dl-view-toggle button.active {
    background: #073746;
    color: #fff;
  }
  .dl-quick-ship {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    font-size: 12px;
    color: #555;
    cursor: pointer;
  }
  .dl-quick-ship input[type=checkbox] {
    accent-color: #073746;
  }
  .dl-sort-select {
    padding: 6px 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 12px;
    color: #333;
    background: #fff;
    cursor: pointer;
  }

  /* Tabs */
  .dl-tabs {
    display: flex;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 0;
  }
  .dl-tab {
    padding: 10px 20px;
    font-size: 13px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    color: #555;
    user-select: none;
  }
  .dl-tab.active {
    border-bottom-color: #073746;
    color: #073746;
    font-weight: 500;
  }

  /* Table */
  .dl-table-wrap {
    overflow-x: auto;
  }
  .dl-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  .dl-table thead th {
    padding: 10px 12px;
    text-align: left;
    font-weight: 500;
    color: #555;
    border-bottom: 1px solid #e5e5e5;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
  }
  .dl-table thead th:hover {
    color: #073746;
  }
  .dl-table thead th .sort-icon {
    font-size: 9px;
    margin-left: 2px;
    opacity: 0.5;
  }
  .dl-table tbody tr.dl-row {
    border-bottom: 1px solid #f0f0f0;
    cursor: pointer;
    transition: background 0.15s;
  }
  .dl-table tbody tr.dl-row:hover {
    background: #f9f9f9;
  }
  .dl-table tbody tr.dl-row.active {
    background: #073746;
    color: #fff;
  }
  .dl-table tbody tr.dl-row.active td {
    color: #fff;
  }
  .dl-table tbody td {
    padding: 10px 12px;
    vertical-align: middle;
    white-space: nowrap;
  }
  .dl-shape-icon {
    width: 22px;
    height: 22px;
    object-fit: contain;
    vertical-align: middle;
    margin-right: 6px;
  }
  .dl-badge {
    display: inline-block;
    font-size: 9px;
    padding: 1px 5px;
    border: 1px solid currentColor;
    border-radius: 2px;
    margin-bottom: 2px;
    opacity: 0.7;
  }
  .dl-wishlist-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    color: inherit;
    padding: 0;
    line-height: 1;
  }
  .dl-wishlist-btn.active {
    color: #073746;
  }
  tr.dl-row.active .dl-wishlist-btn {
    color: #fff;
  }

  /* Expand row */
  .dl-expand-row {
    display: none;
  }
  .dl-expand-row.open {
    display: table-row;
  }
  .dl-expand-cell {
    padding: 0 !important;
    border-bottom: 2px solid #073746;
  }
  .dl-expand-inner {
    display: flex;
    gap: 24px;
    padding: 20px 16px;
    background: #fff;
  }
  .dl-expand-img {
    width: 140px;
    height: 140px;
    object-fit: contain;
    flex-shrink: 0;
    background: #f5f5f5;
    border-radius: 4px;
  }
  .dl-expand-img-placeholder {
    width: 140px;
    height: 140px;
    background: #f0f0f0;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ccc;
    font-size: 32px;
    flex-shrink: 0;
  }
  .dl-expand-info {
    flex: 1;
    min-width: 0;
  }
  .dl-expand-title {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .dl-expand-price {
    font-size: 13px;
    color: #555;
    margin-bottom: 12px;
  }
  .dl-expand-specs {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px 12px;
    font-size: 11px;
    margin-bottom: 12px;
  }
  .dl-expand-spec-label {
    color: #888;
    margin-bottom: 2px;
  }
  .dl-expand-spec-value {
    font-weight: 500;
    color: #1a1a1a;
  }
  .dl-expand-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    flex-shrink: 0;
    min-width: 140px;
  }
  .dl-btn-select {
    background: #073746;
    color: #fff;
    border: none;
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 13px;
    cursor: pointer;
    width: 100%;
    text-align: center;
  }
  .dl-btn-select:hover {
    background: var(--button-active-bg);
  }
  .dl-btn-details {
    background: none;
    border: none;
    color: #073746;
    font-size: 12px;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
    width: 100%;
    text-align: center;
  }
  .dl-tag {
    display: inline-block;
    font-size: 10px;
    padding: 2px 8px;
    border: 1px solid #ccc;
    border-radius: 2px;
    color: #555;
    margin-top: 4px;
  }

  /* Loading / empty */
  .dl-loading {
    text-align: center;
    padding: 60px 20px;
    color: #888;
    font-size: 14px;
  }
  .dl-count {
    font-size: 12px;
    color: #888;
    margin-left: 4px;
  }

  /* Pagination */
  .dl-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 20px 0;
    font-size: 13px;
  }
  .dl-pagination button {
    padding: 6px 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
    font-size: 12px;
  }
  .dl-pagination button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .dl-pagination .dl-page-info {
    color: #555;
  }

  @media(max-width:768px){
  .dl-page{flex-direction:column}
  .dl-filters{width:100%}
  .dl-expand-specs{grid-template-columns:repeat(3,1fr)}
  .dl-expand-inner{flex-direction:column}
  .dl-expand-actions{flex-direction:row;width:100%}

  /* 隐藏筛选侧边栏，改为抽屉 */
  .dl-filters{
    position:fixed;
    top:0;left:0;
    height:100%;
    width:85%;
    max-width:320px;
    background:#fff;
    z-index:1001;
    overflow-y:auto;
    transform:translateX(-100%);
    transition:transform 0.3s ease;
    padding: 20px 20px 0;
    box-shadow:2px 0 16px rgba(0,0,0,0.15);
  }
  .dl-filters.dl-mobile-open{
    transform:translateX(0);
  }

  /* 遮罩 */
  .dl-mobile-filter-overlay{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,0.45);
    z-index:1000;
  }
  .dl-mobile-filter-overlay.active{display:block;}

  /* 浮动 Filters 按钮 */
  .dl-mobile-filter-fab{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    position:fixed;
    bottom:0;
    left:16px;        /* 改这里 */
    right:16px;       /* 改这里 */
    width:calc(100% - 32px);  /* 改这里 */
    padding:15px;
    background:#073746;
    color:#fff;
    font-size:14px;
    font-weight:600;
    letter-spacing:0.08em;
    border:none;
    z-index:999;
    cursor:pointer;
    bottom:16px;      /* 同时底部也留点空间，视觉更好 */
  }


  /* VIEW RESULTS 按钮 */
  .dl-mobile-view-results{
    position:sticky;
    bottom:0;
    padding:12px 16px;
    background:#fff;
    border:1px solid #fff;
  }
  .dl-mobile-view-results button{
    width:100%;
    padding:13px;
    background:#073746;
    color:#fff;
    font-size:13px;
    font-weight:700;
    letter-spacing:0.1em;
    border:none;
    cursor:pointer;
  }
  .dl-mobile-filter-header{
    position:absolute;
    top: 3px;
      right: 0px;
    z-index:10;
  }
  .dl-mobile-filter-close{
    background:none;
    border:none;
    font-size:20px;
    color:#555;
    cursor:pointer;
    padding:4px 8px;
    line-height:1;
  }
  .dl-mobile-filter-close:hover{color:#073746;}


}

/* 桌面端隐藏移动端元素 */
@media(min-width:769px){
  .dl-mobile-filter-fab,
  .dl-mobile-filter-overlay,
  .dl-mobile-view-results{display:none!important;}
  .dl-mobile-filter-header{display:none!important;}
}


  {% comment %} 筛选选择 {% endcomment %}
  .dl-filter-reset {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 12px;
  min-height: 0;
}
.dl-filter-tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 8px;
  border: 1px solid #ddd;
  border-radius: 20px;
  font-size: 12px;
  background: #fff;
}
.dl-filter-tag button {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 11px;
  color: #888;
  padding: 0;
  line-height: 1;
}
.dl-filter-reset-all {
  display: inline-flex;
  align-items: center;
  padding: 3px 8px;
  border: 1px solid #333;
  border-radius: 20px;
  font-size: 12px;
  background: #fff;
  cursor: pointer;
  font-weight: 500;
}
.dl-flex{display:flex;align-items: center;}
/* Wishlist active state */
.dl-wishlist-btn.wishlisted {
  color: #616161;
}
.dl-wishlist-btn.wishlisted::before {
  content: '♥';
}
.dl-wishlist-btn:not(.wishlisted)::before {
  content: '♡';
}
.dl-grid-icon-btn.dl-wishlist-btn::before {
 font-size:24px;
     margin-top: 3px;
}

/* Compare tab */
.dl-compare-empty {
  text-align: center;
  padding: 40px 20px;
  color: #888;
  font-size: 14px;
}

/* ===== GRID / VISUAL VIEW ===== */
#dl-grid-wrap-{{ section.id }} {
 
}
.dl-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
   margin-top:20px;
}
.dl-grid-card {
  border: 1px solid #e5e5e5;
  border-radius: 4px;
  overflow: hidden;
  background: #fff;
  display: flex;
  flex-direction: column;
  position: relative;
  cursor: pointer;
  transition: box-shadow 0.2s;
}
.dl-grid-card:hover {
  box-shadow: 0 4px 16px rgba(0,0,0,0.10);
}
.dl-grid-card-img-wrap {
  position: relative;
  background: #f5f5f5;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.dl-grid-card-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.dl-grid-card-img-placeholder {
  font-size: 48px;
  color: #ccc;
}
.dl-grid-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: #eaf8ed;
  color: #282828;
  font-size: 10px;
  padding: 3px 8px;
  border-radius: 2px;
  font-weight: 500;
  letter-spacing: 0.3px;
}
.dl-grid-icons {
  position: absolute;
  top: 10px;
  right: 10px;
  display: flex;
  gap: 6px;
  align-items: center;
}
.dl-grid-icon-btn {
  background: rgba(255,255,255,0.85);
  border: none;
  border-radius: 50%;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 14px;
  color: #555;
  padding: 0;
  line-height: 1;
  transition: background 0.15s;
}
.dl-grid-icon-btn:hover { background: #fff; }
.dl-grid-icon-btn.wishlisted { color: #073746; }
.dl-grid-card-body {
  padding: 12px 14px 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}
.dl-grid-card-name {
  font-size: 13px;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.4;
}
.dl-grid-card-sub {
  font-size: 12px;
  color: #888;
}
.dl-grid-card-price {
  font-size: 14px;
  font-weight: 600;
  color: #1a1a1a;
  margin-top: 2px;
}
.dl-grid-card-select {
  margin-top: 10px;
  width: 100%;
  padding: 9px 0;
  border: 1.5px solid #073746;
  border-radius: 3px;
  background: #fff;
  color: #073746;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  letter-spacing: 0.2px;
  transition: background 0.15s, color 0.15s;
}
.dl-grid-card-select:hover {
  background: #073746;
  color: #fff;
}
@media (max-width: 900px) {
  .dl-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .dl-grid { grid-template-columns: 1fr; }
}

.dl-expand-spin {
  position: relative;
  overflow: hidden;
  cursor: grab;
  user-select: none;
}

.dl-expand-spin:active {
  cursor: grabbing;
}

.dl-expand-spin canvas {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.dl-expand-spin-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 12px;
  background: #f5f5f5;
}

.dl-expand-video {
  display: block;
  background: #000;
  object-fit: contain;
}

.dpi-drag-label {
  position: absolute;
  bottom: 12px; left: 50%;
  transform: translateX(-50%);
  font-size: 12px;
  color: #888;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 2;
}
.dpi-spin-loader {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0);
  font-size: 13px;
  color: #666;
}


</style>
<div class="dl-mobile-filter-overlay" id="dl-overlay-{{ section.id }}" onclick="dlCloseMobileFilters('{{ section.id }}')"></div>

<div class="dl-page" id="dl-page-{{ section.id }}">

  {%- comment -%} ===== LEFT FILTER PANEL ===== {%- endcomment -%}
  <aside class="dl-filters" id="dl-filters-{{ section.id }}">
    <!-- Mobile Close Button -->
    <div class="dl-mobile-filter-header" id="dl-mobile-filter-header-{{ section.id }}">
      <button class="dl-mobile-filter-close"  aria-label="Close filters">✕</button>
    </div>

    <div class="dl-filter-reset" id="dl-filter-reset-{{ section.id }}"></div>


    {%- comment -%} Diamond Origin  只有天然钻，先隐藏{%- endcomment -%}
    {% comment %} <div style="margin-bottom:8px;font-size:13px;font-weight:500;">Diamond Origin</div>
    <div class="dl-origin-toggle" id="dl-origin-{{ section.id }}">
      <button class="active" data-origin="Lab Grown" onclick="dlSetOrigin('{{ section.id }}','Lab Grown',this)">Lab Grown Diamonds</button>
      <button  data-origin="natural" onclick="dlSetOrigin('{{ section.id }}','Natural',this)">Natural Diamonds</button>
      
    </div> {% endcomment %}

    {%- comment -%} Diamond Shape {%- endcomment -%}
    <div class="dl-filter-group open" id="dl-fg-shape-{{ section.id }}">
  <div class="dl-filter-group-header" onclick="dlToggleGroup('dl-fg-shape-{{ section.id }}')">
    <span>Diamond Shape</span>
    <span class="dl-chevron">
      <svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242">
        <path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path>
      </svg>
    </span>
  </div>
  <div class="dl-filter-group-body">
    <div class="dl-shape-grid" id="dl-shapes-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'diamond_shape' -%}
          <div
            class="dl-shape-item"
            data-shape="{{ block.settings.shape_name | escape }}"
            onclick="dlToggleShape('{{ section.id }}','{{ block.settings.shape_name | escape }}',this)"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.shape_image != blank -%}
              <img
                src="{{ block.settings.shape_image | image_url: width: 60 }}"
                alt="{{ block.settings.shape_name | escape }}"
                width="60"
                height="60"
                loading="lazy"
              >
            {%- else -%}
              {{- block.settings.shape_name | escape -}}
            {%- endif -%}
            <span>{{ block.settings.shape_name }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>


    {%- comment -%} Carat {%- endcomment -%}
    <div class="dl-filter-group open" id="dl-fg-carat-{{ section.id }}">
      <div class="dl-filter-group-header" onclick="dlToggleGroup('dl-fg-carat-{{ section.id }}')">
        <span>Carat All</span><span class="dl-chevron"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242"><path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path></svg></span>
      </div>
      <div class="dl-filter-group-body">
        <div class="dl-range-wrap" data-filter="carat" data-min="0.5" data-max="20" data-step="0.1">
          <div class="dl-range-track">
            <div class="dl-range-fill"></div>
            <input type="range" min="0.5" max="20" step="0.1" value="0.5" data-role="min">
            <input type="range" min="0.5" max="20" step="0.1" value="20" data-role="max">
          </div>
          <div class="dl-range-labels">
            <span class="dl-range-min-label">0.5</span>
            <span class="dl-range-max-label">20</span>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Color {%- endcomment -%}
    <div class="dl-filter-group open" id="dl-fg-color-{{ section.id }}">
      <div class="dl-filter-group-header" onclick="dlToggleGroup('dl-fg-color-{{ section.id }}')">
        <span>Color All</span><span class="dl-chevron"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242"><path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path></svg></span>
      </div>
      <div class="dl-filter-group-body">
        <div class="dl-range-wrap dl-step-range" data-filter="color" data-min="0" data-max="9" data-step="1" style="--dl-segments: 9">
        <div class="dl-range-track">
          <div class="dl-range-fill"></div>
          <input type="range" min="0" max="9" step="1" value="0" data-role="min" aria-label="Minimum color">
          <input type="range" min="0" max="9" step="1" value="9" data-role="max" aria-label="Maximum color">
        </div>
        <div class="dl-range-ticks">
          <span>M</span><span>L</span><span>K</span><span>J</span><span>I</span>
          <span>H</span><span>G</span><span>F</span><span>E</span><span>D</span>
        </div>
      </div>

      </div>
    </div>

    {%- comment -%} Clarity {%- endcomment -%}
    <div class="dl-filter-group open" id="dl-fg-clarity-{{ section.id }}">
      <div class="dl-filter-group-header" onclick="dlToggleGroup('dl-fg-clarity-{{ section.id }}')">
        <span>Clarity All</span><span class="dl-chevron"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242"><path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path></svg></span>
      </div>
      <div class="dl-filter-group-body">
        <div class="dl-range-wrap dl-step-range" data-filter="clarity" data-min="0" data-max="7" data-step="1" style="--dl-segments: 7">
          <div class="dl-range-track">
            <div class="dl-range-fill"></div>
            <input type="range" min="0" max="7" step="1" value="0" data-role="min" aria-label="Minimum clarity">
            <input type="range" min="0" max="7" step="1" value="7" data-role="max" aria-label="Maximum clarity">
          </div>
          <div class="dl-range-ticks">
            <span>SI2</span><span>SI1</span><span>VS2</span><span>VS1</span>
            <span>VVS2</span><span>VVS1</span><span>IF</span><span>FL</span>
          </div>
        </div>

      </div>
    </div>

    {%- comment -%} Cut {%- endcomment -%}
    <div class="dl-filter-group open" id="dl-fg-cut-{{ section.id }}">
      <div class="dl-filter-group-header" onclick="dlToggleGroup('dl-fg-cut-{{ section.id }}')">
        <span>Cut All</span><span class="dl-chevron"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242"><path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path></svg></span>
      </div>
      <div class="dl-filter-group-body">
        <div class="dl-range-wrap dl-step-range" data-filter="cut" data-min="0" data-max="4" data-step="1" style="--dl-segments: 4">
          <div class="dl-range-track">
            <div class="dl-range-fill"></div>
            <input type="range" min="0" max="4" step="1" value="0" data-role="min" aria-label="Minimum cut">
            <input type="range" min="0" max="4" step="1" value="4" data-role="max" aria-label="Maximum cut">
          </div>
          <div class="dl-range-ticks">
            <span>Fair</span><span>Good</span><span>Very<br>Good</span>
            <span>Ideal</span><span>Super<br>Ideal</span>
          </div>
        </div>

      </div>
    </div>

    {%- comment -%} Setting Price {%- endcomment -%}
    <div class="dl-filter-group open" id="dl-fg-price-{{ section.id }}">
      <div class="dl-filter-group-header" onclick="dlToggleGroup('dl-fg-price-{{ section.id }}')">
        <span>Price</span><span class="dl-chevron"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242"><path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path></svg></span>
      </div>
      <div class="dl-filter-group-body">
        <div class="dl-range-wrap" data-filter="price" data-min="10" data-max="100000" data-step="10">
          <div class="dl-range-track">
            <div class="dl-range-fill"></div>
            <input type="range" min="10" max="100000" step="10" value="10" data-role="min">
            <input type="range" min="10" max="100000" step="10" value="100000" data-role="max">
          </div>
          <div class="dl-range-labels">
            <span class="dl-range-min-label">$10</span>
            <span class="dl-range-max-label">$10000</span>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Report {%- endcomment -%}
    {% comment %} <div class="dl-filter-group open" id="dl-fg-report-{{ section.id }}">
      <div class="dl-filter-group-header" onclick="dlToggleGroup('dl-fg-report-{{ section.id }}')">
        <span>Report</span><span class="dl-chevron"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242"><path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path></svg></span>
      </div>
      <div class="dl-filter-group-body">
        <div class="dl-checkbox-list">
          {%- assign reports = 'IGI,GIA,HRD' | split: ',' -%}
            {%- for report in reports -%}
            <label class="dl-checkbox-item">
              <input type="checkbox" value="{{ report }}" onchange="dlFilterChange('{{ section.id }}')">
              <span>{{ report }}</span>
              <span style="font-size:11px;color:#aaa;margin-left:2px;">ⓘ</span>
            </label>
          {%- endfor -%}
        </div>
      </div>
    </div> {% endcomment %}
      <!-- Mobile View Results Button -->
      <div class="dl-mobile-view-results">
        <button id="dl-mobile-view-results-{{ section.id }}">VIEW RESULTS</button>
      </div>

  </aside>

  {%- comment -%} ===== RIGHT CONTENT ===== {%- endcomment -%}
  <div class="dl-content">

    {%- comment -%} Top bar {%- endcomment -%}
    <div class="dl-topbar">
      <div class="dl-view-toggle" id="dl-view-{{ section.id }}">
        <button onclick="dlSetView('{{ section.id }}','visual',this)">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor"><rect x="0" y="0" width="6" height="6"/><rect x="8" y="0" width="6" height="6"/><rect x="0" y="8" width="6" height="6"/><rect x="8" y="8" width="6" height="6"/></svg>
          Visual
        </button>
        <button class="active" onclick="dlSetView('{{ section.id }}','list',this)">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor"><rect x="0" y="1" width="14" height="2"/><rect x="0" y="6" width="14" height="2"/><rect x="0" y="11" width="14" height="2"/></svg>
          List
        </button>
      </div>
      <label class="dl-quick-ship">
        {% comment %} <input type="checkbox" id="dl-quickship-{{ section.id }}" onchange="dlFilterChange('{{ section.id }}')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3"/><rect x="9" y="11" width="14" height="10" rx="1"/><circle cx="12" cy="21" r="1"/><circle cx="20" cy="21" r="1"/></svg>
        Quick Ship {% endcomment %}
      </label>
      <select class="dl-sort-select" id="dl-sort-{{ section.id }}" onchange="dlFilterChange('{{ section.id }}')">
        <option value="popular">Sort By: Most Popular</option>
        <option value="priceAsc">Price: Low to High</option>
        <option value="priceDesc">Price: High to Low</option>
        <option value="caratAsc">Carat: Low to High</option>
        <option value="caratDesc">Carat: High to Low</option>
      </select>
    </div>

    {%- comment -%} Tabs {%- endcomment -%}
    <div class="dl-tabs">
      <div class="dl-tab active" id="dl-tab-all-{{ section.id }}" onclick="dlSetTab('{{ section.id }}','all',this)">
        All Diamonds <span class="dl-count" id="dl-total-{{ section.id }}">(0)</span>
      </div>
      <div class="dl-tab" id="dl-tab-compare-{{ section.id }}" onclick="dlSetTab('{{ section.id }}','compare',this)">
        ♡ Compare <span class="dl-count" id="dl-count-{{ section.id }}">(0)</span>
      </div>
    </div>

    {%- comment -%} Table {%- endcomment -%}
    <div class="dl-table-wrap" id="dl-table-wrap-{{ section.id }}">
      <table class="dl-table" id="dl-table-{{ section.id }}">
        <thead>
          <tr>
            <th onclick="dlSort('{{ section.id }}','shape')">Shape <span class="sort-icon">⇅</span></th>
            <th onclick="dlSort('{{ section.id }}','carat')">Carat <span class="sort-icon">⇅</span></th>
            <th onclick="dlSort('{{ section.id }}','color')">Color <span class="sort-icon">⇅</span></th>
            <th onclick="dlSort('{{ section.id }}','clarity')">Clarity <span class="sort-icon">⇅</span></th>
            <th onclick="dlSort('{{ section.id }}','cut')">Cut <span class="sort-icon">⇅</span></th>
            <th onclick="dlSort('{{ section.id }}','price')">Price <span class="sort-icon">⇅</span></th>
            <th><div class="text-center">Compare</div></th>
          </tr>
        </thead>
        <tbody id="dl-tbody-{{ section.id }}">
          <tr><td colspan="7" class="dl-loading">Loading diamonds...</td></tr>
        </tbody>
      </table>
    </div>
        {%- comment -%} Grid / Visual View {%- endcomment -%}
    <div id="dl-grid-wrap-{{ section.id }}" style="display:none;">
      <div class="dl-grid" id="dl-grid-{{ section.id }}"></div>
    </div>

    <div id="dl-compare-wrap-{{ section.id }}" style="display:none;">
        <div class="dl-table-wrap">
          <table class="dl-table" id="dl-compare-table-{{ section.id }}">
            <thead>
              <tr>
                <th>Shape</th><th>Carat</th><th>Color</th><th>Clarity</th>
                <th>Cut</th><th>Price</th><th><div class="text-center">Compare</div></th>
              </tr>
            </thead>
            <tbody id="dl-compare-tbody-{{ section.id }}"></tbody>
          </table>
          <div class="dl-compare-empty" id="dl-compare-empty-{{ section.id }}" style="display:none;">
            No diamonds in your wishlist yet.
          </div>
      </div>
    </div>


    {%- comment -%} Pagination {%- endcomment -%}
    <div class="dl-pagination" id="dl-pagination-{{ section.id }}">
      <button id="dl-prev-{{ section.id }}" onclick="dlChangePage('{{ section.id }}',-1)" disabled>← Prev</button>
      <span class="dl-page-info" id="dl-page-info-{{ section.id }}">Page 1</span>
      <button id="dl-next-{{ section.id }}" onclick="dlChangePage('{{ section.id }}',1)">Next →</button>
    </div>

  </div>
</div>
<div class="lgs-container">
<!-- Mobile Floating Filter Button -->
<button class="dl-mobile-filter-fab" id="dl-filter-fab-{{ section.id }}">
  Filters
  <svg width="15" height="15" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" style="fill:white;" t="1621832162336" class="icon" viewBox="0 0 1024 1024" version="1.1" p-id="8897">
    <path d="M981.333333 682.666667H509.866667c-10.24-72.106667-72.106667-128-147.2-128s-136.96 55.893333-147.2 128H42.666667v42.666666h172.8c10.24 72.106667 72.106667 128 147.2 128s136.96-55.893333 147.2-128H981.333333v-42.666666zM362.666667 810.666667a106.666667 106.666667 0 0 1 0-213.333334 106.666667 106.666667 0 0 1 0 213.333334zM661.333333 469.333333c75.093333 0 136.96-55.893333 147.2-128H981.333333V298.666667h-172.8c-10.24-72.106667-72.106667-128-147.2-128s-136.96 55.893333-147.2 128H42.666667v42.666666h471.466666c10.24 72.106667 72.106667 128 147.2 128z m0-256a106.666667 106.666667 0 0 1 0 213.333334 106.666667 106.666667 0 0 1 0-213.333334z" p-id="8898"></path>
</svg>
</button>
</div>
<script>
  window.dlShapeImages = window.dlShapeImages || {};
  window.dlShapeImages[{{ section.id | json }}] = {
    {%- assign comma = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'diamond_shape' and block.settings.shape_image != blank -%}
        {%- if comma -%},{%- endif -%}
        {{ block.settings.shape_name | json }}: {{ block.settings.shape_image | image_url: width: 60 | json }}
        {%- assign comma = true -%}
      {%- endif -%}
    {%- endfor -%}
  };
</script>
<script>
(function() {
  const SID = '{{ section.id }}';
  const API_ENDPOINT = {{ section.settings.api_endpoint | json }};
  const PAGE_SIZE = {{ section.settings.page_size | default: 40 }};

  // State
  const state = {
    origin: 'Lab Grown',
    shapes: [],
    carat: [0.5, 20],
    color: [0, 9],
    clarity: [0, 7],
    cut: [0, 4],
    price: [10, 100000],
    _initPriceMin: 10,
    _initPriceMax: 100000,
    reports: [],
    quickShip: false,
    sort: 'popular',
    page: 1,
    total: 0,
    data: [],
    expandedRow: null,
    view: 'list',
    tab:'diamonds'
  };

  const COLOR_LABELS = ['M','L','K','J','I','H','G','F','E','D'];

  const CLARITY_LABELS = ['SI2','SI1','VS2','VS1','VVS2','VVS1','IF','FL'];
  const CUT_LABELS = ['Fair','Good','Very Good','Ideal','Super Ideal'];
  // ===== URL 参数回填筛选器 =====
  // ===== 筛选状态：URL 保存与恢复 =====
  function dlSaveFiltersToURL() {
    const url = new URL(window.location.href);
    const params = url.searchParams;

    // 保留 URL 中与筛选无关的参数。
    params.set('origin', state.origin);

    if (state.shapes.length) {
      params.set('shape', state.shapes.join(','));
    } else {
      params.delete('shape');
    }

    const ranges = [
      ['carat', 'minCarat', 'maxCarat'],
      ['price', 'minPrice', 'maxPrice'],
      ['color', 'minColor', 'maxColor'],
      ['clarity', 'minClarity', 'maxClarity'],
      ['cut', 'minCut', 'maxCut']
    ];

    ranges.forEach(([key, minName, maxName]) => {
      params.set(minName, String(state[key][0]));
      params.set(maxName, String(state[key][1]));
    });

    if (state.reports.length) {
      params.set('report', state.reports.join(','));
    } else {
      params.delete('report');
    }

    params.set('sort', state.sort);
    params.set('page', String(state.page));

    const nextURL = url.pathname + url.search + url.hash;
    const currentURL =
      window.location.pathname +
      window.location.search +
      window.location.hash;

    // replaceState 不会让每次拖动滑块都新增一条后退记录。
    if (nextURL !== currentURL) {
      window.history.replaceState(window.history.state, '', nextURL);
    }

    // 保留现有选钻流程使用的 key。
    try {
      localStorage.setItem('current_collections_diamond', nextURL);
    } catch (error) {
      console.warn('[DL] Could not save collection return URL.', error);
    }

    return nextURL;
  }

  function dlInitFromURL() {
    const params = new URLSearchParams(window.location.search);

    const origin = params.get('origin');
    const originButtons = Array.from(
      document.querySelectorAll(`#dl-origin-${SID} button`)
    );

    if (
      origin &&
      originButtons.some(button => button.dataset.origin === origin)
    ) {
      state.origin = origin;
    }

    originButtons.forEach(button => {
      button.classList.toggle(
        'active',
        button.dataset.origin === state.origin
      );
    });

    // 保持当前单选 Shape 行为。
    // 兼容旧链接：重复传入 shape 时，最后一个值代表最新选择。
    const shapeParams = params.getAll('shape');
    const shapeParam = shapeParams.length
      ? shapeParams[shapeParams.length - 1]
      : null;


    if (shapeParam !== null) {
      const requestedShape = shapeParam
        .split(',')
        .map(value => value.trim())
        .find(Boolean);

      const shapeItems = Array.from(
        document.querySelectorAll(`#dl-shapes-${SID} .dl-shape-item`)
      );

      // 戒托页面会将空格转成连字符，比较时统一格式。
      const normalizeShape = value =>
        String(value || '')
          .trim()
          .toLowerCase()
          .replace(/[\s_-]+/g, '');

      const selectedItem = requestedShape
        ? shapeItems.find(item =>
            normalizeShape(item.dataset.shape) ===
            normalizeShape(requestedShape)
          )
        : null;

      state.shapes = selectedItem ? [selectedItem.dataset.shape] : [];

      shapeItems.forEach(item => {
        item.classList.toggle('active', item === selectedItem);
      });
    }

    function readRangeValue(name, labels) {
      const raw = params.get(name);
      if (raw === null || raw.trim() === '') return null;

      const numericValue = Number(raw);
      if (Number.isFinite(numericValue)) return numericValue;

      if (!labels) return null;

      const index = labels.findIndex(
        label => label.toLowerCase() === raw.trim().toLowerCase()
      );

      return index >= 0 ? index : null;
    }

    function restoreRange(key, minName, maxName, labels) {
      const requestedMin = readRangeValue(minName, labels);
      const requestedMax = readRangeValue(maxName, labels);

      if (requestedMin === null && requestedMax === null) return;

      const wrap = document.querySelector(
        `#dl-filters-${SID} .dl-range-wrap[data-filter="${key}"]`
      );
      if (!wrap) return;

      const minInput = wrap.querySelector('[data-role=min]');
      const maxInput = wrap.querySelector('[data-role=max]');
      if (!minInput || !maxInput) return;

      const absMin = Number(minInput.min);
      const absMax = Number(maxInput.max);

      const clamp = value => Math.min(absMax, Math.max(absMin, value));

      let minValue = clamp(requestedMin ?? state[key][0]);
      let maxValue = clamp(requestedMax ?? state[key][1]);

      if (minValue > maxValue) {
        [minValue, maxValue] = [maxValue, minValue];
      }

      // 必须先设置两个值，再触发事件，避免旧端点把新端点截断。
      minInput.value = minValue;
      maxInput.value = maxValue;

      // 使用已有事件同步 state、填充条和标签。
      minInput.dispatchEvent(new Event('input'));
    }

    // 回填过程中不触发延迟请求，最后统一 fetchData()。
    state._batchResetting = true;

    try {
      restoreRange('carat', 'minCarat', 'maxCarat');
      restoreRange('price', 'minPrice', 'maxPrice');
      restoreRange('color', 'minColor', 'maxColor', COLOR_LABELS);
      restoreRange('clarity', 'minClarity', 'maxClarity', CLARITY_LABELS);
      restoreRange('cut', 'minCut', 'maxCut', CUT_LABELS);
    } finally {
      state._batchResetting = false;
    }

    const reportParam = params.get('report');

    if (reportParam !== null) {
      const requestedReports = reportParam
        .split(',')
        .map(value => value.trim())
        .filter(Boolean);

      const reportInputs = Array.from(
        document.querySelectorAll(
          `#dl-fg-report-${SID} input[type=checkbox]`
        )
      );

      reportInputs.forEach(input => {
        input.checked = requestedReports.includes(input.value);
      });

      state.reports = reportInputs
        .filter(input => input.checked)
        .map(input => input.value);
    }

    const sort = params.get('sort');
    if (sort) state.sort = sort;

    const sortSelect = document.getElementById(`dl-sort-${SID}`);
    if (
      sortSelect &&
      Array.from(sortSelect.options).some(option => option.value === state.sort)
    ) {
      sortSelect.value = state.sort;
    }

    const page = Number(params.get('page'));
    if (Number.isInteger(page) && page >= 1) {
      state.page = page;
    }
  }
  // ===== END 筛选状态：URL 保存与恢复 =====

  // 防抖：slider 停止拖动 300ms 后才发请求
  let _dlFetchTimer = null;
  let _dlFetchVersion = 0;

  function debouncedFetchData() {
    // 筛选一变化，就让之前的请求失效，包括防抖等待期间。
    _dlFetchVersion++;

    state.page = 1;
    dlSaveFiltersToURL();

    clearTimeout(_dlFetchTimer);
    _dlFetchTimer = setTimeout(() => fetchData(), 1000);
  }



  // ---- Init ----
  function init() {
    initRangeSliders();
     window['dlState_' + SID] = state;
     dlInitFromURL(); 
    fetchData();
    dlUpdateWishlistCount(SID);
   
  }

  // ---- Range Sliders ----
  function initRangeSliders() {
    document.querySelectorAll(`#dl-filters-${SID} .dl-range-wrap`).forEach(wrap => {
      const minInput = wrap.querySelector('[data-role=min]');
      const maxInput = wrap.querySelector('[data-role=max]');
      const fill = wrap.querySelector('.dl-range-fill');
      const minLabel = wrap.querySelector('.dl-range-min-label');
      const maxLabel = wrap.querySelector('.dl-range-max-label');
      const filterKey = wrap.dataset.filter;
      const absMin = parseFloat(wrap.dataset.min);
      const absMax = parseFloat(wrap.dataset.max);
        function updateFill() {
        let minV = parseFloat(minInput.value);
        let maxV = parseFloat(maxInput.value);
        const pMin = ((minV - absMin) / (absMax - absMin)) * 100;
        const pMax = ((maxV - absMin) / (absMax - absMin)) * 100;
        fill.style.left = pMin + '%';
        fill.style.width = (pMax - pMin) + '%';
        if (minLabel) minLabel.textContent = filterKey === 'price' ? '$' + minV.toLocaleString() : minV;
        if (maxLabel) maxLabel.textContent = filterKey === 'price' ? '$' + maxV.toLocaleString() : maxV;
        state[filterKey] = [minV, maxV];

        // 动态调整 z-index，让靠近右侧的滑块在上层
        if (minV / (absMax - absMin) > 0.5) {
            minInput.style.zIndex = 5;
            maxInput.style.zIndex = 4;
        } else {
            minInput.style.zIndex = 4;
            maxInput.style.zIndex = 5;
        }
        }

        minInput.addEventListener('input', () => {
          if (parseFloat(minInput.value) > parseFloat(maxInput.value)) {
            minInput.value = maxInput.value;
          }
          updateFill();
          if (!state._batchResetting) debouncedFetchData();   // ← 改这里
        });

        maxInput.addEventListener('input', () => {
          if (parseFloat(maxInput.value) < parseFloat(minInput.value)) {
            maxInput.value = minInput.value;
          }
          updateFill();
          if (!state._batchResetting) debouncedFetchData();   // ← 改这里
        });


        updateFill();

    });
  }

  // ---- Fetch ----
  function buildParams() {
    const params = new URLSearchParams();
    params.set('origin', state.origin);
    if (state.shapes.length) params.set('shapes', state.shapes.join(','));
    params.set('carat_min', state.carat[0]);
    params.set('carat_max', state.carat[1]);
    params.set('color_min', COLOR_LABELS[state.color[0]] || 'M');
    params.set('color_max', COLOR_LABELS[state.color[1]] || 'D');
    params.set('cut_min', CUT_LABELS[state.cut[0]] || 'Fair');
    params.set('cut_max', CUT_LABELS[state.cut[1]] || 'Super Ideal');

    params.set('clarity_min', CLARITY_LABELS[state.clarity[0]] || 'SI2');
    params.set('clarity_max', CLARITY_LABELS[state.clarity[1]] || 'FL');
   
    params.set('price_min', state.price[0]);
    params.set('price_max', state.price[1]);
    if (state.reports.length) params.set('reports', state.reports.join(','));
    //if (state.quickShip) params.set('quick_ship', '1');
    params.set('sort', state.sort);
    params.set('page', state.page);
    params.set('per_page', PAGE_SIZE);
    return params.toString();
  }
function updateFilterReset() {
  const container = document.getElementById(`dl-filter-reset-${SID}`);
  if (!container) return;

  const tags = [];

  // Price
  if (state.price[0] !== 10 || state.price[1] !== 100000) {
    tags.push({
      label: `$${state.price[0].toLocaleString()} - $${state.price[1].toLocaleString()}`,
      clear: () => {
        state.price = [10, 100000];
        resetRangeSlider('price');
      }
    });
  }

  // Shapes
  state.shapes.forEach(shape => {
    tags.push({
      label: shape,
      clear: () => {
        const idx = state.shapes.indexOf(shape);
        if (idx > -1) state.shapes.splice(idx, 1);
        const el = document.querySelector(`#dl-shapes-${SID} [data-shape="${shape}"]`);
        if (el) el.classList.remove('active');
      }
    });
  });

  // Carat
  if (state.carat[0] !== 0.5 || state.carat[1] !== 20) {
    tags.push({
      label: `${state.carat[0]} - ${state.carat[1]} Carat`,
      clear: () => {
        state.carat = [0.5, 20];
        resetRangeSlider('carat');
      }
    });
  }

  // Cut
    if (state.cut[0] !== 0 || state.cut[1] !== 4) {
    const cutMin = CUT_LABELS[state.cut[0]] || CUT_LABELS[0];
    const cutMax = CUT_LABELS[Math.min(state.cut[1], CUT_LABELS.length - 1)];
    tags.push({
        label: `${cutMin} - ${cutMax} Cut`,
        clear: () => {
        state.cut = [0, 4];
        resetRangeSlider('cut');
        }
    });
    }

  // Color
if (state.color[0] !== 0 || state.color[1] !== 9) {
  const colorMin = COLOR_LABELS[state.color[0]] || COLOR_LABELS[0];
  const colorMax = COLOR_LABELS[Math.min(state.color[1], COLOR_LABELS.length - 1)];
  tags.push({
    label: `Color ${colorMin} - ${colorMax}`,
    clear: () => {
      state.color = [0, 9];
      resetRangeSlider('color');
    }
  });
}

// Clarity
if (state.clarity[0] !== 0 || state.clarity[1] !== 7) {
  const clarityMin = CLARITY_LABELS[state.clarity[0]] || CLARITY_LABELS[0];
  const clarityMax = CLARITY_LABELS[Math.min(state.clarity[1], CLARITY_LABELS.length - 1)];
  tags.push({
    label: `${clarityMin} - ${clarityMax}`,
    clear: () => {
      state.clarity = [0, 7];
      resetRangeSlider('clarity');
    }
  });
}


  // Reports
  state.reports.forEach(report => {
    tags.push({
      label: report,
      clear: () => {
        state.reports = state.reports.filter(r => r !== report);
        const cb = document.querySelector(`#dl-fg-report-${SID} input[value="${report}"]`);
        if (cb) cb.checked = false;
      }
    });
  });

  // Render
    if (!tags.length) {
    container.innerHTML = '';
    return;
    }

    container.innerHTML =
    tags.map((tag, i) => `
        <span class="dl-filter-tag">
        ${tag.label}
        <button data-tag-index="${i}" aria-label="Remove filter">✕</button>
        </span>
    `).join('') +
    `<button class="dl-filter-reset-all" onclick="dlResetFilters('${SID}')">Reset All ✕</button>`;

    // 用事件委托绑定，避免字符串传参问题
    container.querySelectorAll('[data-tag-index]').forEach(btn => {
    btn.addEventListener('click', function() {
        const idx = parseInt(this.dataset.tagIndex);
        if (tags[idx]) {
        tags[idx].clear();
        state.page = 1;
        fetchData();
        }
    });
    });


  
}

function resetRangeSlider(filterKey) {
  const wrap = document.querySelector(`#dl-filters-${SID} .dl-range-wrap[data-filter="${filterKey}"]`);
  if (!wrap) return;
  const minInput = wrap.querySelector('[data-role=min]');
  const maxInput = wrap.querySelector('[data-role=max]');
  if (minInput) minInput.value = minInput.min;
  if (maxInput) maxInput.value = maxInput.max;
  minInput?.dispatchEvent(new Event('input'));
}

  function fetchData() {
    // 直接请求时，取消尚未执行的防抖请求。
    clearTimeout(_dlFetchTimer);
    _dlFetchTimer = null;

    // 记录本次请求版本，后续只有最新版本可以更新页面。
    const requestVersion = ++_dlFetchVersion;

    dlSaveFiltersToURL();
    updateFilterReset();
    const tbody = document.getElementById(`dl-tbody-${SID}`);
    tbody.innerHTML = '<tr><td colspan="7" class="dl-loading">Loading diamonds...</td></tr>';
    let shopDomain = window.Shopify?.shop || location.hostname;
    shopDomain= "https://"+shopDomain
    let body = {
      shopDomain: shopDomain,
      shapes:     state.shapes.length ? state.shapes : [],
      minCarat:   state.carat[0],
      maxCarat:   state.carat[1],
      colors: state.color[0] === 0 && state.color[1] === 9
      ? []
      : COLOR_LABELS.slice(state.color[0], state.color[1] + 1),

      fancyColors: [],
      cuts: state.cut[0] === 0 && state.cut[1] === 4
      ? []
      : CUT_LABELS.slice(state.cut[0], state.cut[1] + 1),
      claritys:   state.clarity[0] === 0 && state.clarity[1] === 7
                    ? []
                    : CLARITY_LABELS.slice(state.clarity[0], state.clarity[1] + 1),
      minPrice:   state.price[0],
      maxPrice:   state.price[1],
      page:       state.page - 1,   // 后台从0开始
      size:       PAGE_SIZE,
      sortBy:     state.sort
    };
    if(state.origin){
      body.diamondOrigin = state.origin
    }
    if(body.shapes && body.shapes.length>0 && body.shapes[0] =='Quirky'){
      body.shapes=['Elongated Cushion','Triangular','Cushion Antique','Cushion Mixed Cut','Hexagonal Modified Brilliant','Oval Modified Brilliant']
    }
    {% comment %} if(state.quickShip){
      body.quickShip = 1;
    } {% endcomment %}
    if(state.reports){
      body.reports = state.reports;
    }

    fetch(API_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    })
      .then(r => r.json())
      .then(json => {
          // 旧请求即使最后才返回，也不能覆盖最新筛选结果。
          if (requestVersion !== _dlFetchVersion) return;
          const diamonds = json.content || [];
          const total = json.totalElements || diamonds.length;
          state.data = diamonds;
          state.total = total;
          state.page = (json.number || 0) + 1;

          // 动态更新 Price 滑块范围
          {% comment %} if (diamonds.length > 0) {
            const prices = diamonds.map(d => d.price).filter(p => typeof p === 'number');
            if (prices.length > 0) {
              const minP = Math.floor(Math.min(...prices));
              const maxP = Math.ceil(Math.max(...prices));
              updatePriceSliderRange(minP, maxP);
            }
          } {% endcomment %}

          renderTable();
        })

      .catch((e) => {
        // 旧请求失败时，也不能覆盖最新请求的列表或加载状态。
        if (requestVersion !== _dlFetchVersion) return;
        console.log(e);
        tbody.innerHTML = '<tr><td colspan="7" class="dl-loading">Failed to load data. Please check your API endpoint.</td></tr>';
      });
  }
  function updatePriceSliderRange(minP, maxP) {
    const wrap = document.querySelector(`#dl-filters-${SID} .dl-range-wrap[data-filter="price"]`);
    if (!wrap) return;

    const minInput = wrap.querySelector('[data-role=min]');
    const maxInput = wrap.querySelector('[data-role=max]');
    const fill = wrap.querySelector('.dl-range-fill');
    const minLabel = wrap.querySelector('.dl-range-min-label');
    const maxLabel = wrap.querySelector('.dl-range-max-label');

    // 更新 input 的 min/max 属性
    wrap.dataset.min = minP;
    wrap.dataset.max = maxP;
    minInput.min = minP;
    minInput.max = maxP;
    maxInput.min = minP;
    maxInput.max = maxP;

    // 只在用户没有手动调整过价格时才重置滑块位置
    if (state.price[0] === state._initPriceMin && state.price[1] === state._initPriceMax) {
      minInput.value = minP;
      maxInput.value = maxP;
      state.price = [minP, maxP];
      state._initPriceMin = minP;
      state._initPriceMax = maxP;
    }
    // 如果 URL 指定了 price，在 API 返回范围后同步 slider UI
    if (state._urlPriceMin != null || state._urlPriceMax != null) {
      const clampedMin = Math.max(minP, state._urlPriceMin ?? minP);
      const clampedMax = Math.min(maxP, state._urlPriceMax ?? maxP);
      minInput.value = clampedMin;
      maxInput.value = clampedMax;
      state.price = [clampedMin, clampedMax];
      state._urlPriceMin = null;
      state._urlPriceMax = null;
    }


    // 更新填充条和标签
    const absMin = minP;
    const absMax = maxP;
    const pMin = ((parseFloat(minInput.value) - absMin) / (absMax - absMin)) * 100;
    const pMax = ((parseFloat(maxInput.value) - absMin) / (absMax - absMin)) * 100;
    if (fill) {
      fill.style.left = pMin + '%';
      fill.style.width = (pMax - pMin) + '%';
    }
    if (minLabel) minLabel.textContent = '$' + parseFloat(minInput.value).toLocaleString();
    if (maxLabel) maxLabel.textContent = '$' + parseFloat(maxInput.value).toLocaleString();
  }

  // ---- Render Grid (Visual View) ----
  function renderGrid() {
    const gridEl = document.getElementById(`dl-grid-${SID}`);
    const totalEl = document.getElementById(`dl-total-${SID}`);
    if (totalEl) totalEl.textContent = `(${state.total.toLocaleString()})`;
    updatePagination();

    if (!gridEl) return;
    if (!state.data.length) {
      gridEl.innerHTML = '<div class="dl-loading" style="grid-column:1/-1">No diamonds found matching your filters.</div>';
      return;
    }

    // 简单判断 Best Value：价格最低的前20%标记
    const prices = state.data.map(d => typeof d.price === 'number' ? d.price : Infinity);
    const sortedPrices = [...prices].sort((a,b) => a - b);
    const bestValueThreshold = sortedPrices[Math.max(0, Math.floor(sortedPrices.length * 0.2) - 1)];

    let html = '';
    state.data.forEach((d, idx) => {
      const attr = d;
      const priceFormatted = typeof d.price === 'number'
        ? '$ ' + d.price.toLocaleString()
        : (d.price_display || d.price || '-');

      // 图片
      let imgHtml = '';
      let imgs = [];
      if (attr.medias && attr.medias.length > 0) {
        imgs = attr.medias.filter(m => m.mediaType === 1 && m.url).map(m => m.url);
      }
      if (!imgs.length && d.pictures) {
        imgs = d.pictures.split(',').map(s => s.trim()).filter(Boolean);
      }
      if (imgs[0]) {
        imgHtml = `<img src="${imgs[0]}" alt="${attr.shape || ''} Diamond" loading="lazy">`;
      } else {
        imgHtml = `<div class="dl-grid-card-img-placeholder">💎</div>`;
      }

      // Best Value 徽章
      const isBestValue = typeof d.price === 'number' && d.price <= bestValueThreshold;
      const badgeHtml = isBestValue ? `<span class="dl-grid-badge">Best Value</span>` : '';

      // Wishlist 按钮
      const wishlisted = dlIsWishlisted(d);
      const wishlistHtml = `
        <button class="dl-grid-icon-btn dl-wishlist-btn ${wishlisted ? 'wishlisted' : ''}"
          id="dl-gwl-${SID}-${idx}"
          onclick="event.stopPropagation();dlToggleWishlist('${SID}',${idx})"
          title="Add to Wishlist">
        </button>`;

      // 360° 图标（如有 medias 视频类型）
      const has360 = attr.medias && attr.medias.some(m => m.mediaType === 2);
      const icon360Html = has360
        ? `<button class="dl-grid-icon-btn" title="360° View" onclick="event.stopPropagation()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path d="M9 10l3-3 3 3M12 7v10"/>
            </svg>
           </button>`
        : '';

      // 名称 & 副标题
      const cardName = attr.name || 'Secret Garden Diamond Ring';
      const cardSub  = attr.carat ? `(${attr.carat}ct. tw.)` : '';

      html += `
        <div class="dl-grid-card" onclick="dlToggleRow('${SID}','${idx}')">
          <div class="dl-grid-card-img-wrap">
            ${imgHtml}
            ${badgeHtml}
            <div class="dl-grid-icons">
              ${icon360Html}
