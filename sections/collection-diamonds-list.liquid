  // ===== WISHLIST HELPERS =====

const WISHLIST_KEY = 'ecglosty_wishlist';

function dlGetWishlist() {
  try {
    const raw = localStorage.getItem(WISHLIST_KEY);
    if (raw) {
      const parsed = JSON.parse(raw);
      if (parsed && Array.isArray(parsed.diamonds)) return parsed;
    }
  } catch(e) {}
  return { diamonds: [], others: [] };
}

function dlSaveWishlist(wl) {
  localStorage.setItem(WISHLIST_KEY, JSON.stringify(wl));
}

// 判断某条数据是否已在 wishlist（用唯一标识，优先用 id/sku，fallback 用 title+carat）
function dlGetDiamondKey(d) {
  return d.id || d.sku || (d.title + '_' + d.carat);
}

function dlIsWishlisted(d) {
  const wl = dlGetWishlist();
  const key = dlGetDiamondKey(d);
  return wl.diamonds.some(item => dlGetDiamondKey(item) === key);
}

// 切换 wishlist 状态
window.dlToggleWishlist = function(sid, idx) {
  const state = window['dlState_' + sid];  // 见下方说明
  if (!state || !state.data[idx]) return;
  const d = state.data[idx];
  const key = dlGetDiamondKey(d);
  const wl = dlGetWishlist();

  const existingIdx = wl.diamonds.findIndex(item => dlGetDiamondKey(item) === key);
  if (existingIdx >= 0) {
    // 已选 → 取消
    wl.diamonds.splice(existingIdx, 1);
  } else {
    // 未选 → 添加
    wl.diamonds.push(d);
  }
  dlSaveWishlist(wl);

  // 更新按钮状态
  const btn = document.getElementById(`dl-wl-${sid}-${idx}`);
  if (btn) {
    btn.classList.toggle('wishlisted', existingIdx < 0);
  }
   const gbtn = document.getElementById(`dl-gwl-${sid}-${idx}`);
  if (gbtn) {
    gbtn.classList.toggle('wishlisted', existingIdx < 0);
  }

  // 更新 count
  dlUpdateWishlistCount(sid);

  // 如果 compare tab 当前是打开的，刷新渲染
  const compareWrap = document.getElementById(`dl-compare-wrap-${sid}`);
  if (compareWrap && compareWrap.style.display !== 'none') {
    dlRenderCompare(sid);
  }
};

// 更新 dl-count 显示
function dlUpdateWishlistCount(sid) {
  const wl = dlGetWishlist();
  const countEl = document.getElementById(`dl-count-${sid}`);
  if (countEl) countEl.textContent = `(${wl.diamonds.length || '0'})`;
}

// 渲染 Compare 面板
function dlRenderCompare(sid) {
  const wl = dlGetWishlist();
  const tbody = document.getElementById(`dl-compare-tbody-${sid}`);
  const emptyEl = document.getElementById(`dl-compare-empty-${sid}`);
  if (!tbody) return;

  if (wl.diamonds.length === 0) {
    tbody.innerHTML = '';
    if (emptyEl) emptyEl.style.display = '';
    return;
  }
  if (emptyEl) emptyEl.style.display = 'none';

  let html = '';
  wl.diamonds.forEach((d, i) => {
    const attr = d || {};
    const key = dlGetDiamondKey(d);
    const rowId = `dl-crow-${sid}-${i}`;
    const expandId = `dl-cexpand-${sid}-${i}`;

    const priceFormatted = typeof d.price === 'number'
      ? '$' + d.price.toLocaleString()
      : (d.price_display || d.price || '-');

    // 取图片（和 renderTable 逻辑一致）
    let imgHtml = '';
    let imgs = [];
    if (attr.medias && attr.medias.length > 0) {
      imgs = attr.medias.filter(m => m.mediaType === 1 && m.url).map(m => m.url);
    }
    if (!imgs.length && d.pictures) {
      imgs = d.pictures.split(',').map(s => s.trim()).filter(Boolean);
    }
    imgHtml = imgs[0]
      ? `<img class="dl-expand-img" src="${imgs[0]}" alt="${attr.shape || ''} Diamond">`
      : `<div class="dl-expand-img-placeholder">💎</div>`;

    // shape icon（和 renderTable 一致）
    const shapeIcon = (window.dlShapeImages && window.dlShapeImages[sid] && window.dlShapeImages[sid][attr.shape])
      ? `<img src="${window.dlShapeImages[sid][attr.shape]}" alt="${attr.shape || ''}" class="dl-shape-icon">`
      : `<span>${attr.shape || '-'}</span>`;

    html += `
      <tr class="dl-row" id="${rowId}" onclick="dlToggleCompareRow('${sid}',${i})">
        <td>
          <div class="dl-flex">
            ${shapeIcon}
            ${attr.shape || '-'}
          </div>
        </td>
        <td>${attr.carat || '-'}</td>
        <td>${attr.color || '-'}</td>
        <td>${attr.clarity || '-'}</td>
        <td>${attr.cut || '-'}</td>
        <td>${priceFormatted}</td>
        <td>
          <div class="text-center">
            <button
                class="dl-wishlist-btn wishlisted"
                data-compare-sid="${sid}"
                data-compare-idx="${i}"
                onclick="event.stopPropagation();dlRemoveFromCompare(this)"
                title="Remove from Wishlist">
              </button>
          </div>
        </td>
      </tr>
      <tr class="dl-expand-row" id="${expandId}">
        <td class="dl-expand-cell" colspan="7">
          <div class="dl-expand-inner">
            ${imgHtml}
            <div class="dl-expand-info">
              <div class="dl-expand-title">${d.name || (attr.carat + ' ct. ' + attr.shape + ' Diamond')}</div>
              <div class="dl-expand-price">${priceFormatted}</div>
              <div class="dl-expand-specs">
                <div><div class="dl-expand-spec-label">Carat:</div><div class="dl-expand-spec-value">${attr.carat || '-'}</div></div>
                <div><div class="dl-expand-spec-label">Cut:</div><div class="dl-expand-spec-value">${attr.cut || '-'}</div></div>
                <div><div class="dl-expand-spec-label">Color:</div><div class="dl-expand-spec-value">${attr.color || '-'}</div></div>
                <div><div class="dl-expand-spec-label">Clarity:</div><div class="dl-expand-spec-value">${attr.clarity || '-'}</div></div>
                <div><div class="dl-expand-spec-label">LW:</div><div class="dl-expand-spec-value">${attr.diamondLength && attr.diamondWidth ? (attr.diamondLength + '/' + attr.diamondWidth) : '-'}</div></div>
                <div><div class="dl-expand-spec-label">Fluor:</div><div class="dl-expand-spec-value">${attr.flo || '-'}</div></div>
                <div><div class="dl-expand-spec-label">Symmetry:</div><div class="dl-expand-spec-value">${attr.symm || '-'}</div></div>
                <div><div class="dl-expand-spec-label">Table:</div><div class="dl-expand-spec-value">${attr.diamondTable ? attr.diamondTable + '%' : '-'}</div></div>
                <div><div class="dl-expand-spec-label">Origin:</div><div class="dl-expand-spec-value">${attr.lab || '-'}</div></div>
                <div><div class="dl-expand-spec-label">Measurements:</div><div class="dl-expand-spec-value">${attr.diamondLength && attr.diamondWidth && attr.diamondHeight ? (attr.diamondLength + ' × ' + attr.diamondWidth + ' × ' + attr.diamondHeight) : '-'}</div></div>
                <div><div class="dl-expand-spec-label">Culet:</div><div class="dl-expand-spec-value">${attr.culet || '-'}</div></div>
                <div><div class="dl-expand-spec-label">Polish:</div><div class="dl-expand-spec-value">${attr.pol || '-'}</div></div>
                <div><div class="dl-expand-spec-label">Girdle:</div><div class="dl-expand-spec-value">${attr.girdle || '-'}</div></div>
                <div><div class="dl-expand-spec-label">Depth:</div><div class="dl-expand-spec-value">${attr.depth ? attr.depth + '%' : '-'}</div></div>
                <div><div class="dl-expand-spec-label">Report:</div><div class="dl-expand-spec-value">${attr.lab || '-'}</div></div>
              </div>
              ${d.quick_ship ? '<span class="dl-tag">QUICK SHIP</span>' : ''}
              ${d.only_one ? '<span class="dl-tag">ONLY ONE AVAILABLE</span>' : ''}
            </div>
            <div class="dl-expand-actions">
              <button class="dl-btn-select" onclick="event.stopPropagation();dlSelectDiamondFromCompare('${sid}',${i})">Select Diamond</button>
              ${d.urlHandle ? `<button class="dl-btn-details" onclick="event.stopPropagation();dlViewDetails('${sid}',${JSON.stringify(d.urlHandle)})">View Diamond Details</button>` : ''}
            </div>
          </div>
        </td>
      </tr>
    `;
  });

  tbody.innerHTML = html;
}

window.dlToggleCompareRow = function(sid, idx) {
  const row = document.getElementById(`dl-crow-${sid}-${idx}`);
  const expand = document.getElementById(`dl-cexpand-${sid}-${idx}`);
  if (!row || !expand) return;

  const isOpen = expand.classList.contains('open');

  // 先收起所有
  document.querySelectorAll(`#dl-compare-tbody-${sid} .dl-row`).forEach(r => r.classList.remove('active'));
  document.querySelectorAll(`#dl-compare-tbody-${sid} .dl-expand-row`).forEach(e => e.classList.remove('open'));

  if (!isOpen) {
    row.classList.add('active');
    expand.classList.add('open');
  }
};
window.dlSelectDiamondFromCompare = function(sid, idx) {
  const wl = dlGetWishlist();
  const d = wl.diamonds[idx];
  if (!d) return;
  // 复用原来 dlSelectDiamond 的逻辑，直接传 d 对象
  localStorage.setItem('ecglosty_selected_diamond', JSON.stringify(d));
  if (d.urlHandle) {
    location.href = '/products/' + d.urlHandle;
  }
};


// 在 compare 面板里取消选择
window.dlRemoveFromCompare = function(btn) {
  const sid = btn.dataset.compareSid;
  const idx = parseInt(btn.dataset.compareIdx);

  const wl = dlGetWishlist();
  if (idx < 0 || idx >= wl.diamonds.length) return;

  wl.diamonds.splice(idx, 1);  // 直接按索引删除，不需要 key 比对
  dlSaveWishlist(wl);
  dlUpdateWishlistCount(sid);
  dlRenderCompare(sid);
  dlSyncWishlistButtons(sid);
};


// 同步主列表所有行的 wishlist 按钮状态
function dlSyncWishlistButtons(sid) {
  const state = window['dlState_' + sid];
  if (!state || !state.data) return;
  state.data.forEach((d, idx) => {
    const btn = document.getElementById(`dl-wl-${sid}-${idx}`);
    if (btn) btn.classList.toggle('wishlisted', dlIsWishlisted(d));
  });
}


  // Boot
