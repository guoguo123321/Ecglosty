  function dlBuildExpandMedia(attr, d, idx) {
  const medias = Array.isArray(attr.medias)
    ? attr.medias
    : [];

  /*
   * 条件 1：
   * mediaType = 4，优先作为 3D 旋转图片使用
   */
  const spinMedia = medias.find(
    m =>
      String(m.mediaType) === '4' &&
      m.url
  );

  if (spinMedia) {
    const mediaJson = encodeURIComponent(
      JSON.stringify(spinMedia)
    );

    return `
      <div
        class="dl-expand-img dl-expand-spin"
        data-dl-spin-media="${mediaJson}"
        data-dl-spin-id="${SID}-${idx}"
      >
        <span class="dl-expand-spin-loading">
          Loading…
        </span>
      </div>
    `;
  }

  /*
   * 条件 2：
   * mediaType = 2，作为视频使用
   */
  const videoMedia = medias.find(
    m =>
      String(m.mediaType) === '2' &&
      m.url
  );

  if (videoMedia) {
    return `
      <video
        class="dl-expand-img dl-expand-video"
        data-dl-video-src="${dlEscapeHtml(videoMedia.url)}"
        controls
        playsinline
        preload="none"
        onclick="event.stopPropagation();"
      >
      </video>
    `;
  }


  /*
   * 默认逻辑：
   * mediaType = 1，或者使用 d.pictures
   */
  let imgs = medias
    .filter(
      m =>
        String(m.mediaType) === '1' &&
        m.url
    )
    .map(m => m.url);

  if (!imgs.length && d.pictures) {
    imgs = d.pictures
      .split(',')
      .map(s => s.trim())
      .filter(Boolean);
  }

  return imgs[0]
    ? `
      <img
        class="dl-expand-img"
        data-dl-image-src="${dlEscapeHtml(imgs[0])}"
        alt="${dlEscapeHtml(attr.shape || 'Diamond')} Diamond"
        onclick="event.stopPropagation();"
      >
    `
    : `
      <div class="dl-expand-img-placeholder">
        💎
      </div>
    `;

}

function dlEscapeHtml(value) {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}
function dlDestroyExpandSpin(expand) {
  if (!expand) return;

  const spinContainer = expand.querySelector('[data-dl-spin-media]');
  if (!spinContainer) return;

  if (typeof spinContainer.dlSpinDestroy === 'function') {
    spinContainer.dlSpinDestroy();
    spinContainer.dlSpinDestroy = null;
  }

  delete spinContainer.dataset.dlSpinInitialized;
  delete spinContainer.dataset.dlSpinLoading;
  spinContainer.innerHTML = '<span class="dl-expand-spin-loading">Loading…</span>';
}

function dlInitExpandSpinForRow(sid, idx) {
  const expandId = `dl-expand-${sid}-${idx}`;
  const expand = document.getElementById(expandId);

  if (!expand) {
    return;
  }

  /*
   * 当前行展开后，才加载普通图片
   */
  const lazyImage = expand.querySelector(
    '[data-dl-image-src]'
  );

  if (
    lazyImage &&
    !lazyImage.getAttribute('src')
  ) {
    lazyImage.setAttribute(
      'src',
      lazyImage.dataset.dlImageSrc
    );
  }

  /*
   * 当前行展开后，才加载视频
   */
  const lazyVideo = expand.querySelector(
    '[data-dl-video-src]'
  );

  if (
    lazyVideo &&
    !lazyVideo.getAttribute('src')
  ) {
    lazyVideo.setAttribute(
      'src',
      lazyVideo.dataset.dlVideoSrc
    );

    lazyVideo.load();
  }

  /*
   * 当前行没有 3D 媒体，就到这里结束
   */
  const spinContainer = expand.querySelector(
    '[data-dl-spin-media]'
  );

  if (!spinContainer) {
    return;
  }

  /*
   * 防止同一行重复初始化
   */
  if (
    spinContainer.dataset.dlSpinInitialized === 'true' ||
    spinContainer.dataset.dlSpinLoading === 'true'
  ) {
    return;
  }

  spinContainer.dataset.dlSpinLoading = 'true';

  try {
    const media = JSON.parse(
      decodeURIComponent(
        spinContainer.dataset.dlSpinMedia
      )
    );

    spinContainer.innerHTML = '';

    /*
     * 第三个参数传入当前行的容器，
     * 3D 内容只会插入当前展开行
     */
    spinContainer.dlSpinDestroy = renderSpin(
      media,
      spinContainer.dataset.dlSpinId,
      spinContainer
    );

    spinContainer.dataset.dlSpinInitialized =
      'true';

    spinContainer.addEventListener(
      'click',
      event => {
        event.stopPropagation();
      }
    );
  } catch (error) {
    console.error(
      'Failed to initialize diamond 3D media:',
      error
    );

    spinContainer.innerHTML = `
      <div class="dl-expand-img-placeholder">
        💎
      </div>
    `;
  }
}


//和钻石详情使用同一个3D旋转代码
function isPortraitMedia(index) {
  return index >= 4;
}
// ── 创建媒体容器 ──────────────────────────────────────────────────────────
function createMediaItem(index, extraClasses) {
  const item = document.createElement('div');
  item.className = 'dpi-media-item' + (extraClasses ? ' ' + extraClasses : '');
  if (isPortraitMedia(index)) {
    item.classList.add('dpi-media-item--portrait');
  }
  return item;
}

function renderSpin(media, index, targetElement) {
  const item = createMediaItem(index, 'dpi-media-item--product');

  const { url, imageName, imageSuffix, imageNumber } = media;

  const TOTAL_FRAMES = imageNumber || 1;

  // 鼠标拖动灵敏度
  // 数值越小，鼠标移动相同距离时旋转越快
  const SENSITIVITY = 1.0;

  // 自动旋转速度
  const AUTO_PLAY_SPEED = 0.5;

  // 惯性衰减速度
  // 数值越小，松手后停止越快
  const FRICTION = 0.90;

  // 松手时的速度放大倍数
  const SPEED_BOOST = 2.5;

  // 松手后的最大惯性速度
  const MAX_INERTIA = 0.8;

  const frameUrls = [];

  for (let i = 1; i <= TOTAL_FRAMES; i++) {
    frameUrls.push(
      url + imageName + i + '.' + imageSuffix
    );
  }

  const canvas = document.createElement('canvas');

  canvas.width = 800;
  canvas.height = 800;

  canvas.style.cssText = `
    width: 100%;
    height: 100%;
    object-fit: contain;
    cursor: grab;
    display: block;
    transform: translateZ(0);
    touch-action: none;
  `;

  const loader = document.createElement('div');

  loader.className = 'dpi-spin-loader';

  loader.innerHTML = `
    <div style="text-align: center;">
    <span id="dpi-spin-text-${index}">Loading…</span>

    <div
      style="
        width: 160px;
        height: 5px;
        background: #e0e0e0;
        border-radius: 3px;
        margin-top: 10px;
        overflow: hidden;
      "
    >
      <div
        id="dpi-spin-bar-${index}"
        style="
          width: 0%;
          height: 100%;
          background: #1a3a4a;
          transition: width 0.1s;
        "
      ></div>
    </div>
    </div>
  `;

  const dragLabel = document.createElement('div');

  dragLabel.className = 'dpi-drag-label';
  dragLabel.textContent = 'Drag to Spin';
  dragLabel.style.opacity = '1';

  item.appendChild(canvas);
  item.appendChild(loader);
  item.appendChild(dragLabel);

  
  if (targetElement) {
    targetElement.appendChild(item);
  } else {
    mediaGridEl.appendChild(item);
  }

  const ctx = canvas.getContext('2d');

  const imgs = new Array(TOTAL_FRAMES);

  let loadedCount = 0;
  let isReady = false;

  let currentFrameFloat = 0.0;
  let lastRenderedFrame = -1;

  let isDragging = false;
  let isMouseOver = false;

  let startX = 0;
  let startFrameFloat = 0.0;

  let trackX = 0;
  let trackTime = 0;

  let finalVelocity = 0;
  let inertiaSpeed = 0;

  let rafId = null;
  let destroyed = false;
  let loaderTimeoutId = null;

  // 用于根据真实帧间隔计算速度
  let lastAnimationTime = 0;

  const spinTextEl = document.getElementById(
    `dpi-spin-text-${index}`
  );

  const spinBarEl = document.getElementById(
    `dpi-spin-bar-${index}`
  );

  function clampFrame(frame) {
    return (
      (frame % TOTAL_FRAMES + TOTAL_FRAMES) %
      TOTAL_FRAMES
    );
  }

  function renderFrame(frameFloat) {
    const frame = Math.round(
      clampFrame(frameFloat)
    );

    if (frame === lastRenderedFrame) {
      return;
    }

    const img = imgs[frame];

    if (
      img &&
      img.complete &&
      img.naturalWidth > 0
    ) {
      ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
      );

      ctx.drawImage(
        img,
        0,
        0,
        canvas.width,
        canvas.height
      );

      lastRenderedFrame = frame;
    }
  }

  function animate(now = performance.now()) {
    if (destroyed) return;
    if (!lastAnimationTime) {
      lastAnimationTime = now;
    }

    // 以 60fps 为基准计算时间差，
    // 防止高刷新率屏幕旋转速度过快
    const deltaTime = Math.min(
      (now - lastAnimationTime) / 16.667,
      2
    );

    lastAnimationTime = now;

    if (!isDragging && isReady) {
      if (Math.abs(inertiaSpeed) > 0) {
        currentFrameFloat -=
          inertiaSpeed * deltaTime;

        // 根据实际时间逐渐降低惯性
        inertiaSpeed *= Math.pow(
          FRICTION,
          deltaTime
        );

        // 速度足够小时直接停止
        if (Math.abs(inertiaSpeed) < 0.02) {
          inertiaSpeed = 0;
        }
      }

      // 没有惯性并且鼠标不在图片上时，缓慢自动旋转
      if (
        inertiaSpeed === 0 &&
        !isMouseOver
      ) {
        currentFrameFloat +=
          AUTO_PLAY_SPEED * deltaTime;
      }

      renderFrame(currentFrameFloat);
    }

    rafId = requestAnimationFrame(animate);
  }

  // 先加载第 1 帧并立即显示
  const firstImg = new Image();

  firstImg.onload = () => {
    if (destroyed) return;
    if (firstImg.naturalWidth > 0) {
      canvas.width = firstImg.naturalWidth;
      canvas.height = firstImg.naturalHeight;
    }

    imgs[0] = firstImg;

    // 先显示第 1 帧
    renderFrame(0);

    // 然后加载剩余所有帧
    preloadAllFrames();
  };

  firstImg.onerror = () => {
    if (destroyed) return;
    // 第 1 帧失败时，也继续尝试加载其他帧
    preloadAllFrames();
  };

  firstImg.src = frameUrls[0];

  function preloadAllFrames() {
    if (destroyed) return;
    loadedCount = 0;

    frameUrls.forEach((src, idx) => {
      // 第 1 帧已经加载过，直接计数
      if (idx === 0 && imgs[0]) {
        loadedCount++;

        updateLoader();

        if (loadedCount === TOTAL_FRAMES) {
          finishLoading();
        }

        return;
      }

      const img = new Image();

      img.onload = () => {
        if (destroyed) return;
        loadedCount++;

        updateLoader();

        if (loadedCount === TOTAL_FRAMES) {
          finishLoading();
        }
      };

      img.onerror = () => {
        if (destroyed) return;
        loadedCount++;

        updateLoader();

        if (loadedCount === TOTAL_FRAMES) {
          finishLoading();
        }
      };

      img.src = src;
      imgs[idx] = img;
    });
  }

  function updateLoader() {
    const percentage = Math.floor(
      (loadedCount / TOTAL_FRAMES) * 100
    );

    if (spinBarEl) {
      spinBarEl.style.width =
        percentage + '%';
    }

    if (spinTextEl) {
      spinTextEl.textContent =
        percentage + '%';
    }
  }

  function finishLoading() {
    if (destroyed || isReady) return;

    isReady = true;
    loader.style.opacity = '0';

    loaderTimeoutId = setTimeout(() => {
      if (!destroyed) loader.style.display = 'none';
    }, 300);

    animate();
  }


  item.addEventListener('mouseenter', () => {
    isMouseOver = true;
  });

  item.addEventListener('mouseleave', () => {
    isMouseOver = false;

    dragLabel.style.opacity = '1';

    if (isDragging) {
      handleEnd();
    }
  });

  function handleStart(event) {
    if (!isReady) {
      return;
    }

    isDragging = true;
    inertiaSpeed = 0;
    finalVelocity = 0;

    dragLabel.style.opacity = '0';
    canvas.style.cursor = 'grabbing';

    const clientX =
      event.clientX ??
      event.touches?.[0]?.clientX ??
      0;

    startX = clientX;
    startFrameFloat = currentFrameFloat;

    trackX = clientX;
    trackTime = performance.now();
  }

  function handleMove(event) {
    if (!isDragging) {
      return;
    }

    if (event.cancelable) {
      event.preventDefault();
    }

    const clientX =
      event.clientX ??
      event.touches?.[0]?.clientX ??
      0;

    const now = performance.now();

    const deltaX = clientX - startX;

    // 鼠标拖动时实时旋转
    currentFrameFloat =
      startFrameFloat -
      deltaX / SENSITIVITY;

    renderFrame(currentFrameFloat);

    const dt = now - trackTime;

    if (dt > 0) {
      const instantVelocity =
        (clientX - trackX) / dt;

      // 平滑计算速度，防止松手瞬间加速
      finalVelocity =
        finalVelocity * 0.75 +
        instantVelocity * 0.25;

      trackX = clientX;
      trackTime = now;
    }
  }

  function handleEnd() {
    if (!isDragging) {
      return;
    }

    isDragging = false;
    canvas.style.cursor = 'grab';

    // 限制松手后的惯性速度
    inertiaSpeed = Math.max(
      -MAX_INERTIA,
      Math.min(
        MAX_INERTIA,
        finalVelocity * SPEED_BOOST
      )
    );

    finalVelocity = 0;
  }

  // 鼠标事件
  canvas.addEventListener(
    'mousedown',
    handleStart
  );

  window.addEventListener(
    'mousemove',
    handleMove
  );

  window.addEventListener(
    'mouseup',
    handleEnd
  );

  // 触摸事件
  canvas.addEventListener(
    'touchstart',
    (event) => {
      isMouseOver = true;
      handleStart(event);
    },
    {
      passive: false
    }
  );

  canvas.addEventListener(
    'touchmove',
    handleMove,
    {
      passive: false
    }
  );

  function handleTouchEnd() {
    isMouseOver = false;
    handleEnd();
  }

  window.addEventListener('touchend', handleTouchEnd);

  return function destroySpin() {
    if (destroyed) return;
    destroyed = true;

    if (rafId !== null) cancelAnimationFrame(rafId);
    if (loaderTimeoutId !== null) clearTimeout(loaderTimeoutId);

    window.removeEventListener('mousemove', handleMove);
    window.removeEventListener('mouseup', handleEnd);
    window.removeEventListener('touchend', handleTouchEnd);

    firstImg.onload = null;
    firstImg.onerror = null;
    firstImg.src = '';

    imgs.forEach(img => {
      if (!img || img === firstImg) return;
      img.onload = null;
      img.onerror = null;
      img.src = '';
    });

    imgs.length = 0;
    item.remove();
  };


}

//end 3D旋转代码


  function shapeIconSVG(shape, sectionId) {
    const imageMap = (window.dlShapeImages && window.dlShapeImages[sectionId]) || {};
    if (imageMap[shape]) {
      return `<img src="${imageMap[shape]}" alt="${shape}" class="dl-shape-icon">`;
    }
    return dlShapeSVGFallback(shape);
  }

  function dlShapeSVGFallback(shape) {
    const s = (shape || '').toLowerCase();
    let path = '';
    if (s === 'round') path = '<circle cx="11" cy="11" r="7"/>';
    else if (s === 'oval') path = '<ellipse cx="11" cy="11" rx="6" ry="8"/>';
    else if (s === 'emerald') path = '<rect x="4" y="6" width="14" height="10" rx="1.5"/>';
    else if (s.includes('cushion')) path = '<rect x="4" y="4" width="14" height="14" rx="4"/>';
    else if (s === 'pear') path = '<path d="M11 3 C15 3 17 7 17 10 C17 15 14 19 11 19 C8 19 5 15 5 10 C5 7 7 3 11 3Z"/>';
    else if (s === 'radiant') path = '<polygon points="7,4 15,4 18,11 15,18 7,18 4,11"/>';
    else if (s === 'princess') path = '<rect x="4" y="4" width="14" height="14"/>';
    else if (s === 'marquise') path = '<ellipse cx="11" cy="11" rx="9" ry="5"/>';
    else if (s === 'asscher') path = '<rect x="5" y="5" width="12" height="12" rx="1"/>';
    else path = '<circle cx="11" cy="11" r="7"/>';
    return `<svg class="dl-shape-icon" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5">${path}</svg>`;
  }

