          window.dlShapeImages &&
          window.dlShapeImages[SID]  // shape 图片 map 已经建立
        );
      }

      if (isReady()) {
        init();
        return;
      }

      const observer = new MutationObserver(function(mutations, obs) {
        if (isReady()) {
          obs.disconnect();
          init();
        }
      });

      observer.observe(document.body || document.documentElement, {
        childList: true,
        subtree: true
      });
    })();
    function dlOpenMobileFilters(){
      var filters = document.getElementById('dl-filters-'+SID);
      var overlay = document.getElementById('dl-overlay-'+SID);
      if(filters) filters.classList.add('dl-mobile-open');
      if(overlay) overlay.classList.add('active');
      document.body.style.overflow='hidden';
    }
    function dlCloseMobileFilters(){
      var filters = document.getElementById('dl-filters-'+SID);
      var overlay = document.getElementById('dl-overlay-'+SID);
      if(filters) filters.classList.remove('dl-mobile-open');
      if(overlay) overlay.classList.remove('active');
      document.body.style.overflow='';
    }

    const mobileFilterfab = document.getElementById(`dl-filter-fab-${SID}`);
    if(mobileFilterfab){
      mobileFilterfab.addEventListener('click', dlOpenMobileFilters);
    }
    const mobileViewresults = document.getElementById(`dl-mobile-view-results-${SID}`);
    if(mobileViewresults){
      mobileViewresults.addEventListener('click', dlCloseMobileFilters);
    }
    const mobileFilterClose = document.getElementById(`dl-mobile-filter-header-${SID}`);
    if(mobileFilterClose){
      mobileFilterClose.addEventListener('click', dlCloseMobileFilters);
    }

})();

</script>




