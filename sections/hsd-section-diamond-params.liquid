{%- liquid
  assign se_stts = section.settings
  assign set_blo = section.blocks
  assign heading_c = se_stts.color_scheme.settings.foreground_heading
  assign subheading_c = se_stts.color_scheme.settings.foreground_subheading

  if se_stts.layout == 'lgs-container'
    assign html_layout = '<div class="lgs-container">__</div>' | split: '__'
  elsif se_stts.layout == 'custom-container'
    capture custom_layout
      echo '<div class="custom-container" style="--hsd-container-width: '
      echo se_stts.custom_container | escape
      echo ';">__</div>'
    endcapture
    assign html_layout = custom_layout | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
-%}
<div class="{{ section.id }} hsd-section-diamond-params lgs-section-inner color-{{ se_stts.color_scheme }}{% if heading_c != blank and heading_c.alpha != 0.0 %} hsd-dp--heading-color{% endif %}{% if subheading_c != blank and subheading_c.alpha != 0.0 %} hsd-dp--subheading-color{% endif %}" {% render 'section_style', se_stts: se_stts -%}>
  {{-html_layout[0]-}}
    {%- render 'section_tophead', se_stts: se_stts -%}

    {%- if set_blo.size > 0 -%}
      <div class="hsd-dp__list{% if set_blo.size == 1 %} hsd-dp__list--single{% endif %}">
        {%- for block in set_blo -%}

          {%- render 'hsd-diamond-param-item', block: block -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="hsd-dp__empty">
        <p>Add 4C Item blocks to populate this section.</p>
      </div>
    {%- endif -%}
  {{-html_layout[1]-}}
</div>

