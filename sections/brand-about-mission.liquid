{% liquid
  assign se_stts = section.settings
  assign stt_layout = se_stts.layout
  if stt_layout == 'lgs-container'
    assign html_layout = '<div class="lgs-container">__</div>' | split: '__'
  elsif stt_layout == 'custom-container'
    assign html_layout = '<div class="custom-container">__</div>' | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
%}
<style>
  {%- if se_stts.layout == 'custom-container' -%}
  .{{ section.id }} .custom-container{max-width:{{ se_stts.custom_container }};margin:0 auto;}
  {%- endif -%}
  .{{ section.id }}.brand-about-mission-box{background:var(--bg-gradient);background-color:var(--bg-color);}
  .{{ section.id }} .brand-about-mission__card{background-color:var(--color-background);}
  .{{ section.id }} .lgs-title,
  .{{ section.id }} .brand-about-mission__title{--color:var(--color-foreground-heading);color:var(--color-foreground-heading);}
  .{{ section.id }} .lgs-subtitle{--color:var(--color-foreground-subheading);color:var(--color-foreground-subheading);}
  .{{ section.id }} .brand-about-label,
  .{{ section.id }} .brand-about-body{color:var(--color-foreground);}
</style>
<div class="{{ section.id }} brand-about-mission-box lgs-section-inner color-{{ se_stts.color_scheme }}" {% render 'section_style', se_stts: se_stts %}>
  {{- html_layout[0] -}}
    {%- render 'section_tophead', se_stts: se_stts -%}
    <div class="brand-about-mission__grid">
      <article class="brand-about-mission__card">
        {%- if se_stts.mission_label != blank -%}<p class="brand-about-label">{{ se_stts.mission_label }}</p>{%- endif -%}
        {%- if se_stts.mission_heading != blank -%}<h3 class="brand-about-mission__title">{{ se_stts.mission_heading }}</h3>{%- endif -%}
        {%- if se_stts.mission_text != blank -%}<div class="brand-about-body">{{ se_stts.mission_text }}</div>{%- endif -%}
      </article>
      <article class="brand-about-mission__card">
        {%- if se_stts.vision_label != blank -%}<p class="brand-about-label">{{ se_stts.vision_label }}</p>{%- endif -%}
        {%- if se_stts.vision_heading != blank -%}<h3 class="brand-about-mission__title">{{ se_stts.vision_heading }}</h3>{%- endif -%}
        {%- if se_stts.vision_text != blank -%}<div class="brand-about-body">{{ se_stts.vision_text }}</div>{%- endif -%}
      </article>
    </div>
  {{- html_layout[1] -}}
</div>

{% schema %}
{
  "name": "Brand About Mission",
  "tag": "section",
  "class": "shopify-brand-about-mission",
  "settings": [
    {"type": "select","id": "layout","label": "layout","default": "lgs-container",
      "options": [
        {"label": "lgs-container","value": "lgs-container"},
        {"label": "wrapped container","value": "wrapped-container"},
        {"label": "custom container","value": "custom-container"}
      ]
    },
    {"type": "text","id": "custom_container","label": "custom container","default": "1100px"},
    {"type": "header","content": "Colors"},
    {"type": "color_scheme","id": "color_scheme","label": "t:settings.color_scheme","default": "scheme-1","info": "Card background (Background), titles (Headings), labels/body (Text). Section background still uses bg_color below."},
    {"type": "header","content": "1. Heading options"},
    {"type": "select","id": "design_heading","label": "+ Design heading","default": "1",
      "options": [
        {"value": "1","label": "Design 01"},
        {"value": "2","label": "Design 02"},
        {"value": "3","label": "Design 03"},
        {"value": "4","label": "Design 04"},
        {"value": "5","label": "Design 05"},
        {"value": "6","label": "Design 06 (width line-awesome)"},
        {"value": "7","label": "Design 07"},
        {"value": "8","label": "Design 08"},
        {"value": "9","label": "Design 09"},
        {"value": "10","label": "Design 10"},
        {"value": "11","label": "Design 11"},
        {"value": "12","label": "Design 12"},
        {"value": "13","label": "Design 13"},
        {"value": "14","label": "Design 14"},
        {"value": "15","label": "Design 15"},
        {"value": "16","label": "Design 16"}
      ]
    },
    {"type": "select","id": "heading_align","label": "+ Heading align","default": "lgs-text-center",
      "options": [
        {"value": "lgs-text-start","label": "Left"},
        {"value": "lgs-text-center","label": "Center"},
        {"value": "lgs-text-end","label": "Right"}
      ]
    },
    {"type": "html","id": "top_heading","label": "+ Heading","default": "Where We’re Going"},
    {"type": "text","id": "icon_heading","label": "Enter a icon name on heading","info": "Only used for design 6 [LineAwesome]()","default": "las la-gem"},
    {"type": "textarea","id": "top_subheading","label": "+ Subheading","default": "Mission & Vision"},
    {"type": "number","id": "tophead_mb","label": "+ Space bottom (px)","info": "The vertical spacing between heading and content","default": 60},
    {"type": "text","id": "mission_label","label": "Mission label","default": "Our Mission"},
    {"type": "text","id": "mission_heading","label": "Mission heading","default": "Make jewelry more meaningful"},
    {"type": "richtext","id": "mission_text","label": "Mission text","default": "<p>To create fine jewelry that helps people honor love, memory, and self-expression—through transparent craftsmanship and design that delights in the details.</p>"},
    {"type": "text","id": "vision_label","label": "Vision label","default": "Our Vision"},
    {"type": "text","id": "vision_heading","label": "Vision heading","default": "A more thoughtful jewelry future"},
    {"type": "richtext","id": "vision_text","label": "Vision text","default": "<p>To become a house known for intentional design and lasting quality—where every piece feels uniquely yours, and every choice leaves a positive mark on people and planet.</p>"},
    {"type": "color","id": "cl_bg","label": "bg_color","default": "#ffffff"},
    {"type": "color_background","id": "cl_bg_gradient","label": "Background gradient"},
    {"type": "header","content": "+ Design pc options"},
    {"type": "text","id": "mg","label": "Margin","info": "Margin top, margin right, margin bottom, margin left. If you not use to blank","default": "0px,0px,0px,0px"},
    {"type": "text","id": "pd","label": "Padding","info": "Padding top, padding right, padding bottom, padding left. If you not use to blank","default": "0px,0px,90px,0px"},
    {"type": "header","content": "+ Design Tablet Options"},
    {"type": "text","id": "mg_tb","label": "Margin","default": "0px,0px,0px,0px"},
    {"type": "text","id": "pd_tb","label": "Padding","default": "0px,0px,50px,0px"},
    {"type": "header","content": "+ Design mobile options"},
    {"type": "text","id": "mg_mb","label": "Margin","default": "0px,0px,0px,0px"},
    {"type": "text","id": "pd_mb","label": "Padding","default": "0px,0px,30px,0px"}
  ],
  "presets": [
    {
      "name": "Brand About Mission",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
