{%- liquid  
	assign isShowHTMl = false
	if template.suffix == 'config' and request.design_mode
		assign isShowHTMl = true
	endif 
 	assign se_stts = section.settings
	assign se_blocks = section.blocks 
 -%}
{%- if isShowHTMl -%}
	{{ 'top-head.css' | asset_url | stylesheet_tag }}
	<div timeline hdt-reveal="slide-in" class="lgs-top-heading lgs_des_title_{{ se_stts.design_heading }} {{ se_stts.heading_align }}" style="--tophead_mb: {{ se_stts.tophead_mb }}px;--tophead_mt: {{ se_stts.tophead_mt }}px;">
		{%- if se_stts.top_heading != blank -%}<h3 class="lgs-section-title lgs-title"><span>{{ se_stts.top_heading }}</span></h3>{%- endif -%}
		{% if se_stts.design_heading == "13" %}
			<span class="heading-char lgs-d-block"><svg version="1.0" xmlns="http://www.w3.org/2000/svg" width="82" height="30" viewBox="0 0 82.000000 9.000000" preserveAspectRatio="xMidYMid meet"><g transform="translate(0.000000,9.000000) scale(0.050000,-0.050000)" fill="currentColor" stroke="none"> <path d="M20 161 c0 -10 17 -24 37 -30 21 -7 54 -30 73 -52 50 -54 142 -50 214 11 32 28 75 50 94 50 19 0 56 -22 82 -50 62 -66 157 -66 236 0 75 63 106 63 180 0 76 -64 152 -64 228 0 75 63 117 63 176 0 66 -70 160 -67 245 8 82 74 59 105 -26 34 -77 -65 -113 -65 -199 -2 -86 63 -141 63 -216 0 -75 -63 -113 -63 -188 0 -32 27 -82 50 -110 50 -27 0 -77 -22 -110 -50 -74 -63 -111 -63 -196 0 -37 28 -88 50 -112 50 -25 0 -72 -22 -104 -50 -33 -27 -75 -50 -94 -50 -19 0 -61 23 -94 50 -60 50 -116 66 -116 31z"/></g></svg></span>
		{% endif %}
		{%- if se_stts.design_heading == "6" -%}
			{%- if se_stts.icon_heading != blank -%}
	            <span class="lgs-cbl"><i class="{{ se_stts.icon_heading }}"></i></span>
	        {%- endif -%}
		{%- endif -%}
		{%- if se_stts.top_subheading != blank -%}<span class="lgs-section-des lgs-subtitle">{{ se_stts.top_subheading }}</span>{%- endif -%}
	</div>
{%- endif -%} 

{%- style -%}
	{%- for block in se_blocks -%}{%- assign bk_stts = block.settings -%}
		.lgs-{{ block.type }} {
			{%- if bk_stts.italic%}font-style: italic;{% endif -%}
		   	--color: {{ bk_stts.color }};
			{%- if block.type == 'title' -%}
			font-family: var(--font-heading--family);
			{%- elsif block.type == 'subtitle' -%}
			font-family: var(--font-subheading--family);
			{%- else -%}
			font-family: var(--font-family-{{ bk_stts.family }});
			{%- endif -%}
			font-size: {{ bk_stts.size_mb }}px;
			font-weight: {{ bk_stts.weight }};
		   {%- if bk_stts.ls_mb != 0 %}word-spacing: {{ bk_stts.ls_mb }}px;{% endif -%}
		   {%- if bk_stts.lh_mb != 0 %}line-height: {{ bk_stts.lh_mb }}px;{% endif -%}
		   {%- if bk_stts.space_mb != 0 %}margin-bottom: {{ bk_stts.space_mb }}px;{% endif -%}
		}
		{% if block.type == "title" %}
			.lgs-top-heading .lgs-cbl {
				--color: {{ bk_stts.color }};
			}
		{% endif %}
      {% if block.type == 'button' %}
        .lgs-{{ block.type }} {
          --bgcolor: {{ bk_stts.bg_color }};
          padding: {{ bk_stts.padding-top-bottom }}px {{ bk_stts.padding-left-right }}px;
        }
      {% endif %}
      {% comment %}
        {% if block.type == "button" %}
          .lgs-{{ block.type }} {
          }
        {% endif %}
      {% endcomment %}
		@media (min-width: 768px) {
			.lgs-{{ block.type }} {
			   /* font-size: {{ bk_stts.size }}px; */
         font-size: clamp({{ bk_stts.size_mb }}px,calc({{ bk_stts.size }} / var(--wrapper-mw-nounit) * 100vw),{{ bk_stts.size }}px);
				font-weight: {{ bk_stts.weight }}; 
			   {%- if bk_stts.ls != 0 %}word-spacing: {{ bk_stts.ls }}px;{% endif -%}
			   {% comment %}{%- if bk_stts.lh != 0 %}line-height: {{ bk_stts.lh }}px;{% endif -%}{% endcomment %}
         {%- if bk_stts.lh != 0 %}line-height: clamp({{ bk_stts.lh_mb }}px,calc({{ bk_stts.lh }} / var(--wrapper-mw-nounit) * 100vw),{{ bk_stts.lh }}px);{% endif -%}
		     {%- if bk_stts.space != 0 %}margin-bottom: {{ bk_stts.space }}px;{% endif -%}
			}
      {% comment %}
        {% if block.type == 'button' %}
          .lgs-{{ block.type }} {
            padding: {{ bk_stts.padding-top-bottom }}px {{ bk_stts.padding-left-right }}px;
          }
        {% endif %}  
      {% endcomment %}
		}
	{%- endfor -%}
{%- endstyle -%}

