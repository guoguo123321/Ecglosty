{% render 'swiper-assets' %}
{% liquid
  assign se_stts = section.settings
  assign set_blo = section.blocks
  assign stt_layout = se_stts.layout
  if stt_layout == 'lgs-container'
    assign html_layout = '<div class="lgs-container">__</div>' | split: '__'
  elsif stt_layout == 'custom-container'
    assign html_layout = '<div class="custom-container">__</div>' | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
  assign image = set_blo | where:"type","image"
  assign text = set_blo | where:"type","text"
  assign show_pag = false
  assign show_nav = false
  if se_stts.show_pagination_pc or se_stts.show_pagination_mb
    assign show_pag = true
  endif
  if se_stts.show_navigation_pc or se_stts.show_navigation_mb
    assign show_nav = true
  endif
%}
{%- if se_stts.layout == 'custom-container' or se_stts.color_scheme != blank %}
<style>
  {%- if se_stts.layout == 'custom-container' -%}
  .{{ section.id }} .custom-container{
    max-width:{{ se_stts.custom_container }};
    margin: 0 auto;
  }
  {%- endif -%}
  {%- liquid
    assign heading_c = se_stts.color_scheme.settings.foreground_heading
    assign subheading_c = se_stts.color_scheme.settings.foreground_subheading
  -%}
  {%- if heading_c != blank and heading_c.alpha != 0.0 -%}
  .{{ section.id }} .lgs-title{--color:var(--color-foreground-heading);color:var(--color-foreground-heading);}
  {%- endif -%}
  {%- if subheading_c != blank and subheading_c.alpha != 0.0 -%}
  .{{ section.id }} .lgs-subtitle{--color:var(--color-foreground-subheading);color:var(--color-foreground-subheading);}
  {%- endif -%}
</style>
{%- endif -%}
<div class="gallery-box lgs-section-inner {{ section.id }} color-{{ se_stts.color_scheme }}{% if se_stts.scroll_mode == 'continuous' %} is-continuous{% endif %}" {% render 'section_style', se_stts: se_stts -%}>
  {{- html_layout[0] -}}
    {%- render 'section_tophead', se_stts: se_stts -%}
    <div class="gallery-content">
      <div class="swiper gallery">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% assign blo_setts = block.settings %}
              <div class="swiper-slide">
                <{% if blo_setts.use_link %}a{% else %}div{% endif %} href="{{ blo_setts.url }}" class="gallery-image">
                  <img src="{{ blo_setts.image | image_url }}" width="{{ blo_setts.image.width }}" height="{{ blo_setts.image.height }}">
                </{% if blo_setts.use_link %}a{% else %}div{% endif %}>
              </div>
            {% endfor %}
          </div>
          <div class="gallery-media common-swiper-media{% if se_stts.show_pagination_pc %} has-pag-pc{% endif %}{% if se_stts.show_navigation_pc %} has-nav-pc{% endif %}{% if se_stts.show_pagination_mb %} has-pag-mb{% endif %}{% if se_stts.show_navigation_mb %} has-nav-mb{% endif %} media-align-{{ se_stts.media_align_mb }}">
            {%- if show_pag -%}
            <div class="swiper-pagination gallery-pagination common-swiper-pagination"></div>
            {%- endif -%}
            {%- if show_nav -%}
            <div class="common-swiper-direction">
              <div class="common-prev swiper-button-prev gallery-prev custom-prev">
                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34">
                  <rect x="0.5" y="0.5" width="33" height="33" rx="16.5" fill="#000" fill-opacity="0.2" stroke="#fff"/>
                  <path fill="#fff" d="M18.369 12.364 19.164 13.221 15.455 17.221 19.164 21.221 18.369 22.078 13.865 17.221z"/>
                </svg>
              </div>
              <div class="common-next swiper-button-next gallery-next custom-next">
                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34">
                  <rect x="0.5" y="0.5" width="33" height="33" rx="16.5" fill="#000" fill-opacity="0.2" stroke="#fff"/>
                  <path fill="#fff" d="M15.631 22.078 14.836 21.221 18.545 17.221 14.836 13.221 15.631 12.364 20.135 17.221z"/>
                </svg>
              </div>
            </div>
            {%- endif -%}
          </div>
      </div>
    </div>
 {{- html_layout[1] -}}
</div>

<script>
themeSwiperReady(function () {

  (function(){
  var root = document.querySelector('.{{ section.id }}.gallery-box');
  if (!root) return;

  var scrollRight = {% if se_stts.scroll_dir == 'right' %}true{% else %}false{% endif %};
  var isContinuous = {% if se_stts.scroll_mode == 'continuous' %}true{% else %}false{% endif %};
  var autoplaySpeed = {{ se_stts.autoplay_speed }};
  var drift = scrollRight ? '60px' : '-60px';

  var options = {
    loop: true,
    centeredSlides: true,
    slidesOffsetBefore: 40,
    speed: isContinuous ? autoplaySpeed : 700,
    autoplay: {
      delay: isContinuous ? 0 : autoplaySpeed,
      disableOnInteraction: false,
      reverseDirection: scrollRight,
    },
    lazy: {
      loadPrevNext: true,
      loadPrevNextAmount: 3,
    },
    {%- if show_pag -%}
    pagination: {
      el: root.querySelector('.gallery-pagination'),
      clickable: true,
    },
    {%- endif -%}
    {%- if show_nav -%}
    navigation: {
      nextEl: root.querySelector('.gallery-next'),
      prevEl: root.querySelector('.gallery-prev'),
    },
    {%- endif -%}
    breakpoints: {
      0: {
        slidesPerView: {{ se_stts.col_mb }},
        spaceBetween: 4
      },
      768: {
        slidesPerView: {{ se_stts.col_tb }},
        spaceBetween: 4
      },
      1025: {
        slidesPerView: {{ se_stts.col_dk }},
        spaceBetween: 8
      }
    },
  };

  if (!isContinuous) {
    options.on = {
      slideChangeTransitionEnd: function () {
        this.slides.transition(this.params.autoplay.delay + this.params.speed).transform('translate3d(' + drift + ', 0, 0)');
      },
      slideChangeTransitionStart: function () {
        this.slides.transition(this.params.speed).transform('translate3d(0, 0, 0)');
      },
    };
  }

  new Swiper(root.querySelector('.gallery'), options);
  })();
}, '.{{ section.id }}');
</script>
{% schema %}
  {
    "name": "gallery",
    "class": "shopify-gallery",
    "tag":"section",
    "settings": [
      {"type": "select","id": "layout","label": "layout","default":"lgs-container",
        "options": [
          {"label":"lgs-container","value": "lgs-container"},
          {"label":"wrapped container","value": "wrapped-container"},
          {"label":"custom container","value": "custom-container"},
        ]
      },
      {"type": "text","id": "custom_container","label": "custom container","default": "1200px"},

      {"type": "select","id": "col_dk","label": "Items per row","default": "6",
        "options": [
          {"value": "1","label": "1"},
          {"value": "2","label": "2"},
          {"value": "3","label": "3"},
          {"value": "4","label": "4"},
          {"value": "5","label": "5"},
          {"value": "6","label": "6"}
        ]
      },
      {"type": "select","id": "col_tb","label": "Items per row (Tablet)","default": "4",
        "options": [
          {"value": "1","label": "1"},
          {"value": "2","label": "2"},
          {"value": "3","label": "3"},
          {"value": "4","label": "4"}
        ]
      },
      {"type": "select","id": "col_mb","label": "Items per row (Mobile)","default": "2",
        "options": [
          {"value": "1","label": "1"},
          {"value": "2","label": "2"}
        ]
      },

      {"type": "header","content": "Swiper controls"},
      {"type": "checkbox","id": "show_pagination_pc","label": "Show pagination (PC)","default": false},
      {"type": "checkbox","id": "show_navigation_pc","label": "Show navigation arrows (PC)","default": true},
      {"type": "checkbox","id": "show_pagination_mb","label": "Show pagination (Mobile)","default": false},
      {"type": "checkbox","id": "show_navigation_mb","label": "Show navigation arrows (Mobile)","default": true},
      {"type": "select","id": "media_align_mb","label": "Controls align (Mobile)","default": "between",
        "options": [
          {"value": "start","label": "Left"},
          {"value": "center","label": "Center"},
          {"value": "end","label": "Right"},
          {"value": "between","label": "Space between"}
        ]
      },

      {"type": "header","content": "Autoplay"},
      {"type": "select","id": "scroll_mode","label": "Scroll mode","default": "step",
        "options": [
          {"value": "step","label": "Step (pause between slides)"},
          {"value": "continuous","label": "Continuous (匀速)"}
        ]
      },
      {"type": "range","id": "autoplay_speed","label": "Autoplay speed","min": 1000,"max": 9000,"step": 500,"default": 5000,"unit": "ms","info": "Step: pause between slides. Continuous: transition duration (higher = slower)"},
      {"type": "select","id": "scroll_dir","label": "Scroll direction","default": "left",
        "options": [
          {"value": "left","label": "Left"},
          {"value": "right","label": "Right"}
        ]
      },

      {"type": "header","content": "Colors"},
      {"type": "color_scheme","id": "color_scheme","label": "t:settings.color_scheme","default": "scheme-1","info": "Section heading uses Headings / Sub heading when set; otherwise Config Header"},

      {"type": "header","content": "1. Heading options"},
      {"type": "select","id": "design_heading","label": "+ Design heading","default": "1",
          "options": [
              {"value": "1","label": "Design 01"},
              {"value": "2","label": "Design 02"},
              {"value": "3","label": "Design 03"},
              {"value": "4","label": "Design 04"},
              {"value": "5","label": "Design 05"},
              {"value": "6","label": "Design 06 (width line-awesome)"},
              {"value": "7","label": "Design 07"},
              {"value": "8","label": "Design 08"},
              {"value": "9","label": "Design 09"},
              {"value": "10","label": "Design 10"},
              {"value": "11","label": "Design 11"},
              {"value": "12","label": "Design 12"},
              {"value": "13","label": "Design 13"},
              {"value": "14","label": "Design 14"},
              {"value": "15","label": "Design 15"},
              {"value": "16","label": "Design 16"}
          ]
      },
      {"type": "select","id": "heading_align","label": "+ Heading align","default": "lgs-text-center",
        "options": [
            {"value": "lgs-text-start","label": "Left"},
            {"value": "lgs-text-center","label": "Center"},
            {"value": "lgs-text-end","label": "Right"}
        ]
      },
      {"type": "html","id": "top_heading","label": "+ Heading","default": "reviews heading"},
      {"type": "text","id": "icon_heading","label": "Enter a icon name on heading","info": "Only used for design 6 [LineAwesome]()","default": "las la-gem"},
      {"type": "textarea","id": "top_subheading","label": "+ Subheading"},
      {"type": "number","id": "tophead_mb","label": "+ Space bottom (px)","info": "The vertical spacing between heading and content","default": 30},


      {"type":"color","id":"cl_bg","label":"bg_color","default":"#ffffff"},
      {"type": "color_background","id": "cl_bg_gradient","label": "Background gradient"},

      {"type": "header","content": "+ Design pc options"},
      {"type": "text","id": "mg","label": "Margin","info":"Margin top, margin right, margin bottom, margin left. If you not use to blank","default": "0px,0px,0px,0px"},
      {"type": "text","id": "pd","label": "Padding","info":"Padding top, padding right, padding bottom, padding left. If you not use to blank","default": "0px,0px,0px,0px"},
    
      {"type": "header","content": "+ Design Tablet Options"},
      {"type": "text","id": "mg_tb","label": "Margin","default": "0px,0px,0px,0px"},
      {"type": "text","id": "pd_tb","label": "Padding","default": "0px,0px,0px,0px"},
    
      {"type": "header","content": "+ Design mobile options"},
      {"type": "text","id": "mg_mb","label": "Margin","default": "0px,0px,0px,0px"},
      {"type": "text","id": "pd_mb","label": "Padding","default": "0px,0px,0px,0px"},
    ],
  "blocks":[
    {
      "name":"item",
      "type":"item",
      "settings":[
        {"type": "image_picker","id": "image","label": "image"},
        {"type": "checkbox","id": "use_link","label": "use link?","default":false},
        {"type": "url","id": "url","label": "url"},
      ]
    },
  ],
    "presets":[
      {"name":"gallery","category": "t:categories.lg",}
    ]
  }
{% endschema %}
