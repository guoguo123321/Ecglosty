  cursor: pointer;
}

#jewelry-collection-{{ section.id }} .jc-metal-swatch .jc-swatch-img {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  margin: 0;
}

#jewelry-collection-{{ section.id }} .jc-swatch-label {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  padding: 2px 4px;
  letter-spacing: -.02em;
  color: #1a1a1a;
  font-size: 10px;
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: opacity .15s ease;
}

#jewelry-collection-{{ section.id }} .jc-metal-swatch:hover,
#jewelry-collection-{{ section.id }} .jc-metal-swatch.jc-card-swatch-active,
#jewelry-collection-{{ section.id }} .jc-metal-swatch:focus-visible {
  outline: 1px solid #06374C;
  outline-offset: 1px;
}

#jewelry-collection-{{ section.id }} .jc-metal-swatch.jc-card-swatch-active,
#jewelry-collection-{{ section.id }} .jc-metal-swatch:focus-visible {
  z-index: 2;
}

#jewelry-collection-{{ section.id }} .jc-metal-swatch:hover {
  z-index: 3;
}

#jewelry-collection-{{ section.id }} .jc-metal-swatch:hover .jc-swatch-label,
#jewelry-collection-{{ section.id }} .jc-metal-swatch.jc-card-swatch-active .jc-swatch-label,
#jewelry-collection-{{ section.id }} .jc-metal-swatch:focus-visible .jc-swatch-label {
  opacity: 1;
  visibility: visible;
}
/* end Metal swatch：图片中心显示 label */
</style>

<script>
(function() {
  const sid = '{{ section.id }}';
  const fnSuffix = sid.replace(/-/g, '_');
  const API_URL = {{ section.settings.api_endpoint | json }};
  const SHOP_DOMAIN = {{ section.settings.shop_domain | json }};
  const PAGE_SIZE = {{ section.settings.page_size | default: 20 }};
  let collection_handle= '{{ collection.handle }}';

  const METAL_BLOCKS = [
  {%- assign metal_blocks = section.blocks | where: 'type', 'metal' -%}
  {%- for block in metal_blocks -%}
    {%- if block.settings.swatch_image != blank -%}
      { value: {{ block.settings.api_value | json }}, label: {{ block.settings.label | json }}, image: {{ block.settings.swatch_image | image_url: width: 40 | json }} }{% unless forloop.last %},{% endunless %}
    {%- else -%}
      { value: {{ block.settings.api_value | json }}, label: {{ block.settings.label | json }}, image: '' }{% unless forloop.last %},{% endunless %}
    {%- endif -%}
  {%- endfor -%}
];

 const SHAPE_BLOCKS = [
  {%- assign shape_blocks = section.blocks | where: 'type', 'diamond_shape' -%}
  {%- for block in shape_blocks -%}
    {
      value: {{ block.settings.api_value | json }},
      label: {{ block.settings.label | json }},
      icon:
        {%- if block.settings.icon != blank -%}
          {{ block.settings.icon | image_url: width: 40 | json }}
        {%- else -%}
          ''
        {%- endif -%}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
];

  let state = {
    shapes: [], metals: [], widths: [], prongType: [], styles: [],
    minPrice: null, maxPrice: null,
    page: 0, sortBy: 'bestSellers',
    totalPages: 0, loading: false
  };

  const $id = id => document.getElementById(id);
  const grid        = $id(`jc-grid-${sid}`);
  const countEl     = $id(`jc-count-${sid}`);
  const pillsEl     = $id(`jc-pills-${sid}`);
  const emptyEl     = $id(`jc-empty-${sid}`);
  const errorEl     = $id(`jc-error-${sid}`);
  const loadMoreWrap = $id(`jc-loadmore-wrap-${sid}`);
  const loadMoreBtn  = $id(`jc-loadmore-${sid}`);
  const drawer      = $id(`jc-drawer-${sid}`);
  const overlay     = $id(`jc-overlay-${sid}`);

  // Wishlist
  const WL_KEY = 'ecglosty_wishlist';
  function getWishlist() {
    try {
      const raw = localStorage.getItem(WL_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed && Array.isArray(parsed.others)) return parsed;
      }
    } catch(e) {}
    return { diamonds: [], others: [] };
  }

  function saveWishlist(wl) {
    localStorage.setItem(WL_KEY, JSON.stringify(wl));
  }

  function getWishlistKey(p) {
    return p.productId || p.id || p.urlHandle;
  }

  function isWishlisted(p) {
    const wl = getWishlist();
    const key = getWishlistKey(p);
    return wl.others.some(item => getWishlistKey(item) === key);
  }

  function toggleWishlist(p) {
    const wl = getWishlist();
    const key = getWishlistKey(p);
    const idx = wl.others.findIndex(item => getWishlistKey(item) === key);
    if (idx >= 0) {
      wl.others.splice(idx, 1);
    } else {
      wl.others.push(p);  // 存整个产品对象，与详情页一致
    }
    saveWishlist(wl);
    return idx < 0; // true = 已加入
  }
// end Wishlist

  // Fetch
  async function fetchProducts(append = false) {
    if (state.loading) return;
    state.loading = true;

    if (!append) {
      showSkeleton();
      emptyEl.style.display = 'none';
      errorEl.style.display = 'none';
      loadMoreWrap.style.display = 'none';
    } else {
      loadMoreBtn.disabled = true;
      loadMoreBtn.textContent = 'Loading...';
    }
    if(collection_handle=="start-with-a-setting"){
      collection_handle = "";
    }
    try {
        let shopDomain = SHOP_DOMAIN?SHOP_DOMAIN:(window.Shopify?.shop || location.hostname);
        shopDomain= "https://"+shopDomain
        const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          shopDomain: shopDomain,
          metals:    state.metals,
          ringWidths:    state.widths,
          ringProngTypes: state.prongType,
          styles:    state.styles,
          shapes:    state.shapes,
          minPrice:  state.minPrice,
          maxPrice:  state.maxPrice,
          page:      state.page,
          size:      PAGE_SIZE,
          sortBy:    state.sortBy,
          collections:collection_handle
        })
      });
      if (!res.ok) throw new Error('API error'); 
      const data = await res.json();
      state.totalPages = data.totalPages || 0;
      countEl.textContent = `${data.totalElements || 0} Results`;

      if (!append) grid.innerHTML = '';

      if (!data.content || data.content.length === 0) {
        if (!append) emptyEl.style.display = 'block';
      } else {
        const fragment = document.createDocumentFragment();
        data.content.forEach(p => fragment.appendChild(buildCard(p)));
        grid.appendChild(fragment);
      }


      loadMoreWrap.style.display = state.page < state.totalPages - 1 ? 'block' : 'none';
      loadMoreBtn.disabled = false;
      loadMoreBtn.textContent = 'Load More';

    } catch (e) {
      if (!append) { grid.innerHTML = ''; errorEl.style.display = 'block'; }
    } finally {
      state.loading = false;
    }
  }

  window[`jcFetch_${fnSuffix}`]   = (reset) => { if (reset) state.page = 0; fetchProducts(false); };
  window[`jcClearAll_${fnSuffix}`] = clearAll;

  function showSkeleton() {
    grid.innerHTML = '';
    for (let i = 0; i < 10; i++) {
      const sk = document.createElement('div');
      sk.className = 'jc-skeleton';
      grid.appendChild(sk);
    }
  }

  function buildCard(p) {
    const isWished = isWishlisted(p);

    // Main image
    // 首次渲染与选项切换共用同一套 SKU 匹配逻辑
    function normalizeSpec(value) {
      return String(value ?? '').trim().toLowerCase();
    }

    function getSkuImages(metal, shape) {
      const skus = p.skuCombination?.productSkuList || [];

      const selectedValues = [metal, shape]
        .map(normalizeSpec)
        .filter(Boolean);

      function readSkuImages(sku) {
        return [...new Set(
          (Array.isArray(sku?.medias) ? sku.medias : [])
            .filter(media => media && Number(media.mediaType) === 1)
            .sort((a, b) =>
              Number(a.sortOrder ?? 0) - Number(b.sortOrder ?? 0)
            )
            .flatMap(media =>
              String(media.url || '')
                .split(',')
                .map(url => url.trim())
                .filter(Boolean)
            )
        )].slice(0, 2);
      }

      function readProductImages() {
        return [...new Set(
          String(p.pictures || '')
            .split(',')
            .map(url => url.trim())
            .filter(Boolean)
        )].slice(0, 2);
      }

      // 没有 Metal、Shape：优先取 SKU 列表中第一组可用图片
      if (!selectedValues.length) {
        for (const sku of skus) {
          const images = readSkuImages(sku);
          if (images.length) return images;
        }

        // SKU 都没有图片，才使用产品通用图片
        return readProductImages();
      }

      // 有选中属性：只匹配当前属性对应的 SKU
      const matchedSkus = skus.filter(sku => {
        const skuValues = String(sku.specSkuValue || '')
          .split('::')
          .map(normalizeSpec)
          .filter(Boolean);

        return selectedValues.every(value => skuValues.includes(value));
      });

      for (const sku of matchedSkus) {
        const images = readSkuImages(sku);
        if (images.length) return images;
      }

      // 当前组合没有可用 SKU 图片，回退到产品通用图片
      return readProductImages();
    }

    // Spec trees
    const trees      = p.skuCombination?.productSpecTrees || [];
    const metalTree  = trees.find(t => t.specName?.toLowerCase() === 'metal');
    const shapeTree  = trees.find(t => ['view with diamond shape','diamond shape','shape'].includes(t.specName?.toLowerCase()));
    const metalVals  = (metalTree?.specValues  || []).map(v => v.specValue);
    const shapeVals  = (shapeTree?.specValues  || []).map(v => v.specValue);
    // 默认选中：优先匹配筛选状态，否则取第一个
    const defaultMetal = state.metals.length > 0
      ? (metalVals.find(v => state.metals.includes(v)) || metalVals[0] || '')
      : (metalVals[0] || '');
    const defaultShape = state.shapes.length > 0
      ? (shapeVals.find(v => state.shapes.includes(v)) || shapeVals[0] || '')
      : (shapeVals[0] || '');
    // 图片必须跟随当前默认选中的 Metal + Shape
    const cardImages = getSkuImages(defaultMetal, defaultShape);
    const imgSrc = cardImages[0] || '';
    const hoverImgSrc = cardImages[1] || '';

    // Price
    const price = p.minPrice != null
      ? (p.minPrice !== p.maxPrice
          ? `$${Number(p.minPrice).toFixed(2)} – $${Number(p.maxPrice).toFixed(2)}`
          : `$${Number(p.minPrice).toFixed(2)}`)
      : '';

    const card = document.createElement('div');
    card.className = 'jc-card';
    card.innerHTML = `
            <div class="jc-card-img-wrap${hoverImgSrc ? ' jc-card-img-wrap--has-hover' : ''}">
        ${imgSrc ? `<img class="jc-card-img jc-card-img--main" src="${imgSrc}" alt="${p.name || ''}" loading="lazy">` : ''}
        ${hoverImgSrc ? `<img class="jc-card-img jc-card-img--hover" src="${hoverImgSrc}" alt="" aria-hidden="true" loading="lazy">` : ''}
        ${p.ringBadge ? `<span class="jc-personalize-badge">${p.ringBadge}</span>` : ''}
        <button class="jc-heart-btn" data-id="${p.id}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="${isWished ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </button>

      </div>
      <div class="jc-swatches">
          ${METAL_BLOCKS.filter(b => metalVals.includes(b.value))
            .map(b => b.image
              ? `<img class="jc-swatch-img jc-card-swatch${b.value === defaultMetal ? ' jc-card-swatch-active' : ''}" src="${b.image}" alt="${b.label}" title="${b.label}" data-type="metal" data-value="${b.value}">`
              : `<span class="jc-swatch-dot jc-card-swatch${b.value === defaultMetal ? ' jc-card-swatch-active' : ''}" title="${b.label}" data-type="metal" data-value="${b.value}"></span>`)
            .join('')}
      </div>
      <div class="jc-shape-icons">
        ${SHAPE_BLOCKS.filter(b => shapeVals.includes(b.value))
          .map(b => b.icon ? `<img class="jc-shape-icon jc-card-swatch${b.value === defaultShape ? ' jc-card-swatch-active' : ''}" src="${b.icon}" alt="${b.label}" title="${b.label}" data-type="shape" data-value="${b.value}">` : '')
          .join('')}
      </div>

      <div class="jc-card-name">${p.name || ''}</div>
      <div class="jc-card-selected-opts">
        ${defaultShape ? `<span class="jc-opt-tag">${defaultShape}</span>` : ''}
        ${defaultMetal ? `<span class="jc-opt-tag">${defaultMetal}</span>` : ''}
      </div>
      <div class="jc-card-price">${price}</div>

    `;

    // Swatch 点击切换选中状态
    // Metal 图片：增加居中的 label，并将点击/选中状态移到容器
    card.querySelectorAll('.jc-swatches .jc-swatch-img').forEach(img => {
      const wrapper = document.createElement('span');
      wrapper.className = 'jc-metal-swatch jc-card-swatch';

      if (img.classList.contains('jc-card-swatch-active')) {
        wrapper.classList.add('jc-card-swatch-active');
      }

      wrapper.dataset.type = img.dataset.type;
      wrapper.dataset.value = img.dataset.value;

      const labelText = img.alt || '';
      wrapper.setAttribute('aria-label', labelText);
      wrapper.setAttribute('role', 'button');
      wrapper.tabIndex = 0;

      const label = document.createElement('span');
      label.className = 'jc-swatch-label';
      label.textContent = labelText;
      label.setAttribute('aria-hidden', 'true');

      // 避免原生 title 提示与居中 label 同时出现
      img.removeAttribute('title');
      img.classList.remove('jc-card-swatch', 'jc-card-swatch-active');
      img.removeAttribute('data-type');
      img.removeAttribute('data-value');

      img.replaceWith(wrapper);
      wrapper.append(img, label);

      wrapper.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          wrapper.click();
        }
      });
    });

        // 更新卡片的默认图和悬停图，保留徽章与收藏按钮
    function updateCardImages(images) {
      const wrap = card.querySelector('.jc-card-img-wrap');
      if (!wrap) return;

      if (!images.length) {
        wrap.querySelectorAll('.jc-card-img').forEach(img => img.remove());
        wrap.classList.remove('jc-card-img-wrap--has-hover');
        return;
      }

      let mainImg = wrap.querySelector('.jc-card-img--main')
        || wrap.querySelector('.jc-card-img:not(.jc-card-img--hover)');

      if (!mainImg) {
        mainImg = document.createElement('img');
        mainImg.className = 'jc-card-img jc-card-img--main';
        mainImg.loading = 'lazy';
        wrap.prepend(mainImg);
      }

      mainImg.classList.add('jc-card-img--main');
      mainImg.src = images[0];
      mainImg.alt = p.name || '';

      let hoverImg = wrap.querySelector('.jc-card-img--hover');

      if (images[1]) {
        if (!hoverImg) {
          hoverImg = document.createElement('img');
          hoverImg.className = 'jc-card-img jc-card-img--hover';
          hoverImg.loading = 'lazy';
          hoverImg.alt = '';
          hoverImg.setAttribute('aria-hidden', 'true');
          mainImg.after(hoverImg);
        }

        hoverImg.src = images[1];
        wrap.classList.add('jc-card-img-wrap--has-hover');
      } else {
        // SKU 只有一张图片时，移除上一组悬停图
        if (hoverImg) hoverImg.remove();
        wrap.classList.remove('jc-card-img-wrap--has-hover');
      }
    }

    // Swatch 点击切换选中状态，并切换对应 SKU 图片
    card.querySelectorAll('.jc-card-swatch').forEach(el => {
      el.addEventListener('click', e => {
        e.stopPropagation();

        const type = el.dataset.type;

        card.querySelectorAll(`.jc-card-swatch[data-type="${type}"]`)
          .forEach(s => s.classList.remove('jc-card-swatch-active'));

        el.classList.add('jc-card-swatch-active');

        const selMetal = card.querySelector(
          '.jc-card-swatch[data-type="metal"].jc-card-swatch-active'
        )?.dataset.value || '';

        const selShape = card.querySelector(
          '.jc-card-swatch[data-type="shape"].jc-card-swatch-active'
        )?.dataset.value || '';

        // 更新已选属性文字
        const optsEl = card.querySelector('.jc-card-selected-opts');

        if (optsEl) {
          optsEl.replaceChildren();

          [selShape, selMetal].filter(Boolean).forEach(value => {
            const tag = document.createElement('span');
            tag.className = 'jc-opt-tag';
            tag.textContent = value;
            optsEl.appendChild(tag);
          });
        }

        // 按卡片当前实际选中的 Metal + Shape 获取 SKU 图片
        const images = getSkuImages(selMetal, selShape);
        updateCardImages(images);

      });
    });


    // 卡片跳转，携带选中参数
    card.addEventListener('click', e => {
      if (e.target.closest('.jc-heart-btn') || e.target.closest('.jc-card-swatch')) return;

      const path = window.location.pathname;
      const search = window.location.search;
      const fullPathAndQuery = path + search;
      localStorage.setItem('current_collections_ringsetting',fullPathAndQuery);

      if (p.urlHandle) {
        const selMetal = card.querySelector('.jc-card-swatch[data-type="metal"].jc-card-swatch-active')?.dataset.value || '';
        const selShape = card.querySelector('.jc-card-swatch[data-type="shape"].jc-card-swatch-active')?.dataset.value || '';
        const params = new URLSearchParams();
        if (selMetal) params.set('metal', selMetal);
        if (selShape) params.set('shape', selShape);
        const qs = params.toString();
        window.location.href = `/products/${p.urlHandle}${qs ? '?' + qs : ''}`;
      }
    });


    card.querySelector('.jc-heart-btn').addEventListener('click', e => {
      e.stopPropagation();
      const wished = toggleWishlist(p);  // 传整个 p 对象
      e.currentTarget.querySelector('svg').setAttribute('fill', wished ? 'currentColor' : 'none');
    });


    return card;
  }
    // 记录筛选项的操作顺序，仅用于 pills 展示
  let pillClickOrder = [];

  function pillOrderKey(type, value) {
    return JSON.stringify([type, String(value)]);
  }

  function trackPillOrder(type, value, selected) {
    const key = pillOrderKey(type, value);
    const index = pillClickOrder.indexOf(key);

    if (!selected) {
      if (index !== -1) pillClickOrder.splice(index, 1);
    } else if (index === -1) {
      pillClickOrder.push(key);
    }
  }

  const pillTypeMap = {
    shape: 'shape',
    shapes: 'shape',
    metal: 'metal',
    metals: 'metal',
    widths: 'width',
    prongType: 'prongType',
    styles: 'styles'
  };

  const pillSectionRoot = $id(`jewelry-collection-${sid}`);
  const pillEventRoots = [pillSectionRoot];

  // 抽屉若位于 section 外部，也监听它
  if (drawer && !pillSectionRoot.contains(drawer)) {
    pillEventRoots.push(drawer);
  }

  pillEventRoots.forEach(root => {
    // 捕获阶段先记录，之后原有点击逻辑再更新 state 和 pills
    root.addEventListener('click', event => {
      const button = event.target.closest(
        '.jc-shape-btn, .jc-metal-btn, .jc-drawer-icon-btn'
      );
      if (!button || !root.contains(button)) return;

      const type = pillTypeMap[button.dataset.filter];
      if (!type) return;

      trackPillOrder(
        type,
        button.dataset.value,
        !button.classList.contains('active')
      );
    }, true);

    root.addEventListener('change', event => {
      const checkbox = event.target;
      if (!checkbox.matches('.jc-drawer-check')) return;

      const type = pillTypeMap[checkbox.dataset.filter];
      if (!type) return;

      trackPillOrder(type, checkbox.value, checkbox.checked);
    }, true);

    // 价格作为一个 pill，首次调整时记录位置
    const trackPriceOrder = event => {
      if (!event.target.matches(
        '[id^="jc-range-min-"], [id^="jc-range-max-"], ' +
        '[id^="jc-price-min-display-"], [id^="jc-price-max-display-"]'
      )) return;

      trackPillOrder('price', 'price', true);
    };

    root.addEventListener('input', trackPriceOrder, true);
    root.addEventListener('change', trackPriceOrder, true);
  });


  // Filter buttons
  document.querySelectorAll(`#jewelry-collection-${sid} .jc-shape-btn, #jewelry-collection-${sid} .jc-metal-btn`)
    .forEach(btn => btn.addEventListener('click', () => {
      btn.classList.toggle('active');
      state.shapes = getActiveVals('shape');
      state.metals = getActiveVals('metal');
      updateSelectedLabels();
      updatePills();
      resetAndFetch();
    }));
  
  function getActiveVals(filter) {
    return [...document.querySelectorAll(`#jewelry-collection-${sid} [data-filter="${filter}"].active`)]
      .map(el => el.dataset.value);
  }

  // Sort
  $id(`jc-sort-${sid}`).addEventListener('change', e => {
    state.sortBy = e.target.value;
    resetAndFetch();
  });

    // Drawer open/close
  $id(`jc-drawer-btn-${sid}`).addEventListener('click', () => {
    syncDrawerFromState();
    drawer.classList.add('open');
    overlay.classList.add('open');
  });
  const closeDrawer = () => {
    drawer.classList.remove('open');
    overlay.classList.remove('open');
  };
  $id(`jc-drawer-close-${sid}`).addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);

  // 抽屉内图标按钮点击（Setting Style / Diamond Shape / Metal）
  document.querySelectorAll(`#jc-drawer-${sid} .jc-drawer-icon-btn`).forEach(btn => {
    btn.addEventListener('click', () => {
      btn.classList.toggle('active');
      const filter = btn.dataset.filter;
      const val = btn.dataset.value;

      if (filter === 'shapes') {
        // 同步外部 shape 按钮
        state.shapes = getDrawerActiveVals('shapes');
        syncOuterButtons('shape', state.shapes);
        updateSelectedLabels();
      } else if (filter === 'metals') {
        // 同步外部 metal 按钮
        state.metals = getDrawerActiveVals('metals');
        syncOuterButtons('metal', state.metals);
        updateSelectedLabels();
      } else if (filter === 'styles') {
        state.styles = getDrawerActiveVals('styles');
      }
      updateDrawerPills();
    });
  });

  // 抽屉内复选框
  document.querySelectorAll(`#jc-drawer-${sid} .jc-drawer-check`).forEach(c => {
    c.addEventListener('change', () => updateDrawerPills());
  });

  // Apply（VIEW RESULTS）
  $id(`jc-apply-${sid}`).addEventListener('click', () => {
    state.widths = getDrawerCheckedVals('widths');
    state.prongType = getDrawerCheckedVals('prongType');
    // shapes/metals 已实时同步
    updatePills();
    closeDrawer();
    resetAndFetch();
  });

  // 价格滑块
  const rangeMin = $id(`jc-range-min-${sid}`);
  const rangeMax = $id(`jc-range-max-${sid}`);
  const priceMinDisplay = $id(`jc-price-min-display-${sid}`);
  const priceMaxDisplay = $id(`jc-price-max-display-${sid}`);

  function updateRangeTrack() {
    const min = parseInt(rangeMin.value);
    const max = parseInt(rangeMax.value);
    const total = parseInt(rangeMin.max);
    const fill = $id(`jc-range-fill-${sid}`);
    if (fill) {
      fill.style.left  = (min / total * 100) + '%';
      fill.style.width = ((max - min) / total * 100) + '%';
    }
    priceMinDisplay.value = `$${min.toLocaleString()}`;
    priceMaxDisplay.value = `$${max.toLocaleString()}`;

    state.minPrice = min > 0 ? min : null;
    state.maxPrice = max < parseInt(rangeMin.max) ? max : null;
  }

  priceMinDisplay.addEventListener('change', () => {
    const val = parseInt(priceMinDisplay.value.replace(/[^0-9]/g, '')) || 0;
    rangeMin.value = Math.min(val, parseInt(rangeMax.value));
    updateRangeTrack();
  });
  priceMaxDisplay.addEventListener('change', () => {
    const val = parseInt(priceMaxDisplay.value.replace(/[^0-9]/g, '')) || parseInt(rangeMax.max);
    rangeMax.value = Math.max(val, parseInt(rangeMin.value));
    updateRangeTrack();
  });

  rangeMin.addEventListener('input', () => {
    if (parseInt(rangeMin.value) > parseInt(rangeMax.value)) rangeMin.value = rangeMax.value;
    updateRangeTrack();
  });
  rangeMax.addEventListener('input', () => {
    if (parseInt(rangeMax.value) < parseInt(rangeMin.value)) rangeMax.value = rangeMin.value;
    updateRangeTrack();
  });

  // 在 price slider wrap 后插入 track/fill DOM
  const sliderWrap = document.querySelector(`#jc-drawer-${sid} .jc-price-slider-wrap`);
  if (sliderWrap) {
    const track = document.createElement('div'); track.className = 'jc-range-track';
    const fill  = document.createElement('div'); fill.className  = 'jc-range-fill'; fill.id = `jc-range-fill-${sid}`;
    sliderWrap.insertBefore(track, sliderWrap.firstChild);
    sliderWrap.insertBefore(fill,  sliderWrap.firstChild);
    updateRangeTrack();
  }

    // 抽屉 pills：按照点击顺序展示
  function updateDrawerPills() {
    const bar = $id(`jc-drawer-pills-${sid}`);
    if (!bar) return;

    bar.innerHTML = '';

    const allActive = [...document.querySelectorAll(
      `#jc-drawer-${sid} .jc-drawer-icon-btn.active, ` +
      `#jc-drawer-${sid} .jc-drawer-check:checked`
    )];

    const drawerPills = new Map();

    allActive.forEach(el => {
      const type = pillTypeMap[el.dataset.filter];
      if (!type) return;

      const value = el.classList.contains('jc-drawer-check')
        ? el.value
        : el.dataset.value;

      const key = pillOrderKey(type, value);

      // Metal 显示 api_value，其他选项保持原有文字
      const label = type === 'metal'
        ? value
        : (
            el.dataset.label ||
            el.closest('label')?.textContent.trim() ||
            value
          );

      drawerPills.set(key, { el, type, value, label });

      // 初始选中等非点击来源的选项，追加到末尾
      trackPillOrder(type, value, true);
    });

    pillClickOrder.forEach(key => {
      const item = drawerPills.get(key);
      if (!item) return;

      const { el, type, value, label } = item;

      const pill = document.createElement('span');
      pill.className = 'jc-pill';
      pill.appendChild(document.createTextNode(`${label} `));

      const remove = document.createElement('span');
      remove.className = 'jc-pill-remove';
      remove.textContent = '×';

      remove.addEventListener('click', () => {
        trackPillOrder(type, value, false);

        el.classList.remove('active');
        if (el.type === 'checkbox') {
          el.checked = false;
        }

        updateDrawerPills();
      });

      pill.appendChild(remove);
      bar.appendChild(pill);
    });
  }


  // 从抽屉获取选中值
  function getDrawerActiveVals(filter) {
    return [...document.querySelectorAll(`#jc-drawer-${sid} .jc-drawer-icon-btn[data-filter="${filter}"].active`)]
      .map(el => el.dataset.value);
  }
  function getDrawerCheckedVals(filter) {
    return [...document.querySelectorAll(`#jc-drawer-${sid} .jc-drawer-check[data-filter="${filter}"]:checked`)]
      .map(el => el.value);
  }

  // 同步外部筛选按钮状态
  function syncOuterButtons(filter, activeVals) {
    document.querySelectorAll(`#jewelry-collection-${sid} [data-filter="${filter}"]`).forEach(btn => {
      btn.classList.toggle('active', activeVals.includes(btn.dataset.value));
    });
  }

  // 打开抽屉时同步 state → 抽屉按钮状态
  function syncDrawerFromState() {
    // Shape
    document.querySelectorAll(`#jc-drawer-${sid} .jc-drawer-icon-btn[data-filter="shapes"]`).forEach(btn => {
      btn.classList.toggle('active', state.shapes.includes(btn.dataset.value));
    });
    // Metal
    document.querySelectorAll(`#jc-drawer-${sid} .jc-drawer-icon-btn[data-filter="metals"]`).forEach(btn => {
      btn.classList.toggle('active', state.metals.includes(btn.dataset.value));
    });
    // Styles
    document.querySelectorAll(`#jc-drawer-${sid} .jc-drawer-icon-btn[data-filter="styles"]`).forEach(btn => {
      btn.classList.toggle('active', state.styles.includes(btn.dataset.value));
    });
    // Widths
    document.querySelectorAll(`#jc-drawer-${sid} .jc-drawer-check[data-filter="widths"]`).forEach(c => {
      if(state.widths.length>0){
         c.checked = state.widths.includes(c.value);
      }
     
    });
    // ProngType
    document.querySelectorAll(`#jc-drawer-${sid} .jc-drawer-check[data-filter="prongType"]`).forEach(c => {
      if(state.prongType.length>0){
         c.checked = state.prongType.includes(c.value);
      }
      
    });
    updateDrawerPills();
  }

  // 折叠/展开 group
  window.jcToggleGroup = function(header) {
    const body = header.nextElementSibling;
    const arrow = header.querySelector('.jc-group-arrow');
    const isOpen = body.style.display !== 'none';
    body.style.display = isOpen ? 'none' : 'block';
    arrow.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    header.classList.toggle('jc-group-collapsed', isOpen);
  };


  // Clear all
  function clearAll() {
    state.shapes = []; state.metals = []; state.widths = [];
    state.prongType = []; state.styles = [];
    state.minPrice = null; state.maxPrice = null;
    // 外部按钮
    document.querySelectorAll(`#jewelry-collection-${sid} .active`).forEach(el => el.classList.remove('active'));
    // 抽屉按钮
    document.querySelectorAll(`#jc-drawer-${sid} .jc-drawer-icon-btn`).forEach(el => el.classList.remove('active'));
    document.querySelectorAll(`#jc-drawer-${sid} .jc-drawer-check`).forEach(c => c.checked = false);
    // 价格重置
    if (rangeMin) { rangeMin.value = rangeMin.min; updateRangeTrack(); }
    if (rangeMax) { rangeMax.value = rangeMax.max; updateRangeTrack(); }
    updateSelectedLabels();
    updateDrawerPills();
    updatePills();
    resetAndFetch();
  }


  // Pills
    function updatePills() {
      pillsEl.innerHTML = '';

      const all = [
        ...state.shapes.map(v => ({
          label: SHAPE_BLOCKS.find(b => b.value === v)?.label || v,
          type: 'shape',
          value: v
        })),
        ...state.metals.map(v => ({
          label: v,
          type: 'metal',
          value: v
        })),
        ...state.widths.map(v => ({
          label: v,
          type: 'width',
          value: v
        })),
        ...state.prongType.map(v => ({
          label: v,
          type: 'prongType',
          value: v
        })),
        ...state.styles.map(v => ({
          label: v,
          type: 'styles',
          value: v
        })),
        ...(state.minPrice || state.maxPrice ? [{
          label: `$${state.minPrice || 0}–$${state.maxPrice || '∞'}`,
          type: 'price',
          value: 'price'
        }] : [])
      ];

      const activePills = new Map(
        all.map(item => [
          pillOrderKey(item.type, item.value),
          item
        ])
      );

      // 移除已取消的选项，保留其余选项的点击顺序
      pillClickOrder = pillClickOrder.filter(key => activePills.has(key));

      // URL 初始化等非点击来源的筛选项，追加到末尾
      activePills.forEach((item, key) => {
        if (!pillClickOrder.includes(key)) {
          pillClickOrder.push(key);
        }
      });

      pillClickOrder.forEach(key => {
        const f = activePills.get(key);
        const pill = document.createElement('span');
        pill.className = 'jc-pill';
        pill.appendChild(document.createTextNode(`${f.label} `));

        const remove = document.createElement('span');
        remove.className = 'jc-pill-remove';
        remove.dataset.type = f.type;
        remove.dataset.value = f.value;
        remove.textContent = '×';
        remove.addEventListener('click', () => {
          trackPillOrder(f.type, f.value, false);
          removePill(f.type, f.value);
        });

        pill.appendChild(remove);
        pillsEl.appendChild(pill);
      });
    }


  function removePill(type, value) {
    const uncheck = (filter, val) => {
      const el = document.querySelector(`#jc-drawer-${sid} [data-filter="${filter}"][value="${val}"]`);
      if (el) el.checked = false;
    };
    if (type === 'shape')     { state.shapes    = state.shapes.filter(v=>v!==value);    document.querySelector(`#jewelry-collection-${sid} [data-filter="shape"][data-value="${value}"]`)?.classList.remove('active'); }
    if (type === 'metal')     { state.metals    = state.metals.filter(v=>v!==value);    document.querySelector(`#jewelry-collection-${sid} [data-filter="metal"][data-value="${value}"]`)?.classList.remove('active'); }
    if (type === 'width')     { state.widths    = state.widths.filter(v=>v!==value);    uncheck('width',     value); }
    if (type === 'prongType') { state.prongType = state.prongType.filter(v=>v!==value); uncheck('prongType', value); }
    if (type === 'styles')    { state.styles    = state.styles.filter(v=>v!==value);    uncheck('styles',    value); }
    if (type === 'price')     { state.minPrice = null; state.maxPrice = null; $id(`jc-min-price-${sid}`).value=''; $id(`jc-max-price-${sid}`).value=''; }
    updateSelectedLabels();
    updatePills();
    resetAndFetch();
  }

  // Load More
  loadMoreBtn.addEventListener('click', () => { state.page++; fetchProducts(true); });

  function resetAndFetch() { state.page = 0; fetchProducts(false); }
  // 在 filter toggle 按钮的 click 事件里，更新标题旁的选中值显示
function updateSelectedLabels() {
  const shapeSelected = state.shapes.length === 0
    ? 'All'
    : SHAPE_BLOCKS.filter(b => state.shapes.includes(b.value)).map(b => b.label).join(', ');
  const metalSelected = state.metals.length === 0
    ? 'All'
    : METAL_BLOCKS.filter(b => state.metals.includes(b.value)).map(b => b.value).join(', ');

  const shapeEl = document.getElementById(`jc-shape-selected-${sid}`);
  const metalEl = document.getElementById(`jc-metal-selected-${sid}`);
  if (shapeEl) shapeEl.textContent = shapeSelected;
  if (metalEl) metalEl.textContent = metalSelected;
}
  //params筛选
  // ── URL 参数初始化筛选 ──────────────────────────────────────
  function initFromURL() {
    const params = new URLSearchParams(window.location.search);

    // shape（单值）
    const shape = params.get('shape');
    if (shape) state.shapes = [shape];

    // metal（单值）
    const metal = params.get('metal');
    if (metal) state.metals = [metal];

    // widths（逗号分隔多值）
    const widths = params.get('widths');
    if (widths) state.widths = widths.split(',').map(v => v.trim()).filter(Boolean);

    // prongType（逗号分隔多值）
    const prongType = params.get('prongType');
    if (prongType) state.prongType = prongType.split(',').map(v => v.trim()).filter(Boolean);

    // styles（逗号分隔多值）
    const styles = params.get('styles');
    if (styles) state.styles = styles.split(',').map(v => v.trim()).filter(Boolean);

    // 价格区间
    const minPrice = params.get('minPrice');
    const maxPrice = params.get('maxPrice');
    if (minPrice) state.minPrice = parseInt(minPrice) || null;
    if (maxPrice) state.maxPrice = parseInt(maxPrice) || null;

    // 排序
    const sort = params.get('sort');
    const validSorts = ['bestSellers', 'priceAsc', 'priceDesc', 'newest'];
    if (sort && validSorts.includes(sort)) state.sortBy = sort;

    // 同步 UI 状态
    // 外部 shape 按钮
    document.querySelectorAll(`#jewelry-collection-${sid} [data-filter="shape"]`).forEach(btn => {
      btn.classList.toggle('active', state.shapes.includes(btn.dataset.value));
    });
    // 外部 metal 按钮
    document.querySelectorAll(`#jewelry-collection-${sid} [data-filter="metal"]`).forEach(btn => {
      btn.classList.toggle('active', state.metals.includes(btn.dataset.value));
    });
    // 排序下拉
    const sortEl = $id(`jc-sort-${sid}`);
    if (sortEl) sortEl.value = state.sortBy;
    // 价格 slider
    if (minPrice && rangeMin) {
      rangeMin.value = state.minPrice;
      updateRangeTrack();
    }
    if (maxPrice && rangeMax) {
      rangeMax.value = state.maxPrice;
      updateRangeTrack();
    }

    updateSelectedLabels();
    updatePills();
  }

  initFromURL();
  // ── END URL 参数初始化 ──────────────────────────────────────

  //end params筛选
  // Init
  fetchProducts(false);
})();
</script>

