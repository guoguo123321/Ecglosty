
<div class="jc-section lgs-container" id="jewelry-collection-{{ section.id }}">
  <!-- Mobile bottom Filters button -->
  <div class="jc-mobile-filters-bar">
    <button
      type="button"
      class="jc-mobile-filters-btn"
      onclick="document.getElementById('jc-drawer-btn-{{ section.id }}')?.click()"
      aria-controls="jc-drawer-{{ section.id }}"
      aria-label="Open filters"
    >
      <span>Filters</span>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        aria-hidden="true"
      >
        <path d="M3 7h10m4 0h4M3 17h4m4 0h10"/>
        <circle cx="15" cy="7" r="2"/>
        <circle cx="9" cy="17" r="2"/>
      </svg>
    </button>
  </div>

  <!-- Filter Bar -->
<div class="jc-filter-bar">
  <div class="jc-filter-main-row">

    <!-- Diamond Shape -->
    <div class="jc-filter-col">
      <div class="jc-filter-col-header">
        <span class="jc-filter-label">Diamond Shape</span>
        <span class="jc-filter-selected-label" id="jc-shape-selected-{{ section.id }}">All</span>
      </div>
      <div class="jc-filter-options" id="jc-shapes-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'diamond_shape' -%}
            <div class="jc-shape-inner">
              <button class="jc-shape-btn"
              data-value="{{ block.settings.api_value }}"
              data-label="{{ block.settings.label }}"
              data-filter="shape"
              title="{{ block.settings.label }}">
              {%- if block.settings.icon != blank -%}
                <img src="{{ block.settings.icon | image_url: width: 200 }}" alt="{{ block.settings.label }}">
              {%- endif -%}
            </button>
            </div>
            
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Metal -->
    <div class="jc-filter-col jc-filter-col-metal">
      <div class="jc-filter-col-header">
        <span class="jc-filter-label">Metal</span>
        <span class="jc-filter-selected-label" id="jc-metal-selected-{{ section.id }}">All</span>
      </div>
      <div class="jc-filter-options jc-filter-options-metal" id="jc-metals-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'metal' -%}
            <button class="jc-metal-btn"
              data-value="{{ block.settings.api_value }}"
              data-label="{{ block.settings.label }}"
              data-filter="metal"
              title="{{ block.settings.api_value }}">
              {%- if block.settings.swatch_image != blank -%}
                <img src="{{ block.settings.swatch_image | image_url: width: 200 }}" alt="{{ block.settings.label }}" class="jc-metal-swatch-img">
              {%- endif -%}
              <span class="jc-metal-label-text">{{ block.settings.label }}</span>
            </button>

          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Right Controls -->
    <div class="jc-filter-controls">
        <button class="jc-filters-btn" id="jc-drawer-btn-{{ section.id }}">
          Filters
          <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="14px" height="14px" viewBox="0 0 14 14" version="1.1">
                <g id="页面-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                    <g id="1.-选戒托-戒托列表页" transform="translate(-1406.000000, -744.000000)" fill="#FFFFFF" fill-rule="nonzero">
                        <g id="编组-14" transform="translate(1324.000000, 732.000000)">
                            <g id="编组-4" transform="translate(32.000000, 12.000000)">
                                <g id="编组" transform="translate(50.000000, 0.000000)">
                                    <path d="M7.77777778,11.6666667 C7.77777778,12.9553311 8.8224467,14 10.1111111,14 C11.3997755,14 12.4444445,12.9553311 12.4444445,11.6666667 C12.4444445,10.3780023 11.3997755,9.33333333 10.1111111,9.33333333 C8.8224467,9.33333333 7.77777778,10.3780023 7.77777778,11.6666667 Z M11.2777778,11.6666667 C11.2777778,12.3109989 10.7554433,12.8333333 10.1111111,12.8333333 C9.46677891,12.8333333 8.94444445,12.3109989 8.94444445,11.6666667 C8.94444445,11.0223345 9.46677891,10.5 10.1111111,10.5 C10.7554433,10.5 11.2777778,11.0223345 11.2777778,11.6666667 Z M7.77777778,2.33333333 C7.77777778,3.62199775 8.8224467,4.66666667 10.1111111,4.66666667 C11.3997755,4.66666667 12.4444445,3.62199775 12.4444445,2.33333333 C12.4444445,1.04466892 11.3997755,0 10.1111111,0 C8.8224467,0 7.77777778,1.04466892 7.77777778,2.33333333 Z M11.2777778,2.33333333 C11.2777778,2.97766554 10.7554433,3.5 10.1111111,3.5 C9.46677891,3.5 8.94444445,2.97766554 8.94444445,2.33333333 C8.94444445,1.68900113 9.46677891,1.16666667 10.1111111,1.16666667 C10.7554433,1.16666667 11.2777778,1.68900113 11.2777778,2.33333333 Z" id="形状"></path>
                                    <path d="M7.97222222,12.25 L0,12.25 L0,11.6666667 L0,11.0833333 L7.97222222,11.0833333 C8.36111111,11.0833333 8.55555555,11.2777778 8.55555555,11.6666667 C8.55555555,12.0555556 8.36111111,12.25 7.97222222,12.25 Z" id="路径"></path>
                                    <path d="M1.75,7.58333333 L0,7.58333333 L0,7 L0,6.41666667 L1.75,6.41666667 C2.13888889,6.41666667 2.33333333,6.61111111 2.33333333,7 C2.33333333,7.38888889 2.13888889,7.58333333 1.75,7.58333333 Z" id="路径"></path>
                                    <polygon id="路径" points="14 7.58333333 7 7.58333333 7 7 7 6.41666667 14 6.41666667 14 7"></polygon>
                                    <path d="M14,12.25 L12.25,12.25 C11.8611111,12.25 11.6666667,12.0555556 11.6666667,11.6666667 C11.6666667,11.2777778 11.8611111,11.0833333 12.25,11.0833333 L14,11.0833333 L14,11.6666667 L14,12.25 Z" id="路径"></path>
                                    <path d="M7.97222222,2.91666667 L0,2.91666667 L0,2.33333333 L0,1.75 L7.97222222,1.75 C8.36111111,1.75 8.55555555,1.94444444 8.55555555,2.33333333 C8.55555555,2.72222222 8.36111111,2.91666667 7.97222222,2.91666667 Z" id="路径"></path>
                                    <path d="M14,2.91666667 L12.25,2.91666667 C11.8611111,2.91666667 11.6666667,2.72222222 11.6666667,2.33333333 C11.6666667,1.94444444 11.8611111,1.75 12.25,1.75 L14,1.75 L14,2.33333333 L14,2.91666667 Z" id="路径"></path>
                                    <path d="M3.88888888,9.33333333 C5.1775533,9.33333333 6.22222222,8.28866442 6.22222222,7 C6.22222222,5.71133558 5.1775533,4.66666667 3.88888888,4.66666667 C2.60022447,4.66666667 1.55555555,5.71133558 1.55555555,7 C1.55555555,8.28866442 2.60022447,9.33333333 3.88888888,9.33333333 Z M3.88888888,8.16666667 C3.24455667,8.16666667 2.72222222,7.64433221 2.72222222,7 C2.72222222,6.35566779 3.24455667,5.83333333 3.88888888,5.83333333 C4.53322109,5.83333333 5.05555555,6.35566779 5.05555555,7 C5.05555555,7.64433221 4.53322109,8.16666667 3.88888888,8.16666667 Z" id="形状"></path>
                                </g>
                            </g>
                        </g>
                    </g>
                </g>
            </svg>
        </button>
      <button
        type="button"
        class="jc-clear-all-btn"
        id="jc-clear-all-{{ section.id }}"
        onclick="jcClearAll_{{ section.id | replace: '-', '_' }}()"
      >
        Clear All
      </button>

      <select class="jc-sort-select" id="jc-sort-{{ section.id }}">
        <option value="bestSellers">Sort By: Best Sellers</option>
        <option value="priceAsc">Price: Low to High</option>
        <option value="priceDesc">Price: High to Low</option>
        <option value="newest">Newest</option>
      </select>
    </div>

  </div>

  <!-- Row 2: Results + Active Pills -->
  <div class="jc-filter-row2">
    <div class="jc-filter-left">
      <span class="jc-result-count" id="jc-count-{{ section.id }}">0 Results</span>
      <div class="jc-active-pills" id="jc-pills-{{ section.id }}"></div>
    </div>
  </div>
</div>


  <!-- Drawer Overlay -->
  <div class="jc-drawer-overlay" id="jc-overlay-{{ section.id }}"></div>

  <!-- Filters Drawer -->
<div class="jc-drawer-overlay" id="jc-overlay-{{ section.id }}"></div>
<div class="jc-drawer" id="jc-drawer-{{ section.id }}">

  <!-- 抽屉顶部 -->
  <div class="jc-drawer-header">
    <span>Filters</span>
    <button class="jc-drawer-close" id="jc-drawer-close-{{ section.id }}">✕</button>
  </div>

  <!-- 已选 pills + 结果数 -->
  <div class="jc-drawer-pills-bar" id="jc-drawer-pills-{{ section.id }}"></div>

  <!-- 抽屉内容（可滚动） -->
  <div class="jc-drawer-body">

    <!-- Setting Style -->
    {%- assign style_blocks = section.blocks | where: 'type', 'setting_style' -%}
    {%- if style_blocks.size > 0 -%}
    <div class="jc-drawer-group" data-group="styles">
      <div class="jc-drawer-group-header" onclick="jcToggleGroup(this)">
        <span>Setting Style</span><span class="jc-group-arrow"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242">
        <path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path>
      </svg></span>
      </div>
      <div class="jc-drawer-group-body">
        <div class="jc-icon-grid">
          {%- for block in style_blocks -%}
            <button
              type="button"
              class="jc-drawer-icon-btn jc-drawer-style-btn"
              data-filter="styles"
              data-value="{{ block.settings.api_value | escape }}"
              data-label="{{ block.settings.label | escape }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon != blank -%}
                <img
                  src="{{ block.settings.icon | image_url: width: 96 }}"
                  alt="{{ block.settings.label | escape }}"
                  width="48"
                  height="48"
                  loading="lazy"
                >
              {%- endif -%}
              <span>{{ block.settings.label | escape }}</span>
            </button>
          {%- endfor -%}

        </div>
        <!-- Bridal Sets Only -->
        {% comment %} <label class="jc-checkbox-label" style="margin-top:10px">
          <input type="checkbox" class="jc-drawer-check" data-filter="bridalOnly" value="true">
          Bridal Sets Only
        </label> {% endcomment %}
      </div>
    </div>
    {%- endif -%}

    <!-- Diamond Shape（与外部联动） -->
    <div class="jc-drawer-group" data-group="shapes">
      <div class="jc-drawer-group-header" onclick="jcToggleGroup(this)">
        <span>Diamond Shape</span><span class="jc-group-arrow"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242">
        <path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path>
      </svg></span>
      </div>
      <div class="jc-drawer-group-body">
        <div class="jc-icon-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'diamond_shape' -%}
              <button class="jc-drawer-icon-btn jc-drawer-shape-btn" data-filter="shapes" data-value="{{ block.settings.api_value }}" data-label="{{ block.settings.label }}">
                {%- if block.settings.icon != blank -%}
                  <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="{{ block.settings.label }}">
                {%- endif -%}
                <span>{{ block.settings.label }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    <!-- Metal（与外部联动） -->
    <div class="jc-drawer-group" data-group="metals">
      <div class="jc-drawer-group-header" onclick="jcToggleGroup(this)">
        <span>Metal</span><span class="jc-group-arrow"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242">
        <path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path>
      </svg></span>
      </div>
      <div class="jc-drawer-group-body">
        <div class="jc-icon-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'metal' -%}
              <button class="jc-drawer-icon-btn jc-drawer-metal-btn" data-filter="metals" data-value="{{ block.settings.api_value }}" data-label="{{ block.settings.label }}">
                  {%- if block.settings.swatch_image != blank -%}
                    <img src="{{ block.settings.swatch_image | image_url: width: 80 }}" alt="{{ block.settings.label }}" class="jc-metal-swatch-img">
                  {%- endif -%}
                  <span>{{ block.settings.label }}</span>
                </button>

            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    <!-- Width -->
    {%- assign width_blocks = section.blocks | where: 'type', 'width' -%}
    {%- if width_blocks.size > 0 -%}
    <div class="jc-drawer-group" data-group="widths">
      <div class="jc-drawer-group-header jc-group-collapsed" onclick="jcToggleGroup(this)">
        <span>Width</span><span class="jc-group-arrow"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242">
        <path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path>
      </svg></span>
      </div>
      <div class="jc-drawer-group-body" style="display:none">
        {%- for block in width_blocks -%}
          <label class="jc-checkbox-label">
            <input type="checkbox" class="jc-drawer-check" data-filter="widths" value="{{ block.settings.api_value }}">
            {{ block.settings.label }}
          </label>
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}

    <!-- Prong Type -->
    {%- assign prong_blocks = section.blocks | where: 'type', 'prong_type' -%}
    {%- if prong_blocks.size > 0 -%}
    <div class="jc-drawer-group" data-group="prongType">
      <div class="jc-drawer-group-header jc-group-collapsed" onclick="jcToggleGroup(this)">
        <span>Prong Type</span><span class="jc-group-arrow"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242">
        <path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path>
      </svg></span>
      </div>
      <div class="jc-drawer-group-body" style="display:none">
        {%- for block in prong_blocks -%}
          <label class="jc-checkbox-label">
            <input type="checkbox" class="jc-drawer-check" data-filter="prongType" value="{{ block.settings.api_value }}">
            {{ block.settings.label }}
          </label>
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}

    <!-- Setting Price -->
    <div class="jc-drawer-group" data-group="price">
      <div class="jc-drawer-group-header" onclick="jcToggleGroup(this)">
        <span>Setting Price</span><span class="jc-group-arrow"><svg class="icon" style="width: 1em;height: 1em;vertical-align: middle;fill: currentColor;overflow: hidden;" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="7242">
        <path d="M948.560332 281.179984c-13.765515-13.833053-36.127825-13.833053-49.89334 0L511.991302 668.591431 125.313565 281.179984c-13.763468-13.798261-36.093033-13.798261-49.856501 0-13.799284 13.798261-13.799284 36.161594 0 49.993624l410.857439 411.674037c7.067976 7.085372 16.402575 10.521634 25.675776 10.331299 9.274224 0.191358 18.608823-3.245927 25.677822-10.331299l410.891208-411.708829c6.863315-6.89913 10.331299-15.940041 10.331299-24.979928S955.423647 288.078091 948.560332 281.179984z" fill="#262B2C" p-id="7243"></path>
      </svg></span>
      </div>
      <div class=jc-drawer-group-body>
          <div class=jc-price-slider-wrap>
            <input type=range class=jc-range id="jc-range-min-{{ section.id }}" min=0 max=10000 step=50 value=0>
            <input type=range class=jc-range id="jc-range-max-{{ section.id }}" min=0 max=10000 step=50 value=10000>
          </div>
          <div class=jc-price-display>
            <input type=text class=jc-price-input id="jc-price-min-display-{{ section.id }}" value="$0">
            <input type=text class=jc-price-input id="jc-price-max-display-{{ section.id }}" value="$10,000">
          </div>
        </div>

    </div>

  </div><!-- end drawer-body -->

  <!-- 底部固定按钮 -->
  {% comment %} <div class="jc-drawer-footer">
    <button class="jc-view-results-btn" id="jc-apply-{{ section.id }}">VIEW RESULTS</button>
  </div> {% endcomment %}
  <div class="jc-drawer-footer">
    <button
      type="button"
      class="jc-drawer-clear-all-btn"
      onclick="jcClearAll_{{ section.id | replace: '-', '_' }}()"
    >
      Clear All
    </button>

    <button
      type="button"
      class="jc-view-results-btn"
      id="jc-apply-{{ section.id }}"
    >
      VIEW RESULTS
    </button>
  </div>


</div>


  <!-- Product Grid -->
  <div class="jc-grid" id="jc-grid-{{ section.id }}">
    {%- for i in (1..10) -%}
      <div class="jc-skeleton"></div>
    {%- endfor -%}
  </div>

  <!-- Empty State -->
  <div class="jc-empty" id="jc-empty-{{ section.id }}" style="display:none">
    <p>No results found</p>
    <button class="jc-clear-btn-sm" onclick="jcClearAll_{{ section.id | replace: '-', '_' }}()">Clear Filters</button>
  </div>

  <!-- Error State -->
  <div class="jc-error" id="jc-error-{{ section.id }}" style="display:none">
    <p>Failed to load products.</p>
    <button onclick="jcFetch_{{ section.id | replace: '-', '_' }}(true)">Retry</button>
  </div>

  <!-- Load More -->
  <div class="jc-load-more-wrap" id="jc-loadmore-wrap-{{ section.id }}" style="display:none">
    <button class="jc-load-more-btn" id="jc-loadmore-{{ section.id }}">Load More</button>
  </div>

</div>
{% liquid
  assign card_name_font = section.settings.card_name_font
  assign card_name_weight = section.settings.card_name_weight
