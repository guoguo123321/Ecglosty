.jc-range::-moz-range-thumb{width:16px;height:16px;border-radius:50%;background:#073746;cursor:pointer;pointer-events:all;border:none;box-shadow:none}
.jc-range-track{position:absolute;top:8px;left:0;right:0;height:2px;background:#073746;border-radius:0;z-index:0}
