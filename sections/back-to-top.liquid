{% liquid
  assign show_desktop = section.settings.show_desktop
  assign show_mobile = section.settings.show_mobile
  if show_desktop == false and show_mobile == false
    assign render_btn = false
  else
    assign render_btn = true
  endif
%}

{% if render_btn %}
  {%- capture visibility_class -%}
    {%- unless show_desktop %} back-to-top--hide-desktop{% endunless -%}
    {%- unless show_mobile %} back-to-top--hide-mobile{% endunless -%}
  {%- endcapture -%}

  <button
    type="button"
    class="back-to-top{{ visibility_class }}"
    id="BackToTop-{{ section.id }}"
    aria-label="Back to top"
    hidden
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="15"
      height="19"
      viewBox="0 0 14.1 18"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        fill="#172B4D"
        d="M13.851 .854c0 .471-.379.854-.846.854H.86C.393 1.708.014 1.325.014.854.014.382.393 0 .86 0h12.145c.467 0 .846.382.846.854ZM7 4.029a.846.846 0 0 0-.846.854v12.263a.846.846 0 0 0 1.691 0V4.883A.846.846 0 0 0 7 4.029Zm.6-.63a.846.846 0 0 0-1.153-.043L.218 9.645a.846.846 0 0 0 1.196 1.207l6.228-6.289a.846.846 0 0 0-.043-1.164Zm-1.2 0a.846.846 0 0 0-.043 1.164l6.229 6.289a.846.846 0 0 0 1.196-1.207L7.553 3.356a.846.846 0 0 0-1.153.043Z"
      />
    </svg>
  </button>

  <script>
    (function () {
      var btn = document.getElementById('BackToTop-{{ section.id }}');
      if (!btn) return;
      var showAt = 300;
      function toggle() {
        btn.hidden = window.scrollY <= showAt;
      }
      window.addEventListener('scroll', toggle, { passive: true });
      toggle();
      btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Back to top",
  "tag": "div",
  "class": "back-to-top-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "PC 端显示",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "移动端显示",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Back to top"
    }
  ]
}
{% endschema %}
