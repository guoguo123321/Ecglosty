          {"value": "2","label": "t:options.collection_row_counts.two"},
          {"value": "3","label": "t:options.collection_row_counts.three"},
          {"value": "4","label": "t:options.collection_row_counts.four"},
          {"value": "5","label": "t:options.collection_row_counts.five"},
          {"value": "6","label": "t:options.collection_row_counts.six"}
        ]
      },
      {
        "type": "select","id": "col_tb","label": "t:settings.collection_items_per_row_tablet","default": "3",
        "options": [
          {"value": "1","label": "t:options.collection_row_counts.one"},
          {"value": "2","label": "t:options.collection_row_counts.two"},
          {"value": "3","label": "t:options.collection_row_counts.three"},
          {"value": "4","label": "t:options.collection_row_counts.four"}
