{% comment %}
  Product collection carousel with single-item or responsive row navigation.
  @example
  Configure the collection and select one or row in the slide mode setting.
{% endcomment %}
{% liquid
  assign se_stts = section.settings
  assign col_dk = se_stts.col_dk | default: 5 | plus: 0
  assign col_tb = se_stts.col_tb | default: 3 | plus: 0
  assign col_mb = se_stts.col_mb | default: 2 | plus: 0
  assign set_blo = section.blocks
  assign stt_layout = se_stts.layout
  if stt_layout == 'lgs-container'
    assign html_layout = '<div class="lgs-container">__</div>' | split: '__'
  elsif stt_layout == 'custom-container'
    assign html_layout = '<div class="custom-container">__</div>' | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
  assign image = set_blo | where:"type","image"
  assign text = set_blo | where:"type","text"
  assign show_pag = false
  assign show_nav = false
  if se_stts.show_pagination_pc or se_stts.show_pagination_mb
    assign show_pag = true
  endif
  if se_stts.show_navigation_pc or se_stts.show_navigation_mb
    assign show_nav = true
  endif
%}
{%- capture image_sizes -%}
  (min-width: 1025px) {{ 100.0 | divided_by: col_dk }}vw, (min-width: 768px) {{ 100.0 | divided_by: col_tb }}vw, {{ 100.0 | divided_by: col_mb }}vw
{%- endcapture -%}
<style>
  {%- if se_stts.layout == 'custom-container' -%}
  .{{ section.id }} .custom-container{max-width:{{ se_stts.custom_container }};margin: 0 auto;}
  {%- endif -%}
  {%- liquid
    assign heading_c = se_stts.color_scheme.settings.foreground_heading
    assign subheading_c = se_stts.color_scheme.settings.foreground_subheading
  -%}
  {%- if heading_c != blank and heading_c.alpha != 0.0 -%}
  .{{ section.id }} .lgs-title{--color:var(--color-foreground-heading);color:var(--color-foreground-heading);}
  {%- endif -%}
  {%- if subheading_c != blank and subheading_c.alpha != 0.0 -%}
  .{{ section.id }} .lgs-subtitle{--color:var(--color-foreground-subheading);color:var(--color-foreground-subheading);}
  {%- endif -%}
  .{{ section.id }} .index-collection-item:hover .index-collection-title,
  .{{ section.id }} .index-collection-item:hover .index-collection-price{
    --color: var(--color-primary-hover);
    color: var(--color-primary-hover);
  }
  .{{ section.id }} .swiper-button-prev.common-prev svg rect,
  .{{ section.id }} .swiper-button-next.common-next svg rect{
    stroke: var(--color-arrow);
  }
  .{{ section.id }} .swiper-button-prev.common-prev svg path,
  .{{ section.id }} .swiper-button-next.common-next svg path{
    fill: var(--color-arrow);
  }
  .{{ section.id }} .swiper-button-prev.common-prev:hover svg rect,
  .{{ section.id }} .swiper-button-next.common-next:hover svg rect{
    fill: var(--color-arrow-hover);
    stroke: var(--color-arrow-hover);
    fill-opacity: 1;
  }
  .{{ section.id }} .swiper-button-prev.common-prev:hover svg path,
  .{{ section.id }} .swiper-button-next.common-next:hover svg path{
    fill: #ffffff;
    fill-opacity: 1;
  }
</style>
{% render 'swiper-assets' %}
<div class="{{ section.id }} index-collection-box lgs-section-inner color-{{ se_stts.color_scheme }}" {% render 'section_style', se_stts: se_stts -%}>
  {{-html_layout[0]-}}
    {%- render 'section_tophead', se_stts: se_stts -%}
    <div class="index-collection-swiper">
      <div class="swiper index-collection">
        <div class="swiper-wrapper">
          {% for product in se_stts.collection.products limit:se_stts.collection_number %}
              {%- liquid
                assign main_media = product.featured_media | default: product.media.first
                assign hover_media = nil
                if product.media.size > 1
                  for media in product.media
                    if media.id != main_media.id and media.media_type == 'image'
                      assign hover_media = media
                      break
                    endif
                  endfor
                endif
              -%}
              <div class="swiper-slide">
                <a class="index-collection-item{% if hover_media != blank %} has-hover-img{% endif %}" href="{{ product.url }}">
                    {% comment %} 图片 {% endcomment %}
                    <div class="index-collection-media-wrap">
                      {% if main_media != blank %}
                        {{
                          main_media
                          | image_url: width: 600
                          | image_tag:
                            class: 'index-collection-img index-collection-img-main',
                            loading: 'lazy',
                            widths: '200,300,400,600',
                            sizes: image_sizes,
                            alt: product.title,
                            width: main_media.width,
                            height: main_media.height
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'lgs-placeholder-svg lgs-obj-eff index-collection-img index-collection-img-main'}}
                      {% endif %}
                      {% if hover_media != blank %}
                        {{
                          hover_media
                          | image_url: width: 600
                          | image_tag:
                            class: 'index-collection-img index-collection-img-hover',
                            loading: 'lazy',
                            widths: '200,300,400,600',
                            sizes: image_sizes,
                            alt: product.title,
                            width: hover_media.width,
                            height: hover_media.height
                        }}
                      {% endif %}
                    </div>
                    <div class="index-collection-info">
                      <div
                        class="{% render 'lg-typography-classes', settings: se_stts, prefix: 'title_', base_class: 'index-collection-title' %}"
                        style="{% render 'lg-typography-style', settings: se_stts, prefix: 'title_' %}"
                      >{{ product.title }}</div>
                      <div
                        class="{% render 'lg-typography-classes', settings: se_stts, prefix: 'price_', base_class: 'index-collection-price' %}"
                        style="{% render 'lg-typography-style', settings: se_stts, prefix: 'price_' %}"
                      ><span translate="no">{{ product.price | money }}</span></div>
                    </div>
                    {%- if product.metafields.custom.brand.value != blank -%}
                      <div class="index-collection-brand color-{{ se_stts.brand_color_scheme }}">{{ product.metafields.custom.brand.value }}</div>
                    {%- endif -%}
                </a>
              </div>
            {% endfor %}
        </div>
        <div class="index-collection-media common-swiper-media{% if se_stts.show_pagination_pc %} has-pag-pc{% endif %}{% if se_stts.show_navigation_pc %} has-nav-pc{% endif %}{% if se_stts.show_pagination_mb %} has-pag-mb{% endif %}{% if se_stts.show_navigation_mb %} has-nav-mb{% endif %} media-align-{{ se_stts.media_align_mb }}">
          {%- if show_pag -%}
          <div class="swiper-pagination index-collection-pagination common-swiper-pagination"></div>
          {%- endif -%}
          {%- if show_nav -%}
          <div class="common-swiper-direction">
            <!-- 如果需要导航按钮 -->
            <div class="common-prev swiper-button-prev index-collection-prev custom-prev">
              <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34">
                <rect x="0.5" y="0.5" width="33" height="33" rx="16.5" fill="none" stroke="#000"/>
                <path fill="#000" d="M20 21.257 19.248 22 14 17l5.248-5 .752.743L15.587 17z"/>
              </svg>
            </div>
            <div class="common-next swiper-button-next index-collection-next custom-next">
              <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34">
                <rect x="0.5" y="0.5" width="33" height="33" rx="16.5" fill="none" stroke="#000"/>
                <path fill="#000" d="M14 12.743 14.752 12 20 17l-5.248 5-.752-.743L18.413 17z"/>
              </svg>
            </div>
          </div>
          {%- endif -%}
        </div>
        
        <!-- 如果需要滚动条 -->
        <!-- <div class="swiper-scrollbar"></div> -->
      </div>  
    </div>
  {{-html_layout[1]-}}
</div>

<script>
themeSwiperReady(function () {

    new Swiper('.{{ section.id }} .index-collection', {
      slidesPerView: {{ col_mb }},
      slidesPerGroup: {% if se_stts.slide_mode == 'row' %}{{ col_mb }}{% else %}1{% endif %},
      loop: true,
      // Keep loop duplicates aligned with row groups at every breakpoint.
      loopAdditionalSlides: {% if se_stts.slide_mode == 'row' %}0{% else %}5{% endif %},
      {%- if show_pag -%}
      pagination: {
        el: '.{{ section.id }} .index-collection-pagination',
        clickable: true,
      },
      {%- endif -%}
      {%- if show_nav -%}
      navigation: {
        nextEl: '.{{ section.id }} .index-collection-next',
        prevEl: '.{{ section.id }} .index-collection-prev',
      },
      {%- endif -%}
       breakpointsBase: 'container',
       breakpoints: { 
         0: {
           slidesPerView: {{ col_mb }},
           slidesPerGroup: {% if se_stts.slide_mode == 'row' %}{{ col_mb }}{% else %}1{% endif %},
           spaceBetween: 8
         },
         768: {
           slidesPerView: {{ col_tb }},
           slidesPerGroup: {% if se_stts.slide_mode == 'row' %}{{ col_tb }}{% else %}1{% endif %},
           spaceBetween: 8
         },
         1025: {
           slidesPerView: {{ col_dk }},
           slidesPerGroup: {% if se_stts.slide_mode == 'row' %}{{ col_dk }}{% else %}1{% endif %},
           spaceBetween: 15
         }
       },
    })
}, '.{{ section.id }}');
</script>
{% schema %}
