              val => String(val.specValue || '').trim().toLowerCase() !== 'browse all diamonds'
            ) || spec.specValues[0]
          : spec.specValues[0];

        if (firstSelected) {
          selectedSpecs[spec.specId] = firstSelected.specValueId;
          selectedValEl.textContent = firstSelected.specValue;
        }

        labelRow.appendChild(specNameEl);
        labelRow.appendChild(selectedValEl);

        // 原来的 Carat Size 特殊标签改为：
        /**if (spec.specName && spec.specName.toLowerCase().includes('centerstone')) {
          const browseLink = document.createElement('a');
          browseLink.href = 'javascript:void(0)';
          browseLink.textContent = 'Browse All Diamonds';
          browseLink.style.cssText = 'font-size:12px;color:#1a3a4a;margin-left:auto;text-decoration:underline;font-weight:400;cursor:pointer;';
          browseLink.addEventListener('click', () => switchToBrowseMode());
          labelRow.appendChild(browseLink);
        }**/

        group.appendChild(labelRow);

        const optionsRow = document.createElement('div');
        optionsRow.className = 'dpi-rp__spec-options';

        spec.specValues.forEach((val, valIndex) => {
          let btn;
          const isBrowseAllDiamonds = isCenterstone && String(val.specValue || '').trim().toLowerCase() === 'browse all diamonds';
          const isFirst = firstSelected && val.specValueId === firstSelected.specValueId;


          if (val.optionImage) {
            // ── 有图标：根据 specName 决定图标展示形态 ──
            if (spec.specName === 'Metal') {
              // 圆形色块
              btn = document.createElement('button');
              btn.className = 'dpi-rp__opt-metal' + (isFirst ? ' selected' : '');
              btn.type = 'button';
              btn.title = val.specValue;
              const img = document.createElement('img');
              img.src = val.optionImage;
              img.alt = val.specValue;
              btn.appendChild(img);

            } else {
              // 其他有图标的选项（Diamond Shape、Style 等）：图标 + 可选文字
              btn = document.createElement('button');
              btn.className = 'dpi-rp__opt-shape' + (isFirst ? ' selected' : '');
              btn.type = 'button';
              btn.title = val.specValue;
              const img = document.createElement('img');
              img.src = val.optionImage;
              img.alt = val.specValue;
              const lbl = document.createElement('span');
              lbl.textContent = val.specValue;
              btn.appendChild(img);
              btn.appendChild(lbl);
            }

          } else {
            // ── 无图标：统一显示文字 pill ──
            btn = document.createElement('button');
            btn.type = 'button';

            // Centerstone：截取 ct 之前的字符
            let displayText = val.specValue;
            if (spec.specName && spec.specName.toLowerCase().includes('centerstone')) {
              const ctIdx = displayText.toLowerCase().indexOf('ct');
              if (ctIdx > -1) displayText = displayText.substring(0, ctIdx).trim();
            }

            btn.className = 'dpi-rp__opt-pill' + (isFirst ? ' selected' : '');
            btn.textContent = displayText;
          }

          btn.dataset.specId      = spec.specId;
          btn.dataset.specValueId = val.specValueId;
          btn.dataset.specValue   = val.specValue;

          if (isBrowseAllDiamonds) {
            btn.dataset.browseAllDiamonds = 'true';
            btn.hidden = true;
            btn.style.setProperty('display', 'none', 'important');
          }

          btn.addEventListener('click', () => {
            optionsRow.querySelectorAll('[data-spec-id]').forEach(b => {
              b.classList.remove('selected');
            });

            btn.classList.add('selected');
            selectedSpecs[spec.specId] = val.specValueId;
            selectedValEl.textContent = val.specValue;

            if (isBrowseAllDiamonds) {
              // 隐藏选项选中后，进入挑选钻石状态
              switchToBrowseMode();
            } else {
              // 点击任何普通 specValue，清除 Browse 按钮的选中样式
              if (browseDiamondsBtn) {
                browseDiamondsBtn.classList.remove('is-selected');
                browseDiamondsBtn.setAttribute('aria-pressed', 'false');
              }

              // 只有普通 Centerstone 选项恢复默认购买状态
              if (isCenterstone) {
                switchToDefaultMode();
              }
            }

            onSpecChange();
          });

          optionsRow.appendChild(btn);

        });


        group.appendChild(optionsRow);

        // Browse 按钮紧跟 Centerstone 的选项，不再放在购买面板里。
        if (isCenterstone && browseDiamondsBtn) {
          group.appendChild(browseDiamondsBtn);
        }

        specsEl.appendChild(group);
      });

      // 没有渲染 Centerstone 时，保留 Browse 按钮，
      // 同时确保它仍位于 Diamond Quality 前面。
      if (browseDiamondsBtn && !specsEl.contains(browseDiamondsBtn)) {
        const qualityGroup = specsEl.querySelector(
          '[data-diamond-quality="true"]'
        );
        specsEl.insertBefore(browseDiamondsBtn, qualityGroup);
      }
    }


    // ── SKU 匹配 ──
    function findMatchedSku() {
      if (!productSkuList.length || !specTrees.length) return null;
      // 按 specTrees 顺序拼接 selectedSpecs 的 specValue
      const selectedValues = specTrees.map(spec => {
        const selectedId = selectedSpecs[spec.specId];
        const found = spec.specValues.find(v => v.specValueId === selectedId);
        return found ? found.specValue : null;
      });
      if (selectedValues.some(v => v === null)) return null;
      const targetSkuValue = selectedValues.join('::');
      return productSkuList.find(sku => sku.specSkuValue === targetSkuValue) || null;
    }

    // ── Shopify Variant 匹配 ──
    async function findShopifyVariant(specSkuValue) {
      
      if (!attrsPos) return null;
      // const optionKey = `option${attrsPos}`;
      // return variantsJson.find(v => v[optionKey] === specSkuValue) || null;
      const res = await fetch(`${API_BASE}/store/product/variant/lookup`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            shopDomain: `${SHOP_DOMAIN}`,
            optionField: `option${attrsPos}`,
            specSkuValue: specSkuValue
          })
        });

        const repose = await res.json();
        const node = repose.data?.result?.productVariants?.edges?.[0]?.node;
        
        if (node) {
          // GID 转纯数字 ID
          node.numericId = node.id.split('/').pop();
        }
        
        return node || null;
    }

    // ── 格式化价格 ──
    function formatMoney(amount) {
      // amount 是数字（元），直接格式化
      return '$' + Number(amount).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }
    // ── 更新 CHOOSE THIS SETTING 按钮状态 ──
    function updateChooseBtn(available) {
      // ── CHOOSE THIS SETTING 按钮 ──
      if (chooseBtn) {
        if (available) {
          chooseBtn.disabled = false;
          chooseBtn.classList.remove('sold-out');
          chooseBtn.textContent = 'CHOOSE THIS SETTING';
        } else {
          chooseBtn.disabled = true;
          chooseBtn.classList.add('sold-out');
          chooseBtn.textContent = 'SOLD OUT';
        }
      }

      // ── ADD TO BAG 按钮同步库存状态 ──
      // ── ADD TO BAG 按钮同步库存状态（仅在有 Centerstone 时管理显示） ──
      if (addToBagBtn) {
        const hasCenterstoneNow = specTrees.some(
          spec => spec.specName && spec.specName.toLowerCase().includes('centerstone')
        );
        if (hasCenterstoneNow) {
          // 有 Centerstone 时才控制 display
          if (available) {
            addToBagBtn.disabled = false;
            addToBagBtn.classList.remove('sold-out');
            addToBagBtn.textContent = 'ADD TO BAG';
          } else {
            addToBagBtn.disabled = true;
            addToBagBtn.classList.add('sold-out');
            addToBagBtn.textContent = 'SOLD OUT';
          }
        } else {
          // 无 Centerstone：只更新库存状态，不改 display
          addToBagBtn.disabled = !available;
          addToBagBtn.classList.toggle('sold-out', !available);
        }
      }

    }

    // ── 标记各选项是否售完 ──
    // 逻辑：固定其他维度的当前选中值，遍历该维度每个选项，
    // 看是否能找到至少一个有库存的 SKU（纯本地判断，不发请求）
    function updateSoldOutOptions() {
      if (!productSkuList.length || !specTrees.length) return;

      specTrees.forEach(spec => {
        const specId = spec.specId;
        spec.specValues.forEach(val => {
          // 构造假设选中该值时的完整 selectedSpecs
          const hypothetical = { ...selectedSpecs, [specId]: val.specValueId };

          // 拼接 specSkuValue
          const values = specTrees.map(s => {
            const selId = hypothetical[s.specId];
            const found = s.specValues.find(v => v.specValueId === selId);
            return found ? found.specValue : null;
          });

          let hasSku = false;
          if (!values.some(v => v === null)) {
            const targetKey = values.join('::');
            // 本地 SKU 列表判断（有 SKU 记录即视为有货，精确库存依赖 Shopify）
            hasSku = productSkuList.some(sku => sku.specSkuValue === targetKey);
          }

          // 找到对应按钮并标记
          const btn = specsEl.querySelector(
            `[data-spec-id="${specId}"][data-spec-value-id="${val.specValueId}"]`
          );
          if (btn) {
            btn.classList.toggle('sold-out', !hasSku);
            // 已售完的选项仍可点击（让用户看到反馈），但可选择禁用：
            // btn.disabled = !hasSku;
          }
        });
      });
    }

    // ── 折叠内容中的动态选项文字和条件文案 ──
    function updateAccordionContent() {
      const normalizeName = value =>
        String(value || '').trim().toLowerCase().replace(/\s+/g, ' ');

      function getSelectedValue(names) {
        const spec = specTrees.find(item =>
          names.includes(normalizeName(item.specName))
        );

        if (!spec) return '';

        const selectedId = selectedSpecs[spec.specId];

        const selectedValue = (spec.specValues || []).find(value =>
          String(value.specValueId) === String(selectedId)
        );

        return selectedValue ? String(selectedValue.specValue || '') : '';
      }

      const metalValue = getSelectedValue(['metal']);

      const showRhodium = [
        '14k white gold',
        '18k white gold'
      ].includes(normalizeName(metalValue));

      const values = {
        shape: getSelectedValue(['diamond shape', 'shape']),
        metal: metalValue
      };

      section.querySelectorAll('[data-dpi-dynamic-content]').forEach(content => {
        if (!content.hasAttribute('data-dpi-tokens-ready')) {
          const walker = document.createTreeWalker(
            content,
            NodeFilter.SHOW_TEXT,
            {
              acceptNode(node) {
                if (node.parentElement?.closest(
                  'script, style, textarea, code, pre, ' +
                  '[data-dpi-content-token], [data-dpi-rhodium]'
                )) {
                  return NodeFilter.FILTER_REJECT;
                }

                return /\[\[(shape|metal|rhodium)\]\]/i.test(
                  node.nodeValue || ''
                )
                  ? NodeFilter.FILTER_ACCEPT
                  : NodeFilter.FILTER_REJECT;
              }
            }
          );

          const textNodes = [];

          while (walker.nextNode()) {
            textNodes.push(walker.currentNode);
          }

          textNodes.forEach(node => {
            const text = node.nodeValue || '';

            // 条件文案优先整体匹配，Shape / Metal 单独匹配。
            const pattern =
              /\[\[rhodium\]\]([\s\S]*?)\[\[\/rhodium\]\]|\[\[(shape|metal)\]\]/gi;

            const fragment = document.createDocumentFragment();

            let lastIndex = 0;
            let match;

            while ((match = pattern.exec(text)) !== null) {
              fragment.appendChild(
                document.createTextNode(text.slice(lastIndex, match.index))
              );

              const span = document.createElement('span');

              if (match[1] !== undefined) {
                // 文案来自 content，而不是写死在 JavaScript 里。
                span.setAttribute('data-dpi-rhodium', '');
                span.textContent = match[1];
              } else {
                span.dataset.dpiContentToken = match[2].toLowerCase();
              }

              fragment.appendChild(span);
              lastIndex = pattern.lastIndex;
            }

            fragment.appendChild(
              document.createTextNode(text.slice(lastIndex))
            );

            node.replaceWith(fragment);
          });

          content.setAttribute('data-dpi-tokens-ready', '');
        }

        // 更新 Shape 和 Metal。
        content.querySelectorAll('[data-dpi-content-token]').forEach(token => {
          const value = values[token.dataset.dpiContentToken] || '';

          if (token.textContent !== value) {
            token.textContent = value;
          }
        });

        // 根据 Metal 显示或隐藏条件文案。
        content.querySelectorAll('[data-dpi-rhodium]').forEach(element => {
          element.hidden = !showRhodium;
          element.style.setProperty(
            'display',
            showRhodium ? 'inline' : 'none'
          );

          // 如果整段只有这一句，同步隐藏外层段落，避免留下空行。
          const parent = element.parentElement;

          if (parent && parent !== content && parent.tagName === 'P') {
            const isStandalone = Array.from(parent.childNodes).every(node =>
              node === element ||
              (node.nodeType === Node.TEXT_NODE && !node.textContent.trim()) ||
              (node.nodeType === Node.ELEMENT_NODE && node.tagName === 'BR')
            );

            if (isStandalone) {
              parent.hidden = !showRhodium;

              if (showRhodium) {
                parent.style.removeProperty('display');
              } else {
                parent.style.setProperty('display', 'none');
              }
            }
          }
        });
      });
    }


    // ── Spec 变化处理 ──
    function onSpecChange() {
      updateAccordionContent();
      const sku = findMatchedSku();
      if (!sku) return;

      // 更新价格
      if (priceEl) priceEl.textContent = formatMoney(sku.productPrice);
      if (comparePriceEl) {
        if (sku.linePrice && sku.linePrice > sku.productPrice) {
          comparePriceEl.textContent = formatMoney(sku.linePrice);
          comparePriceEl.style.display = '';
        } else {
          comparePriceEl.style.display = 'none';
        }
      }

      // 更新媒体
      const medias = (sku.medias && sku.medias.length > 0) ? sku.medias : defaultMedias;
      populateMedia(medias);

      // 更新 Shopify variant + 库存判断
      findShopifyVariant(sku.specSkuValue).then(function(shopifyVariant) {
        if (shopifyVariant && variantIdEl) {
          variantIdEl.value = shopifyVariant.numericId;
        }
        // 判断库存
        const available = shopifyVariant
          ? (shopifyVariant.inventoryPolicy === 'CONTINUE' || (shopifyVariant.inventoryQuantity != null && shopifyVariant.inventoryQuantity > 0))
          : false;
        updateChooseBtn(available);
        updateSoldOutOptions();
      });
    }


    // ── Choose This Setting 按钮 ──
    if (chooseBtn) {
      chooseBtn.addEventListener('click', () => {
        if (!currentProductData) return;
        const sku = findMatchedSku();
        const medias = (sku.medias && sku.medias.length > 0) ? sku.medias : defaultMedias;
        
        //const shopifyVariant = sku ? findShopifyVariant(sku.specSkuValue) : null;
        findShopifyVariant(sku.specSkuValue).then(function(shopifyVariant) {
        
          let selectedSku = sku;
            selectedSku.medias = medias;
            // 保存当前页面变体数据中的 variantId → specSkuValue 对应关系
            const variantSpecSkuMap = {};

            if (attrsPos) {
              const optionKey = `option${attrsPos}`;

              variantsJson.forEach(variant => {
                const specSkuValue = variant[optionKey];

                if (variant.id != null && specSkuValue != null) {
                  variantSpecSkuMap[specSkuValue] = String(variant.id);
                }
              });
            }

            const saveData = {
              ...currentProductData,
              selectedSku: selectedSku,
              selectedVariantId: shopifyVariant ? shopifyVariant.numericId : null,
              variantSpecSkuMap: variantSpecSkuMap,
            };
            const selectedShapeBtn = section.querySelector(
              '.dpi-rp__opt-shape.selected'
            );
            if (selectedShapeBtn) {
              saveData.selectedShape = selectedShapeBtn.dataset.specValue;
            }

            localStorage.setItem('current_ringsetting', JSON.stringify(saveData));
            const diamond = localStorage.getItem('current_diamond');
            if (diamond) {
              window.location.href = '/pages/purchase-review';
            } else {
              localStorage.setItem('select_purchase_number','ringsetting');
              let current_collections_diamond=localStorage.getItem('current_collections_diamond');
              if(!current_collections_diamond){
                current_collections_diamond='/collections/lab-grown-diamond';
              }

              // 查找 Diamond Shape 已选值
              const shapeSpecForBtn=specTrees.find(spec=>
                spec.specName&&spec.specName.toLowerCase().includes('diamond shape')
              );
              let shapeParam='';
              if(shapeSpecForBtn){
                const selectedShapeId=selectedSpecs[shapeSpecForBtn.specId];
                const selectedShapeVal=shapeSpecForBtn.specValues.find(v=>v.specValueId===selectedShapeId);
                if(selectedShapeVal&&selectedShapeVal.specValue){
                  shapeParam=selectedShapeVal.specValue.toLowerCase().replace(/\s+/g,'-');
                }
              }

              // 使用戒托当前选择的 Shape，替换旧筛选 URL 中的 Shape。
              // 保留其他筛选条件，但重新从第 1 页开始。
              const diamondURL = new URL(
                current_collections_diamond,
                window.location.origin
              );

              if (shapeParam) {
                // set 会替换旧值，并清除重复的 shape 参数。
                diamondURL.searchParams.set('shape', shapeParam);
              }

              diamondURL.searchParams.set('page', '1');

              current_collections_diamond =
                diamondURL.pathname +
                diamondURL.search +
                diamondURL.hash;

              localStorage.setItem(
                'current_collections_diamond',
                current_collections_diamond
              );
              window.location.href = current_collections_diamond;

            }
        });
       
        
      });
    }

    // ── Wishlist 按钮 ──
    
      // ===== WISHLIST (others) =====
      const WISHLIST_KEY = 'ecglosty_wishlist';

      function ringGetWishlist() {
        try {
          const raw = localStorage.getItem(WISHLIST_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            if (parsed && Array.isArray(parsed.others)) return parsed;
          }
        } catch(e) {}
        return { diamonds: [], others: [] };
      }

      function ringSaveWishlist(wl) {
        localStorage.setItem(WISHLIST_KEY, JSON.stringify(wl));
      }

      function ringGetKey(d) {
        return d.productId || d.id || d.urlHandle;
      }

      function ringIsWishlisted(d) {
        const wl = ringGetWishlist();
        const key = ringGetKey(d);
        return wl.others.some(item => ringGetKey(item) === key);
      }

      function ringToggleWishlist() {
        if (!currentProductData) return;
        const wl = ringGetWishlist();
        const key = ringGetKey(currentProductData);
        const existingIdx = wl.others.findIndex(item => ringGetKey(item) === key);
        if (existingIdx >= 0) {
          wl.others.splice(existingIdx, 1);
        } else {
          wl.others.push(currentProductData);
        }
        ringSaveWishlist(wl);
        ringSyncWishlistBtn();
      }

      function ringSyncWishlistBtn() {
        const btn = document.getElementById(`dpi-rp-wishlist-btn-${sid}`);
        if (!btn) return;
        const wishlisted = currentProductData && ringIsWishlisted(currentProductData);
        btn.classList.toggle('wishlisted', !!wishlisted);
        const textNode = btn.childNodes[btn.childNodes.length - 1];
        if (textNode && textNode.nodeType === Node.TEXT_NODE) {
          textNode.textContent = wishlisted ? ' WISHLISTED' : ' ADD TO WISHLIST';
        }
      }

      // 绑定点击事件
      document.getElementById(`dpi-rp-wishlist-btn-${sid}`)?.addEventListener('click', ringToggleWishlist);

    
    //end愿望清单
    // ── Fallback：使用 Shopify 图片 ──
    function populateMediaFallback() {
      const images = window.__dpi_images || [];
      const medias = images.map((src, i) => ({ mediaType: 1, url: src, sortOrder: i + 1 }));
      if (medias.length === 0) {
        // 用 Shopify featured image
        const featuredImg = section.querySelector('.dpi-rp__media-placeholder img');
        if (featuredImg) return; // 保留占位图
      }
      populateMedia(medias);
    }
    // ── Browse All Diamonds / ADD TO BAG 切换 ──
    const purchasePanel     = section.querySelector(`#dpi-rp-purchase-panel-${sid}`);
    const addToBagBtn       = section.querySelector(`#dpi-rp-add-to-bag-${sid}`);
    const browseDiamondsBtn = section.querySelector(`#dpi-rp-browse-btn-${sid}`);
    const browseDescEl      = section.querySelector(`#dpi-rp-browse-desc-${sid}`);
    const ringSizeGroup     = section.querySelector(`#dpi-rp-ring-size-${sid}`);
    const dpiRpPriceLabel     = section.querySelector(`#dpi-rp__price-label`);

    const addonsEngraving     = section.querySelector(`#dpi-rp__addons-engraving-${sid}`);
        // 隐藏/恢复 Diamond Quality。
    // 进入 Browse 模式时，直接同步第一个值，不触发选项点击事件。
    function syncDiamondQualityMode(isBrowseMode) {
      specTrees.forEach(spec => {
        const isDiamondQuality =
          String(spec.specName || '').trim().toLowerCase() ===
          'diamond quality';

        if (!isDiamondQuality) return;

        const group = Array.from(
          specsEl.querySelectorAll('[data-diamond-quality="true"]')
        ).find(el =>
          Array.from(el.querySelectorAll('[data-spec-id]')).some(
            btn => btn.dataset.specId === String(spec.specId)
          )
        );

        if (group) {
          group.hidden = isBrowseMode;

          if (isBrowseMode) {
            group.style.setProperty('display', 'none', 'important');
          } else {
            group.style.removeProperty('display');
          }
        }

        if (!isBrowseMode) return;

        const firstValue = spec.specValues?.[0];
        if (!firstValue) return;

        selectedSpecs[spec.specId] = firstValue.specValueId;

        if (group) {
          group.querySelectorAll('[data-spec-value-id]').forEach(btn => {
            btn.classList.toggle(
              'selected',
              btn.dataset.specValueId === String(firstValue.specValueId)
            );
          });

          const selectedValEl = group.querySelector(
            '.dpi-rp__spec-selected-val'
          );

          if (selectedValEl) {
            selectedValEl.textContent = firstValue.specValue;
          }
        }
      });
    }

    function switchToDefaultMode() {
      syncDiamondQualityMode(false);
      // 1. 隐藏 CHOOSE THIS SETTING，显示 ADD TO BAG
      if (chooseBtn)   chooseBtn.style.display = 'none';
      if (addToBagBtn) addToBagBtn.style.display = '';
      if (addonsEngraving) addonsEngraving.style.display = '';
      // 2. 显示 Ring Size 选择器块
      if (ringSizeGroup) ringSizeGroup.style.display = '';

      // 3. 隐藏说明文案
      if (browseDescEl) browseDescEl.style.display = 'none';

      if (dpiRpPriceLabel) dpiRpPriceLabel.style.display = 'none';

      // 4. 恢复 Browse All Diamonds 按钮可点击
      if (browseDiamondsBtn) {
        browseDiamondsBtn.disabled = false;
        browseDiamondsBtn.classList.remove('is-selected');
        browseDiamondsBtn.setAttribute('aria-pressed', 'false');
      }

    }

    function switchToBrowseMode() {
      syncDiamondQualityMode(true);
      // 1. 隐藏 ADD TO BAG，显示 CHOOSE THIS SETTING
      if (addToBagBtn) addToBagBtn.style.display = 'none';
      if (addonsEngraving) addonsEngraving.style.display = 'none';
      if (chooseBtn)   chooseBtn.style.display = '';

      // 2. 隐藏 Ring Size 选择器块
      if (ringSizeGroup) ringSizeGroup.style.display = 'none';

      // 3. 显示说明文案
      if (browseDescEl) browseDescEl.style.display = '';

      if (dpiRpPriceLabel) dpiRpPriceLabel.style.display = '';
      // 4. Browse All Diamonds 按钮变为不可再点击（防止重复触发）
      if (browseDiamondsBtn) {
        browseDiamondsBtn.disabled = true;
        browseDiamondsBtn.classList.add('is-selected');
        browseDiamondsBtn.setAttribute('aria-pressed', 'true');
      }

    }

    if (browseDiamondsBtn) {
      browseDiamondsBtn.setAttribute('aria-pressed', 'false');

      browseDiamondsBtn.addEventListener('click', () => {
        const browseOption = specsEl.querySelector(
          '[data-browse-all-diamonds="true"]'
        );

        if (browseOption) {
          // 复用选项事件，更新 selectedSpecs、标签及 SKU
          browseOption.click();
        } else {
          // 没有隐藏的 Browse 选项时，也需要重置 Quality 并更新 SKU。
          switchToBrowseMode();
          onSpecChange();
        }
      });
    }

    
        // ── Ring Size 渲染 ──
    function renderRingSize(ringSizeList) {
      const container = section.querySelector(`#dpi-rp-ring-size-options-${sid}`);
      if (!container || !ringSizeList || ringSizeList.length === 0) return;

      let selectedSize = null;
      let showAll = false;

      function getDisplaySizes(sizes) {
        if (sizes.length <= 5) return { displayed: sizes, hasMore: false };

        // 判断范围：最小值 < 4 且 最大值 > 8
        const numericSizes = sizes.map(s => parseFloat(s));
        const minVal = Math.min(...numericSizes);
        const maxVal = Math.max(...numericSizes);

        if (minVal < 4 && maxVal > 8) {
          // 固定显示 4.5、5、6、7、8
          const preferred = ['4.5', '5', '6', '7', '8'];
          const displayed = preferred
            .map(p => sizes.find(s => parseFloat(s) === parseFloat(p)))
            .filter(Boolean);

          // 如果 preferred 里有的值在 sizes 中不存在，用原始顺序补足到5个
          if (displayed.length < 5) {
            sizes.forEach(s => {
              if (displayed.length >= 5) return;
              if (!displayed.includes(s)) displayed.push(s);
            });
          }

          return { displayed, hasMore: true };
        }

        // 原规则：取中间，间隔1个，取5个
        const mid = Math.floor(sizes.length / 2);
        let startIdx = Math.max(0, mid - 4);
        const picked = [];
        let i = startIdx;
        while (picked.length < 5 && i < sizes.length) {
          picked.push(sizes[i]);
          i += 2;
        }
        // 不足5个则从头补
        if (picked.length < 5) {
          let j = 0;
          while (picked.length < 5 && j < sizes.length) {
            if (!picked.includes(sizes[j])) picked.push(sizes[j]);
            j++;
          }
        }
        return { displayed: picked, hasMore: true };
      }


      function renderSizeButtons(sizes) {
        container.innerHTML = '';
        const { displayed, hasMore } = showAll
          ? { displayed: sizes, hasMore: false }
          : getDisplaySizes(sizes);

        displayed.forEach((size, idx) => {
          const btn = document.createElement('button');
          btn.className = 'dpi-rp__ring-size-btn' + (idx === 0 && !selectedSize ? ' selected' : '');
          btn.type = 'button';
          btn.textContent = size;
          btn.dataset.size = size;

          if (selectedSize === size) btn.classList.add('selected');

          btn.addEventListener('click', () => {
            container.querySelectorAll('.dpi-rp__ring-size-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            selectedSize = size;
          });

          container.appendChild(btn);
        });

        if (hasMore && !showAll) {
          const moreBtn = document.createElement('button');
          moreBtn.className = 'dpi-rp__ring-size-btn dpi-rp__ring-size-btn--more';
          moreBtn.type = 'button';
          moreBtn.textContent = 'View More Sizes';
          moreBtn.addEventListener('click', () => {
            showAll = true;
            renderSizeButtons(sizes);
          });
          container.appendChild(moreBtn);
        }
      }

      renderSizeButtons(ringSizeList);
    }

    // ── Size Guide 弹窗 ──
    const sizeGuideModal   = section.querySelector(`#dpi-rp-size-guide-modal-${sid}`);
    const sizeGuideOverlay = section.querySelector(`#dpi-rp-size-guide-overlay-${sid}`);
    const sizeGuideClose   = section.querySelector(`#dpi-rp-size-guide-close-${sid}`);
    const sizeGuideLink    = section.querySelector(`#dpi-rp-size-guide-${sid}`);

    function openSizeGuide(e) {
      e.preventDefault();
      if (sizeGuideModal) sizeGuideModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeSizeGuide() {
      if (sizeGuideModal) sizeGuideModal.classList.remove('open');
      document.body.style.overflow = '';
    }

    if (sizeGuideLink)    sizeGuideLink.addEventListener('click', openSizeGuide);
    if (sizeGuideClose)   sizeGuideClose.addEventListener('click', closeSizeGuide);
    if (sizeGuideOverlay) sizeGuideOverlay.addEventListener('click', closeSizeGuide);

    // ESC 键关闭
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeSizeGuide();
    });
  // ── end Size Guide 弹窗 ──

    // ── ADD TO BAG 加购逻辑 ──
    if (addToBagBtn) {
      addToBagBtn.addEventListener('click', async () => {
        const variantId = variantIdEl ? variantIdEl.value : null;
        if (!variantId) {
          alert('Please select a valid option first.');
          return;
        }
        // ── 库存校验：复用 findShopifyVariant 的结果 ──
        // addToBagBtn 与 chooseBtn 共享同一套库存状态，
        // updateChooseBtn(available) 调用时同步更新 addToBagBtn
        if (addToBagBtn.disabled || addToBagBtn.classList.contains('sold-out')) {
          return; // 已售完，静默拦截（按钮样式已提示用户）
        }

        // 获取当前选中的 Ring Size
        const selectedSizeBtn = section.querySelector(
          `#dpi-rp-ring-size-options-${sid} .dpi-rp__ring-size-btn.selected`
        );
        const selectedSize = selectedSizeBtn ? selectedSizeBtn.dataset.size : null;

        // 构建加购 payload
        const properties = {};

        // 1. Ring Size
        if (selectedSize) {
          properties['Ring Size'] = selectedSize;
        }

        // 2. 当前所有已选 spec 变体选项（Metal、Diamond Shape、Centerstone 等）
        specTrees.forEach(spec => {
          const selectedId = selectedSpecs[spec.specId];
          const selectedVal = spec.specValues.find(v => v.specValueId === selectedId);
          if (selectedVal) {
            properties[spec.specName] = selectedVal.specValue;
          }
        });
        // 刻字内容
      const engravingCheckbox=section.querySelector(`#dpi-rp-engraving-${sid}`);
      const engravingInput=section.querySelector('input[name="properties-option-engraving"]');
      if(engravingCheckbox && engravingCheckbox.checked && engravingInput && engravingInput.value.trim()){
        properties['Engraving']=engravingInput.value.trim();
      }



        const payload = {
          items: [
            {
              id: Number(variantId),
              quantity: 1,
              properties: properties
            }
          ]
        };

        // 禁用按钮防止重复点击
        addToBagBtn.disabled = true;
        const originalText = addToBagBtn.textContent;
        addToBagBtn.textContent = 'Adding…';

        try {
          // ── 1. 先获取 cart drawer 的 section id ──
          const cartItemsComponent = document.querySelector('cart-items-component[data-drawer]');
          const sectionId = cartItemsComponent?.dataset?.sectionId;

          // ── 2. 构建请求，附带 sections 参数让 Shopify 一并渲染最新 HTML ──
          const sectionsParam = sectionId ? `&sections=${sectionId}` : '';
          
          const res = await fetch(`/cart/add.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...payload,
              sections: sectionId ? [sectionId] : undefined
            })
          });

          if (!res.ok) throw new Error('Cart error ' + res.status);

          const data = await res.json();

          // 成功反馈
          addToBagBtn.textContent = 'Added!';
          addToBagBtn.style.background = '#2a6a3a';

          // ── 3. dispatch CartAddEvent，携带 sections HTML 和 item_count ──
          document.dispatchEvent(new CustomEvent('cart:update', {
            bubbles: true,
            detail: {
              resource: {
                item_count: data.item_count ?? data.items_count
              },
              data: {
                sections: data.sections ?? {}   // Shopify 返回的最新 section HTML
              }
            }
          }));

          setTimeout(() => {
            addToBagBtn.textContent = originalText;
            addToBagBtn.style.background = '';
            addToBagBtn.disabled = false;
          }, 2000);

        } catch (err) {
          console.error('[DPI] Add to cart failed:', err);
          addToBagBtn.textContent = 'Failed, retry';
          addToBagBtn.style.background = '#c0392b';
          setTimeout(() => {
            addToBagBtn.textContent = originalText;
            addToBagBtn.style.background = '';
            addToBagBtn.disabled = false;
          }, 2000);
        }

      });
    }



    // ── 主入口：拉取 API ──
    async function fetchProductData() {
    //   if (!API_BASE || !PRODUCT_ID) {
    //     populateMediaFallback();
    //     return;
    //   }
      try {
        const url = `${API_BASE}/store/product/details/${PRODUCT_ID}?shopDomain=${SHOP_DOMAIN}`;
        const res  = await fetch(url);
        if (!res.ok) throw new Error('API error ' + res.status);
        const json = await res.json();
        if (json.code === 'ok' && json.data && json.data.product) {
          const product = json.data.product;
          currentProductData = product;
          ringSyncWishlistBtn(); 
          // 解析数据
          const combo = product.skuCombination || {};
          productSkuList = combo.productSkuList || [];
          specTrees      = combo.productSpecTrees || [];
          defaultMedias  = product.attribute?.medias || [];

          // 如果 defaultMedias 为空，用 pictures 字段
          if (defaultMedias.length === 0 && product.pictures) {
            defaultMedias = product.pictures.split(',').map((url, i) => ({
              mediaType: 1, url: url.trim(), sortOrder: i + 1
            }));
          }
          
        
          // 初始化选中第一个 spec value
          specTrees.forEach(spec => {
            if (spec.specValues && spec.specValues.length > 0) {
              selectedSpecs[spec.specId] = spec.specValues[0].specValueId;
            }
          });

          // 渲染
          renderSpecs(specTrees);

          // ── Diamond Shape 预填充逻辑 ──
          const currentDiamondRaw=localStorage.getItem('current_diamond');
          if(currentDiamondRaw){
            try{
              const currentDiamond=JSON.parse(currentDiamondRaw);
              const targetShape=currentDiamond.shape;

              if(targetShape){
                specTrees.forEach(spec=>{
                  if(spec.specName&&spec.specName.toLowerCase().includes('diamond shape')){
                    // 查找匹配的 specValue
                    const matchedVal=spec.specValues.find(v=>
                      v.specValue&&v.specValue.toLowerCase()===targetShape.toLowerCase()
                    );

                    if(matchedVal){
                      // 填充 selectedSpecs
                      selectedSpecs[spec.specId]=matchedVal.specValueId;

                      // 同步桌面端按钮 selected 状态
                      const specGroups=specsEl.querySelectorAll('.dpi-rp__spec-group');
                      specGroups.forEach(group=>{
                        const btns=group.querySelectorAll(`[data-spec-id="${spec.specId}"]`);
                        if(btns.length>0){
                          btns.forEach(b=>b.classList.remove('selected'));
                          const targetBtn=group.querySelector(
                            `[data-spec-id="${spec.specId}"][data-spec-value-id="${matchedVal.specValueId}"]`
                          );
                          if(targetBtn)targetBtn.classList.add('selected');
                          // 同步 spec-selected-val 文字
                          const selectedValEl=group.querySelector('.dpi-rp__spec-selected-val');
                          if(selectedValEl)selectedValEl.textContent=matchedVal.specValue;

                          // 隐藏整个 spec-group
                          group.style.display='none';
                        }
                      });
                    }
                  }
                });
              }
            }catch(e){
              console.warn('[DPI] Failed to parse current_diamond:',e);
            }
          }
          // ── 判断是否存在 Centerstone 选项 ──
          const hasCenterstone = specTrees.some(
            spec => spec.specName && spec.specName.toLowerCase().includes('centerstone')
          );
          const hasDiamond = !!localStorage.getItem('current_diamond'); 
          if (!hasCenterstone || hasDiamond) {
            // 无 Centerstone：显示 CHOOSE THIS SETTING + browse_diamonds_desc，隐藏 ADD TO BAG + Ring Size
            if (chooseBtn)     chooseBtn.style.display = '';
            if (addToBagBtn)   addToBagBtn.style.display = 'none';
            if (addonsEngraving) addonsEngraving.style.display = 'none';
            if (browseDescEl)  browseDescEl.style.display = '';
            if (ringSizeGroup) ringSizeGroup.style.display = 'none';
          } else {
            // 有 Centerstone：显示 ADD TO BAG + Ring Size，隐藏 CHOOSE THIS SETTING + browse_diamonds_desc
            if (chooseBtn)     chooseBtn.style.display = 'none';
            if (addToBagBtn)   addToBagBtn.style.display = '';
            if (addonsEngraving) addonsEngraving.style.display = '';
            if (browseDescEl)  browseDescEl.style.display = 'none';
            if (ringSizeGroup) ringSizeGroup.style.display = '';
          }

          onSpecChange(); // 用初始选中的 SKU 渲染媒体和价格
          // 渲染 Ring Size
          const ringSizeList = product.ringSize?product.ringSize.split(','):[];
          renderRingSize(ringSizeList);

        } else {
          throw new Error('Unexpected response');
        }
      } catch (err) {
        console.warn('[DPI] API fetch failed, using fallback.', err);
        populateMediaFallback();
      }
    }

    fetchProductData();
  }

})();
