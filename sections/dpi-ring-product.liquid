{% javascript %}
(function () {
  'use strict';

  // ── 找到当前 section 根元素 ──
  // 用 data-section-id 定位，支持页面多个 section 实例
  const roots = document.querySelectorAll('.dpi-rp[data-section-id]');
  roots.forEach(initSection);

  function initSection(section) {
    let currentSortedMedias=[];
    const sid        = section.dataset.sectionId;
    const PRODUCT_ID = section.dataset.productId;
    const PRODUCT_HANDLE = section.dataset.handle;
    const SHOP_DOMAIN= "https://"+section.dataset.shopDomain;
    const API_BASE   = (section.dataset.apiEndpoint || '').replace(/\/$/, '');

    // DOM refs
    const mediaGrid     = section.querySelector(`#dpi-rp-media-grid-${sid}`);
    const specsEl       = section.querySelector(`#dpi-rp-specs-${sid}`);
    const priceEl       = section.querySelector(`#dpi-rp-price-${sid}`);
    const comparePriceEl= section.querySelector(`#dpi-rp-compare-price-${sid}`);
    const variantIdEl   = section.querySelector(`#dpi-rp-variant-id-${sid}`);
    const shipDateEl    = section.querySelector(`#dpi-rp-ship-date-${sid}`);
    const chooseBtn     = section.querySelector(`#dpi-rp-choose-btn-${sid}`);
  

    // Lightbox
    const lightbox        = section.querySelector(`#dpi-rp-lightbox-${sid}`);
    const lightboxImg     = section.querySelector(`#dpi-rp-lightbox-img-${sid}`);
    const lightboxClose   = section.querySelector(`#dpi-rp-lightbox-close-${sid}`);
    const lightboxOverlay = section.querySelector(`#dpi-rp-lightbox-overlay-${sid}`);

    // 3D Modal
    const modelModal   = section.querySelector(`#dpi-rp-model-modal-${sid}`);
    const modelViewer  = section.querySelector(`#dpi-rp-model-viewer-${sid}`);
    const modelClose   = section.querySelector(`#dpi-rp-model-close-${sid}`);
    const modelOverlay = section.querySelector(`#dpi-rp-model-overlay-${sid}`);

    // Shopify variants & options
    const variantsJson = JSON.parse(
      section.querySelector(`#dpi-rp-variants-json-${sid}`).textContent
    );
    const optionsJson  = JSON.parse(
      section.querySelector(`#dpi-rp-options-json-${sid}`).textContent
    );
    // 找 attrs option 的 position（1-based）
    const attrsOption  = optionsJson.find(o => o.name.toLowerCase() === 'attrs');
    const attrsPos     = attrsOption ? attrsOption.position : null; // 1-based
    //3D旋转重构
        // 当前媒体区域的旋转实例
    const spinCleanups = new Set();
    let mediaMode = null;
    let mediaResizeTimer = null;

    function destroySpins() {
      for (const cleanup of [...spinCleanups]) cleanup();
      spinCleanups.clear();
    }

    function removeMobileCarousel() {
      section.querySelector('.dpi-rp__carousel-main')?.remove();
      section.querySelector('.dpi-rp__carousel-thumbs')?.remove();
      // 当前代码的 shape dropdown 挂在 section 外
      document.querySelector('.dpi-rp__shape-dropdown')?.remove();
    }

    function mountSpin(host, media, settings) {
      const {
        sensitivity,
        autoPlaySpeed,
        friction,
        speedBoost,
        maxInertia,
        mobile = false
      } = settings;

      const totalFrames = Math.max(
        1,
        Math.floor(Number(media.imageNumber) || 1)
      );

      const canvas = document.createElement('canvas');
      canvas.width = 800;
      canvas.height = 800;
      canvas.style.cssText = mobile
        ? 'width:100%;height:auto;object-fit:contain;cursor:grab;display:block;transform:translateZ(0);touch-action:none;'
        : 'width:100%;height:100%;object-fit:contain;cursor:grab;display:block;transform:translateZ(0);touch-action:none;';

      const loader = document.createElement('div');
      loader.className = 'dpi-rp__spin-loader';
      loader.innerHTML = `
        <span class="dpi-rp__spin-progress-text">Loading…</span>
        <div style="width:160px;height:5px;background:#e0e0e0;border-radius:3px;margin-top:10px;overflow:hidden;">
          <div class="dpi-rp__spin-progress-bar"
            style="width:0%;height:100%;background:#1a3a4a;transition:width 0.1s;"></div>
        </div>
      `;

      const dragLabel = document.createElement('div');
      dragLabel.className = 'dpi-rp__drag-label';
      dragLabel.textContent = 'Drag to Spin';

      host.style.position = 'relative';
      host.append(canvas, loader, dragLabel);

      const ctx = canvas.getContext('2d');
      if (!ctx) {
        loader.style.display = 'none';
        return;
      }

      // 在当前实例内查找，不依赖重复 ID 或 DOM 是否已插入页面
      const progressText = loader.querySelector('.dpi-rp__spin-progress-text');
      const progressBar = loader.querySelector('.dpi-rp__spin-progress-bar');
      const controller = new AbortController();
      const imgs = new Array(totalFrames);

      let disposed = false;
      let rafId = null;
      let loaderTimer = null;
      let loadedCount = 0;
      let isReady = false;
      let firstFrameShown = false;
      let currentFrameFloat = 0;
      let lastRenderedFrame = -1;
      let lastAnimationTime = 0;
      let isDragging = false;
      let isMouseOver = false;
      let startX = 0;
      let startFrameFloat = 0;
      let trackX = 0;
      let trackTime = 0;
      let finalVelocity = 0;
      let inertiaSpeed = 0;

      function listen(target, type, handler, options = {}) {
        target.addEventListener(type, handler, {
          ...options,
          signal: controller.signal
        });
      }

      function cleanup() {
        if (disposed) return;
        disposed = true;
        isReady = false;
        isDragging = false;

        if (rafId !== null) cancelAnimationFrame(rafId);
        if (loaderTimer !== null) clearTimeout(loaderTimer);

        controller.abort();

        for (const img of imgs) {
          if (!img) continue;
          img.onload = null;
          img.onerror = null;
          // 不承诺取消已经发出的网络请求，但不再保留旧回调
          img.removeAttribute('src');
        }
        imgs.length = 0;

        // 释放旧 Canvas 的绘图缓冲
        canvas.width = 1;
        canvas.height = 1;

        spinCleanups.delete(cleanup);
      }

      spinCleanups.add(cleanup);

      function clampFrame(value) {
        return (value % totalFrames + totalFrames) % totalFrames;
      }

      function renderFrame(value) {
        if (disposed) return;

        // 取整后再取模，避免末帧四舍五入到 totalFrames
        const frame = Math.round(clampFrame(value)) % totalFrames;
        if (frame === lastRenderedFrame) return;

        const img = imgs[frame];
        if (!img || !img.complete || img.naturalWidth <= 0) return;

        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        lastRenderedFrame = frame;
      }

      function showInitialFrame(index) {
        const img = imgs[index];
        if (!img || img.naturalWidth <= 0) return;

        canvas.width = img.naturalWidth;
        canvas.height = img.naturalHeight;
        currentFrameFloat = index;
        lastRenderedFrame = -1;
        renderFrame(index);
        firstFrameShown = true;
      }

      function onFrameSettled() {
        if (disposed) return;

        loadedCount++;
        const percentage = Math.floor(loadedCount / totalFrames * 100);
        progressText.textContent = percentage + '%';
        progressBar.style.width = percentage + '%';

        if (loadedCount !== totalFrames) return;

        if (!firstFrameShown) {
          const fallbackIndex = imgs.findIndex(
            img => img && img.complete && img.naturalWidth > 0
          );
          if (fallbackIndex >= 0) showInitialFrame(fallbackIndex);
        }

        isReady = imgs.some(
          img => img && img.complete && img.naturalWidth > 0
        );

        if (!isReady) {
          progressText.textContent = 'Unable to load spin';
          dragLabel.style.display = 'none';
          return;
        }

        loader.style.opacity = '0';
        loaderTimer = setTimeout(() => {
          if (!disposed) loader.style.display = 'none';
        }, 300);

        rafId = requestAnimationFrame(animate);
      }

      function animate(now) {
        if (disposed) return;

        // 额外兜底：节点被其他逻辑移除时也停止实例
        if (!section.isConnected || !canvas.isConnected) {
          cleanup();
          return;
        }

        if (!lastAnimationTime) lastAnimationTime = now;
        const deltaTime = Math.min(
          Math.max((now - lastAnimationTime) / 16.667, 0),
          2
        );
        lastAnimationTime = now;

        if (!document.hidden && !isDragging && isReady) {
          if (inertiaSpeed !== 0) {
            currentFrameFloat -= inertiaSpeed * deltaTime;
            inertiaSpeed *= Math.pow(friction, deltaTime);

            if (mobile) {
              if (
                (inertiaSpeed < 0 && -inertiaSpeed <= autoPlaySpeed) ||
                (inertiaSpeed >= 0 && inertiaSpeed <= 0.15)
              ) inertiaSpeed = 0;
            } else if (Math.abs(inertiaSpeed) < 0.02) {
              inertiaSpeed = 0;
            }
          }

          if (inertiaSpeed === 0 && !isMouseOver) {
            currentFrameFloat += autoPlaySpeed * deltaTime;
          }

          currentFrameFloat = clampFrame(currentFrameFloat);
          renderFrame(currentFrameFloat);
        }

        rafId = requestAnimationFrame(animate);
      }

      function handleStart(event) {
        if (disposed || !isReady) return;

        isDragging = true;
        inertiaSpeed = 0;
        finalVelocity = 0;
        dragLabel.style.opacity = '0';
        canvas.style.cursor = 'grabbing';

        const clientX = event.clientX ?? event.touches?.[0]?.clientX ?? 0;
        startX = clientX;
        startFrameFloat = currentFrameFloat;
        trackX = clientX;
        trackTime = performance.now();
      }

      function handleMove(event) {
        if (disposed || !isDragging) return;
        if (event.cancelable) event.preventDefault();

        const clientX = event.clientX ?? event.touches?.[0]?.clientX ?? 0;
        const now = performance.now();

        currentFrameFloat = clampFrame(
          startFrameFloat - (clientX - startX) / sensitivity
        );
        renderFrame(currentFrameFloat);

        const dt = now - trackTime;
        if (dt > 0) {
          const velocity = (clientX - trackX) / dt;
          finalVelocity = mobile
            ? velocity
            : finalVelocity * 0.75 + velocity * 0.25;
          trackX = clientX;
          trackTime = now;
        }
      }

      function handleEnd() {
        if (disposed || !isDragging) return;

        isDragging = false;
        canvas.style.cursor = 'grab';
        inertiaSpeed = Math.max(
          -maxInertia,
          Math.min(maxInertia, finalVelocity * speedBoost)
        );
        finalVelocity = 0;
      }

      listen(canvas, 'mousedown', handleStart);
      listen(window, 'mousemove', handleMove);
      listen(window, 'mouseup', handleEnd);

      listen(host, 'mouseenter', () => {
        isMouseOver = true;
      });
      listen(host, 'mouseleave', () => {
        isMouseOver = false;
        dragLabel.style.opacity = '1';
        handleEnd();
      });

      listen(canvas, 'touchstart', event => {
        isMouseOver = true;
        handleStart(event);
        if (mobile) event.stopPropagation();
      }, { passive: false });

      listen(canvas, 'touchmove', event => {
        handleMove(event);
        if (mobile) event.stopPropagation();
      }, { passive: false });

      function handleTouchEnd(event) {
        isMouseOver = false;
        handleEnd();
        if (mobile) event.stopPropagation();
      }

      listen(canvas, 'touchend', handleTouchEnd, { passive: false });
      listen(canvas, 'touchcancel', handleTouchEnd, { passive: false });
      listen(window, 'touchend', handleTouchEnd);
      listen(window, 'touchcancel', handleTouchEnd);

      for (let index = 0; index < totalFrames; index++) {
        const img = new Image();
        imgs[index] = img;

        img.onload = () => {
          if (disposed) return;
          if (index === 0 && !firstFrameShown) showInitialFrame(0);
          onFrameSettled();
        };
        img.onerror = () => {
          if (!disposed) onFrameSettled();
        };

        img.src = media.url + media.imageName +
          (index + 1) + '.' + media.imageSuffix;
      }
    }

    //end3D旋转重构
    // 状态
    let apiData          = null;   // 完整 API 响应 product 对象
    let productSkuList   = [];
    let specTrees        = [];
    let defaultMedias    = [];
    let selectedSpecs    = {};     // { specId: specValueId }
    let currentProductData = null;
  /** 移动端轮播***/
    function initMobileCarousel(medias){
      const oldMain=section.querySelector('.dpi-rp__carousel-main');
      const oldThumbs=section.querySelector('.dpi-rp__carousel-thumbs');
      if(oldMain)oldMain.remove();
      if(oldThumbs)oldThumbs.remove();
      const oldDropdown=document.querySelector('.dpi-rp__shape-dropdown');
      if(oldDropdown)oldDropdown.remove();


      const mediaEl=section.querySelector('.dpi-rp__media');
      const grid=section.querySelector('.dpi-rp__media-grid');

      const main=document.createElement('div');
      main.className='dpi-rp__carousel-main';
      const track=document.createElement('div');
      track.className='dpi-rp__carousel-track';
      main.appendChild(track);

      const thumbsBar=document.createElement('div');
      thumbsBar.className='dpi-rp__carousel-thumbs';

      let currentIndex=0;

      medias.forEach((media,i)=>{
        const slide=document.createElement('div');
        slide.className='dpi-rp__carousel-slide';

        // ── 主图 slide 按 mediaType ──
        switch(media.mediaType){
          case 2:{ // 视频
            const video=document.createElement('video');
            video.src=media.url;
            video.poster=media.previewImage||'';
            video.muted=true;video.loop=true;video.playsInline=true;video.autoplay=true;
            slide.appendChild(video);
            break;
          }
          case 3:{ // 3D 模型
            const img=document.createElement('img');
            img.src=media.previewImage||'';
            img.alt='3D Model';
            img.loading='lazy';
            const badge=document.createElement('div');
            badge.className='dpi-rp__media-badge-3d';
            badge.textContent='3D';
            slide.style.position='relative';
            slide.appendChild(img);
            slide.appendChild(badge);
            slide.addEventListener('click',()=>openModelModal(media.url));
            break;
          }
          case 4: {
            mountSpin(slide, media, {
              sensitivity: 8.0,
              autoPlaySpeed: 0.3,
              friction: 0.985,
              speedBoost: 15.0,
              maxInertia: 5.0,
              mobile: true
            });
            break;
          }

          case 5:{ // Skin Tone
            const dataEl=section.querySelector(`#dpi-rp-skin-tone-data-${sid}`);
            const imgMediumSrc=dataEl?.dataset.imgMedium||'';
            const img=document.createElement('img');
            img.src=imgMediumSrc;
            img.alt='Skin tone';
            img.loading='lazy';
            slide.appendChild(img);
            break;
          }
          case 6: {
            const pairings = buildPairings(media);
            if (pairings) slide.appendChild(pairings);
            break;
          }
          default:{ // 普通图片 (mediaType===1)
            const img=document.createElement('img');
            img.src=media.url;
            img.alt='';
            img.loading=i===0?'eager':'lazy';
            slide.addEventListener('click',()=>openLightbox(media.url));
            slide.appendChild(img);
          }
        }
        track.appendChild(slide);

        // ── 缩略图 按 mediaType 取预览图 ──
        const thumb=document.createElement('div');
        thumb.className='dpi-rp__carousel-thumb'+(i===0?' active':'');

        const tImg=document.createElement('img');
        tImg.alt='';
        tImg.loading='lazy';

        switch(media.mediaType){
          case 2: // 视频：用 poster
            tImg.src=media.previewImage||'';
            break;
          case 3: // 3D 模型：用 previewImage
            tImg.src=media.previewImage||'';
            break;
          case 4: // Spin：用第一帧
            tImg.src=(media.url||'')+(media.imageName||'')+'1.'+(media.imageSuffix||'jpg');
            break;
          case 5: // Skin tone：用 medium 图
            const dataEl=section.querySelector(`#dpi-rp-skin-tone-data-${sid}`);
            tImg.src=dataEl?.dataset.imgMedium||'';
            break;
          case 6: {
              const firstImage = getPairingResources(media)
                .find(resource => !resource.isVideo);
              tImg.src = firstImage?.url || '';
              tImg.alt = 'Popular Pairings';
              break;
            }

          default: // 图片
            tImg.src=media.url||'';
        }

        thumb.appendChild(tImg);
        thumb.addEventListener('click',()=>goTo(i));
        thumbsBar.appendChild(thumb);
      });

      function goTo(idx){
        currentIndex=idx;
        track.style.transform=`translateX(-${idx*100}%)`;
        thumbsBar.querySelectorAll('.dpi-rp__carousel-thumb').forEach((t,i)=>{
          t.classList.toggle('active',i===idx);
        });
        const activeThumb=thumbsBar.children[idx];
        if(activeThumb)activeThumb.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});
      }

      // 触摸滑动
      let touchStartX=0,touchDeltaX=0;
      main.addEventListener('touchstart',e=>{touchStartX=e.touches[0].clientX;touchDeltaX=0},{passive:true});
      main.addEventListener('touchmove',e=>{touchDeltaX=e.touches[0].clientX-touchStartX},{passive:true});
      main.addEventListener('touchend',()=>{
        if(Math.abs(touchDeltaX)>40){
          const dir=touchDeltaX<0?1:-1;
          const next=Math.max(0,Math.min(medias.length-1,currentIndex+dir));
          goTo(next);
        }
      });

      // 缩略图横向触摸滑动
      let thumbTouchStartX=0;
      let thumbScrollStart=0;
      let thumbIsDragging=false;

      thumbsBar.addEventListener('touchstart',e=>{
        thumbTouchStartX=e.touches[0].clientX;
        thumbScrollStart=thumbsBar.scrollLeft;
        thumbIsDragging=true;
      },{passive:true});

      thumbsBar.addEventListener('touchmove',e=>{
        if(!thumbIsDragging)return;
        const dx=thumbTouchStartX-e.touches[0].clientX;
        thumbsBar.scrollLeft=thumbScrollStart+dx;
      },{passive:true});

      thumbsBar.addEventListener('touchend',()=>{
        thumbIsDragging=false;
      },{passive:true});

      // 鼠标拖拽（桌面调试用）
      let mouseDown=false;
      let mouseStartX=0;
      let mouseScrollStart=0;

      thumbsBar.addEventListener('mousedown',e=>{
        mouseDown=true;
        mouseStartX=e.clientX;
        mouseScrollStart=thumbsBar.scrollLeft;
        thumbsBar.style.cursor='grabbing';
        e.preventDefault();
      });
      thumbsBar.addEventListener('mousemove',e=>{
        if(!mouseDown)return;
        const dx=mouseStartX-e.clientX;
        thumbsBar.scrollLeft=mouseScrollStart+dx;
      });
      thumbsBar.addEventListener('mouseup',()=>{
        mouseDown=false;
        thumbsBar.style.cursor='';
      });
      thumbsBar.addEventListener('mouseleave',()=>{
        mouseDown=false;
        thumbsBar.style.cursor='';
      });
    // end缩略图横向触摸滑动
      // ── Diamond Shape 覆盖层 ──
      const shapeSpec = specTrees.find(spec =>
        spec.specName && spec.specName.toLowerCase().includes('diamond shape')
      );

      if(shapeSpec && shapeSpec.specValues && shapeSpec.specValues.length > 0){

        // 找到主图 slide（第一张）
        const firstSlide = track.children[0];
        if(firstSlide){
          firstSlide.style.position = 'relative';

          // 当前选中值
          let currentShapeId = selectedSpecs[shapeSpec.specId] || shapeSpec.specValues[0].specValueId;
          let currentShapeVal = shapeSpec.specValues.find(v => v.specValueId === currentShapeId) || shapeSpec.specValues[0];

          // 构建覆盖层
          const overlay = document.createElement('div');
          overlay.className = 'dpi-rp__shape-overlay';

          const label = document.createElement('span');
          label.className = 'dpi-rp__shape-overlay-label';
          label.textContent = 'Shown with 1 ct';

          const selectWrap = document.createElement('div');
          selectWrap.className = 'dpi-rp__shape-overlay-select';

          const shapeImg = document.createElement('img');
          shapeImg.className = 'dpi-rp__shape-overlay-img';
          shapeImg.src = currentShapeVal.optionImage || '';
          shapeImg.alt = currentShapeVal.specValue;

          const shapeName = document.createElement('span');
          shapeName.className = 'dpi-rp__shape-overlay-name';
          shapeName.textContent = currentShapeVal.specValue;

          const arrow = document.createElement('span');
          arrow.className = 'dpi-rp__shape-overlay-arrow';
          arrow.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" class="icon" style="max-width: inherit;"> <path d="M20 8.5 12.5 16 5 8.5" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg>';

          // 下拉面板
          const dropdown=document.createElement('div');
          dropdown.className='dpi-rp__shape-dropdown';
          document.body.appendChild(dropdown);  // ← 改挂到 body


          shapeSpec.specValues.forEach(val => {
            const item = document.createElement('div');
            item.className = 'dpi-rp__shape-dropdown-item' + (val.specValueId === currentShapeId ? ' active' : '');
            item.dataset.specValueId = val.specValueId;

            if(val.optionImage){
              const img = document.createElement('img');
              img.src = val.optionImage;
              img.alt = val.specValue;
              item.appendChild(img);
            }
            const lbl = document.createElement('span');
            lbl.textContent = val.specValue;
            item.appendChild(lbl);

            item.addEventListener('click', e => {
              e.stopPropagation();

              // 更新当前选中
              currentShapeId = val.specValueId;
              currentShapeVal = val;

              // 更新覆盖层显示
              shapeImg.src = val.optionImage || '';
              shapeImg.alt = val.specValue;
              shapeName.textContent = val.specValue;

              // 同步 selectedSpecs
              selectedSpecs[shapeSpec.specId] = val.specValueId;

              // 同步桌面端 spec-selected-val
              const specGroups = specsEl.querySelectorAll('.dpi-rp__spec-group');
              specGroups.forEach(group => {
                const btns = group.querySelectorAll(`[data-spec-id="${shapeSpec.specId}"]`);
                if(btns.length > 0){
                  btns.forEach(b => b.classList.remove('selected'));
                  const targetBtn = group.querySelector(`[data-spec-id="${shapeSpec.specId}"][data-spec-value-id="${val.specValueId}"]`);
                  if(targetBtn) targetBtn.classList.add('selected');
                  const selectedValEl = group.querySelector('.dpi-rp__spec-selected-val');
                  if(selectedValEl) selectedValEl.textContent = val.specValue;
                }
              });

              // 触发 onSpecChange 更新价格/媒体
              onSpecChange();

              // 更新下拉 active 状态
              dropdown.querySelectorAll('.dpi-rp__shape-dropdown-item').forEach(it => {
                it.classList.toggle('active', it.dataset.specValueId === String(val.specValueId));
              });

              // 关闭下拉
              dropdown.classList.remove('open');
            });

            dropdown.appendChild(item);
          });

          function positionDropdown(){
            const rect=selectWrap.getBoundingClientRect();
            dropdown.style.position='fixed';
            dropdown.style.top=(rect.bottom+8)+'px';
            dropdown.style.left=(rect.left+rect.width/2)+'px';
            dropdown.style.transform='translateX(-50%)';
            dropdown.style.zIndex='99999';
          }
          // 滚动时实时更新位置
            function onScroll(){
              if(dropdown.classList.contains('open')){
                positionDropdown();
              }
            }

            // 监听所有可能的滚动容器
            window.addEventListener('scroll',onScroll,true);  // true = capture，捕获所有层级的滚动

            // 下拉关闭时移除监听，防止内存泄漏
            function closeDropdown(){
              dropdown.classList.remove('open');
            }

            selectWrap.addEventListener('click',e=>{
              e.stopPropagation();
              if(dropdown.classList.contains('open')){
                closeDropdown();
              }else{
                positionDropdown();
                dropdown.classList.add('open');
              }
            });

            document.addEventListener('click',closeDropdown);

          selectWrap.appendChild(shapeImg);
          selectWrap.appendChild(shapeName);
          selectWrap.appendChild(arrow);
          //selectWrap.appendChild(dropdown);
          overlay.appendChild(label);
          overlay.appendChild(selectWrap);
          firstSlide.appendChild(overlay);
        }
      }
// ── end Diamond Shape 覆盖层 ──

      mediaEl.insertBefore(main,grid);
      mediaEl.insertBefore(thumbsBar,grid);
    }

/** end 移动端轮播***/


    const shipDays = parseInt(section.querySelector('.dpi-rp__ship-date')?.dataset.shipDays || '10',10);

    // 计算发货日期
    function renderShipDate() {
      if (!shipDateEl) return;
      const d = new Date();
      d.setDate(d.getDate() + shipDays);
      shipDateEl.textContent = d.toLocaleDateString('en-US', {
        month: 'long', day: 'numeric', year: 'numeric'
      });
    }
    renderShipDate();

    // 刻字 checkbox 显示/隐藏
      const engravingCheckbox=section.querySelector(`#dpi-rp-engraving-${sid}`);
      const engravingWrapper=engravingCheckbox?.closest('.dpi-rp__addon-item')?.parentElement?.querySelector('.input-wrapper');

      if(engravingCheckbox&&engravingWrapper){
        engravingCheckbox.addEventListener('change',()=>{
          engravingWrapper.style.display=engravingCheckbox.checked?'block':'none';
          if(!engravingCheckbox.checked){
            // 取消勾选时清空输入
            const input=engravingWrapper.querySelector('input[name="properties-option-engraving"]');
