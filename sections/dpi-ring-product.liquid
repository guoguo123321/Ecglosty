{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_id = product.id
  assign shop_domain = section.settings.shop_domain | default: shop.permanent_domain
  assign api_endpoint = section.settings.api_endpoint
  assign product_handle = product.handle
  assign rp_title_font = section.settings.rp_title_font
  assign rp_title_weight = section.settings.rp_title_weight
  assign rp_title_variant = rp_title_font | font_modify: 'weight', rp_title_weight
  assign rp_title_font = rp_title_variant | default: rp_title_font
-%}
<style>
    {% unless section.settings.rp_title_use_original_font %}
      {{ rp_title_font | font_face: font_display: 'swap' }}
    {% endunless %}
      :root {
        --vertical_gap: {{ section.settings.option_vertical_gap | default: 15 }}px;
        --horizontal_gap: {{ section.settings.option_horizontal_gap | default: 8 }}px;
        --spec_vertical_gap: {{ section.settings.spec_option_vertical_gap | default: 15 }}px;
        --spec_horizontal_gap: {{ section.settings.spec_option_horizontal_gap | default: 8 }}px;
      }
</style>
 
<div
  class="dpi-rp"
  id="dpi-rp-{{ section.id }}"
  data-product-id="{{ product_id }}"
  data-handle="{{ product_handle }}"
  data-shop-domain="{{ shop_domain }}"
  data-api-endpoint="{{ api_endpoint }}"
  data-section-id="{{ section.id }}"
>
  {%- comment -%} ── 左侧媒体区 ── {%- endcomment -%}
  <div class="dpi-rp__media">
    <div class="dpi-rp__media-grid" id="dpi-rp-media-grid-{{ section.id }}">
      <div class="dpi-rp__media-placeholder">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="eager">
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Lightbox {%- endcomment -%}
    <div class="dpi-rp__lightbox" id="dpi-rp-lightbox-{{ section.id }}">
      <div class="dpi-rp__lightbox-overlay" id="dpi-rp-lightbox-overlay-{{ section.id }}"></div>
      <div class="dpi-rp__lightbox-inner">
        <button class="dpi-rp__lightbox-close" id="dpi-rp-lightbox-close-{{ section.id }}" aria-label="Close">&#x2715;</button>
        <img src="" alt="" id="dpi-rp-lightbox-img-{{ section.id }}">
      </div>
    </div>

    {%- comment -%} 3D Model Modal {%- endcomment -%}
    <div class="dpi-rp__model-modal" id="dpi-rp-model-modal-{{ section.id }}">
      <div class="dpi-rp__model-overlay" id="dpi-rp-model-overlay-{{ section.id }}"></div>
      <div class="dpi-rp__model-inner">
        <button class="dpi-rp__model-close" id="dpi-rp-model-close-{{ section.id }}" aria-label="Close">&#x2715;</button>
        <model-viewer
          id="dpi-rp-model-viewer-{{ section.id }}"
          camera-controls
          auto-rotate
          ar
          style="width:100%;height:100%;background:#f5f5f5;"
        ></model-viewer>
      </div>
    </div>
  </div>

  {%- comment -%} ── 右侧信息区 ── {%- endcomment -%}
  <div class="dpi-rp__info">
    {%- comment -%} 顶部标签 {%- endcomment -%}
    <div class="dpi-rp__info-top">
      <span class="dpi-rp__collection-label">SIGNATURE COLLECTIONS</span>
      
    </div>
    <div class="dpi-rp__header-row">
      {%- comment -%} 商品标题 {%- endcomment -%}
      <h1 class="dpi-rp__title">{{ product.title | escape }}</h1>

      {%- comment -%} 价格区 {%- endcomment -%}
      <div class="dpi-rp__price-row">
        <span class="dpi-rp__price" id="dpi-rp-price-{{ section.id }}">
          {{ current_variant.price | money }}
        </span>
        <span class="dpi-rp__price-label" id="dpi-rp__price-label" style="display:none;">(Setting Only)</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="dpi-rp__compare-price" id="dpi-rp-compare-price-{{ section.id }}">
            {{ current_variant.compare_at_price | money }}
          </span>
        {%- else -%}
          <span class="dpi-rp__compare-price" id="dpi-rp-compare-price-{{ section.id }}" style="display:none;"></span>
        {%- endif -%}
      </div>

      {%- comment -%} 评分 {%- endcomment -%}
      <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">{{ product.metafields.judgeme.badge }}</div>
    </div>
    <div class="dpi-rp__info_gap">
      {%- comment -%} SKU 选择器（由 JS 动态渲染） {%- endcomment -%}
      <div class="dpi-rp__specs" id="dpi-rp-specs-{{ section.id }}">
        <div class="dpi-rp__specs-loading">Loading options…</div>
      </div>

      {%- comment -%} 隐藏 variant input {%- endcomment -%}
      <input type="hidden" id="dpi-rp-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

      {%- comment -%} Shopify variants JSON {%- endcomment -%}
      <script id="dpi-rp-variants-json-{{ section.id }}" type="application/json">
        {{ product.variants | json }}
      </script>
      <script id="dpi-rp-options-json-{{ section.id }}" type="application/json">
        {{ product.options_with_values | json }}
      </script>
      {%- comment -%} 操作按钮 {%- endcomment -%}
      <div class="dpi-rp__actions">
        {% comment %} 红框区域：默认显示 {% endcomment %}
        <div class="dpi-rp__purchase-panel" id="dpi-rp-purchase-panel-{{ section.id }}">
          {% comment %} Browse All Diamonds 按钮 {% endcomment %}
          <button class="dpi-rp__btn-browse-diamonds" 
                  id="dpi-rp-browse-btn-{{ section.id }}" 
                  type="button">
            Browse All Diamonds
          </button> 
          {%- comment -%} Browse All Diamonds 点击后显示的说明文案（默认隐藏，可在 section settings 配置） {%- endcomment -%}
          <p class="dpi-rp__browse-desc" id="dpi-rp-browse-desc-{{ section.id }}" style="display:none;">
            {% if section.settings.browse_diamonds_desc !=blank %}
              {{ section.settings.browse_diamonds_desc }}
            {% endif %}
          </p>

          {% comment %} Ring Size 选择器 {% endcomment %}
          <div class="dpi-rp__ring-size-group" id="dpi-rp-ring-size-{{ section.id }}">
            <div class="dpi-rp__ring-size-header">
              <span class="dpi-rp__ring-size-label">Choose Your Ring Size</span>
              <a href="#" class="dpi-rp__size-guide-link" id="dpi-rp-size-guide-{{ section.id }}">Size guide</a>
            </div>
            <div class="dpi-rp__ring-size-options" id="dpi-rp-ring-size-options-{{ section.id }}">
              {% comment %} 由 JS 动态渲染 {% endcomment %}
            </div>
          </div>

          {% comment %} Add-ons {% endcomment %}
          <div class="dpi-rp__addons">
            <div id="dpi-rp__addons-engraving-{{ section.id }}">
              <label class="dpi-rp__addon-item">
                <input type="checkbox" id="dpi-rp-engraving-{{ section.id }}">
                <span>Add Engraving (Optional)</span>
              </label>
              <div class="input-wrapper" style="display:none">
                <input type="text" class="field__input" name="properties-option-engraving" value="" placeholder="Enter your engraving text" autocomplete="off" style="width: 100%;">
              </div>
            </div>
      
            {% comment %}
              <label class="dpi-rp__addon-item">
                <input type="checkbox" id="dpi-rp-matching-band-{{ section.id }}">
                <span>Add Matching Band</span>
              </label>
            </div> {% endcomment %}
            {%- comment -%} 默认隐藏的 CHOOSE THIS SETTING 按钮  {%- endcomment -%}
            <button class="dpi-rp__btn-primary dpi-rp__btn--choose-setting" 
                    id="dpi-rp-choose-btn-{{ section.id }}" 
                    type="button" 
                    style="display:none;">
              CHOOSE THIS SETTING
            </button>
            {% comment %} {{- comment -}} ADD TO BAG 按钮 {{- endcomment -}} {% endcomment %}
            <button class="dpi-rp__btn-add-to-bag" 
                    id="dpi-rp-add-to-bag-{{ section.id }}" 
                    type="button">
              ADD TO BAG
            </button>
          </div>

          <button class="dpi-rp__btn-secondary" id="dpi-rp-wishlist-btn-{{ section.id }}" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            ADD TO WISHLIST
          </button>
        </div>
        {%- comment -%} 发货日期 {%- endcomment -%}
        {% comment %} <p class="dpi-rp__ship-date"
          data-ship-days="{{ section.settings.ship_days | default: 10 }}">
          {{ section.settings.ship_text | default: 'Order now and your order ships by' }}
          <strong id="dpi-rp-ship-date-{{ section.id }}"></strong>
        </p> {% endcomment %}

        {%- comment -%} 物流保障 / 区块化子组件渲染 - 按 section.blocks 顺序遍历,block 拖到哪里就在 dpi-rp__info 内哪渲染 {%- endcomment -%}
        <div class="dpi_acc_inner">
        {%- assign dpi_acc_open = false -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'product-order-details' -%}
              {%- render 'product-order-details', block: block -%}
            {%- when 'product-shipping' -%}
              {%- render 'product-shipping', block: block -%}
            {%- when 'fold' -%}
              {%- render 'fold', block: block -%}
            {%- when 'product-sharing' -%}
              {%- render 'product-sharing', block: block -%}
            {%- when 'block-service' -%}
              {%- render 'block-service', block: block -%}
            {%- when 'dpi-ring-accordion-item' -%}
              {%- if dpi_acc_open == false -%}
                <div class="dpi-rp__accordion-wrap">
                  <div
                    class="accordion accordion--{{ section.id }} accordion--plus accordion--dividers"
                    style="
                      --summary-font-family: var(--font-h6--family);
                      --summary-font-style: var(--font-h6--style);
                      --summary-font-weight: var(--font-h6--weight);
                      --summary-font-size: var(--font-h6--size);
                      --summary-font-line-height: var(--font-h6--line-height);
                      --summary-font-case: var(--font-h6--case);
                      --border-width: 1px;
                      --border-style: solid;
                      --color-border: rgba(var(--color-foreground-rgb), 0.15);
                      --padding-block-start: 14px;
                      --padding-block-end: 14px;
                    "
                  >
                    {%- assign dpi_acc_open = true -%}
              {%- endif -%}
              {%- render 'dpi-ring-accordion-item', block: block -%}
          {%- endcase -%}
        {%- endfor -%}
              {%- if dpi_acc_open == true -%}
                      </div>
                  </div>
         {%- endif -%}
        </div>
      </div>
    
    {%- comment -%} Size Guide 弹窗 {%- endcomment -%}
    <div class="dpi-rp__size-guide-modal" id="dpi-rp-size-guide-modal-{{ section.id }}">
      <div class="dpi-rp__size-guide-overlay" id="dpi-rp-size-guide-overlay-{{ section.id }}"></div>
        <div class="dpi-rp__size-guide-inner">
          <div class="dpi-rp__size-guide-header">
            <span class="dpi-rp__size-guide-title">Ring Size Guide</span>
            <button class="dpi-rp__size-guide-close" 
                    id="dpi-rp-size-guide-close-{{ section.id }}" 
                    aria-label="Close">&#x2715;</button>
          </div>
          <div class="dpi-rp__size-guide-body">
          {%- if section.settings.size_guide_page != blank -%}
            {%- assign size_guide_page = pages[section.settings.size_guide_page] -%}
            {{ size_guide_page.content }}
          {%- else -%}
            <p style="color:#aaa;text-align:center;padding:40px 0;">
              Please select a page in theme settings to display size guide content.
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>
    {%- comment -%} end Size Guide 弹窗 {%- endcomment -%}

  </div>{%- comment -%} /.dpi-rp__info {%- endcomment -%}
    {%- for block in section.blocks -%}
    {%- if block.type == 'skin-tone' -%}
      <div
        id="dpi-rp-skin-tone-data-{{ section.id }}"
        style="display:none;"
        data-img-dark="{{ block.settings.img_dark | image_url: width: 800 }}"
        data-img-medium="{{ block.settings.img_medium | image_url: width: 800 }}"
        data-img-light="{{ block.settings.img_light | image_url: width: 800 }}"
        {{ block.shopify_attributes }}
      ></div>
    {%- endif -%}
  {%- endfor -%}

</div>

{% stylesheet %}
/* ── Root & Layout ── */
.dpi-rp {
  display: grid;
  grid-template-columns: 1.54686fr 1fr;
  gap: 40px;
  max-width: 1400px;
  margin: 0 auto;
  padding: 32px 0px;
  font-family: var(--font-body-family, 'Helvetica Neue', sans-serif);
  color: #1a1a1a;
}
@media(max-width:900px){
  .dpi-rp{
    grid-template-columns:1fr;
    gap:24px;
    padding:16px;
    overflow:hidden; /* 防止子元素撑开整页 */
    max-width:100vw;
  }
  .dpi-rp__media{
    overflow:hidden;
    width:100%;
    max-width:100%;
  }

  /* 移动端轮播容器 */
  .dpi-rp__media-grid{
    display:flex;
    flex-direction:column;
    gap:0;
  }

  /* 主图区 */
  .dpi-rp__carousel-main{
    position:relative;
    width:100%;
    overflow:hidden;
    background:#fff;
  }
  .dpi-rp__carousel-track{
    display:flex;
    transition:transform 0.35s cubic-bezier(0.4,0,0.2,1);
    will-change:transform;
  }
  .dpi-rp__carousel-slide{
    flex:0 0 100%;
    width:100%;
  }
  .dpi-rp__carousel-slide img,
  .dpi-rp__carousel-slide video,
  .dpi-rp__carousel-slide canvas{
    width:100%;
    height:auto;
    object-fit:contain;
    display:block;
  }

  /* 左右箭头（可选，截图中未见，默认隐藏） */
  .dpi-rp__carousel-prev,
  .dpi-rp__carousel-next{
    display:none;
  }

  /* 缩略图横排 */
  .dpi-rp__carousel-thumbs{
    display:flex;
    flex-direction:row;
    gap:6px;
    overflow-x:hidden; /* 隐藏滚动条，由JS控制scrollLeft */
    overflow-y:hidden;
    padding:8px 0 4px;
    scrollbar-width:none;
    cursor:grab;
    user-select:none;
    -webkit-user-select:none;
  }
  .dpi-rp__carousel-thumbs::-webkit-scrollbar{display:none}

  .dpi-rp__carousel-thumb{
    flex:0 0 60px;
    width:60px;
    height:60px;
    min-width:60px;
    border:2px solid transparent;
    cursor:pointer;
    overflow:hidden;
    background:#f5f5f5;
    box-sizing:border-box;
    flex-shrink:0;
  }

  .dpi-rp__carousel-thumb.active{
    border-bottom-color:#1a3a4a;
  }
  .dpi-rp__carousel-thumb img{
    width:100%;
    height:100%;
    object-fit:contain;
    display:block;
  }

  /* 移动端隐藏原始 grid items，由轮播接管 */
  .dpi-rp__media-grid > .dpi-rp__media-item,
  .dpi-rp__media-placeholder{
    display:none;
  }
}

/* 移动端默认显示轮播（在 @media 外，作为基础样式） */
.dpi-rp__carousel-main{ display:block; }
.dpi-rp__carousel-thumbs{ display:flex; }


/* 桌面端隐藏轮播 */
@media(min-width:901px){
  .dpi-rp__carousel-main,
  .dpi-rp__carousel-thumbs{
    display:none;
  }
  /* 桌面端恢复原始 grid items 显示 */
  .dpi-rp__media-grid > .dpi-rp__media-item,
  .dpi-rp__media-placeholder{
    display:block;
  }
}


/* ── Media Grid ── */
.dpi-rp__media { position: relative; }
.dpi-rp__media-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}
.dpi-rp__media-placeholder img {
  width: 100%; height: 100%; object-fit: contain; display: block;
}

/* Media items */
.dpi-rp__media-item {
  position: relative;
  overflow: hidden;
  background: #fff;
}
.dpi-rp__media-item--square {
  aspect-ratio: unset;
}
.dpi-rp__media-item--portrait {
  aspect-ratio: unset;
}
.dpi-rp__media-item img,
.dpi-rp__media-item video,
.dpi-rp__media-item canvas {
  width: 100%; height: auto; object-fit: contain; display: block;
}
.dpi-rp__media-item--clickable { cursor: zoom-in; }
.dpi-rp__media-label {
  position: absolute;
  bottom: 8px; left: 0; right: 0;
  text-align: center;
  font-size: 11px;
  color: #111;
  padding: 4px 8px;
}
.dpi-rp__media-badge-3d {
  position: absolute;
  top: 8px; right: 8px;
  background: rgba(0,0,0,0.65);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 3px 7px;
  border-radius: 4px;
  cursor: pointer;
  z-index: 2;
}
.dpi-rp__spin-loader {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* background: rgba(248,248,248,0); */
  font-size: 13px;
  color: #555;
  transition: opacity 0.3s;
  z-index: 3;
}
.dpi-rp__drag-label {
  position: absolute;
  bottom: 12px; left: 50%;
  transform: translateX(-50%);
  font-size: 12px;
  color: #888;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 2;
}

/* ── Lightbox ── */
.dpi-rp__lightbox {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9999;
  align-items: center;
  justify-content: center;
}
.dpi-rp__lightbox.open { display: flex; }
.dpi-rp__lightbox-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.85);
}
.dpi-rp__lightbox-inner {
  position: relative;
  z-index: 1;
  max-width: 90vw;
  max-height: 90vh;
}
.dpi-rp__lightbox-inner img {
  max-width: 90vw;
  max-height: 85vh;
  object-fit: contain;
  display: block;
}
.dpi-rp__lightbox-close {
  position: absolute;
  top: -40px; right: 0;
  background: none;
  border: none;
  color: #fff;
  font-size: 24px;
  cursor: pointer;
  line-height: 1;
}

/* ── 3D Modal ── */
.dpi-rp__model-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9999;
  align-items: center;
  justify-content: center;
}
.dpi-rp__model-modal.open { display: flex; }
.dpi-rp__model-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.75);
}
.dpi-rp__model-inner {
  position: relative;
  z-index: 1;
  width: min(700px, 90vw);
  height: min(600px, 80vh);
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
}
.dpi-rp__model-close {
  position: absolute;
  top: 12px; right: 12px;
  background: rgba(0,0,0,0.5);
  border: none;
  color: #fff;
  font-size: 18px;
  width: 32px; height: 32px;
  border-radius: 50%;
  cursor: pointer;
  z-index: 2;
  display: flex; align-items: center; justify-content: center;
}

/* ── Info Panel ── */
.dpi-rp__info {
 
}
.dpi-rp__info .dpi-rp__info_gap{
 display: flex;
  flex-direction: column;
  gap: 20px;
}

.dpi-rp__info-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.dpi-rp__header-row{
  margin-bottom:24px;
}
.dpi-rp__collection-label {
  font-size: 11px;
  letter-spacing: 0.12em;
  color: #888;
  text-transform: uppercase;
}
.dpi-rp__igi-badge {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  font-weight: 600;
  color: #1a1a1a;
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 20px;
  padding: 4px 12px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.08);
}
#dpi-rp-{{ section.id }} .dpi-rp__title {
  {% unless section.settings.rp_title_use_original_font %}
    font-family: {{ rp_title_font.family | json }},
      {{ rp_title_font.fallback_families }};
  {% endunless %}

  {% if section.settings.rp_title_use_original_size %}
    font-size: clamp(18px, 2.2vw, 26px);
  {% else %}
    font-size: {{ section.settings.rp_title_size }}px;
  {% endif %}

  font-weight: {{ section.settings.rp_title_weight }};
  line-height: 1.3;
  margin: 0;
  color: #3f4a5c;
}

.dpi-rp__price-row {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
}
.dpi-rp__price {
  font-size: 0.875rem;

  color: var(--color, var(--color-foreground));
}
.dpi-rp__price-label {
  font-size: 13px;
  color: #888;
}
.dpi-rp__compare-price {
  font-size: 16px;
  color: #aaa;
  text-decoration: line-through;
}


/* ── Spec Selectors ── */
.dpi-rp__specs { display: flex; flex-direction: column; gap: var(--spec_vertical_gap); }
.dpi-rp__specs-loading { color: #aaa; font-size: 14px; padding: 20px 0; }
.dpi-rp__spec-group { display: flex; flex-direction: column; gap: 10px; }
.dpi-rp__spec-label {
  font-size: 13px;
 
  color: rgb(40 40 40 / 1.0);
  display: flex;
  align-items: center;
  gap: 6px;
}
.dpi-rp__spec-label span.dpi-rp__spec-selected-val {
  font-weight: 400;
  color: rgb(40 40 40 / 1.0);
}
.dpi-rp__spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spec_horizontal_gap);
}

/* Shape selector */
.dpi-rp__opt-shape {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
  cursor: pointer;
  padding: 1px;
  border: none;

  background: #fff;
  min-width: 36px;
  transition: border-color 0.2s, background 0.2s;
}
.dpi-rp__opt-shape img { width: 36px; height: 36px; object-fit: contain; border: 1px solid transparent;}
.dpi-rp__opt-shape span { font-size: 11px; color: #555; white-space: nowrap; display: none;}
.dpi-rp__opt-shape.selected img,
.dpi-rp__opt-shape:hover img{
  
  border: 1px solid #1a3a4a;
  
}

/* Metal swatch */
.dpi-rp__opt-metal {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid transparent;
  cursor: pointer;
  overflow: hidden;
  transition: border-color 0.2s;
  position: relative;
  padding: 0;          /* 清除 button 默认 padding */
  flex-shrink: 0;
  display: block;      /* 避免 inline 基线偏移 */
  box-sizing: border-box;
}
.dpi-rp__opt-metal img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 50%;  /* 双重保险：图片自身也加圆角 */
  pointer-events: none;
}
.dpi-rp__opt-metal.selected {
  border-color: #1a3a4a;
}
.dpi-rp__opt-metal:hover {
  border-color: #888;
}


/* Text pill */
.dpi-rp__opt-pill {
  padding: 7px 16px;
  border: 1.5px solid transparent;

  background: #f6f6f6;
  font-size: 13px;
  color: #333;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s, color 0.2s;
  white-space: nowrap;
}
.dpi-rp__opt-pill.selected {
  border-color: #1a3a4a;
  background: #fff;
  
}
.dpi-rp__opt-pill:hover:not(.selected) {
  border-color: #888;
}

/* Origin toggle */
.dpi-rp__opt-origin {
  padding: 7px 20px;
  border: 1.5px solid #d0d0d0;
  border-radius: 4px;
  background: #fff;
  font-size: 13px;
  color: #333;
  cursor: pointer;
  transition: all 0.2s;
}
.dpi-rp__opt-origin.selected {
  border-color: #1a3a4a;
  background: #1a3a4a;
  color: #fff;
}

/* ── Ship Date ── */
.dpi-rp__ship-date {
  font-size: 13px;
  color: #555;
  margin: 0;
}

/* ── Action Buttons ── */
.dpi-rp__actions { display: flex; flex-direction: column; gap: 10px; }
.dpi-rp__btn-primary {
  width: 100%;
  padding: 16px;
  background: #1a3a4a;
  color: #fff;
  border: none;
  
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.1em;
  cursor: pointer;
  transition: background 0.2s;
}
.dpi-rp__btn-primary:hover { background: #0f2535; }
.dpi-rp__btn-secondary {
  width: 100%;
  padding: 14px;
  background: #fff;
  color: var(--custom-font-color);
  border: 1px solid #06374C;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: border-color 0.2s;
}
.dpi-rp__btn-secondary:hover { border-color: #1a3a4a; }

/* ── Badges ── */
.dpi-rp__badges {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  padding: 16px;
  border: 1px solid #ebebeb;
  border-radius: 6px;
}
.dpi-rp__badge-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #555;
}
.dpi-rp__badge-item svg { flex-shrink: 0; color: #1a3a4a; }

/* ── Accordions ── */
/* 使用 horizon 主题原生 .accordion / .details 全局样式；此处不再覆盖 */
.dpi-rp__shipping-title { font-weight: 600; color: #1a1a1a; margin-bottom: 8px; }

.dpi-rp__btn-secondary.wishlisted {
  background: var(--button-active-bg);
    color: var(--button-active-color);
    border-color: var(--button-active-bg);
}
.dpi-rp__btn-secondary.wishlisted svg {
  fill: var(--button-active-color);
  stroke: var(--button-active-color);
}
/* ── Skin Tone Slider ── */
.dpi-rp__media-item--skin-tone {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 0;
  overflow: hidden;
  position: relative;
}

.dpi-rp__skin-images {
  position: absolute;
  inset: 0;
}

.dpi-rp__skin-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: #f5f5f5;
  transition: opacity 0.15s ease;
}

.dpi-rp__skin-diamond {
  object-fit: contain;
  background: transparent;
  z-index: 1;
  pointer-events: none;
}

/* 右侧滑块 */
.dpi-rp__skin-slider-wrap {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 66%;
  max-height:150px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 10px 6px;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(4px);
  width: 44px;
  z-index: 2;
  border-radius: 22px 0 0 22px;
}

.dpi-rp__skin-label {
  font-size: 10px;
  color: #555;
  letter-spacing: 0.03em;
  text-align: center;
  line-height: 1.2;
  white-space: nowrap;
}

.dpi-rp__skin-track {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 100%;
}

.dpi-rp__skin-range {
  -webkit-appearance: slider-vertical;
  appearance: slider-vertical;
  writing-mode: vertical-lr;
  direction: rtl;
  width: 4px;
  height: 100%;
  max-height:150px;
  flex: 1;
  cursor: pointer;
  accent-color: #1a6b5a;
  background: transparent;
}

.dpi-rp__skin-track::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 3px;
  bottom: 0;
  width: 2px;
  transform: translateX(-50%);
  background: linear-gradient(to bottom, #2c2c2c 0%, #d4a574 50%, #f5e6d3 100%);
  border-radius: 2px;
  pointer-events: none;
  z-index: -1;
}


/* ── Sold-out / Disabled States ── */
.dpi-rp__opt-pill.sold-out,
.dpi-rp__opt-shape.sold-out,
.dpi-rp__opt-metal.sold-out,
.dpi-rp__opt-origin.sold-out {
  opacity: 0.38;
  cursor: not-allowed;
  position: relative;
}
/* 划线效果（pill / origin） */
.dpi-rp__opt-pill.sold-out::after,
.dpi-rp__opt-origin.sold-out::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom right,
    transparent calc(50% - 0.5px),
    #aaa calc(50% - 0.5px),
    #aaa calc(50% + 0.5px),
    transparent calc(50% + 0.5px)
  );
  pointer-events: none;
}

.dpi-rp__btn-primary:disabled,
.dpi-rp__btn-primary.sold-out {
  background: #9aacb5;
  cursor: not-allowed;
  letter-spacing: 0.08em;
}


/* ── Purchase Panel (添加购物车区域) ── */
.dpi-rp__purchase-panel {
 
 
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Browse All Diamonds */
.dpi-rp__btn-browse-diamonds {
  width: 100%;
  max-width: 200px;
  padding: 12px 16px;
  background: #f6f6f6;
  color: #333;
  border: 1.5px solid transparent;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  text-align: center;
  transition: background 0.2s, color 0.2s;
  margin-top: -3px;
}
.dpi-rp__btn-browse-diamonds:hover {
  background: #f0f4f6;
  border: 1.5px solid #1a3a4a;
}
/* Browse All Diamonds 点击后的选中状态 */
.dpi-rp__btn-browse-diamonds.is-selected,
.dpi-rp__btn-browse-diamonds.is-selected:hover,
.dpi-rp__btn-browse-diamonds.is-selected:disabled {
  border-color: #1a3a4a;
  background: #fff;
  opacity: 1;
}


/* Ring Size */
.dpi-rp__ring-size-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.dpi-rp__ring-size-label {
  font-size: 13px;
  font-weight: 500;
  color: #1a1a1a;
}
.dpi-rp__size-guide-link {
  font-size: 12px;
  color: #1a3a4a;
  text-decoration: underline;
}
.dpi-rp__ring-size-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--horizontal_gap);
  align-items: center;
}
.dpi-rp__ring-size-btn {
  padding: 7px 14px;
  border: 1.5px solid #d0d0d0;
  background: #fff;
  font-size: 13px;
  color: #333;
  cursor: pointer;
  transition: border-color 0.2s;
  min-width: 44px;
  text-align: center;
}
.dpi-rp__ring-size-btn.selected {
  border-color: #1a3a4a;
  background: #fff;
}
.dpi-rp__ring-size-btn:hover:not(.selected) {
  border-color: #888;
}
.dpi-rp__ring-size-btn--more {
  border-color: #1a3a4a;
  color: #1a3a4a;
  font-weight: 500;
  background: #fff;
}
.dpi-rp__ring-size-btn--more:hover {
  background: #f0f4f6;
}

/* Add-ons */
.dpi-rp__addons {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.dpi-rp__addon-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: #333;
  cursor: pointer;
}
.dpi-rp__addon-item input[type="checkbox"] {
  width: 16px;
  height: 16px;
  border: 1.5px solid #ccc;
  cursor: pointer;
  accent-color: #1a3a4a;
  flex-shrink: 0;
}

/* ADD TO BAG */
.dpi-rp__btn-add-to-bag {
  width: 100%;
  padding: 16px;
  background: #1a1a1a;
  color: #fff;
  border: none;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.1em;
  cursor: pointer;
  transition: background 0.2s;
}
.dpi-rp__btn-add-to-bag:hover {
  background: #333;
}
.dpi-rp__btn-add-to-bag:disabled {
  background: #9aacb5;
  cursor: not-allowed;
}
/* ── Browse All Diamonds 说明文案 ── */
.dpi-rp__browse-desc {
  font-size: 13px;
  line-height: 1.7;
  color: #555;
  margin: 0;
  padding: 12px 0 4px;
  border-top: 1px solid #ebebeb;
}

/* ── Size Guide Modal ── */
.dpi-rp__size-guide-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 10000;
  align-items: center;
  justify-content: center;
}
.dpi-rp__size-guide-modal.open {
  display: flex;
}
.dpi-rp__size-guide-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
}
.dpi-rp__size-guide-inner {
  position: relative;
  z-index: 1;
  width: min(720px, 92vw);
  max-height: 80vh;
  background: #fff;
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.18);
}
.dpi-rp__size-guide-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 24px;
  border-bottom: 1px solid #ebebeb;
  flex-shrink: 0;
}
.dpi-rp__size-guide-title {
  font-size: 15px;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 0.04em;
}
.dpi-rp__size-guide-close {
  background: none;
  border: none;
  font-size: 20px;
  color: #888;
  cursor: pointer;
  line-height: 1;
  padding: 4px;
  transition: color 0.2s;
}
.dpi-rp__size-guide-close:hover {
  color: #1a1a1a;
}
.dpi-rp__size-guide-body {
  padding: 24px;
  overflow-y: auto;
  flex: 1;
  font-size: 14px;
  line-height: 1.8;
  color: #444;
}
/* 弹窗内 page 内容样式兼容 */
.dpi-rp__size-guide-body table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
.dpi-rp__size-guide-body th,
.dpi-rp__size-guide-body td {
  border: 1px solid #e0e0e0;
  padding: 8px 12px;
  text-align: center;
}
.dpi-rp__size-guide-body th {
  background: #f6f6f6;
  font-weight: 600;
  color: #1a1a1a;
}
/* ── end Size Guide Modal ── */

/* Diamond Shape 覆盖层 — 移动端主图底部 */
.dpi-rp__shape-overlay{
  position:absolute;
  bottom:12px;
  left:50%;
  transform:translateX(-50%);
  display:flex;
  align-items:center;
  gap:8px;
 
  white-space:nowrap;
  z-index:10;
  font-size:13px;
  color:#1a1a1a;
}
.dpi-rp__shape-overlay-label{
  font-size:12px;
  color:#555;
  white-space:nowrap;
}
.dpi-rp__shape-overlay-select{
  display:flex;
  align-items:center;
  cursor:pointer;
  position:relative;
  border: 1px rgb(192, 192, 192) solid;
  background: #ffffff;
  padding: .65em .85em;
  gap: 8px;
}
.dpi-rp__shape-overlay-img{
  width:22px !important;
  height:22px !important;
  object-fit:contain;
  flex-shrink:0;
}
.dpi-rp__shape-overlay-name{
  font-size:13px;
  font-weight:500;
  color:#1a1a1a;
}
.dpi-rp__shape-overlay-arrow{
  font-size:10px;
  color:#555;
  margin-left:2px;
}
/* 下拉面板 */
/* 下拉面板 — 向下展开，单列 */
.dpi-rp__shape-dropdown{
  display:none;
  background:#fff;
  border:1px solid #e0e0e0;
  border-radius:8px;
  box-shadow:0 4px 16px rgba(0,0,0,0.12);
  padding:4px 0;
  min-width:140px;
  max-height:260px;
  overflow-y:auto;
}

.dpi-rp__shape-dropdown.open{
  display:flex;
  flex-direction:column;  /* 单列 */
  flex-wrap:nowrap;
}

/* 每一项：横排，图标+文字左对齐 */
.dpi-rp__shape-dropdown-item{
  display:flex;
  flex-direction:row;      /* 改为横排 */
  align-items:center;
  gap:10px;
  padding:8px 16px;
  border-radius:0;
  cursor:pointer;
  width:100%;
  box-sizing:border-box;
  transition:background 0.15s;
}
.dpi-rp__shape-dropdown-item:hover{
  background:#f5f5f5;
}
.dpi-rp__shape-dropdown-item.active{
  background:#f0f4f6;
  outline:none;            /* 去掉之前的outline */
}
.dpi-rp__shape-dropdown-item img{
  width:24px;
  height:24px;
  object-fit:contain;
  flex-shrink:0;
  border-radius:50%;
 
  background:#f5f5f5;
  padding:2px;
  box-sizing:border-box;
}
.dpi-rp__shape-dropdown-item span{
  font-size:13px;
  color:#1a1a1a;
  text-align:left;
  font-weight:400;
}
.dpi-rp__shape-dropdown-item.active span{
  font-weight:500;
}

/* end Diamond Shape 覆盖层 — 移动端主图底部 */

/* ============== horizon 原生 accordion 配套样式 ============== */
.dpi-rp__accordion-wrap {
  width: 100%;
 
}
.dpi-rp__accordion-wrap .accordion {
  flex: 1;
  width: 100%;
}
/* horizon 主题的 dividers 变量是 --style-border-width-dividers(原写法里写成 --style-border-width 是错的,整条失效导致边框看不见)。这里做兜底:任意一个别名能用就行 */
.dpi-rp__accordion-wrap .accordion--dividers {
  --show-fallback-borders: 0;
  --style-border-width: var(--style-border-width-dividers, var(--border-width, 1px));
}
.dpi-rp__accordion-wrap .accordion--dividers:not([class*='color-'])[style*='--border-width: 0'],
.dpi-rp__accordion-wrap .accordion--dividers:not([class*='color-'])[style*='--border-style: none'] {
  --show-fallback-borders: 1;
}
/* 非首项加上边框 */
.dpi-rp__accordion-wrap .accordion--dividers accordion-custom .details {
  border-top: 1px solid #000000;
}
/* 最后一项加下边框 */
.dpi-rp__accordion-wrap .accordion--dividers accordion-custom:last-child .details {
  border-bottom: 1px solid #000000;
}
.dpi-rp__accordion-wrap .accordion--dividers .details-content {
  padding-bottom: var(--padding-sm);
}
.dpi-rp__accordion-wrap .accordion--caret .icon-plus,
.dpi-rp__accordion-wrap .accordion--plus .icon-caret {
  display: none;
}
.dpi-rp__accordion-wrap .accordion .details__header {
  font-family: var(--summary-font-family);
  font-style: var(--summary-font-style);
  font-weight: var(--summary-font-weight);
  font-size: 14px;
  line-height: var(--summary-font-line-height);
  text-transform: var(--summary-font-case);
  min-height: var(--minimum-touch-target);
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  padding-block: 11.2px;
  padding-block-end: 11.2px;
  list-style: none;
}
.dpi-rp__accordion-wrap .accordion .details__header::-webkit-details-marker {
  display: none;
}
.dpi-rp__accordion-wrap .accordion .details__header::marker {
  display: none;
  content: '';
}
.dpi-rp__accordion-wrap .accordion .details__header > span.svg-wrapper {
  margin-inline-start: auto;
  display: inline-flex;
  width: 14px;
  height: 14px;
}
.dpi-rp__accordion-wrap .accordion .details__header > span.svg-wrapper svg {
  width: 100%;
  height: 100%;
}
.accordion--plus .dpi-rp__accordion-header {
  display: flex;
  align-items: center;
}
.dpi-rp__accordion-wrap .accordion .details__header .dpi-rp__accordion-icon-img {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  flex-shrink: 0;
}
.dpi-rp__accordion-wrap .accordion .details__header .dpi-rp__accordion-icon-img svg,
.dpi-rp__accordion-wrap .accordion .details__header .dpi-rp__accordion-icon-img img {
  width: 32px !important;
  height: 32px !important;
  max-width: none;
  object-fit: contain;
  fill: currentColor;
  stroke: currentColor;
  flex-shrink: 0;
}
.dpi-rp__accordion-wrap .accordion .details {
  border: 0;
  width: 100%;
}
.dpi-rp__accordion-wrap .accordion .details-content {
  padding-block-end: var(--padding-md, 16px);
}
.dpi-rp__accordion-wrap .accordion .details-content > * {
  margin: 0 0 var(--padding-xs) 0;
}
.dpi-rp__accordion-wrap .accordion .details-content > *:last-child {
  margin-bottom: 0;
}

/* 画廊 */
/* mediaType 6: Popular Pairings */
.dpi-rp .dpi-rp__pairings {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding: 18px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #fafafa;
}

.dpi-rp .dpi-rp__pairings-title {
  margin: 0 0 16px;
  text-align: center;
  font-size: 14px;
  font-weight: 400;
}

.dpi-rp .dpi-rp__pairings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  width: 100%;
  
  margin: 0 auto;
}

.dpi-rp .dpi-rp__pairings-card {
  position: relative;
  display: block;
  padding: 0;
  border: 0;
  border-radius: 0;
  overflow: hidden;
  aspect-ratio: 1;
  background: #eee;
  cursor: pointer;
}

.dpi-rp .dpi-rp__pairings-card img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.dpi-rp .dpi-rp__pairings-more {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(0 0 0 / 45%);
  color: #fff;
  font-size: 14px;
  pointer-events: none;
}

/* Independent album dialog */
.dpi-rp .dpi-rp__album {
  position: fixed;
  inset: 0;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  max-width: none;
  max-height: none;
  margin: 0;
  padding: 24px;
  border: 0;
  background: transparent;
  color: #fff;
}

.dpi-rp .dpi-rp__album[open] {
  display: flex;
  align-items: center;
  justify-content: center;
}

.dpi-rp .dpi-rp__album::backdrop {
  background: rgb(0 0 0 / 78%);
}

.dpi-rp .dpi-rp__album-panel {
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: min(100%, 1000px);
