    // ── 渲染媒体 ──
        // 根据屏幕模式，仅创建当前需要的媒体
    function renderCurrentMedia() {
      if (!mediaGrid) return;

      // 先停止旧动画、解绑旧监听，再删除 DOM
      destroySpins();

      // 停止旧媒体区域里的视频
      section.querySelectorAll(
        '.dpi-rp__media-grid video, .dpi-rp__carousel-main video'
      ).forEach(video => {
        video.pause();
        video.removeAttribute('src');
        video.load();
      });

      removeMobileCarousel();
      mediaGrid.innerHTML = '';

      mediaMode = window.innerWidth <= 900 ? 'mobile' : 'desktop';

      if (!currentSortedMedias.length) {
        mediaGrid.style.display = '';
        mediaGrid.innerHTML =
          '<div style="padding:40px;color:#aaa;text-align:center;grid-column:1/-1;">No media available</div>';
        return;
      }

      if (mediaMode === 'mobile') {
        mediaGrid.style.display = 'none';
        initMobileCarousel(currentSortedMedias);
      } else {
        mediaGrid.style.display = '';

        currentSortedMedias.forEach((media, index) => {
          switch (media.mediaType) {
            case 1: renderImage(media, index);    break;
            case 2: renderVideo(media, index);    break;
            case 3: renderModel(media, index);    break;
            case 4: renderSpin(media, index);     break;
            case 5: renderSkinTone(media, index); break;
            case 6: renderPairings(media, index); break;
            default: renderImage(media, index);
          }
        });
      }

      const diamondMedia = currentSortedMedias.find(
        media => media.mediaType === 5
      );
      if (diamondMedia) injectDiamondImage(diamondMedia.url);
    }

    function populateMedia(medias) {
      currentSortedMedias = (Array.isArray(medias) ? [...medias] : [])
        .filter(media =>
          media.mediaType !== 6 ||
          getPairingResources(media).length > 0
        )
        .sort((a, b) => a.sortOrder - b.sortOrder);

      renderCurrentMedia();
    }

    // 每个 section 只注册一次，不再随变体切换重复注册
    function handleMediaResize() {
      clearTimeout(mediaResizeTimer);

      mediaResizeTimer = setTimeout(() => {
        if (!section.isConnected) {
          destroyMediaLifecycle();
          return;
        }

        const nextMode = window.innerWidth <= 900
          ? 'mobile'
          : 'desktop';

        // 同一屏幕模式内的尺寸变化不重建轮播和旋转
        if (mediaMode !== null && nextMode !== mediaMode) {
          renderCurrentMedia();
        }
      }, 200);
    }

    function destroyMediaLifecycle() {
      clearTimeout(mediaResizeTimer);
      destroySpins();
      window.removeEventListener('resize', handleMediaResize);
      document.removeEventListener(
        'shopify:section:unload',
        handleMediaSectionUnload
      );
    }

    function handleMediaSectionUnload(event) {
      if (
        event.target === section ||
        event.target?.contains(section) ||
        String(event.detail?.sectionId || '') === String(sid)
      ) {
        destroyMediaLifecycle();
      }
    }

    window.addEventListener('resize', handleMediaResize);
    document.addEventListener(
      'shopify:section:unload',
      handleMediaSectionUnload
    );


    // 画廊── mediaType 6: Pairings + image/video album ──
    function isPairingVideo(url) {
      try {
        const pathname = new URL(url, window.location.href).pathname;
        return /\.(mp4|webm|ogg|ogv|mov|m4v)$/i.test(pathname);
      } catch (_) {
        return false;
      }
    }

    function getPairingResources(media) {
      if (!Array.isArray(media?.extraInfo)) return [];

      return media.extraInfo
        .filter(resource =>
          resource &&
          typeof resource.url === 'string' &&
          resource.url.trim()
        )
        .map(resource => ({
          url: resource.url.trim(),
          alt: typeof resource.alt === 'string' ? resource.alt : '',
          isVideo: isPairingVideo(resource.url.trim())
        }));
    }

    let pairingAlbum = null;

    function ensurePairingAlbum() {
      if (pairingAlbum) return pairingAlbum;

      const dialog = document.createElement('dialog');
      dialog.className = 'dpi-rp__album';
      dialog.id = `dpi-rp-album-${sid}`;
      dialog.setAttribute('aria-label', 'Popular Pairings gallery');

      dialog.innerHTML = `
        <div class="dpi-rp__album-panel">
          <button type="button" class="dpi-rp__album-close"
            aria-label="Close gallery">×</button>
          <div class="dpi-rp__album-stage"></div>
          <button type="button"
            class="dpi-rp__album-arrow dpi-rp__album-prev"
            aria-label="Previous media"><span>‹</span></button>
          <button type="button"
            class="dpi-rp__album-arrow dpi-rp__album-next"
            aria-label="Next media"><span>›</span></button>
          <div class="dpi-rp__album-caption" aria-live="polite"></div>
          <div class="dpi-rp__album-thumbs"
            aria-label="Gallery previews"></div>
        </div>
      `;

      section.appendChild(dialog);

      const stage = dialog.querySelector('.dpi-rp__album-stage');
      const caption = dialog.querySelector('.dpi-rp__album-caption');
      const thumbs = dialog.querySelector('.dpi-rp__album-thumbs');
      const previous = dialog.querySelector('.dpi-rp__album-prev');
      const next = dialog.querySelector('.dpi-rp__album-next');

      let resources = [];
      let activeIndex = 0;
      let returnFocus = null;
      let previousOverflow = '';

      function clearStage() {
        stage.querySelectorAll('video').forEach(video => {
          video.pause();
          video.removeAttribute('src');
          video.load();
        });
        stage.replaceChildren();
      }

      function show(index) {
        if (!resources.length) return;

        activeIndex = (index + resources.length) % resources.length;
        const resource = resources[activeIndex];

        // Pause/unload the previous video before switching.
        clearStage();

        const element = document.createElement(
          resource.isVideo ? 'video' : 'img'
        );

        if (resource.isVideo) {
          element.controls = true;
          element.playsInline = true;
          element.preload = 'metadata';
          element.setAttribute(
            'aria-label',
            resource.alt || `Video ${activeIndex + 1}`
          );
          // No forced autoplay: user controls playback.
        } else {
          element.alt = resource.alt || `Pairing ${activeIndex + 1}`;
        }

        element.src = resource.url;
        stage.appendChild(element);

        caption.textContent =
          `${activeIndex + 1} / ${resources.length}` +
          (resource.alt ? ` · ${resource.alt}` : '');

        Array.from(thumbs.children).forEach((button, index) => {
          const active = index === activeIndex;
          button.classList.toggle('active', active);
          button.setAttribute('aria-pressed', String(active));
        });

        thumbs.children[activeIndex]?.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest',
          inline: 'center'
        });
      }

      function open(items, index, trigger) {
        resources = items;
        if (!resources.length) return;

        returnFocus = trigger || document.activeElement;
        thumbs.replaceChildren();

        resources.forEach((resource, resourceIndex) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'dpi-rp__album-thumb';
          button.setAttribute(
            'aria-label',
            `Show ${resource.isVideo ? 'video' : 'image'} ${resourceIndex + 1}`
          );

          const preview = document.createElement(
            resource.isVideo ? 'video' : 'img'
          );

          if (resource.isVideo) {
            preview.muted = true;
            preview.playsInline = true;
            preview.preload = 'metadata';
            preview.setAttribute('aria-hidden', 'true');
          } else {
            preview.alt = '';
            preview.loading = 'lazy';
          }

          preview.src = resource.url;
          button.appendChild(preview);

          if (resource.isVideo) {
            const badge = document.createElement('span');
            badge.className = 'dpi-rp__album-video-badge';
            badge.textContent = '▶';
            button.appendChild(badge);
          }

          button.addEventListener('click', () => show(resourceIndex));
          thumbs.appendChild(button);
        });

        previous.hidden = resources.length < 2;
        next.hidden = resources.length < 2;

        if (!dialog.open) {
          previousOverflow = document.documentElement.style.overflow;
          dialog.showModal();
          document.documentElement.style.overflow = 'hidden';
        }

        show(index);
      }

      dialog.querySelector('.dpi-rp__album-close')
        .addEventListener('click', () => dialog.close());

      // The transparent area outside the panel closes the dialog.
      dialog.addEventListener('click', event => {
        if (event.target === dialog) dialog.close();
      });

      previous.addEventListener('click', () => show(activeIndex - 1));
      next.addEventListener('click', () => show(activeIndex + 1));

      dialog.addEventListener('keydown', event => {
        // Keep video-control keyboard interactions intact.
        if (event.target.closest('video')) return;

        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          show(activeIndex - 1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          show(activeIndex + 1);
        }
      });

      // Native dialog also supports Escape and traps modal focus.
      dialog.addEventListener('close', () => {
        clearStage();
        thumbs.querySelectorAll('video').forEach(video => {
          video.pause();
          video.removeAttribute('src');
          video.load();
        });
        thumbs.replaceChildren();
        resources = [];
        document.documentElement.style.overflow = previousOverflow;

        if (returnFocus?.isConnected) returnFocus.focus();
      });

      pairingAlbum = { open };
      return pairingAlbum;
    }

    function buildPairings(media) {
      const resources = getPairingResources(media);
      const pictures = resources
        .map((resource, index) => ({ resource, index }))
        // .filter(entry => !entry.resource.isVideo)
        .slice(0, 4);

      if (!pictures.length) return null;

      const wrapper = document.createElement('div');
      wrapper.className = 'dpi-rp__pairings';

      const title = document.createElement('div');
      title.className = 'dpi-rp__pairings-title';
      title.textContent = 'Popular Pairings';

      const grid = document.createElement('div');
      grid.className = 'dpi-rp__pairings-grid';

      pictures.forEach(({ resource, index }, pictureIndex) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'dpi-rp__pairings-card';
        button.setAttribute(
          'aria-label',
          resource.alt || `Open pairing ${pictureIndex + 1}`
        );
        button.setAttribute('aria-haspopup', 'dialog');

        const preview = document.createElement(
          resource.isVideo ? 'video' : 'img'
        );

        if (resource.isVideo) {
          preview.muted = true;
          preview.playsInline = true;
          preview.preload = 'metadata';
          preview.setAttribute('aria-hidden', 'true');
        } else {
          preview.alt = resource.alt || '';
          preview.loading = 'lazy';
        }

        preview.src = resource.url;
        preview.style.cssText =
          'display:block;width:100%;height:100%;object-fit:cover;pointer-events:none;';
        button.appendChild(preview);

        if (resource.isVideo) {
          const badge = document.createElement('span');
          badge.textContent = '▶';
          badge.setAttribute('aria-hidden', 'true');
          badge.style.cssText =
            'position:absolute;right:8px;bottom:8px;z-index:1;' +
            'display:grid;place-items:center;width:28px;height:28px;line-height:28px;' +
            'border-radius:50%;background:rgba(0,0,0,.55);color:#fff;' +
            'font-size:13px;pointer-events:none;';
          button.appendChild(badge);
        }


        // Fourth image gets the reference screenshot overlay.
        if (pictureIndex === 3) {
          const more = document.createElement('span');
          more.className = 'dpi-rp__pairings-more';
          more.textContent = 'View More';
          button.appendChild(more);
        }

        button.addEventListener('click', () => {
          ensurePairingAlbum().open(resources, index, button);
        });

        grid.appendChild(button);
      });

      wrapper.append(title, grid);
      return wrapper;
    }

    function renderPairings(media, index) {
      const pairings = buildPairings(media);
      if (!pairings) return;

      const item = createItem(index, 'dpi-rp__media-item--pairings');
      item.appendChild(pairings);
      mediaGrid.appendChild(item);
    }
    // end 画廊
    function isPortrait(index) { return index >= 4; }

    function createItem(index, extra) {
      const el = document.createElement('div');
      el.className = 'dpi-rp__media-item ' + (isPortrait(index) ? 'dpi-rp__media-item--portrait' : 'dpi-rp__media-item--square') + (extra ? ' ' + extra : '');
      return el;
    }
    // ──（透明底PNG叠加在肤色图之上）──
    function injectDiamondImage(url) {
      const diamondImg = section.querySelector('.dpi-rp__skin-diamond');
      if (!diamondImg || !url) return;
      diamondImg.src = url;
      diamondImg.style.opacity = '1';
    }

    function renderImage(media, index) {
      const item = createItem(index, 'dpi-rp__media-item--clickable');
      const img  = document.createElement('img');
      img.src    = media.url;
      img.alt    = '';
      img.loading= 'lazy';
      img.addEventListener('click', () => openLightbox(media.url));
      item.appendChild(img);
      if (media.extraInfo) {
        const lbl = document.createElement('div');
        lbl.className   = 'dpi-rp__media-label';
        lbl.textContent = media.extraInfo;
        item.appendChild(lbl);
      }
      mediaGrid.appendChild(item);
    }

    function renderVideo(media, index) {
      const item  = createItem(index);
      const video = document.createElement('video');
      video.src       = media.url;
      video.poster    = media.previewImage || '';
      video.muted     = true;
      video.loop      = true;
      video.playsInline = true;
      video.addEventListener('mouseenter', () => video.play());
      video.addEventListener('mouseleave', () => { video.pause(); video.currentTime = 0; });
      item.appendChild(video);
      mediaGrid.appendChild(item);
    }

    function renderModel(media, index) {
      const item    = createItem(index);
      const preview = document.createElement('img');
      preview.src   = media.previewImage || '';
      preview.alt   = '3D Model';
      preview.loading = 'lazy';
      const badge   = document.createElement('div');
      badge.className   = 'dpi-rp__media-badge-3d';
      badge.textContent = '3D';
      badge.addEventListener('click', () => openModelModal(media.url));
      preview.addEventListener('click', () => openModelModal(media.url));
      item.style.cursor = 'pointer';
      item.appendChild(preview);
      item.appendChild(badge);
      mediaGrid.appendChild(item);
    }

    function renderSpin(media, index) {
      const item = createItem(index);
      mediaGrid.appendChild(item);

      mountSpin(item, media, {
        sensitivity: 1.0,
        autoPlaySpeed: 0.5,
        friction: 0.90,
        speedBoost: 2.5,
        maxInertia: 0.8,
        mobile: false
      });
    }

    // ── mediaType 5 — Skin Tone Slider ──
    function renderSkinTone(media, index) {
      const item = createItem(index, 'dpi-rp__media-item--skin-tone');

      // 从数据桥接节点读取3张皮肤图
      const dataEl       = section.querySelector(`#dpi-rp-skin-tone-data-${sid}`);
      const imgDarkSrc   = dataEl?.dataset.imgDark   || '';
      const imgMediumSrc = dataEl?.dataset.imgMedium || '';
      const imgLightSrc  = dataEl?.dataset.imgLight  || '';

      item.innerHTML = `
        <div class="dpi-rp__skin-images">
          <img class="dpi-rp__skin-img dpi-rp__skin-img--dark"
              src="${imgDarkSrc}" alt="Dark skin tone" loading="lazy"
              style="opacity:0;">
          <img class="dpi-rp__skin-img dpi-rp__skin-img--medium"
              src="${imgMediumSrc}" alt="Medium skin tone" loading="lazy"
              style="opacity:1;">
          <img class="dpi-rp__skin-img dpi-rp__skin-img--light"
              src="${imgLightSrc}" alt="Light skin tone" loading="lazy"
              style="opacity:0;">
          <img class="dpi-rp__skin-img dpi-rp__skin-diamond"
              src="" alt="Diamond"
              style="opacity:0;z-index:1;pointer-events:none;object-fit:contain;background:transparent;">
        </div>
        <div class="dpi-rp__skin-slider-wrap">
          <span class="dpi-rp__skin-label">Darker</span>
          <div class="dpi-rp__skin-track">
            <input class="dpi-rp__skin-range"
                  type="range" min="0" max="100" value="50" step="1"
                  orient="vertical">
          </div>
          <span class="dpi-rp__skin-label">Lighter</span>
        </div>
      `;

      mediaGrid.appendChild(item);

      // 绑定滑块
      const range     = item.querySelector('.dpi-rp__skin-range');
      const imgDark   = item.querySelector('.dpi-rp__skin-img--dark');
      const imgMedium = item.querySelector('.dpi-rp__skin-img--medium');
      const imgLight  = item.querySelector('.dpi-rp__skin-img--light');

      function updateOpacity(val) {
        const v = Number(val);
        let oDark, oMedium, oLight;
        if (v <= 50) {
          const t = v / 50;
          oDark = 1 - t; oMedium = t; oLight = 0;
        } else {
          const t = (v - 50) / 50;
          oDark = 0; oMedium = 1 - t; oLight = t;
        }
        if (imgDark)   imgDark.style.opacity   = oDark;
        if (imgMedium) imgMedium.style.opacity = oMedium;
        if (imgLight)  imgLight.style.opacity  = oLight;
      }

      updateOpacity(range.value);
      range.addEventListener('input', e => updateOpacity(e.target.value));
    }


    // ── 渲染 Spec 选择器 ──
    function renderSpecs(trees) {
      // 保留同一个 Browse 按钮节点及其事件，避免重新渲染时被删除。
      if (browseDiamondsBtn) browseDiamondsBtn.remove();

      specsEl.innerHTML = '';
      const hasDiamond = !!localStorage.getItem('current_diamond');

      const isDiamondQualitySpec = spec =>
        String(spec.specName || '').trim().toLowerCase() === 'diamond quality';

      // 仅调整 DOM 渲染顺序，不改变 specTrees 的 SKU 拼接顺序。
      const displayTrees = [
        ...trees.filter(spec => !isDiamondQualitySpec(spec)),
        ...trees.filter(isDiamondQualitySpec)
      ];

      displayTrees.forEach((spec, specIndex) => {
        const isCenterstone = spec.specName && spec.specName.toLowerCase().includes('centerstone'); 
        // ── 有 current_diamond 且是 centerstone：跳过渲染，但默认选中第一个值 ──
        if (hasDiamond && isCenterstone) {
          if (spec.specValues && spec.specValues.length > 0) {
            selectedSpecs[spec.specId] = spec.specValues[0].specValueId;
          }
         
          return; // 跳过 DOM 渲染
        }

        const group = document.createElement('div');
        group.className = 'dpi-rp__spec-group';

        if (isDiamondQualitySpec(spec)) {
          group.dataset.diamondQuality = 'true';
        }


        const labelRow = document.createElement('div');
        labelRow.className = 'dpi-rp__spec-label';

        const specNameEl = document.createElement('span');
        specNameEl.textContent = spec.specName + ': ';

        const selectedValEl = document.createElement('span');
        selectedValEl.className = 'dpi-rp__spec-selected-val';
        const firstSelected = isCenterstone
