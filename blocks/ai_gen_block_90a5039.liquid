{% doc %}
  @prompt
    生成一个拆分展示分区，左边是博客文章一样的功能，右边是博客的菜单，一级二级三级菜单，点击可正常跳转到对应的博客文章, 错了。左边是博客文章分区，右边是可以直接选择一个菜单的分区，比如我制作了一个博客菜单，直接选这个菜单，就展示在右边。类似于书本的目录, 左边修改一下：左边是正常的博客文章分区，只有一篇文章而已，并不是一大堆文章。, 左边修改一下：左边是模板的博客文章分区, 右边修改一下：右边的菜单功能换成手风琴样式
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-split-accordion-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;color:{{ block.settings.text_color }};background:{{ block.settings.background_color }};font-family:{{ settings.type_body_font.family }},sans-serif}.ai-split-accordion-{{ ai_gen_id }}__layout{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(240px,.8fr);gap:48px}.ai-split-accordion-{{ ai_gen_id }}__heading,.ai-split-accordion-{{ ai_gen_id }}__menu-title{color:{{ block.settings.heading_color }};font-family:{{ settings.type_heading_font.family }},sans-serif}.ai-split-accordion-{{ ai_gen_id }}__article{display:grid;grid-template-columns:180px 1fr;gap:20px}.ai-split-accordion-{{ ai_gen_id }}__image,.ai-split-accordion-{{ ai_gen_id }}__placeholder{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:{{ block.settings.image_radius }}px;background:{{ block.settings.placeholder_color }}}.ai-split-accordion-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center}.ai-split-accordion-{{ ai_gen_id }}__placeholder svg{width:65%;height:65%}.ai-split-accordion-{{ ai_gen_id }}__article-title{margin:0 0 10px}.ai-split-accordion-{{ ai_gen_id }}__meta,.ai-split-accordion-{{ ai_gen_id }}__empty{color:{{ block.settings.muted_color }};font-size:13px}.ai-split-accordion-{{ ai_gen_id }}__menu{position:sticky;top:24px;padding:24px;border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.menu_radius }}px;background:{{ block.settings.menu_background }}}.ai-split-accordion-{{ ai_gen_id }}__menu details{border-bottom:1px solid {{ block.settings.border_color }}}.ai-split-accordion-{{ ai_gen_id }}__menu details:last-child{border-bottom:0}.ai-split-accordion-{{ ai_gen_id }}__menu summary{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 0;cursor:pointer;font-weight:600;list-style:none}.ai-split-accordion-{{ ai_gen_id }}__menu summary::-webkit-details-marker{display:none}.ai-split-accordion-{{ ai_gen_id }}__menu summary:after{content:'+';font-size:20px;font-weight:400}.ai-split-accordion-{{ ai_gen_id }}__menu details[open]>summary:after{content:'−'}.ai-split-accordion-{{ ai_gen_id }}__menu ul{margin:0;padding:0 0 10px 16px;list-style:none}.ai-split-accordion-{{ ai_gen_id }}__menu ul ul{padding:0 0 0 16px}.ai-split-accordion-{{ ai_gen_id }}__menu li{padding:6px 0}.ai-split-accordion-{{ ai_gen_id }}__menu a{color:inherit;text-decoration:none}.ai-split-accordion-{{ ai_gen_id }}__menu a:hover{color:{{ block.settings.link_color }};text-decoration:underline}@media(max-width:749px){.ai-split-accordion-{{ ai_gen_id }}__layout{grid-template-columns:1fr;gap:32px}.ai-split-accordion-{{ ai_gen_id }}__menu{position:static}.ai-split-accordion-{{ ai_gen_id }}__article{grid-template-columns:110px 1fr;gap:14px}}
{% endstyle %}
{% assign current_article = article %}<div class="ai-split-accordion-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-split-accordion-{{ ai_gen_id }}__layout"><main>{% if current_article != blank %}<h2 class="ai-split-accordion-{{ ai_gen_id }}__heading">{{ block.settings.article_heading }}</h2><article class="ai-split-accordion-{{ ai_gen_id }}__article">{% if current_article.image %}<img class="ai-split-accordion-{{ ai_gen_id }}__image" src="{{ current_article.image | image_url: width: 600 }}" alt="{{ current_article.image.alt | default: current_article.title | escape }}" width="600" height="450" loading="lazy">{% else %}<div class="ai-split-accordion-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<div><p class="ai-split-accordion-{{ ai_gen_id }}__meta">{{ current_article.published_at | date: '%B %d, %Y' }}</p><h3 class="ai-split-accordion-{{ ai_gen_id }}__article-title">{{ current_article.title }}</h3><div>{{ current_article.content }}</div></div></article>{% else %}<p class="ai-split-accordion-{{ ai_gen_id }}__empty">此分区仅在博客文章模板中显示当前文章。</p>{% endif %}</main><aside class="ai-split-accordion-{{ ai_gen_id }}__menu" aria-label="{{ block.settings.menu_title | escape }}"><h2 class="ai-split-accordion-{{ ai_gen_id }}__menu-title">{{ block.settings.menu_title }}</h2>{% if block.settings.blog_menu != blank %}{% for link in block.settings.blog_menu.links %}<details{% if forloop.first %} open{% endif %}><summary>{{ link.title }}</summary>{% if link.links != blank %}<ul>{% for child_link in link.links %}<li>{% if child_link.links != blank %}<details><summary>{{ child_link.title }}</summary><ul>{% for grandchild_link in child_link.links %}<li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a></li>{% endfor %}</ul></details>{% else %}<a href="{{ child_link.url }}">{{ child_link.title }}</a>{% endif %}</li>{% endfor %}</ul>{% endif %}</details>{% endfor %}{% else %}<p class="ai-split-accordion-{{ ai_gen_id }}__empty">请在主题编辑器中选择博客菜单。</p>{% endif %}</aside></div></div>
{% schema %}{"name":"Split blog accordion","settings":[{"type":"header","content":"Article template"},{"type":"text","id":"article_heading","label":"Article heading","default":"Blog article"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Blog menu"},{"type":"link_list","id":"blog_menu","label":"Menu"},{"type":"text","id":"menu_title","label":"Menu heading","default":"Contents"},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"color","id":"menu_background","label":"Menu background","default":"#F7F6F2"},{"type":"color","id":"heading_color","label":"Headings","default":"#282828"},{"type":"color","id":"text_color","label":"Text","default":"#282828"},{"type":"color","id":"link_color","label":"Links","default":"#073746"},{"type":"color","id":"muted_color","label":"Muted text","default":"#666666"},{"type":"color","id":"border_color","label":"Borders","default":"#D1CDC7"},{"type":"color","id":"placeholder_color","label":"Placeholder","default":"#EEEEEE"},{"type":"header","content":"Style"},{"type":"range","id":"image_radius","label":"Image radius","min":0,"max":24,"step":2,"unit":"px","default":4},{"type":"range","id":"menu_radius","label":"Menu radius","min":0,"max":24,"step":2,"unit":"px","default":8}],"presets":[{"name":"Split blog accordion"}],"tag":null,"class":"split-blog-accordion-block"}{% endschema %}