{% doc %}
  @prompt
    生成一个博客分区，可以控制图片为正方形或者长方形，可以轮播。, 增加一个可以居中的功能。轮播功能需要内置。, 增加一个控制页面宽度的功能, 页面宽度新增功能：可以自己编辑，比如1500px, 博客标题增加控制字体大小功能, 再增加一个控制文章标题大小的功能
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign blo_setts = block.settings %}
{% capture heading_base_class %}ai-blog-carousel-{{ ai_gen_id }}__title{% endcapture %}
{% capture article_base_class %}ai-blog-carousel-{{ ai_gen_id }}__article-title{% endcapture %}
{% style %}
  .ai-blog-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ blo_setts.desktop_width_percent }}%;
    max-width: {{ blo_setts.page_width }}px;
    margin: 0 auto;
    padding: 32px 0;
    background: {{ blo_setts.background_color }};
    color: {{ blo_setts.text_color }};
  }
  .ai-blog-carousel-{{ ai_gen_id }}__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .ai-blog-carousel-{{ ai_gen_id }}__track::-webkit-scrollbar {
    display: none;
  }
  .ai-blog-carousel-{{ ai_gen_id }}__card {
    flex: 0 0 calc((100% - 40px) / 3);
    scroll-snap-align: start;
  }
  .ai-blog-carousel-{{ ai_gen_id }}__image {
    aspect-ratio: {{ blo_setts.image_ratio }};
    overflow: hidden;
    border-radius: {{ blo_setts.card_radius }}px;
    background: {{ blo_setts.image_background }};
  }
  .ai-blog-carousel-{{ ai_gen_id }}__image img,
  .ai-blog-carousel-{{ ai_gen_id }}__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ai-blog-carousel-{{ ai_gen_id }}__title {
    margin: 0 0 24px;
    text-align: {{ blo_setts.content_alignment }};
  }
  .ai-blog-carousel-{{ ai_gen_id }}__meta {
    margin-top: {{ blo_setts.image_title_gap }}px;
    text-align: {{ blo_setts.content_alignment }};
  }
  .ai-blog-carousel-{{ ai_gen_id }}__article-title {
    margin: {% if blo_setts.show_date %}8px 0 0{% else %}0{% endif %};
  }
  .ai-blog-carousel-{{ ai_gen_id }}__meta p {
    margin: 0;
    font-size: 14px;
  }
  @media (max-width: 749px) {
    .ai-blog-carousel-{{ ai_gen_id }} {
      width: 100%;
      max-width: none;
    }
    .ai-blog-carousel-{{ ai_gen_id }}__card {
      flex-basis: 82%;
    }
  }
{% endstyle %}

<blog-carousel-{{ ai_gen_id }}
  class="ai-blog-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <h2
    class="{% render 'lg-typography-classes', settings: blo_setts, prefix: 'heading_', base_class: heading_base_class %}"
    style="{% render 'lg-typography-style', settings: blo_setts, prefix: 'heading_' %}"
  >
    {{ blo_setts.heading | escape }}
  </h2>

  {% if blo_setts.blog != blank %}
    <div class="ai-blog-carousel-{{ ai_gen_id }}__track" data-track>
      {% for article in blo_setts.blog.articles limit: blo_setts.article_limit %}
        <article class="ai-blog-carousel-{{ ai_gen_id }}__card">
          <a href="{{ article.url }}">
            <div class="ai-blog-carousel-{{ ai_gen_id }}__image">
              {% if article.image %}
                <img
                  src="{{ article.image | image_url: width: 900 }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="ai-blog-carousel-{{ ai_gen_id }}__meta">
              {% if blo_setts.show_date %}
                <p>{{ article.published_at | date: '%Y年%m月%d日' }}</p>
              {% endif %}
              <h3
                class="{% render 'lg-typography-classes', settings: blo_setts, prefix: 'article_', base_class: article_base_class %}"
                style="{% render 'lg-typography-style', settings: blo_setts, prefix: 'article_' %}"
              >
                {{ article.title | escape }}
              </h3>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-blog-carousel-{{ ai_gen_id }}__image">{{ 'image' | placeholder_svg_tag }}</div>
  {% endif %}
</blog-carousel-{{ ai_gen_id }}>

<script>
  (function () {
    class C{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.t = this.querySelector('[data-track]');
        if (!this.t) return;
        {% if blo_setts.autoplay %}
        this.i = setInterval(() => this.m(), {{ blo_setts.autoplay_speed | times: 1000 }});
        {% endif %}
      }
      m() {
        let c = this.t.querySelector('.ai-blog-carousel-{{ ai_gen_id }}__card');
        if (!c) return;
        let d = c.getBoundingClientRect().width + 20;
        let e = this.t.scrollWidth - this.t.clientWidth;
        this.t.scrollTo({
          left: this.t.scrollLeft + d >= e ? 0 : this.t.scrollLeft + d,
          behavior: 'smooth'
        });
      }
    }
    if (!customElements.get('blog-carousel-{{ ai_gen_id }}')) {
      customElements.define('blog-carousel-{{ ai_gen_id }}', C{{ ai_gen_id }});
    }
  })();
</script>

