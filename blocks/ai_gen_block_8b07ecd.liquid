{% doc %}
  @prompt
    生成一个博客文章分区。样式参考系统自带的模板, 在文章的右边增加一个菜单侧边栏, 右边的菜单侧边栏是直接选中后台编辑好的菜单，不是让我写的, 不要修改其他设置。菜单侧边栏是可以展开2级和3级类目的。, 不要修改其他设置。菜单侧边栏的样式修改为手风琴，点击可以展开2级和3级类目。, 不要修改其他设置。右边的菜单侧边栏需要修改为手风琴样式，点击自动展开下一个类目, 不要修改其他设置。右边的菜单侧边栏继续修改下样式，修改为手风琴样式, 不要修改其他设置。菜单侧边栏修改样式为手风琴样式，用+-号来打开，二级类目不要出现”总览“文字。, 不要修改其他设置。增加控制展示博客文字图片的功能。, 不要修改其他设置。左边的博客文章，增加一个控制文章标题样式的功能, 不要修改其他设置。右边的菜单侧边栏下面区域，再增加一个单独的热门博客文章展示。, 不要修改其他设置。右边菜单侧边栏下面的热门文章区域，最多可以添加5篇博客，图片可以选择长方形或者竖形或者正方形。, 不要修改其他设置。菜单侧边栏下方区域的热门文章最多可以显示5篇文章，目前没有显示出来, 不要修改其他设置。右边菜单侧边栏的+-符号位置修改到正确的类目位置。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-blog-article-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;padding:{{ block.settings.vertical_spacing }}px 24px;color:{{ block.settings.text_color }};background:{{ block.settings.background_color }}}
.ai-blog-article__inner-{{ ai_gen_id }}{max-width:{{ block.settings.content_width }}px;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) {{ block.settings.sidebar_width }}px;gap:{{ block.settings.column_gap }}px}
.ai-blog-article__main-{{ ai_gen_id }}{min-width:0}.ai-blog-article__header-{{ ai_gen_id }}{text-align:{{ block.settings.alignment }};margin-bottom:36px}.ai-blog-article__title-{{ ai_gen_id }}{margin:0 0 18px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.title_size }}px;font-weight:{{ block.settings.title_weight }};text-transform:{{ block.settings.title_case }};line-height:1.08}.ai-blog-article__meta-{{ ai_gen_id }}{display:flex;justify-content:{{ block.settings.alignment }};gap:18px;color:{{ block.settings.muted_color }};font-size:14px}.ai-blog-article__media-{{ ai_gen_id }}{margin-bottom:40px;background:#f4f4f4;border-radius:{{ block.settings.image_radius }}px;overflow:hidden}.ai-blog-article__media-{{ ai_gen_id }} img,.ai-blog-article__media-{{ ai_gen_id }} svg{display:block;width:100%;height:auto}.ai-blog-article__content-{{ ai_gen_id }}{max-width:760px;margin:auto;font-size:{{ block.settings.body_size }}px;line-height:1.75}.ai-blog-article__sidebar-{{ ai_gen_id }}{position:sticky;top:24px;padding:18px;background:{{ block.settings.sidebar_background }};border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.sidebar_radius }}px;height:max-content}.ai-blog-article__sidebar-title-{{ ai_gen_id }},.ai-blog-article__popular-title-{{ ai_gen_id }}{margin:0;padding:4px 6px 16px;color:{{ block.settings.heading_color }};font-size:18px}.ai-blog-article__nav-{{ ai_gen_id }},.ai-blog-article__nav-{{ ai_gen_id }} ul{margin:0;padding:0;list-style:none}.ai-blog-article__nav-{{ ai_gen_id }} ul ul{padding-left:14px;border-left:1px solid {{ block.settings.border_color }}}.ai-blog-article__nav-{{ ai_gen_id }} li{border-bottom:1px solid {{ block.settings.border_color }}}.ai-blog-article__nav-{{ ai_gen_id }} a,.ai-blog-article__nav-{{ ai_gen_id }} summary{box-sizing:border-box;width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 8px;color:{{ block.settings.text_color }};font-size:14px;text-decoration:none;cursor:pointer;position:relative}.ai-blog-article__nav-{{ ai_gen_id }} summary{list-style:none;font-weight:600}.ai-blog-article__nav-{{ ai_gen_id }} summary::-webkit-details-marker{display:none}.ai-blog-article__nav-{{ ai_gen_id }} summary:after{content:'+';display:inline-flex;align-items:center;justify-content:center;flex:0 0 20px;width:20px;height:20px;font-size:19px;line-height:1;color:{{ block.settings.text_color }};margin-left:auto}.ai-blog-article__nav-{{ ai_gen_id }} details[open]>summary:after{content:'−'}.ai-blog-article__nav-{{ ai_gen_id }} ul ul summary{font-weight:500}.ai-blog-article__popular-{{ ai_gen_id }}{margin-top:24px;padding-top:20px;border-top:1px solid {{ block.settings.border_color }}}.ai-blog-article__popular-list-{{ ai_gen_id }}{display:grid;gap:18px}.ai-blog-article__popular-link-{{ ai_gen_id }}{display:block;color:{{ block.settings.text_color }};text-decoration:none}.ai-blog-article__popular-image-{{ ai_gen_id }}{display:block;width:100%;aspect-ratio:{{ block.settings.popular_image_ratio }};object-fit:cover;margin-bottom:10px;border-radius:{{ block.settings.image_radius }}px;background:#eee}.ai-blog-article__popular-name-{{ ai_gen_id }}{margin:0;font-size:14px;line-height:1.45;font-weight:600}@media(max-width:749px){.ai-blog-article-{{ ai_gen_id }}{padding:32px 16px}.ai-blog-article__inner-{{ ai_gen_id }}{display:flex;flex-direction:column}.ai-blog-article__sidebar-{{ ai_gen_id }}{position:static}.ai-blog-article__title-{{ ai_gen_id }}{font-size:calc({{ block.settings.title_size }}px * .72)}}
{% endstyle %}
<article class="ai-blog-article-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-blog-article__inner-{{ ai_gen_id }}"><main class="ai-blog-article__main-{{ ai_gen_id }}">{% if article != blank %}<header class="ai-blog-article__header-{{ ai_gen_id }}">{% if block.settings.show_article_title %}<h1 class="ai-blog-article__title-{{ ai_gen_id }}">{{ article.title | escape }}</h1>{% endif %}{% if block.settings.show_meta %}<div class="ai-blog-article__meta-{{ ai_gen_id }}"><span>{{ article.published_at | date: block.settings.date_format }}</span>{% if article.author != blank %}<span>{{ article.author | escape }}</span>{% endif %}</div>{% endif %}</header>{% endif %}{% if article != blank and block.settings.show_article_image %}<div class="ai-blog-article__media-{{ ai_gen_id }}">{% if article.image %}<img src="{{ article.image | image_url: width: 1800 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="eager">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div>{% endif %}{% if article != blank and block.settings.show_article_text %}<div class="ai-blog-article__content-{{ ai_gen_id }}">{{ article.content }}</div>{% endif %}</main>{% if block.settings.show_sidebar %}<aside class="ai-blog-article__sidebar-{{ ai_gen_id }}">{% if block.settings.sidebar_menu != blank %}<h2 class="ai-blog-article__sidebar-title-{{ ai_gen_id }}">{{ block.settings.sidebar_title }}</h2><nav class="ai-blog-article__nav-{{ ai_gen_id }}"><ul>{% for link in block.settings.sidebar_menu.links %}<li>{% if link.links != blank %}<details><summary>{{ link.title | escape }}</summary><ul>{% for child_link in link.links %}<li>{% if child_link.links != blank %}<details><summary>{{ child_link.title | escape }}</summary><ul>{% for grandchild_link in child_link.links %}<li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a></li>{% endfor %}</ul></details>{% else %}<a href="{{ child_link.url }}">{{ child_link.title | escape }}</a>{% endif %}</li>{% endfor %}</ul></details>{% else %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endif %}</li>{% endfor %}</ul></nav>{% endif %}{% if block.settings.popular_article != blank or block.settings.popular_article_2 != blank or block.settings.popular_article_3 != blank or block.settings.popular_article_4 != blank or block.settings.popular_article_5 != blank %}<section class="ai-blog-article__popular-{{ ai_gen_id }}"><h2 class="ai-blog-article__popular-title-{{ ai_gen_id }}">{{ block.settings.popular_title }}</h2><div class="ai-blog-article__popular-list-{{ ai_gen_id }}">{% for i in (1..5) %}{% assign article_key = 'popular_article' %}{% if i > 1 %}{% assign article_key = 'popular_article_' | append: i %}{% endif %}{% assign popular_article = block.settings[article_key] %}{% if popular_article != blank %}<a class="ai-blog-article__popular-link-{{ ai_gen_id }}" href="{{ popular_article.url }}">{% if popular_article.image %}<img class="ai-blog-article__popular-image-{{ ai_gen_id }}" src="{{ popular_article.image | image_url: width: 600 }}" alt="{{ popular_article.image.alt | default: popular_article.title | escape }}" loading="lazy">{% endif %}<p class="ai-blog-article__popular-name-{{ ai_gen_id }}">{{ popular_article.title | escape }}</p></a>{% endif %}{% endfor %}</div></section>{% endif %}</aside>{% endif %}</div></article>
{% schema %}{"name":"博客文章","settings":[{"type":"checkbox","id":"show_article_title","label":"显示文章标题","default":true},{"type":"checkbox","id":"show_article_image","label":"显示文章图片","default":true},{"type":"checkbox","id":"show_article_text","label":"显示文章文字","default":true},{"type":"checkbox","id":"show_meta","label":"显示文章信息","default":true},{"type":"text","id":"date_format","label":"日期格式","default":"%Y年%m月%d日"},{"type":"range","id":"title_size","label":"标题大小","min":24,"max":88,"step":2,"unit":"px","default":56},{"type":"select","id":"title_weight","label":"标题粗细","options":[{"value":"400","label":"常规"},{"value":"500","label":"中等"},{"value":"600","label":"半粗"},{"value":"700","label":"粗体"}],"default":"600"},{"type":"select","id":"title_case","label":"标题大小写","options":[{"value":"none","label":"默认"},{"value":"uppercase","label":"全部大写"},{"value":"capitalize","label":"首字母大写"}],"default":"none"},{"type":"checkbox","id":"show_sidebar","label":"显示侧边栏","default":true},{"type":"text","id":"sidebar_title","label":"侧边栏标题","default":"文章导航"},{"type":"link_list","id":"sidebar_menu","label":"选择菜单"},{"type":"article","id":"popular_article","label":"热门文章"},{"type":"article","id":"popular_article_2","label":"热门文章2"},{"type":"article","id":"popular_article_3","label":"热门文章3"},{"type":"article","id":"popular_article_4","label":"热门文章4"},{"type":"article","id":"popular_article_5","label":"热门文章5"},{"type":"text","id":"popular_title","label":"热门文章标题","default":"热门文章"},{"type":"select","id":"popular_image_ratio","label":"图片比例","options":[{"value":"1.5","label":"长方形"},{"value":"0.75","label":"竖形"},{"value":"1","label":"正方形"}],"default":"1.5"},{"type":"range","id":"desktop_width_percent","label":"桌面宽度","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"content_width","label":"内容最大宽度","min":640,"max":1400,"step":40,"unit":"px","default":1120},{"type":"range","id":"sidebar_width","label":"侧边栏宽度","min":180,"max":360,"step":20,"unit":"px","default":240},{"type":"range","id":"column_gap","label":"内容间距","min":20,"max":80,"step":10,"unit":"px","default":40},{"type":"range","id":"vertical_spacing","label":"上下间距","min":20,"max":120,"step":10,"unit":"px","default":60},{"type":"select","id":"alignment","label":"标题对齐","options":[{"value":"left","label":"左对齐"},{"value":"center","label":"居中"}],"default":"center"},{"type":"range","id":"body_size","label":"正文大小","min":14,"max":22,"step":1,"unit":"px","default":16},{"type":"range","id":"image_radius","label":"图片圆角","min":0,"max":24,"step":2,"unit":"px","default":0},{"type":"range","id":"sidebar_radius","label":"侧边栏圆角","min":0,"max":24,"step":2,"unit":"px","default":0},{"type":"color","id":"background_color","label":"背景","default":"#FFFFFF"},{"type":"color","id":"sidebar_background","label":"侧边栏背景","default":"#F5F5F5"},{"type":"color","id":"heading_color","label":"标题","default":"#222222"},{"type":"color","id":"text_color","label":"正文","default":"#000000"},{"type":"color","id":"muted_color","label":"辅助文字","default":"#666666"},{"type":"color","id":"accent_color","label":"强调色","default":"#000F9F"},{"type":"color","id":"border_color","label":"边框","default":"#E6E6E6"}],"presets":[{"name":"博客文章"}],"tag":null,"class":"blog-article-block"}{% endschema %}