{% doc %}
  @prompt
    生成一个手风琴功能，可以自定义页宽，可以自定义配色，可以插入链接, 桌面宽度为1200px, 手风琴里面还可以继续增加手风琴功能，比如增加一个FAQ功能
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-accordion-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width }}px;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-accordion-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-accordion-item-{{ ai_gen_id }} {
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
  }

  .ai-accordion-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.padding }}px;
    cursor: pointer;
    background-color: {{ block.settings.header_background_color }};
    transition: background-color 0.3s ease;
    border: none;
    width: 100%;
    text-align: left;
  }

  .ai-accordion-header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.header_hover_color }};
  }

  .ai-accordion-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0;
  }

  .ai-accordion-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: 16px;
  }

  .ai-accordion-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
  }

  .ai-accordion-item-{{ ai_gen_id }}.active .ai-accordion-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-accordion-content-wrapper-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-accordion-content-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.padding }}px {{ block.settings.padding }}px;
    color: {{ block.settings.content_color }};
    font-size: {{ block.settings.content_size }}px;
    line-height: 1.6;
  }

  .ai-accordion-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-accordion-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-accordion-sub-item-{{ ai_gen_id }} {
    border: 1px solid {{ block.settings.sub_border_color }};
    border-radius: {{ block.settings.sub_border_radius }}px;
    margin-top: {{ block.settings.sub_item_spacing }}px;
    background-color: {{ block.settings.sub_background_color }};
  }

  .ai-accordion-sub-item-{{ ai_gen_id }}:first-child {
    margin-top: 0;
  }

  .ai-accordion-sub-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.sub_padding }}px;
    cursor: pointer;
    background-color: {{ block.settings.sub_header_background_color }};
    transition: background-color 0.3s ease;
    border: none;
    width: 100%;
    text-align: left;
  }

  .ai-accordion-sub-header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.sub_header_hover_color }};
  }

  .ai-accordion-sub-title-{{ ai_gen_id }} {
    color: {{ block.settings.sub_title_color }};
    font-size: {{ block.settings.sub_title_size }}px;
    font-weight: 500;
    margin: 0;
  }

  .ai-accordion-sub-icon-{{ ai_gen_id }} {
    width: {{ block.settings.sub_icon_size }}px;
    height: {{ block.settings.sub_icon_size }}px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: 12px;
  }

  .ai-accordion-sub-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.sub_icon_color }};
  }

  .ai-accordion-sub-item-{{ ai_gen_id }}.active .ai-accordion-sub-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-accordion-sub-content-wrapper-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-accordion-sub-content-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.sub_padding }}px {{ block.settings.sub_padding }}px;
    color: {{ block.settings.sub_content_color }};
    font-size: {{ block.settings.sub_content_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-accordion-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<accordion-block-{{ ai_gen_id }} class="ai-accordion-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-accordion-container-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign title_key = 'item_' | append: i | append: '_title'
        assign content_key = 'item_' | append: i | append: '_content'
        assign has_sub_key = 'item_' | append: i | append: '_has_sub'
        
        assign title = block.settings[title_key]
        assign content = block.settings[content_key]
        assign has_sub = block.settings[has_sub_key]
      %}
      
      {% if title != blank %}
        <div class="ai-accordion-item-{{ ai_gen_id }}" data-accordion-item>
          <button class="ai-accordion-header-{{ ai_gen_id }}" aria-expanded="false">
            <h3 class="ai-accordion-title-{{ ai_gen_id }}">{{ title }}</h3>
            <div class="ai-accordion-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>
          <div class="ai-accordion-content-wrapper-{{ ai_gen_id }}">
            <div class="ai-accordion-content-{{ ai_gen_id }}">
              {% if has_sub %}
                {% for j in (1..3) %}
                  {% liquid
                    assign sub_title_key = 'item_' | append: i | append: '_sub_' | append: j | append: '_title'
                    assign sub_content_key = 'item_' | append: i | append: '_sub_' | append: j | append: '_content'
                    
                    assign sub_title = block.settings[sub_title_key]
                    assign sub_content = block.settings[sub_content_key]
                  %}
                  
                  {% if sub_title != blank %}
                    <div class="ai-accordion-sub-item-{{ ai_gen_id }}" data-sub-accordion-item>
                      <button class="ai-accordion-sub-header-{{ ai_gen_id }}" aria-expanded="false">
                        <h4 class="ai-accordion-sub-title-{{ ai_gen_id }}">{{ sub_title }}</h4>
                        <div class="ai-accordion-sub-icon-{{ ai_gen_id }}">
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                          </svg>
                        </div>
                      </button>
                      <div class="ai-accordion-sub-content-wrapper-{{ ai_gen_id }}">
                        <div class="ai-accordion-sub-content-{{ ai_gen_id }}">
                          {{ sub_content }}
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              {% else %}
                {{ content }}
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</accordion-block-{{ ai_gen_id }}>

<script>
  (function() {
    class AccordionBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('[data-accordion-item]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          const header = item.querySelector('.ai-accordion-header-{{ ai_gen_id }}');
          const contentWrapper = item.querySelector('.ai-accordion-content-wrapper-{{ ai_gen_id }}');
          const content = item.querySelector('.ai-accordion-content-{{ ai_gen_id }}');

          header.addEventListener('click', () => {
            const isActive = item.classList.contains('active');
            
            if (isActive) {
              item.classList.remove('active');
              contentWrapper.style.maxHeight = null;
              header.setAttribute('aria-expanded', 'false');
              
              item.querySelectorAll('[data-sub-accordion-item].active').forEach(subItem => {
                subItem.classList.remove('active');
                const subWrapper = subItem.querySelector('.ai-accordion-sub-content-wrapper-{{ ai_gen_id }}');
                subWrapper.style.maxHeight = null;
              });
            } else {
              item.classList.add('active');
              this.updateMaxHeight(contentWrapper, content);
              header.setAttribute('aria-expanded', 'true');
            }
          });

          const subItems = item.querySelectorAll('[data-sub-accordion-item]');
          subItems.forEach((subItem) => {
            const subHeader = subItem.querySelector('.ai-accordion-sub-header-{{ ai_gen_id }}');
            const subContentWrapper = subItem.querySelector('.ai-accordion-sub-content-wrapper-{{ ai_gen_id }}');
            const subContent = subItem.querySelector('.ai-accordion-sub-content-{{ ai_gen_id }}');

            subHeader.addEventListener('click', (e) => {
              e.stopPropagation();
              const isActive = subItem.classList.contains('active');
              
              if (isActive) {
                subItem.classList.remove('active');
                subContentWrapper.style.maxHeight = null;
                subHeader.setAttribute('aria-expanded', 'false');
              } else {
                subItem.classList.add('active');
                subContentWrapper.style.maxHeight = subContent.scrollHeight + 'px';
                subHeader.setAttribute('aria-expanded', 'true');
              }

              setTimeout(() => {
                this.updateMaxHeight(contentWrapper, content);
              }, 10);
            });
          });
        });
      }

      updateMaxHeight(wrapper, content) {
        wrapper.style.maxHeight = content.scrollHeight + 'px';
      }
    }

    customElements.define('accordion-block-{{ ai_gen_id }}', AccordionBlock{{ ai_gen_id }});
  })();
</script>

