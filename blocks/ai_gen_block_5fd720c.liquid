{% doc %}
  @prompt
    生成一个博客文章的展示栏，我可以控制每行的博客数量，也可以控制页面宽度，并且苦研根据博客的tag进行筛选。筛选是一个按钮Filter by，是根据后台blog的tag来筛选的。再增加一个控制页面宽度的功能，我可以控制页面px。再增加一个控制移动端页面宽度。, 不要修改其他设置。增加一个控制博客照片的功能，包括长方形正方形，以及边角圆角, 不要修改其他设置。单独增加一个页面切换功能，比如每页博客文章的数量为20，当超过20篇博客，就可以点击数字切换到下一页, 不要修改其他设置。filter按钮修改一下样式，换成下拉式, 不要修改其他设置。给filter按钮增加一个控制宽度的功能，移动端按钮宽度有问题。, 不要修改其他设置。Mobile button width按钮宽度改动无效，修改一下
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-blog-showcase-{{ ai_gen_id }}{display:block;width:100%;max-width:{{ block.settings.desktop_width_px }}px;margin:0 auto}.ai-blog-showcase-{{ ai_gen_id }}__filter{width:{{ block.settings.filter_width_px }}px;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;min-height:48px;padding:12px 16px;border:1px solid #000;border-radius:8px;background:#fff;color:#000;cursor:pointer;font:inherit}.ai-blog-showcase-{{ ai_gen_id }}__filter-wrap{position:relative}.ai-blog-showcase-{{ ai_gen_id }}__tags{display:none;position:absolute;z-index:5;top:calc(100% + 6px);left:0;width:{{ block.settings.filter_width_px }}px;box-sizing:border-box;padding:6px;border:1px solid #e6e6e6;border-radius:8px;background:#fff;box-shadow:0 8px 24px rgba(0,0,0,.14)}.ai-blog-showcase-{{ ai_gen_id }}__tags.is-open{display:flex;flex-direction:column}.ai-blog-showcase-{{ ai_gen_id }}__tag{width:100%;padding:10px 12px;border:0;background:#fff;color:#000;text-align:left;cursor:pointer}.ai-blog-showcase-{{ ai_gen_id }}__tag.is-active,.ai-blog-showcase-{{ ai_gen_id }}__tag:hover{background:#125b6e;color:#fff}.ai-blog-showcase-{{ ai_gen_id }}__header{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}.ai-blog-showcase-{{ ai_gen_id }}__title{margin:0}.ai-blog-showcase-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat({{ block.settings.columns_desktop }},minmax(0,1fr));gap:28px 20px}.ai-blog-showcase-{{ ai_gen_id }}__image,.ai-blog-showcase-{{ ai_gen_id }}__placeholder{display:block;width:100%;aspect-ratio:{{ block.settings.image_ratio }};object-fit:cover;border-radius:{{ block.settings.image_radius }}px;background:#f5f5f5}.ai-blog-showcase-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-blog-showcase-{{ ai_gen_id }}__card-link{color:#222;text-decoration:none}.ai-blog-showcase-{{ ai_gen_id }}__meta{margin-top:14px;color:#555;font-size:13px}.ai-blog-showcase-{{ ai_gen_id }}__card-title{font-size:20px}.ai-blog-showcase-{{ ai_gen_id }}__excerpt{color:#555}.ai-blog-showcase-{{ ai_gen_id }}__pagination{display:flex;justify-content:center;gap:8px;margin-top:36px}.ai-blog-showcase-{{ ai_gen_id }}__page{display:inline-flex;min-width:40px;height:40px;align-items:center;justify-content:center;border:1px solid #000;border-radius:100px;color:#000;text-decoration:none}.ai-blog-showcase-{{ ai_gen_id }}__page.is-current,.ai-blog-showcase-{{ ai_gen_id }}__page:hover{background:#125b6e;color:#fff}@media screen and (max-width:749px){.ai-blog-showcase-{{ ai_gen_id }}{width:100%;max-width:{{ block.settings.mobile_width_px }}px;margin-left:auto;margin-right:auto}.ai-blog-showcase-{{ ai_gen_id }}__header{align-items:flex-start;flex-direction:column}.ai-blog-showcase-{{ ai_gen_id }}__filter-wrap{width:100%}.ai-blog-showcase-{{ ai_gen_id }}__filter{width:{{ block.settings.filter_mobile_width_px }}px;max-width:100%;}.ai-blog-showcase-{{ ai_gen_id }}__tags{width:{{ block.settings.filter_mobile_width_px }}px;max-width:100%}.ai-blog-showcase-{{ ai_gen_id }}__grid{grid-template-columns:repeat({{ block.settings.columns_mobile }},minmax(0,1fr))}}
{% endstyle %}
<blog-showcase-{{ ai_gen_id }} class="ai-blog-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{% assign selected_blog=block.settings.blog %}{% if selected_blog != blank %}<div class="ai-blog-showcase-{{ ai_gen_id }}__header">{% if block.settings.heading != blank %}<h2 class="ai-blog-showcase-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.show_filter %}<div class="ai-blog-showcase-{{ ai_gen_id }}__filter-wrap"><button type="button" class="ai-blog-showcase-{{ ai_gen_id }}__filter" aria-expanded="false">{{ block.settings.filter_label | escape }}<span aria-hidden="true">⌄</span></button><div class="ai-blog-showcase-{{ ai_gen_id }}__tags"><button type="button" class="ai-blog-showcase-{{ ai_gen_id }}__tag is-active" data-tag="all">{{ block.settings.all_label | escape }}</button>{% for tag in selected_blog.all_tags %}<button type="button" class="ai-blog-showcase-{{ ai_gen_id }}__tag" data-tag="{{ tag | escape }}">{{ tag | escape }}</button>{% endfor %}</div></div>{% endif %}</div>{% paginate selected_blog.articles by block.settings.articles_per_page %}<div class="ai-blog-showcase-{{ ai_gen_id }}__grid">{% for article in selected_blog.articles %}<article class="ai-blog-showcase-{{ ai_gen_id }}__card" data-tags="{{ article.tags | join:'||' | escape }}"><a class="ai-blog-showcase-{{ ai_gen_id }}__card-link" href="{{ article.url }}">{% if article.image %}<img class="ai-blog-showcase-{{ ai_gen_id }}__image" src="{{ article.image | image_url:width:900 }}" alt="{{ article.image.alt | default:article.title | escape }}" loading="lazy">{% else %}<div class="ai-blog-showcase-{{ ai_gen_id }}__placeholder">{{ 'blog-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-blog-showcase-{{ ai_gen_id }}__meta">{{ article.published_at | date:'%B %d, %Y' }}</div><h3 class="ai-blog-showcase-{{ ai_gen_id }}__card-title">{{ article.title | escape }}</h3>{% if block.settings.show_excerpt and article.excerpt != blank %}<p class="ai-blog-showcase-{{ ai_gen_id }}__excerpt">{{ article.excerpt | strip_html | truncate:120 | escape }}</p>{% endif %}</a></article>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="ai-blog-showcase-{{ ai_gen_id }}__pagination">{% for part in paginate.parts %}{% if part.is_link %}<a class="ai-blog-showcase-{{ ai_gen_id }}__page" href="{{ part.url }}">{{ part.title }}</a>{% else %}<span class="ai-blog-showcase-{{ ai_gen_id }}__page is-current">{{ part.title }}</span>{% endif %}{% endfor %}</nav>{% endif %}{% endpaginate %}{% endif %}</blog-showcase-{{ ai_gen_id }}><script>(function(){class B{{ai_gen_id}} extends HTMLElement{connectedCallback(){let b=this.querySelector('.ai-blog-showcase-{{ai_gen_id}}__filter'),p=this.querySelector('.ai-blog-showcase-{{ai_gen_id}}__tags'),t=this.querySelectorAll('.ai-blog-showcase-{{ai_gen_id}}__tag'),c=this.querySelectorAll('.ai-blog-showcase-{{ai_gen_id}}__card');if(!b)return;b.onclick=()=>{p.classList.toggle('is-open')};t.forEach(x=>x.onclick=()=>{t.forEach(y=>y.classList.toggle('is-active',x===y));c.forEach(y=>y.hidden=x.dataset.tag!=='all'&&!y.dataset.tags.split('||').includes(x.dataset.tag));p.classList.remove('is-open')})}}customElements.define('blog-showcase-{{ai_gen_id}}',B{{ai_gen_id}})})();</script>
{% schema %}{"name":"Blog article showcase","settings":[{"type":"blog","id":"blog","label":"Blog"},{"type":"text","id":"heading","label":"Heading","default":"Latest articles"},{"type":"checkbox","id":"show_excerpt","label":"Show excerpts","default":true},{"type":"text","id":"filter_label","label":"Filter label","default":"Filter by"},{"type":"text","id":"all_label","label":"All label","default":"All"},{"type":"checkbox","id":"show_filter","label":"Show tag filter","default":true},{"type":"range","id":"filter_width_px","label":"Desktop button width","min":120,"max":500,"step":10,"unit":"px","default":210},{"type":"range","id":"filter_mobile_width_px","label":"Mobile button width","min":120,"max":500,"step":10,"unit":"px","default":280},{"type":"select","id":"columns_desktop","label":"Columns per row","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"3"},{"type":"select","id":"columns_mobile","label":"Columns on mobile","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"1"},{"type":"range","id":"desktop_width_px","label":"Desktop width","min":600,"max":1800,"step":50,"unit":"px","default":1200},{"type":"range","id":"mobile_width_px","label":"Mobile width","min":280,"max":900,"step":20,"unit":"px","default":700},{"type":"range","id":"articles_per_page","label":"Articles per page","min":4,"max":50,"step":1,"default":20},{"type":"select","id":"image_ratio","label":"Image shape","options":[{"value":"4 / 3","label":"Rectangle"},{"value":"1 / 1","label":"Square"}],"default":"4 / 3"},{"type":"range","id":"image_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":8}],"presets":[{"name":"Blog article showcase"}],"tag":null,"class":"blog-article-showcase-block"}{% endschema %}