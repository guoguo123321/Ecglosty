{% doc %}
  @prompt
    生成一个拆分展示分区，左边是默认博客页面，右边是手风琴样式的菜单目录。左右分区的宽度比例可以控制。, 右边修改一下：右边不是目录，是一个手风琴功能，我可以选择一个菜单进去, 左边修改一下：左边增加边框的颜色设置。, 左边分区修改一下：左边的边框增加颜色设置选项, 左边修改一下：左边的博客文章内容，去掉边框样式
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-split-blog-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto}.ai-split-blog-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:minmax(0,{{ block.settings.left_width_percent }}fr) minmax(0,{{ block.settings.right_width_percent }}fr);gap:{{ block.settings.column_gap }}px}.ai-split-blog-{{ ai_gen_id }}__article{padding:{{ block.settings.article_padding }}px;background:{{ block.settings.article_background }};color:{{ block.settings.text_color }}}.ai-split-blog-{{ ai_gen_id }}__article h1{margin:0 0 24px;color:{{ block.settings.heading_color }}}.ai-split-blog-{{ ai_gen_id }}__article-content{line-height:1.7}.ai-split-blog-{{ ai_gen_id }}__article-content img{max-width:100%;height:auto}.ai-split-blog-{{ ai_gen_id }}__menu{padding:{{ block.settings.menu_padding }}px;background:{{ block.settings.menu_background }};border:1px solid {{ block.settings.menu_border_color }};color:{{ block.settings.text_color }}}.ai-split-blog-{{ ai_gen_id }}__menu h2{margin:0 0 16px;color:{{ block.settings.heading_color }}}.ai-split-blog-{{ ai_gen_id }}__item{border-top:1px solid {{ block.settings.menu_border_color }}}.ai-split-blog-{{ ai_gen_id }}__item:last-child{border-bottom:1px solid {{ block.settings.menu_border_color }}}.ai-split-blog-{{ ai_gen_id }}__item-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 0}.ai-split-blog-{{ ai_gen_id }}__link{color:{{ block.settings.text_color }};font-weight:600;text-decoration:none}.ai-split-blog-{{ ai_gen_id }}__link:hover{color:{{ block.settings.accent_color }}}.ai-split-blog-{{ ai_gen_id }}__toggle{border:0;background:transparent;color:{{ block.settings.text_color }};font-size:22px;cursor:pointer}.ai-split-blog-{{ ai_gen_id }}__toggle:focus-visible,.ai-split-blog-{{ ai_gen_id }}__link:focus-visible{outline:3px solid {{ block.settings.accent_color }};outline-offset:3px}.ai-split-blog-{{ ai_gen_id }}__children{display:none;padding:0 0 12px 16px}.ai-split-blog-{{ ai_gen_id }}__children.is-open{display:block}.ai-split-blog-{{ ai_gen_id }}__child{display:block;padding:6px 0;color:{{ block.settings.muted_color }};text-decoration:none}.ai-split-blog-{{ ai_gen_id }}__empty{color:{{ block.settings.muted_color }}}@media(max-width:749px){.ai-split-blog-{{ ai_gen_id }}__grid{grid-template-columns:1fr;gap:24px}}
{% endstyle %}
<split-blog-{{ ai_gen_id }} class="ai-split-blog-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-split-blog-{{ ai_gen_id }}__grid"><article class="ai-split-blog-{{ ai_gen_id }}__article">{% if article != blank %}<h1>{{ article.title | escape }}</h1><div class="ai-split-blog-{{ ai_gen_id }}__article-content">{{ article.content }}</div>{% else %}<h1>博客文章</h1><div class="ai-split-blog-{{ ai_gen_id }}__article-content"><p>请在博客文章页面使用此区块。</p></div>{% endif %}</article><nav class="ai-split-blog-{{ ai_gen_id }}__menu" aria-label="{{ block.settings.menu_title | escape }}"><h2>{{ block.settings.menu_title | escape }}</h2>{% if block.settings.navigation_menu != blank and block.settings.navigation_menu.links.size > 0 %}{% for link in block.settings.navigation_menu.links %}<div class="ai-split-blog-{{ ai_gen_id }}__item"><div class="ai-split-blog-{{ ai_gen_id }}__item-head"><a class="ai-split-blog-{{ ai_gen_id }}__link" href="{{ link.url }}">{{ link.title | escape }}</a>{% if link.links.size > 0 %}<button class="ai-split-blog-{{ ai_gen_id }}__toggle" type="button" aria-expanded="false" aria-label="展开菜单">+</button>{% endif %}</div>{% if link.links.size > 0 %}<div class="ai-split-blog-{{ ai_gen_id }}__children">{% for child in link.links %}<a class="ai-split-blog-{{ ai_gen_id }}__child" href="{{ child.url }}">{{ child.title | escape }}</a>{% endfor %}</div>{% endif %}</div>{% endfor %}{% else %}<p class="ai-split-blog-{{ ai_gen_id }}__empty">请在设置中选择一个菜单。</p>{% endif %}</nav></div></split-blog-{{ ai_gen_id }}>
<script>(function(){class SplitBlog{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.querySelectorAll('.ai-split-blog-{{ ai_gen_id }}__toggle').forEach((button)=>{button.addEventListener('click',()=>{const panel=button.closest('.ai-split-blog-{{ ai_gen_id }}__item').querySelector('.ai-split-blog-{{ ai_gen_id }}__children');const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));button.setAttribute('aria-label',open?'展开菜单':'收起菜单');button.textContent=open?'+':'−';panel.classList.toggle('is-open',!open)})})}}if(!customElements.get('split-blog-{{ ai_gen_id }}'))customElements.define('split-blog-{{ ai_gen_id }}',SplitBlog{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Split blog menu","settings":[{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"left_width_percent","label":"Left column width","min":30,"max":70,"step":5,"unit":"%","default":60},{"type":"range","id":"right_width_percent","label":"Right column width","min":30,"max":70,"step":5,"unit":"%","default":40},{"type":"range","id":"column_gap","label":"Column gap","min":0,"max":64,"step":4,"unit":"px","default":32},{"type":"range","id":"article_padding","label":"Article padding","min":0,"max":64,"step":4,"unit":"px","default":32},{"type":"range","id":"menu_padding","label":"Menu padding","min":0,"max":48,"step":4,"unit":"px","default":24},{"type":"header","content":"Menu"},{"type":"text","id":"menu_title","label":"Menu title","default":"浏览更多"},{"type":"link_list","id":"navigation_menu","label":"Choose menu"},{"type":"header","content":"Colors"},{"type":"color","id":"article_background","label":"Article background","default":"#FFFFFF"},{"type":"color","id":"menu_background","label":"Menu background","default":"#F7F6F2"},{"type":"color","id":"menu_border_color","label":"Menu border color","default":"#D1CDC7"},{"type":"color","id":"heading_color","label":"Headings","default":"#282828"},{"type":"color","id":"text_color","label":"Text","default":"#282828"},{"type":"color","id":"muted_color","label":"Muted text","default":"#555555"},{"type":"color","id":"accent_color","label":"Accent","default":"#073746"}],"presets":[{"name":"Split blog menu"}],"tag":null,"class":"split-blog-menu-block"}{% endschema %}