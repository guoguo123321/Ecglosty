

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% unless product_resource == blank %}
  {% if block.settings.show_variants %}
    {% render 'variant-main-picker', product_resource: product_resource, section: section, product: product, block: block %}
  {% endif %}
{% endunless %}

{% schema %}
{
  "name": "t:names.product_variant_picker",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_variant_picker"
    },
    {
      "type": "paragraph",
      "content": "t:content.edit_variants_in_theme_settings"
    },
    {
      "type": "checkbox",
      "id": "show_variants",
      "label": "显示变体",
      "info": "关闭后前台不展示 Variant picker",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_color_option",
      "label": "显示颜色 (Color)",
      "info": "关闭后前台隐藏颜色 / Color / Colour / Metal / 金属 变体选项；其它变体仍正常显示",
      "default": true,
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:options.dropdowns"
        },
        {
          "value": "buttons",
          "label": "t:options.buttons"
        }
      ],
      "default": "buttons",
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:settings.swatches",
      "default": true,
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left",
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "range",
      "id": "option_vertical_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 15,
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "range",
      "id": "option_horizontal_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "header",
      "content": "Browse All Diamonds",
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "checkbox",
      "id": "show_browse_diamonds",
      "label": "显示 Browse All Diamonds",
      "info": "在「主石大小 / carat」等选项旁显示按钮",
      "default": true,
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "text",
      "id": "browse_diamonds_label",
      "label": "按钮文案",
      "default": "Browse All Diamonds",
      "visible_if": "{{ block.settings.show_variants and block.settings.show_browse_diamonds }}"
    },
    {
      "type": "url",
      "id": "browse_diamonds_link",
      "label": "跳转链接",
      "info": "例如选择 Collections → lab-grown-diamond",
      "visible_if": "{{ block.settings.show_variants and block.settings.show_browse_diamonds }}"
    },
    {
      "type": "header",
      "content": "t:content.padding",
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.show_variants }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.show_variants }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_variant_picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
