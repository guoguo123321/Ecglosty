{%- liquid
  assign bk_stts = block.settings
-%}
{% comment %} <div class="img-with-col-box lgs-row"> {% endcomment %}
  <div class="lgs-col-item lgs-col-lg-{{ bk_stts.col_dk }} lgs-col-md-{{ bk_stts.col_tb }} lgs-col-{{ bk_stts.col_mb }} ">
    <div class="lgs-col-inner {{ bk_stts.content_align }} {{ bk_stts.content_align_tb }} {{ bk_stts.content_align_mb }}">
      {% content_for 'blocks' %}
    </div>
  </div>
{% comment %} </div> {% endcomment %}
