{% schema %}
{
  "name": "Accordion Row (ecglosty)",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Accordion Title"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon Image",
      "info": "Optional image displayed before the heading (32x32px)."
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "select",
      "id": "content_type",
      "label": "Content type",
      "default": "text",
      "options": [
        { "value": "text",    "label": "Plain text" },
        { "value": "richtext","label": "Rich text / HTML" },
        { "value": "page",    "label": "Page content" }
      ]
    },
    {
      "type": "textarea",
      "id": "text_content",
      "label": "Text content",
      "info": "Used when content type is 'Plain text'."
    },
    {
      "type": "richtext",
      "id": "richtext_content",
      "label": "Rich text content",
      "info": "Used when content type is 'Rich text / HTML'."
    },
    {
      "type": "page",
      "id": "page_content",
      "label": "Page",
      "info": "Used when content type is 'Page content'."
    }
  ],
  "presets": [
    {
      "name": "Accordion Row (ecglosty)",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}